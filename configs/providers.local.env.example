# Copy this file outside the repository and fill in the keys:
#   cp configs/providers.local.env.example ../packy.env
#   chmod 600 ../packy.env
# Never commit the filled-in file or paste its contents into logs.

# Strong author/reference model: Anthropic Messages-compatible endpoint.
ANTHROPIC_BASE_URL=https://www.packyapi.com/v1/messages
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=REPLACE_WITH_STRONG_MODEL_KEY

# Weak hidden-test model: OpenAI Responses-compatible endpoint.
PACKY_RESPONSES_BASE_URL=https://www.packyapi.com/v1/responses
HIDDEN_TEST_MODEL=gpt-5.6-sol
HIDDEN_TEST_API_MODE=responses
PACKY_RESPONSES_API_KEY=REPLACE_WITH_HIDDEN_TEST_MODEL_KEY
