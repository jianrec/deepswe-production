+        // None of these exist, so all sizes are 0 and ordering falls back to
+        // the path tie-breaker.
+        assert_eq!(
+            sorted(&["c", "a", "b"], SortBy::Size, false),
+            vec!["a", "b", "c"]
+        );
+    }
+
+    #[test]
+    fn sort_by_size_is_numeric_not_lexicographic() {
+        use std::io::Write;
+        let dir = std::env::temp_dir().join("fd_sort_size_test_numeric");
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+
+        let small = dir.join("small.txt");
+        let large = dir.join("large.txt");
+        std::fs::File::create(&small)
+            .unwrap()
+            .write_all(&[b'x'; 9])
+            .unwrap();
+        std::fs::File::create(&large)
+            .unwrap()
+            .write_all(&[b'x'; 100])
+            .unwrap();
