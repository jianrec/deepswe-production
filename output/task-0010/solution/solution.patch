+            vec!["b/x", "a/z", "a/a"]
+        );
+    }
+
+    #[test]
+    fn sort_by_name_breaks_ties_by_path() {
+        // All three basenames differ except the two "a" files; the "a" files
+        // must be ordered by their full path.
+        assert_eq!(
+            sorted(&["z/a", "a/a", "a/b"], SortBy::Name, false),
+            vec!["a/a", "z/a", "a/b"]
