+        let mut entries = vec![
+            DirEntry::broken_symlink(large.clone()),
+            DirEntry::broken_symlink(small.clone()),
+        ];
+        // Broken-symlink entries read metadata via symlink_metadata, which for
+        // a real regular file returns its true length. The 9-byte file must
+        // precede the 100-byte file numerically.
+        sort_results(&mut entries, SortBy::Size, false);
+        assert_eq!(entries[0].path(), small.as_path());
+        assert_eq!(entries[1].path(), large.as_path());
+
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn timestamp_keys_missing_metadata_do_not_panic() {
+        // None of these paths exist, so timestamps are unavailable and must
+        // fall back to the UNIX epoch without panicking; equal epochs then fall
+        // back to the path tie-breaker.
+        for key in [
+            SortBy::Modified,
+            SortBy::Accessed,
+            SortBy::Created,
+            SortBy::Size,
+        ] {
+            let result = sorted(&["b", "a", "c"], key, false);
+            assert_eq!(result, vec!["a", "b", "c"], "key {key:?} misbehaved");
+        }
+    }
+
