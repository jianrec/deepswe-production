+/// Print a sequence of already-ordered entries using a single writer.
+///
+/// Used by the sorted (buffered) output path, where every matching entry has
+/// been collected and sorted before any output is produced. Each entry is
+/// formatted exactly as in the streaming path (long-format/color/null-separator
+/// handling all live in [`print_entry`]), so only the ordering differs.
+pub fn print_entries<W: Write>(
+    stdout: &mut W,
+    entries: &[DirEntry],
+    config: &Config,
+) -> io::Result<()> {
+    for entry in entries {
+        print_entry(stdout, entry, config)?;
+    }
+    Ok(())
+}
