@@ -0,0 +1,560 @@
+//! Deterministic sorting of search results.
+//!
+//! By default `fd` streams matching entries to the output in the order in
+//! which the parallel directory walk discovers them. That order is not
+//! deterministic: it depends on the number of worker threads, on scheduling,
+//! and on the underlying filesystem. This module provides a first-class
+//! sorting facility that, when enabled, buffers every matching entry and
+//! arranges the full set into a *total, deterministic* order so that identical
+//! inputs always produce identical output regardless of thread count.
+//!
+//! The public surface is intentionally small:
+//!
+//! * [`SortBy`] enumerates the accepted sort keys (and doubles as the
+//!   `clap::ValueEnum` used by the CLI).
+//! * [`compare`] defines the total order between two [`DirEntry`] values for a
+//!   given key.
+//! * [`sort_results`] sorts a vector of entries in place, optionally reversing
+//!   the final order.
+//!
+//! Every ordering rule ultimately falls back to comparing the raw bytes of the
+//! full path, which guarantees a strict total order even when two entries share
+//! the same name, size, timestamp, or extension. Comparisons operate on raw OS
+//! bytes and are therefore case-sensitive; smart-case matching is unrelated to
+//! sorting.
+
+use std::cmp::Ordering;
+use std::ffi::OsStr;
+use std::fs::Metadata;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use clap::ValueEnum;
+
+use crate::dir_entry::DirEntry;
+
+/// The key used to sort search results.
+///
+/// [`SortBy::None`] preserves the historical streaming behavior (results
+/// printed as they are discovered, with no buffering). Any other variant
+/// switches `fd` into buffered mode: every matching entry is collected across
+/// all search roots, sorted according to a total, deterministic order, and only
+/// then produced as output (or fed to `--exec`/`--exec-batch`).
+///
+/// The enum derives [`clap::ValueEnum`] so it can be used directly as the value
+/// parser for the `--sort` option; the variant names map to the lower-case CLI
+/// keys `none`, `path`, `name`, `size`, `modified`, `accessed`, `created`, and
+/// `extension`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default, ValueEnum)]
+pub enum SortBy {
+    /// Do not sort; preserve traversal (streaming) order. This is the default
+    /// and keeps the streaming, unbuffered code path untouched.
+    #[default]
+    None,
+    /// Sort by the full path, compared by raw OS bytes.
+    Path,
+    /// Sort by file name (basename), tie-broken by full path.
+    Name,
+    /// Sort by file size in bytes (numeric), tie-broken by full path.
+    Size,
+    /// Sort by modification time (oldest first), tie-broken by full path.
+    Modified,
+    /// Sort by access time (oldest first), tie-broken by full path.
+    Accessed,
+    /// Sort by creation time (oldest first), tie-broken by full path.
+    Created,
+    /// Sort by file extension, entries without an extension first, then by
+    /// file name, then by full path.
+    Extension,
+}
+
+impl SortBy {
+    /// Whether this key requires buffering all results before producing output.
+    ///
+    /// Every key except [`SortBy::None`] buffers. This helper keeps the
+    /// buffering decision in one place so callers do not need to spell out the
+    /// comparison against `None` themselves.
+    #[inline]
+    pub fn is_buffered(self) -> bool {
+        self != SortBy::None
+    }
+
+    /// Whether this key derives its ordering from filesystem metadata.
+    ///
+    /// `size`, `modified`, `accessed`, and `created` all read [`Metadata`];
+    /// the remaining keys only look at the path. This is primarily useful for
+    /// reasoning about the fallback behavior when metadata is unavailable.
+    #[inline]
+    pub fn needs_metadata(self) -> bool {
+        matches!(
+            self,
+            SortBy::Size | SortBy::Modified | SortBy::Accessed | SortBy::Created
+        )
+    }
+}
+
+/// The raw encoded bytes backing an [`OsStr`].
+///
+/// `OsStr::as_encoded_bytes` returns a platform-defined but stable encoding
+/// that round-trips and preserves byte-wise ordering, which is exactly what we
+/// need for a deterministic, case-sensitive comparison.
+#[inline]
+fn os_bytes(s: &OsStr) -> &[u8] {
+    s.as_encoded_bytes()
+}
+
+/// The raw path bytes of an entry.
+#[inline]
+fn path_bytes(entry: &DirEntry) -> &[u8] {
+    os_bytes(entry.path().as_os_str())
+}
+
+/// Compare two entries by the raw bytes of their full path.
+///
+/// This is the universal tie-breaker that upgrades every per-key ordering into
+/// a strict total order: two distinct entries always have distinct paths, so
+/// comparing paths can only return [`Ordering::Equal`] for genuinely identical
+/// entries.
+#[inline]
+fn cmp_path(a: &DirEntry, b: &DirEntry) -> Ordering {
+    path_bytes(a).cmp(path_bytes(b))
+}
+
+/// The raw bytes of an entry's file name (basename), or an empty slice if it
+/// has none (e.g. a root path).
+#[inline]
+fn file_name_bytes(entry: &DirEntry) -> &[u8] {
+    entry.path().file_name().map(os_bytes).unwrap_or(&[])
+}
+
+/// Compare two entries by file name (basename), then fall back to the full
+/// path to guarantee a total order.
+#[inline]
+fn cmp_name(a: &DirEntry, b: &DirEntry) -> Ordering {
+    file_name_bytes(a)
+        .cmp(file_name_bytes(b))
+        .then_with(|| cmp_path(a, b))
+}
+
+/// The byte length reported by an entry's metadata, or `0` when metadata is
+/// unavailable (broken symlinks, permission errors, races, ...).
+///
+/// Treating missing metadata as size `0` is what the documented ordering rule
+/// requires and, combined with the path tie-breaker, keeps the comparison a
+/// total order and panic-free.
+#[inline]
+fn size_of(entry: &DirEntry) -> u64 {
+    entry.metadata().map(Metadata::len).unwrap_or(0)
+}
+
+/// Compare two entries by numeric byte length, then by full path.
+///
+/// The comparison is numeric (`u64`), so a 9-byte file precedes a 100-byte
+/// file; a naive lexicographic comparison of the decimal strings would order
+/// them the other way around.
+#[inline]
+fn cmp_size(a: &DirEntry, b: &DirEntry) -> Ordering {
+    size_of(a).cmp(&size_of(b)).then_with(|| cmp_path(a, b))
+}
+
+/// Extract a [`SystemTime`] from an entry's metadata using `extract`, falling
+/// back to the UNIX epoch when metadata is missing or the timestamp is not
+/// available on the current platform.
+///
+/// The fallback is what makes the timestamp keys robust: platforms that do not
+/// track, say, creation time simply sort those entries as the epoch rather than
+/// panicking or producing a partial order.
+#[inline]
+fn time_of<F>(entry: &DirEntry, extract: F) -> SystemTime
+where
+    F: Fn(&Metadata) -> std::io::Result<SystemTime>,
+{
+    entry
+        .metadata()
+        .and_then(|m| extract(m).ok())
+        .unwrap_or(UNIX_EPOCH)
+}
+
+/// Compare two entries by a `SystemTime` extracted from their metadata
+/// (ascending, oldest first), then by full path.
+#[inline]
+fn cmp_time<F>(a: &DirEntry, b: &DirEntry, extract: F) -> Ordering
+where
+    F: Fn(&Metadata) -> std::io::Result<SystemTime>,
+{
+    time_of(a, &extract)
+        .cmp(&time_of(b, &extract))
+        .then_with(|| cmp_path(a, b))
+}
+
+/// Compare two optional extensions with "no extension" ordering before any
+/// extension, and present extensions compared by raw bytes.
+#[inline]
+fn cmp_extension_opt(a: Option<&OsStr>, b: Option<&OsStr>) -> Ordering {
+    match (a, b) {
+        (None, None) => Ordering::Equal,
+        (None, Some(_)) => Ordering::Less,
+        (Some(_), None) => Ordering::Greater,
+        (Some(x), Some(y)) => os_bytes(x).cmp(os_bytes(y)),
+    }
+}
+
+/// Compare two entries by file extension (entries without an extension first),
+/// then by file name, then by full path.
+#[inline]
+fn cmp_extension(a: &DirEntry, b: &DirEntry) -> Ordering {
+    cmp_extension_opt(a.extension(), b.extension())
+        .then_with(|| file_name_bytes(a).cmp(file_name_bytes(b)))
+        .then_with(|| cmp_path(a, b))
+}
+
+/// Total, deterministic ordering of two entries for the given sort key.
+///
+/// Every branch ultimately falls back to comparing the full path bytes, so the
+/// result is a strict total order: for any three entries the ordering is
+/// reflexive, antisymmetric, and transitive, and identical inputs always
+/// produce identical output regardless of the thread count used during
+/// traversal.
+///
+/// `SortBy::None` is treated as "compare by path" here so that callers who ask
+/// for a comparison unconditionally still get a well-defined total order; the
+/// streaming decision (whether to sort at all) lives in [`sort_results`].
+pub fn compare(a: &DirEntry, b: &DirEntry, sort_by: SortBy) -> Ordering {
+    match sort_by {
+        SortBy::None | SortBy::Path => cmp_path(a, b),
+        SortBy::Name => cmp_name(a, b),
+        SortBy::Size => cmp_size(a, b),
+        SortBy::Modified => cmp_time(a, b, Metadata::modified),
+        SortBy::Accessed => cmp_time(a, b, Metadata::accessed),
+        SortBy::Created => cmp_time(a, b, Metadata::created),
+        SortBy::Extension => cmp_extension(a, b),
+    }
+}
+
+/// Sort a vector of entries in place according to `sort_by`, optionally
+/// reversing the final order.
+///
+/// A [`SortBy::None`] key is a no-op so the streaming code path stays untouched
+/// (and `reverse` is ignored in that case, mirroring the CLI constraint that
+/// `--reverse` requires a non-`none` `--sort`). For any other key the entries
+/// are sorted with the total order defined by [`compare`]; because the order is
+/// total, a stable or unstable sort would yield the same result, but we use a
+/// stable sort so the behavior is easy to reason about.
+///
+/// Reversing is applied *after* sorting so that `--sort <key> --reverse`
+/// produces exactly the reverse of `--sort <key>`.
+pub fn sort_results(entries: &mut Vec<DirEntry>, sort_by: SortBy, reverse: bool) {
+    if sort_by == SortBy::None {
+        return;
+    }
+
+    entries.sort_by(|a, b| compare(a, b, sort_by));
+
+    if reverse {
+        entries.reverse();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::dir_entry::DirEntry;
+    use std::path::PathBuf;
+
+    /// Construct a `DirEntry` from an arbitrary (possibly nonexistent) path
+    /// without touching the disk. Using the broken-symlink constructor lets us
+    /// exercise the path-based ordering rules deterministically; metadata-based
+    /// keys fall back to their documented defaults because the paths do not
+    /// exist.
+    fn entry(path: &str) -> DirEntry {
+        DirEntry::broken_symlink(PathBuf::from(path))
+    }
+
+    /// Sort the given paths by `sort_by`/`reverse` and return the resulting
+    /// path strings, for convenient assertions.
+    fn sorted(paths: &[&str], sort_by: SortBy, reverse: bool) -> Vec<String> {
+        let mut entries: Vec<DirEntry> = paths.iter().map(|p| entry(p)).collect();
+        sort_results(&mut entries, sort_by, reverse);
+        entries
+            .iter()
+            .map(|e| e.path().to_string_lossy().into_owned())
+            .collect()
+    }
+
+    #[test]
+    fn none_preserves_order() {
+        assert_eq!(
+            sorted(&["b", "a", "c"], SortBy::None, false),
+            vec!["b", "a", "c"]
+        );
+    }
+
+    #[test]
+    fn none_ignores_reverse() {
+        // `--reverse` requires a non-none key, so `None` must ignore it and
+        // leave the input order completely untouched.
+        assert_eq!(
+            sorted(&["b", "a", "c"], SortBy::None, true),
+            vec!["b", "a", "c"]
+        );
+    }
+
+    #[test]
+    fn sort_by_path_is_byte_order() {
+        assert_eq!(
+            sorted(&["b/x", "a/z", "a/a"], SortBy::Path, false),
+            vec!["a/a", "a/z", "b/x"]
+        );
+    }
+
+    #[test]
+    fn sort_by_path_reversed() {
+        assert_eq!(
