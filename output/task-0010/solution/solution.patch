+        let mut expected = forward.clone();
+        expected.reverse();
+        assert_eq!(sorted(&["a/a", "a/z", "b/x"], SortBy::Path, true), expected);
+    }
+
+    #[test]
+    fn compare_is_reflexive() {
+        let a = entry("some/path");
+        for key in [
+            SortBy::None,
+            SortBy::Path,
+            SortBy::Name,
+            SortBy::Size,
+            SortBy::Modified,
+            SortBy::Accessed,
+            SortBy::Created,
+            SortBy::Extension,
+        ] {
+            assert_eq!(compare(&a, &a, key), Ordering::Equal, "key {key:?}");
+        }
+    }
+
+    #[test]
+    fn compare_is_antisymmetric() {
+        let a = entry("a/a");
+        let b = entry("a/b");
+        for key in [
+            SortBy::Path,
+            SortBy::Name,
+            SortBy::Size,
+            SortBy::Modified,
+            SortBy::Accessed,
+            SortBy::Created,
+            SortBy::Extension,
+        ] {
+            let ab = compare(&a, &b, key);
+            let ba = compare(&b, &a, key);
+            assert_eq!(ab, ba.reverse(), "key {key:?} not antisymmetric");
+            assert_ne!(ab, Ordering::Equal, "distinct paths must not be equal");
+        }
+    }
+
+    #[test]
+    fn compare_is_transitive() {
+        // For a total order, a <= b and b <= c must imply a <= c.
+        let paths = ["a/a", "a/b", "b/a", "b/b", "c", "d.rs", "e.md", "f"];
+        for key in [
+            SortBy::Path,
+            SortBy::Name,
+            SortBy::Size,
+            SortBy::Extension,
+        ] {
+            let entries: Vec<DirEntry> = paths.iter().map(|p| entry(p)).collect();
+            for i in 0..entries.len() {
+                for j in 0..entries.len() {
+                    for k in 0..entries.len() {
+                        let ij = compare(&entries[i], &entries[j], key);
+                        let jk = compare(&entries[j], &entries[k], key);
+                        let ik = compare(&entries[i], &entries[k], key);
+                        if ij != Ordering::Greater && jk != Ordering::Greater {
+                            assert_ne!(
