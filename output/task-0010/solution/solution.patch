+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn sort_is_deterministic_across_input_permutations() {
+        // The total order guarantees the same output regardless of the initial
+        // (traversal) order, which is exactly the cross-thread-count guarantee.
+        let base = sorted(&["a/a", "a/z", "b/x", "c/c"], SortBy::Path, false);
+        let permutations: &[&[&str]] = &[
+            &["a/a", "a/z", "b/x", "c/c"],
+            &["c/c", "b/x", "a/z", "a/a"],
+            &["b/x", "c/c", "a/a", "a/z"],
+            &["a/z", "a/a", "c/c", "b/x"],
+        ];
+        for perm in permutations {
+            assert_eq!(sorted(perm, SortBy::Path, false), base);
+        }
+    }
+
+    #[test]
+    fn is_buffered_matches_none() {
+        assert!(!SortBy::None.is_buffered());
+        for key in [
+            SortBy::Path,
+            SortBy::Name,
+            SortBy::Size,
+            SortBy::Modified,
+            SortBy::Accessed,
+            SortBy::Created,
+            SortBy::Extension,
+        ] {
+            assert!(key.is_buffered(), "key {key:?} should buffer");
+        }
+    }
+
+    #[test]
+    fn needs_metadata_only_for_size_and_times() {
+        assert!(SortBy::Size.needs_metadata());
+        assert!(SortBy::Modified.needs_metadata());
+        assert!(SortBy::Accessed.needs_metadata());
+        assert!(SortBy::Created.needs_metadata());
+        assert!(!SortBy::None.needs_metadata());
+        assert!(!SortBy::Path.needs_metadata());
+        assert!(!SortBy::Name.needs_metadata());
+        assert!(!SortBy::Extension.needs_metadata());
+    }
+
+    #[test]
+    fn extension_helper_orders_none_before_present() {
+        assert_eq!(
+            cmp_extension_opt(None, Some(OsStr::new("rs"))),
+            Ordering::Less
+        );
+        assert_eq!(
+            cmp_extension_opt(Some(OsStr::new("rs")), None),
+            Ordering::Greater
+        );
+        assert_eq!(cmp_extension_opt(None, None), Ordering::Equal);
+        assert_eq!(
+            cmp_extension_opt(Some(OsStr::new("a")), Some(OsStr::new("b"))),
+            Ordering::Less
+        );
+    }
+
+    #[test]
+    fn empty_input_sorts_without_panic() {
+        let mut entries: Vec<DirEntry> = Vec::new();
+        sort_results(&mut entries, SortBy::Name, true);
+        assert!(entries.is_empty());
+    }
+
+    #[test]
+    fn single_element_is_stable() {
+        assert_eq!(sorted(&["only"], SortBy::Size, true), vec!["only"]);
+        assert_eq!(sorted(&["only"], SortBy::Name, false), vec!["only"]);
+    }
+}
