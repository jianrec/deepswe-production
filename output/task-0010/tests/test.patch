+use std::fs;
+use std::process::{Command, Output};
+use tempfile::TempDir;
+
+fn run(dir: &TempDir, args: &[&str]) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_fd")).current_dir(dir.path()).env("NO_COLOR", "1").args(args).output().unwrap()
+}
+fn text_lines(output: &Output) -> Vec<String> {
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+    String::from_utf8(output.stdout.clone()).unwrap().lines().map(str::to_owned).collect()
+}
+
+#[test]
+fn null_separator_preserves_sorted_order() {
+    let dir = TempDir::new().unwrap();
+    for name in ["z", "a", "m"] { fs::write(dir.path().join(name), b"").unwrap(); }
+    let output = run(&dir, &["--color", "never", "--type", "f", "--sort", "name", "--print0"]);
+    assert!(output.status.success());
+    assert_eq!(output.stdout, b"./a\0./m\0./z\0");
+}
+
+#[test]
+fn list_details_preserves_name_sorted_path_order() {
+    let dir = TempDir::new().unwrap();
+    for name in ["z", "a", "m"] { fs::write(dir.path().join(name), b"x").unwrap(); }
+    let output = run(&dir, &["--color", "never", "--type", "f", "--sort", "name", "--list-details"]);
+    let names: Vec<_> = text_lines(&output).iter().map(|line| line.split_whitespace().last().unwrap().to_owned()).collect();
+    assert_eq!(names, ["./a", "./m", "./z"]);
+}
+
+#[test]
+fn hidden_filtering_remains_active_when_sorting() {
+    let dir = TempDir::new().unwrap();
+    fs::write(dir.path().join("visible"), b"").unwrap(); fs::write(dir.path().join(".hidden"), b"").unwrap();
+    assert_eq!(text_lines(&run(&dir, &["--color", "never", "--type", "f", "--sort", "path"])), ["visible"]);
+}
+
+#[test]
+fn explicit_hidden_results_are_sorted_normally() {
+    let dir = TempDir::new().unwrap();
+    for name in ["visible", ".z-hidden", ".a-hidden"] { fs::write(dir.path().join(name), b"").unwrap(); }
+    assert_eq!(text_lines(&run(&dir, &["--color", "never", "--type", "f", "--hidden", "--sort", "path"])), [".a-hidden", ".z-hidden", "visible"]);
+}
+
+#[test]
+fn no_matches_keeps_the_existing_nonzero_exit_code() {
+    let dir = TempDir::new().unwrap();
+    fs::write(dir.path().join("present"), b"").unwrap();
+    let output = run(&dir, &["--color", "never", "--sort", "name", "does-not-match"]);
+    assert!(!output.status.success());
+    assert!(output.stdout.is_empty());
+}
