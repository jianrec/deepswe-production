new file mode 100644
index 0000000..44baeac
--- /dev/null
+++ b/tests/hidden_sort_cli.rs
@@ -0,0 +1,56 @@
+use std::fs;
+use std::process::{Command, Output};
+use tempfile::TempDir;
+
+fn run(dir: &TempDir, args: &[&str]) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_fd")).current_dir(dir.path()).args(["--color", "never"]).args(args).output().unwrap()
+}
+fn stdout(output: &Output) -> String { String::from_utf8(output.stdout.clone()).unwrap() }
+fn stderr(output: &Output) -> String { String::from_utf8(output.stderr.clone()).unwrap() }
+
+#[test]
+fn invalid_sort_value_is_a_usage_error_listing_all_keys() {
+    let dir = TempDir::new().unwrap();
+    let output = run(&dir, &["--sort", "bogus"]);
+    assert!(!output.status.success());
+    let error = stderr(&output);
+    for key in ["path", "name", "size", "modified", "accessed", "created", "extension", "none"] { assert!(error.contains(key), "missing {key}: {error}"); }
+}
+
+#[test]
+fn reverse_without_sort_is_rejected_by_clap() {
+    let dir = TempDir::new().unwrap();
+    let output = run(&dir, &["--reverse"]);
+    assert!(!output.status.success());
+    assert!(stderr(&output).contains("--sort"));
+}
+
+#[test]
+fn reverse_with_sort_none_is_rejected() {
+    let dir = TempDir::new().unwrap();
+    let output = run(&dir, &["--sort", "none", "--reverse"]);
+    assert!(!output.status.success());
+    let error = stderr(&output);
+    assert!(error.contains("--sort"));
+    assert!(error.contains("--reverse"));
+}
+
+#[test]
+fn explicit_sort_none_is_accepted_and_matches_unsorted_single_thread_output() {
+    let dir = TempDir::new().unwrap();
+    for name in ["c", "a", "b"] { fs::write(dir.path().join(name), b"").unwrap(); }
+    let base = run(&dir, &["--threads", "1", "--type", "f"]);
+    let none = run(&dir, &["--threads", "1", "--type", "f", "--sort", "none"]);
+    assert!(base.status.success()); assert!(none.status.success());
+    assert_eq!(stdout(&base), stdout(&none));
+}
+
+#[test]
+fn long_help_advertises_sort_and_reverse() {
+    let dir = TempDir::new().unwrap();
+    let output = run(&dir, &["--help"]);
+    assert!(output.status.success());
+    let help = stdout(&output);
+    assert!(help.contains("--sort <key>"));
+    assert!(help.contains("--reverse"));
+}
