+use std::fs;
+use std::process::{Command, Output};
+use tempfile::TempDir;
+
+fn run(dir: &TempDir, args: &[&str]) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_fd")).current_dir(dir.path()).args(["--color", "never", "--type", "f"]).args(args).output().unwrap()
+}
+fn lines(output: &Output) -> Vec<String> {
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+    String::from_utf8(output.stdout.clone()).unwrap().lines().map(str::to_owned).collect()
+}
+fn file(dir: &TempDir, name: &str, size: usize) { fs::write(dir.path().join(name), vec![b'x'; size]).unwrap(); }
+
+#[test]
+fn sort_size_uses_numeric_byte_lengths() {
+    let dir = TempDir::new().unwrap();
+    file(&dir, "hundred", 100); file(&dir, "nine", 9); file(&dir, "ten", 10);
+    assert_eq!(lines(&run(&dir, &["--sort", "size"])), ["nine", "ten", "hundred"]);
+}
+
+#[test]
+fn sort_size_breaks_ties_by_full_path() {
+    let dir = TempDir::new().unwrap();
+    for name in ["z", "a", "m"] { file(&dir, name, 7); }
+    assert_eq!(lines(&run(&dir, &["--sort", "size"])), ["a", "m", "z"]);
+}
+
+#[test]
+fn sort_size_places_zero_length_files_first() {
+    let dir = TempDir::new().unwrap();
+    file(&dir, "nonempty", 1); file(&dir, "empty-b", 0); file(&dir, "empty-a", 0);
+    assert_eq!(lines(&run(&dir, &["--sort", "size"])), ["empty-a", "empty-b", "nonempty"]);
+}
+
+#[test]
+fn reverse_size_reverses_the_complete_total_order() {
+    let dir = TempDir::new().unwrap();
+    file(&dir, "a", 2); file(&dir, "b", 2); file(&dir, "c", 1);
+    assert_eq!(lines(&run(&dir, &["--sort", "size", "--reverse"])), ["b", "a", "c"]);
+}
+
+#[test]
+fn max_results_is_applied_after_size_sorting() {
+    let dir = TempDir::new().unwrap();
+    file(&dir, "large", 500); file(&dir, "small", 1); file(&dir, "medium", 20); file(&dir, "tiny", 0);
+    assert_eq!(lines(&run(&dir, &["--sort", "size", "--max-results", "3"])), ["tiny", "small", "medium"]);
+}
