+use std::fs;
+use std::process::{Command, Output};
+use tempfile::TempDir;
+
+fn run(dir: &TempDir, args: &[&str]) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_fd")).current_dir(dir.path()).args(["--color", "never", "--type", "f"]).args(args).output().unwrap()
+}
+fn lines(output: &Output) -> Vec<String> {
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+    String::from_utf8(output.stdout.clone()).unwrap().lines().map(str::to_owned).collect()
+}
+fn files(dir: &TempDir, names: &[&str]) { for name in names { fs::write(dir.path().join(name), b"").unwrap(); } }
+
+#[test]
+fn sort_extension_places_missing_extensions_first() {
+    let dir = TempDir::new().unwrap(); files(&dir, &["z.txt", "plain", "a.rs"]);
+    assert_eq!(lines(&run(&dir, &["--sort", "extension"])), ["plain", "a.rs", "z.txt"]);
+}
+
+#[test]
+fn sort_extension_compares_extension_case_sensitively() {
+    let dir = TempDir::new().unwrap(); files(&dir, &["a.rs", "b.RS", "c.Rs"]);
+    assert_eq!(lines(&run(&dir, &["--sort", "extension"])), ["b.RS", "c.Rs", "a.rs"]);
+}
+
+#[test]
+fn sort_extension_breaks_ties_by_name_then_path() {
+    let dir = TempDir::new().unwrap();
+    fs::create_dir_all(dir.path().join("a")).unwrap(); fs::create_dir_all(dir.path().join("z")).unwrap();
+    files(&dir, &["beta.log", "alpha.log"]);
+    fs::write(dir.path().join("a/same.log"), b"").unwrap(); fs::write(dir.path().join("z/same.log"), b"").unwrap();
+    assert_eq!(lines(&run(&dir, &["--sort", "extension"])), ["alpha.log", "beta.log", "a/same.log", "z/same.log"]);
+}
+
+#[test]
+fn sort_extension_uses_only_the_final_suffix() {
+    let dir = TempDir::new().unwrap(); files(&dir, &["archive.tar.gz", "archive.gz", "notes.txt"]);
+    assert_eq!(lines(&run(&dir, &["--sort", "extension"])), ["archive.gz", "archive.tar.gz", "notes.txt"]);
