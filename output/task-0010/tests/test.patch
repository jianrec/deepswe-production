+use std::fs;
+use std::os::unix::ffi::OsStringExt;
+use std::process::{Command, Output};
+use tempfile::TempDir;
+
+fn run(dir: &TempDir, args: &[&str]) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_fd")).current_dir(dir.path()).args(["--color", "never"]).args(args).output().unwrap()
+}
+fn lines(output: &Output) -> Vec<String> {
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+    String::from_utf8(output.stdout.clone()).unwrap().lines().map(str::to_owned).collect()
+}
+
+#[test]
+fn sorted_search_combines_all_explicit_roots_before_ordering() {
+    let dir = TempDir::new().unwrap();
+    fs::create_dir_all(dir.path().join("left")).unwrap(); fs::create_dir_all(dir.path().join("right")).unwrap();
+    fs::write(dir.path().join("left/zebra"), b"").unwrap(); fs::write(dir.path().join("right/apple"), b"").unwrap();
+    assert_eq!(lines(&run(&dir, &["--type", "f", "--sort", "name", ".", "left", "right"])), ["right/apple", "left/zebra"]);
+}
+
+#[test]
+fn sorted_mode_ignores_zero_max_buffer_time() {
+    let dir = TempDir::new().unwrap();
+    for index in (0..80).rev() { fs::write(dir.path().join(format!("f{index:03}")), b"").unwrap(); }
+    let output = lines(&run(&dir, &["--type", "f", "--max-buffer-time", "0", "--sort", "path"]));
+    let mut expected = output.clone(); expected.sort();
+    assert_eq!(output, expected);
+}
+
+#[test]
+fn broken_symlink_metadata_fallback_does_not_panic() {
+    let dir = TempDir::new().unwrap();
+    std::os::unix::fs::symlink("missing-target", dir.path().join("broken")).unwrap();
+    fs::write(dir.path().join("regular"), b"x").unwrap();
+    let output = run(&dir, &["--hidden", "--no-ignore", "--sort", "size"]);
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+    assert!(String::from_utf8_lossy(&output.stdout).contains("broken"));
+}
+
+#[test]
+fn path_sort_compares_raw_non_utf8_os_bytes() {
+    let dir = TempDir::new().unwrap();
+    fs::write(dir.path().join(std::ffi::OsString::from_vec(vec![b'b', 0x80])), b"").unwrap();
+    fs::write(dir.path().join(std::ffi::OsString::from_vec(vec![b'a', 0xff])), b"").unwrap();
+    let output = run(&dir, &["--type", "f", "--sort", "path", "--print0"]);
+    assert!(output.status.success());
+    assert_eq!(output.stdout, vec![b'.', b'/', b'a', 0xff, 0, b'.', b'/', b'b', 0x80, 0]);
+}
+
+#[test]
+fn extension_sort_compares_raw_non_utf8_extension_bytes() {
+    let dir = TempDir::new().unwrap();
+    fs::write(dir.path().join(std::ffi::OsString::from_vec(vec![b'a', b'.', 0xff])), b"").unwrap();
+    fs::write(dir.path().join(std::ffi::OsString::from_vec(vec![b'b', b'.', 0x80])), b"").unwrap();
+    let output = run(&dir, &["--type", "f", "--sort", "extension", "--print0"]);
+    assert!(output.status.success());
+    assert_eq!(output.stdout, vec![b'.', b'/', b'b', b'.', 0x80, 0, b'.', b'/', b'a', b'.', 0xff, 0]);
+}
