+use std::fs;
+use std::process::{Command, Output};
+use tempfile::TempDir;
+
+fn run(dir: &TempDir, args: &[&str]) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_fd"))
+        .current_dir(dir.path())
+        .args(["--color", "never", "--type", "f"])
+        .args(args)
+        .output()
+        .unwrap()
+}
+
+fn lines(output: &Output) -> Vec<String> {
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+    String::from_utf8(output.stdout.clone()).unwrap().lines().map(str::to_owned).collect()
+}
+
+#[test]
+fn sort_path_orders_full_paths() {
+    let dir = TempDir::new().unwrap();
+    fs::create_dir_all(dir.path().join("z")).unwrap();
+    fs::create_dir_all(dir.path().join("a")).unwrap();
+    fs::write(dir.path().join("z/first"), b"").unwrap();
+    fs::write(dir.path().join("a/second"), b"").unwrap();
+    assert_eq!(lines(&run(&dir, &["--sort", "path"])), ["a/second", "z/first"]);
+}
+
+#[test]
+fn sort_name_orders_by_basename_not_parent() {
+    let dir = TempDir::new().unwrap();
+    fs::create_dir_all(dir.path().join("a")).unwrap();
+    fs::create_dir_all(dir.path().join("z")).unwrap();
+    fs::write(dir.path().join("a/zebra"), b"").unwrap();
+    fs::write(dir.path().join("z/apple"), b"").unwrap();
+    assert_eq!(lines(&run(&dir, &["--sort", "name"])), ["z/apple", "a/zebra"]);
+}
+
+#[test]
+fn sort_name_breaks_equal_basename_ties_by_path() {
+    let dir = TempDir::new().unwrap();
+    for parent in ["c", "a", "b"] {
+        fs::create_dir_all(dir.path().join(parent)).unwrap();
+        fs::write(dir.path().join(parent).join("same"), b"").unwrap();
+    }
+    assert_eq!(lines(&run(&dir, &["--sort", "name"])), ["a/same", "b/same", "c/same"]);
+}
+
+#[test]
+fn sort_name_is_identical_across_thread_counts() {
+    let dir = TempDir::new().unwrap();
+    for index in (0..40).rev() {
+        let parent = format!("d{}", index % 7);
+        fs::create_dir_all(dir.path().join(&parent)).unwrap();
+        fs::write(dir.path().join(parent).join(format!("f{index:02}")), b"").unwrap();
+    }
+    let one = lines(&run(&dir, &["--threads", "1", "--sort", "name"]));
+    let many = lines(&run(&dir, &["--threads", "8", "--sort", "name"]));
+    assert_eq!(one, many);
+}
+
+#[test]
+fn sort_name_is_case_sensitive() {
+    let dir = TempDir::new().unwrap();
+    for name in ["alpha", "Beta", "ALPHA", "beta"] {
+        fs::write(dir.path().join(name), b"").unwrap();
+    }
+    assert_eq!(lines(&run(&dir, &["--sort", "name"])), ["ALPHA", "Beta", "alpha", "beta"]);
+}
