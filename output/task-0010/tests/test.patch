+
+#[test]
+fn reverse_extension_reverses_all_tie_breakers() {
+    let dir = TempDir::new().unwrap(); files(&dir, &["plain", "a.rs", "b.rs", "z.txt"]);
+    assert_eq!(lines(&run(&dir, &["--sort", "extension", "--reverse"])), ["z.txt", "b.rs", "a.rs", "plain"]);
