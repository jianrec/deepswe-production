+use filetime::{set_file_times, FileTime};
+use std::fs;
+use std::process::{Command, Output};
+use tempfile::TempDir;
+
+fn run(dir: &TempDir, args: &[&str]) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_fd")).current_dir(dir.path()).args(["--color", "never", "--type", "f"]).args(args).output().unwrap()
+}
+fn lines(output: &Output) -> Vec<String> {
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+    String::from_utf8(output.stdout.clone()).unwrap().lines().map(str::to_owned).collect()
+}
+fn timed_file(dir: &TempDir, name: &str, accessed: i64, modified: i64) {
+    let path = dir.path().join(name);
+    fs::write(&path, b"x").unwrap();
+    set_file_times(path, FileTime::from_unix_time(accessed, 0), FileTime::from_unix_time(modified, 0)).unwrap();
+}
+
+#[test]
+fn sort_modified_orders_oldest_first() {
+    let dir = TempDir::new().unwrap();
+    timed_file(&dir, "new", 50, 300); timed_file(&dir, "old", 50, 100); timed_file(&dir, "middle", 50, 200);
+    assert_eq!(lines(&run(&dir, &["--sort", "modified"])), ["old", "middle", "new"]);
+}
+
+#[test]
+fn sort_accessed_orders_oldest_first() {
+    let dir = TempDir::new().unwrap();
+    timed_file(&dir, "new", 300, 50); timed_file(&dir, "old", 100, 50); timed_file(&dir, "middle", 200, 50);
+    assert_eq!(lines(&run(&dir, &["--sort", "accessed"])), ["old", "middle", "new"]);
+}
+
+#[test]
+fn sort_modified_breaks_timestamp_ties_by_path() {
+    let dir = TempDir::new().unwrap();
+    timed_file(&dir, "z", 10, 42); timed_file(&dir, "a", 20, 42); timed_file(&dir, "m", 30, 42);
+    assert_eq!(lines(&run(&dir, &["--sort", "modified"])), ["a", "m", "z"]);
+}
+
+#[test]
+fn sort_accessed_breaks_timestamp_ties_by_path() {
+    let dir = TempDir::new().unwrap();
+    timed_file(&dir, "z", 42, 10); timed_file(&dir, "a", 42, 20); timed_file(&dir, "m", 42, 30);
+    assert_eq!(lines(&run(&dir, &["--sort", "accessed"])), ["a", "m", "z"]);
+}
+
+#[test]
+fn sort_created_is_deterministic_across_threads() {
+    let dir = TempDir::new().unwrap();
+    for index in 0..24 { fs::write(dir.path().join(format!("file-{index:02}")), b"x").unwrap(); }
+    let first = lines(&run(&dir, &["--threads", "1", "--sort", "created"]));
+    let second = lines(&run(&dir, &["--threads", "8", "--sort", "created"]));
+    assert_eq!(first, second);
+    assert_eq!(first.len(), 24);
+}
