+func TestReaderSingleRangeInvalidInputs(t *testing.T) {
+	if _, err := render.ParseRange("bytes=5-5", 5); !errors.Is(err, render.ErrNoOverlap) {
+		t.Fatalf("ParseRange non-overlap error = %v, want ErrNoOverlap", err)
+	}
+	if value := render.FormatContentRange(0, 1, 5); value != "bytes 0-0/5" {
+		t.Fatalf("first-byte Content-Range = %q, want %q", value, "bytes 0-0/5")
+	}
+
+	negativeResponse := httptest.NewRecorder()
+	negativeRange := render.ReaderRange{
+		ContentType:   "text/plain",
+		ContentLength: 3,
+		ReadSeeker:    bytes.NewReader([]byte("abc")),
+		Ranges:        []render.Range{{Start: -1, Length: 1}},
+	}
+	if err := negativeRange.Render(negativeResponse); err == nil {
+		t.Fatal("Render returned nil for a negative range start")
+	}
+	if negativeResponse.Body.Len() != 0 {
+		t.Fatalf("negative-start body = %q, want empty", negativeResponse.Body.String())
+	}
+
+	overlongResponse := httptest.NewRecorder()
+	overlongRange := render.ReaderRange{
+		ContentType:   "text/plain",
+		ContentLength: 3,
+		ReadSeeker:    bytes.NewReader([]byte("abc")),
+		Ranges:        []render.Range{{Start: 1, Length: 5}},
+	}
+	if err := overlongRange.Render(overlongResponse); err == nil {
+		t.Fatal("overlong Render returned nil error")
+	}
+	if overlongResponse.Body.String() != "" {
+		t.Fatalf("overlong body = %q, want empty", overlongResponse.Body.String())
+	}
+
+	engine := gin.New()
+	engine.MaxRanges = 1
+	engine.GET("/limited", func(context *gin.Context) {
+		context.DataFromReaderRange(http.StatusOK, 5, "text/plain", bytes.NewReader([]byte("abcde")), nil)
+	})
+	request := httptest.NewRequest(http.MethodGet, "/limited", nil)
+	request.Header.Set("Range", "bytes=0-0,2-2")
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, request)
+	if response.Code != http.StatusOK {
+		t.Fatalf("too-many-ranges status = %d, want %d", response.Code, http.StatusOK)
+	}
+	if response.Body.String() != "abcde" {
+		t.Fatalf("too-many-ranges body = %q, want full body", response.Body.String())
+	}
+}
