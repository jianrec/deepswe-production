@@ -0,0 +1,319 @@
+package hiddenrange_test
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"mime"
+	"mime/multipart"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/gin-gonic/gin/render"
+)
+
+func TestParseValidStartEnd(t *testing.T) {
+	ranges, err := render.ParseRange("bytes=2-5", 10)
+	if err != nil {
+		t.Fatalf("ParseRange returned error: %v", err)
+	}
+	if len(ranges) != 1 || ranges[0].Start != 2 || ranges[0].Length != 4 {
+		t.Fatalf("ParseRange returned %#v, want start 2 and length 4", ranges)
+	}
+
+	engine := gin.New()
+	served := false
+	engine.GET("/", func(context *gin.Context) {
+		served = context.DataFromReaderRange(http.StatusOK, 10, "text/plain", bytes.NewReader([]byte("0123456789")), map[string]string{"X-Range-Test": "start-end"})
+	})
+
+	request := httptest.NewRequest(http.MethodGet, "/", nil)
+	request.Header.Set("Range", "bytes=2-5")
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, request)
+
+	if !served {
+		t.Fatal("DataFromReaderRange returned false for a valid range")
+	}
+	if response.Code != http.StatusPartialContent {
+		t.Fatalf("status = %d, want %d", response.Code, http.StatusPartialContent)
+	}
+	if value := response.Header().Get("Content-Range"); value != "bytes 2-5/10" {
+		t.Fatalf("Content-Range = %q, want %q", value, "bytes 2-5/10")
+	}
+	if value := response.Header().Get("Content-Length"); value != "4" {
+		t.Fatalf("Content-Length = %q, want %q", value, "4")
+	}
+	if value := response.Header().Get("Content-Type"); value != "text/plain" {
+		t.Fatalf("Content-Type = %q, want %q", value, "text/plain")
+	}
+	if value := response.Header().Get("X-Range-Test"); value != "start-end" {
+		t.Fatalf("X-Range-Test = %q, want %q", value, "start-end")
+	}
+	if body := response.Body.String(); body != "2345" {
+		t.Fatalf("body = %q, want %q", body, "2345")
+	}
+}
+
+func TestParseValidOpenEnded(t *testing.T) {
+	ranges, err := render.ParseRange("bytes=6-", 10)
+	if err != nil {
+		t.Fatalf("ParseRange returned error: %v", err)
+	}
+	if len(ranges) != 1 || ranges[0].Start != 6 || ranges[0].Length != 4 {
+		t.Fatalf("ParseRange returned %#v, want start 6 and length 4", ranges)
+	}
+
+	engine := gin.New()
+	engine.GET("/", func(context *gin.Context) {
+		context.Render(http.StatusPartialContent, render.ReaderRange{
+			ContentType:   "application/octet-stream",
+			ContentLength: 10,
+			ReadSeeker:    bytes.NewReader([]byte("0123456789")),
+			Ranges:        ranges,
+			Boundary:      "parse-valid-unused",
+			Headers:       map[string]string{"X-Range-Test": "open-ended"},
+		})
+	})
+
+	request := httptest.NewRequest(http.MethodGet, "/", nil)
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, request)
+
+	if response.Code != http.StatusPartialContent {
+		t.Fatalf("status = %d, want %d", response.Code, http.StatusPartialContent)
+	}
+	if value := response.Header().Get("Content-Range"); value != "bytes 6-9/10" {
+		t.Fatalf("Content-Range = %q, want %q", value, "bytes 6-9/10")
+	}
+	if value := response.Header().Get("Content-Length"); value != "4" {
+		t.Fatalf("Content-Length = %q, want %q", value, "4")
+	}
+	if value := response.Header().Get("Content-Type"); value != "application/octet-stream" {
+		t.Fatalf("Content-Type = %q, want %q", value, "application/octet-stream")
+	}
+	if value := response.Header().Get("X-Range-Test"); value != "open-ended" {
+		t.Fatalf("X-Range-Test = %q, want %q", value, "open-ended")
+	}
+	if body := response.Body.String(); body != "6789" {
+		t.Fatalf("body = %q, want %q", body, "6789")
+	}
+}
+
+func TestParseValidSuffix(t *testing.T) {
+	ranges, err := render.ParseRange("bytes=-3", 10)
+	if err != nil {
+		t.Fatalf("ParseRange returned error: %v", err)
+	}
+	if len(ranges) != 1 || ranges[0].Start != 7 || ranges[0].Length != 3 {
+		t.Fatalf("ParseRange returned %#v, want start 7 and length 3", ranges)
+	}
+
+	directory := t.TempDir()
+	if err := os.WriteFile(directory+"/sample.txt", []byte("0123456789"), 0o600); err != nil {
+		t.Fatalf("WriteFile returned error: %v", err)
+	}
+
+	engine := gin.New()
+	engine.GET("/", func(context *gin.Context) {
+		context.FileFromFSRange("sample.txt", os.DirFS(directory))
+	})
+
+	request := httptest.NewRequest(http.MethodGet, "/", nil)
+	request.Header.Set("Range", "bytes=-3")
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, request)
+
+	if response.Code != http.StatusPartialContent {
+		t.Fatalf("status = %d, want %d", response.Code, http.StatusPartialContent)
+	}
+	if value := response.Header().Get("Content-Range"); value != "bytes 7-9/10" {
+		t.Fatalf("Content-Range = %q, want %q", value, "bytes 7-9/10")
+	}
+	if value := response.Header().Get("Content-Length"); value != "3" {
+		t.Fatalf("Content-Length = %q, want %q", value, "3")
+	}
+	if value := response.Header().Get("Content-Type"); value != "text/plain; charset=utf-8" {
+		t.Fatalf("Content-Type = %q, want %q", value, "text/plain; charset=utf-8")
+	}
+	if value := response.Header().Get("Accept-Ranges"); value != "bytes" {
+		t.Fatalf("Accept-Ranges = %q, want %q", value, "bytes")
+	}
+	if body := response.Body.String(); body != "789" {
+		t.Fatalf("body = %q, want %q", body, "789")
+	}
+}
+
+func TestParseValidClamping(t *testing.T) {
+	ranges, err := render.ParseRange("bytes=7-99", 10)
+	if err != nil {
+		t.Fatalf("ParseRange returned error: %v", err)
+	}
+	if len(ranges) != 1 || ranges[0].Start != 7 || ranges[0].Length != 3 {
+		t.Fatalf("ParseRange returned %#v, want start 7 and length 3", ranges)
+	}
+
+	engine := gin.New()
+	served := false
+	engine.GET("/", func(context *gin.Context) {
+		served = context.DataFromReaderRange(http.StatusOK, 10, "application/octet-stream", bytes.NewReader([]byte("0123456789")), nil)
+	})
+
+	request := httptest.NewRequest(http.MethodGet, "/", nil)
+	request.Header.Set("Range", "bytes=7-99")
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, request)
+
+	if !served {
+		t.Fatal("DataFromReaderRange returned false for a clamped range")
+	}
+	if response.Code != http.StatusPartialContent {
+		t.Fatalf("status = %d, want %d", response.Code, http.StatusPartialContent)
+	}
+	if value := response.Header().Get("Content-Range"); value != "bytes 7-9/10" {
+		t.Fatalf("Content-Range = %q, want %q", value, "bytes 7-9/10")
+	}
+	if value := response.Header().Get("Content-Length"); value != "3" {
+		t.Fatalf("Content-Length = %q, want %q", value, "3")
+	}
+	if value := response.Header().Get("Content-Type"); value != "application/octet-stream" {
+		t.Fatalf("Content-Type = %q, want %q", value, "application/octet-stream")
+	}
+	if value := response.Header().Get("Accept-Ranges"); value != "bytes" {
+		t.Fatalf("Accept-Ranges = %q, want %q", value, "bytes")
+	}
+	if body := response.Body.String(); body != "789" {
+		t.Fatalf("body = %q, want %q", body, "789")
+	}
+}
+
+func TestParseValidMixedSatisfiableAndOutOfWindow(t *testing.T) {
+	ranges, err := render.ParseRange("bytes=0-1,20-30,8-20", 10)
+	if err != nil {
+		t.Fatalf("ParseRange returned error: %v", err)
+	}
+	if len(ranges) != 2 {
+		t.Fatalf("ParseRange returned %d ranges, want 2: %#v", len(ranges), ranges)
+	}
+	if ranges[0].Start != 0 || ranges[0].Length != 2 {
+		t.Fatalf("first range = %#v, want start 0 and length 2", ranges[0])
+	}
+	if ranges[1].Start != 8 || ranges[1].Length != 2 {
+		t.Fatalf("second range = %#v, want start 8 and length 2", ranges[1])
+	}
+
+	engine := gin.New()
+	engine.MaxRanges = 3
+	served := false
+	engine.GET("/", func(context *gin.Context) {
+		served = context.DataFromReaderRange(http.StatusOK, 10, "application/octet-stream", bytes.NewReader([]byte("0123456789")), nil)
+	})
+
+	request := httptest.NewRequest(http.MethodGet, "/", nil)
+	request.Header.Set("Range", "bytes=0-1,20-30,8-20")
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, request)
+
+	if !served {
+		t.Fatal("DataFromReaderRange returned false for two satisfiable ranges")
+	}
+	if response.Code != http.StatusPartialContent {
+		t.Fatalf("status = %d, want %d", response.Code, http.StatusPartialContent)
+	}
+	if value := response.Header().Get("Accept-Ranges"); value != "bytes" {
+		t.Fatalf("Accept-Ranges = %q, want %q", value, "bytes")
+	}
+	mediaType, parameters, err := mime.ParseMediaType(response.Header().Get("Content-Type"))
+	if err != nil {
+		t.Fatalf("ParseMediaType returned error: %v", err)
+	}
+	if mediaType != "multipart/byteranges" {
+		t.Fatalf("media type = %q, want %q", mediaType, "multipart/byteranges")
+	}
+	if parameters["boundary"] == "" {
+		t.Fatal("multipart boundary is empty")
+	}
+
+	multipartReader := multipart.NewReader(bytes.NewReader(response.Body.Bytes()), parameters["boundary"])
+	firstPart, err := multipartReader.NextPart()
+	if err != nil {
+		t.Fatalf("reading first part returned error: %v", err)
+	}
+	if value := firstPart.Header.Get("Content-Range"); value != "bytes 0-1/10" {
+		t.Fatalf("first Content-Range = %q, want %q", value, "bytes 0-1/10")
+	}
+	if value := firstPart.Header.Get("Content-Type"); value != "application/octet-stream" {
+		t.Fatalf("first Content-Type = %q, want %q", value, "application/octet-stream")
+	}
+	firstBody, err := io.ReadAll(firstPart)
+	if err != nil {
+		t.Fatalf("reading first body returned error: %v", err)
+	}
+	if string(firstBody) != "01" {
+		t.Fatalf("first body = %q, want %q", firstBody, "01")
+	}
+
+	secondPart, err := multipartReader.NextPart()
+	if err != nil {
+		t.Fatalf("reading second part returned error: %v", err)
+	}
+	if value := secondPart.Header.Get("Content-Range"); value != "bytes 8-9/10" {
+		t.Fatalf("second Content-Range = %q, want %q", value, "bytes 8-9/10")
+	}
+	if value := secondPart.Header.Get("Content-Type"); value != "application/octet-stream" {
+		t.Fatalf("second Content-Type = %q, want %q", value, "application/octet-stream")
+	}
+	secondBody, err := io.ReadAll(secondPart)
+	if err != nil {
+		t.Fatalf("reading second body returned error: %v", err)
+	}
+	if string(secondBody) != "89" {
+		t.Fatalf("second body = %q, want %q", secondBody, "89")
+	}
+
+	thirdPart, err := multipartReader.NextPart()
+	if thirdPart != nil || !errors.Is(err, io.EOF) {
+		t.Fatalf("reading third part returned part %#v and error %v, want EOF", thirdPart, err)
+	}
+}
+
+func TestParseValidFormatContentRange(t *testing.T) {
+	if value := render.FormatContentRange(2, 5, 10); value != "bytes 2-6/10" {
+		t.Fatalf("FormatContentRange = %q, want %q", value, "bytes 2-6/10")
+	}
+	if value := render.FormatContentRange(9, 1, 10); value != "bytes 9-9/10" {
+		t.Fatalf("last-byte FormatContentRange = %q, want %q", value, "bytes 9-9/10")
+	}
+
+	_, err := render.ParseRange("bytes=20-30", 10)
+	if !errors.Is(err, render.ErrNoOverlap) {
+		t.Fatalf("ParseRange error = %v, want ErrNoOverlap", err)
+	}
+
+	engine := gin.New()
+	served := true
+	engine.GET("/", func(context *gin.Context) {
+		served = context.DataFromReaderRange(http.StatusOK, 10, "text/plain", bytes.NewReader([]byte("0123456789")), nil)
+	})
+
+	request := httptest.NewRequest(http.MethodGet, "/", nil)
+	request.Header.Set("Range", "bytes=20-30")
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, request)
+
+	if served {
+		t.Fatal("DataFromReaderRange returned true for an out-of-window range")
+	}
+	if response.Code != http.StatusRequestedRangeNotSatisfiable {
+		t.Fatalf("status = %d, want %d", response.Code, http.StatusRequestedRangeNotSatisfiable)
+	}
+	if value := response.Header().Get("Content-Range"); value != "bytes */10" {
+		t.Fatalf("Content-Range = %q, want %q", value, "bytes */10")
+	}
+	if body := response.Body.String(); body != "" {
+		t.Fatalf("body = %q, want empty body", body)
+	}
+}
