+++ b/hiddenrange/parse_invalid_test.go
@@ -0,0 +1,218 @@
+package hiddenrange_test
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"mime/multipart"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/gin-gonic/gin/render"
+)
+
+func TestParseInvalidMalformedPrefixAndEmptySpecs(t *testing.T) {
+	ranges, err := render.ParseRange("items=0-1", 10)
+	if err == nil || ranges != nil {
+		t.Fatalf("ParseRange malformed prefix = %#v, %v; want nil ranges and error", ranges, err)
+	}
+
+	ranges, err = render.ParseRange("Bytes=0-1", 10)
+	if err == nil || ranges != nil {
+		t.Fatalf("ParseRange case-sensitive prefix = %#v, %v; want nil ranges and error", ranges, err)
+	}
+
+	ranges, err = render.ParseRange("bytes=", 10)
+	if err == nil || ranges != nil {
+		t.Fatalf("ParseRange empty specification = %#v, %v; want nil ranges and error", ranges, err)
+	}
+
+	ranges, err = render.ParseRange("bytes=, ,", 10)
+	if err == nil || ranges != nil {
+		t.Fatalf("ParseRange empty list = %#v, %v; want nil ranges and error", ranges, err)
+	}
+}
+
+func TestParseInvalidNumbersAndInvertedRanges(t *testing.T) {
+	ranges, err := render.ParseRange("bytes=abc-1", 10)
+	if err == nil || ranges != nil {
+		t.Fatalf("ParseRange invalid start = %#v, %v; want nil ranges and error", ranges, err)
+	}
+
+	ranges, err = render.ParseRange("bytes=0-abc", 10)
+	if err == nil || ranges != nil {
+		t.Fatalf("ParseRange invalid end = %#v, %v; want nil ranges and error", ranges, err)
+	}
+
+	ranges, err = render.ParseRange("bytes=8-3", 10)
+	if err == nil || ranges != nil {
+		t.Fatalf("ParseRange inverted range = %#v, %v; want nil ranges and error", ranges, err)
+	}
+}
+
+func TestParseInvalidZeroSuffixAndNoOverlap(t *testing.T) {
+	ranges, err := render.ParseRange("bytes=-0", 10)
+	if err == nil || ranges != nil {
+		t.Fatalf("ParseRange zero suffix = %#v, %v; want nil ranges and an error", ranges, err)
+	}
+
+	ranges, err = render.ParseRange("bytes=10-20", 10)
+	if !errors.Is(err, render.ErrNoOverlap) || ranges != nil {
+		t.Fatalf("ParseRange non-overlapping range = %#v, %v; want nil ranges and ErrNoOverlap", ranges, err)
+	}
+}
+
+func TestParseInvalidZeroSizeContent(t *testing.T) {
+	ranges, err := render.ParseRange("bytes=0-0", 0)
+	if !errors.Is(err, render.ErrNoOverlap) || ranges != nil {
+		t.Fatalf("ParseRange zero-size content = %#v, %v; want nil ranges and ErrNoOverlap", ranges, err)
+	}
+	if got := render.FormatContentRange(0, 1, 1); got != "bytes 0-0/1" {
+		t.Fatalf("FormatContentRange(0, 1, 1) = %q; want %q", got, "bytes 0-0/1")
+	}
+
+	engine := gin.New()
+	engine.GET("/empty", func(context *gin.Context) {
+		served := context.DataFromReaderRange(http.StatusOK, 0, "application/octet-stream", bytes.NewReader(nil), map[string]string{"X-Test": "empty"})
+		if served {
+			t.Error("DataFromReaderRange returned true for unsatisfiable zero-size range")
+		}
+	})
+	request := httptest.NewRequest(http.MethodGet, "/empty", nil)
+	request.Header.Set("Range", "bytes=0-0")
+	recorder := httptest.NewRecorder()
+	engine.ServeHTTP(recorder, request)
+
+	if recorder.Code != http.StatusRequestedRangeNotSatisfiable {
+		t.Fatalf("status = %d; want %d", recorder.Code, http.StatusRequestedRangeNotSatisfiable)
+	}
+	if got := recorder.Header().Get("Content-Range"); got != "bytes */0" {
+		t.Fatalf("Content-Range = %q; want %q", got, "bytes */0")
+	}
+	if got := recorder.Body.String(); got != "" {
+		t.Fatalf("body = %q; want empty body", got)
+	}
+}
+
+func TestParseInvalidReaderRangeAndMaximumRanges(t *testing.T) {
+	const boundary = "parse-invalid-boundary"
+	engine := gin.New()
+	engine.GET("/multipart", func(context *gin.Context) {
+		context.Render(http.StatusPartialContent, render.ReaderRange{
+			ContentType:   "text/plain",
+			ContentLength: 6,
+			ReadSeeker:    bytes.NewReader([]byte("abcdef")),
+			Ranges: []render.Range{
+				{Start: 0, Length: 1},
+				{Start: 5, Length: 1},
+			},
+			Boundary: boundary,
+			Headers:  map[string]string{"X-Test": "multipart"},
+		})
+	})
+	request := httptest.NewRequest(http.MethodGet, "/multipart", nil)
+	recorder := httptest.NewRecorder()
+	engine.ServeHTTP(recorder, request)
+
+	if recorder.Code != http.StatusPartialContent {
+		t.Fatalf("multipart status = %d; want %d", recorder.Code, http.StatusPartialContent)
+	}
+	if got := recorder.Header().Get("Content-Type"); got != "multipart/byteranges; boundary="+boundary {
+		t.Fatalf("multipart Content-Type = %q; want %q", got, "multipart/byteranges; boundary="+boundary)
+	}
+	if got := recorder.Header().Get("X-Test"); got != "multipart" {
+		t.Fatalf("multipart X-Test = %q; want %q", got, "multipart")
+	}
+	expectedBody := "--" + boundary + "\r\nContent-Range: bytes 0-0/6\r\nContent-Type: text/plain\r\n\r\na\r\n--" + boundary + "\r\nContent-Range: bytes 5-5/6\r\nContent-Type: text/plain\r\n\r\nf\r\n--" + boundary + "--\r\n"
+	if got := recorder.Body.String(); got != expectedBody {
+		t.Fatalf("multipart body = %q; want %q", got, expectedBody)
+	}
+
+	reader := multipart.NewReader(strings.NewReader(recorder.Body.String()), boundary)
+	first, err := reader.NextPart()
+	if err != nil {
+		t.Fatalf("first multipart part: %v", err)
+	}
+	firstBody, err := io.ReadAll(first)
+	if err != nil {
+		t.Fatalf("read first multipart part: %v", err)
+	}
+	if got := first.Header.Get("Content-Range"); got != "bytes 0-0/6" || string(firstBody) != "a" {
+		t.Fatalf("first multipart part = %q, %q; want %q, %q", got, firstBody, "bytes 0-0/6", "a")
+	}
+	second, err := reader.NextPart()
+	if err != nil {
+		t.Fatalf("second multipart part: %v", err)
+	}
+	secondBody, err := io.ReadAll(second)
+	if err != nil {
+		t.Fatalf("read second multipart part: %v", err)
+	}
+	if got := second.Header.Get("Content-Range"); got != "bytes 5-5/6" || string(secondBody) != "f" {
+		t.Fatalf("second multipart part = %q, %q; want %q, %q", got, secondBody, "bytes 5-5/6", "f")
+	}
+	if _, err := reader.NextPart(); !errors.Is(err, io.EOF) {
+		t.Fatalf("multipart terminator error = %v; want EOF", err)
+	}
+
+	limited := gin.New()
+	limited.MaxRanges = 1
+	limited.GET("/limited", func(context *gin.Context) {
+		served := context.DataFromReaderRange(http.StatusOK, 6, "text/plain", bytes.NewReader([]byte("abcdef")), nil)
+		if served {
+			t.Error("DataFromReaderRange returned true when range count exceeded MaxRanges")
+		}
+	})
+	limitedRequest := httptest.NewRequest(http.MethodGet, "/limited", nil)
+	limitedRequest.Header.Set("Range", "bytes=0-0,5-5")
+	limitedRecorder := httptest.NewRecorder()
+	limited.ServeHTTP(limitedRecorder, limitedRequest)
+	if limitedRecorder.Code != http.StatusOK {
+		t.Fatalf("limited status = %d; want %d", limitedRecorder.Code, http.StatusOK)
+	}
+	if got := limitedRecorder.Header().Get("Content-Range"); got != "" {
+		t.Fatalf("limited Content-Range = %q; want empty", got)
+	}
+	if got := limitedRecorder.Body.String(); got != "abcdef" {
+		t.Fatalf("limited body = %q; want full body", got)
+	}
+}
+
+func TestParseInvalidFileFromFSRange(t *testing.T) {
+	directory := t.TempDir()
+	if err := os.WriteFile(directory+"/sample.txt", []byte("abcdef"), 0o600); err != nil {
+		t.Fatalf("WriteFile: %v", err)
+	}
+
+	engine := gin.New()
+	engine.GET("/file", func(context *gin.Context) {
+		context.FileFromFSRange("sample.txt", os.DirFS(directory))
+	})
+	request := httptest.NewRequest(http.MethodGet, "/file", nil)
+	request.Header.Set("Range", "bytes=1-3")
+	recorder := httptest.NewRecorder()
+	engine.ServeHTTP(recorder, request)
+
+	if recorder.Code != http.StatusPartialContent {
+		t.Fatalf("status = %d; want %d", recorder.Code, http.StatusPartialContent)
+	}
+	if got := recorder.Header().Get("Content-Range"); got != "bytes 1-3/6" {
+		t.Fatalf("Content-Range = %q; want %q", got, "bytes 1-3/6")
+	}
+	if got := recorder.Header().Get("Content-Length"); got != "3" {
+		t.Fatalf("Content-Length = %q; want %q", got, "3")
+	}
+	if got := recorder.Header().Get("Content-Type"); got != "text/plain; charset=utf-8" {
+		t.Fatalf("Content-Type = %q; want %q", got, "text/plain; charset=utf-8")
+	}
+	if got := recorder.Header().Get("Accept-Ranges"); got != "bytes" {
+		t.Fatalf("Accept-Ranges = %q; want %q", got, "bytes")
+	}
+	if got := recorder.Body.String(); got != "bcd" {
+		t.Fatalf("body = %q; want %q", got, "bcd")
+	}
+}
