+package hiddenrange_test
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"mime"
+	"mime/multipart"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/gin-gonic/gin/render"
+)
+
+func context_conditionalRequest(t *testing.T, maxRanges int, body string, headers map[string]string) *httptest.ResponseRecorder {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	engine := gin.New()
+	engine.MaxRanges = maxRanges
+	engine.GET("/data", func(context *gin.Context) {
+		context.DataFromReaderRange(http.StatusOK, int64(len(body)), "text/plain", bytes.NewReader([]byte(body)), headers)
+	})
+	recorder := httptest.NewRecorder()
+	request := httptest.NewRequest(http.MethodGet, "/data", nil)
+	for key, value := range headers {
+		if key == "ETag" || key == "Last-Modified" {
+			continue
+		}
+		request.Header.Set(key, value)
+	}
+	engine.ServeHTTP(recorder, request)
+	return recorder
+}
+
+func context_conditionalParts(t *testing.T, recorder *httptest.ResponseRecorder) []string {
+	t.Helper()
+	mediaType, parameters, err := mime.ParseMediaType(recorder.Header().Get("Content-Type"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if mediaType != "multipart/byteranges" {
+		t.Fatalf("Content-Type = %q", recorder.Header().Get("Content-Type"))
+	}
+	reader := multipart.NewReader(recorder.Body, parameters["boundary"])
+	var parts []string
+	for {
+		part, err := reader.NextPart()
+		if errors.Is(err, io.EOF) {
+			return parts
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		data, err := io.ReadAll(part)
+		if err != nil {
+			t.Fatal(err)
+		}
+		parts = append(parts, part.Header.Get("Content-Range")+"|"+string(data))
+	}
+}
+
+func TestContextConditionalStrongETagMatch(t *testing.T) {
+	const body = "0123456789"
+	recorder := context_conditionalRequest(t, 0, body, map[string]string{"ETag": `"v1"`, "Range": "bytes=2-5", "If-Range": `"v1"`})
+	if recorder.Code != http.StatusPartialContent {
+		t.Fatalf("status = %d", recorder.Code)
+	}
+	if got := recorder.Header().Get("Content-Range"); got != render.FormatContentRange(2, 4, int64(len(body))) {
+		t.Fatalf("Content-Range = %q", got)
+	}
+	if got := recorder.Header().Get("Content-Length"); got != "4" {
+		t.Fatalf("Content-Length = %q", got)
+	}
+	if got := recorder.Body.String(); got != "2345" {
+		t.Fatalf("body = %q", got)
+	}
+}
+
+func TestContextConditionalStrongETagMismatch(t *testing.T) {
+	const body = "0123456789"
+	recorder := context_conditionalRequest(t, 0, body, map[string]string{"ETag": `"v2"`, "Range": "bytes=2-5", "If-Range": `"v1"`})
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("status = %d", recorder.Code)
+	}
+	if got := recorder.Header().Get("Content-Range"); got != "" {
+		t.Fatalf("Content-Range = %q", got)
+	}
+	if got := recorder.Header().Get("Content-Length"); got != "10" {
+		t.Fatalf("Content-Length = %q", got)
+	}
+	if got := recorder.Body.String(); got != body {
+		t.Fatalf("body = %q", got)
+	}
+}
+
+func TestContextConditionalDateMatchAndMismatch(t *testing.T) {
+	const body = "abcdefghij"
+	modified := time.Date(2024, time.January, 2, 3, 4, 5, 0, time.UTC).Format(http.TimeFormat)
+	matched := context_conditionalRequest(t, 0, body, map[string]string{"Last-Modified": modified, "Range": "bytes=1-3", "If-Range": modified})
+	if matched.Code != http.StatusPartialContent || matched.Header().Get("Content-Range") != "bytes 1-3/10" || matched.Body.String() != "bcd" {
+		t.Fatalf("matched response = %d %q %q", matched.Code, matched.Header().Get("Content-Range"), matched.Body.String())
+	}
+	mismatched := context_conditionalRequest(t, 0, body, map[string]string{"Last-Modified": modified, "Range": "bytes=1-3", "If-Range": time.Date(2024, time.January, 1, 3, 4, 5, 0, time.UTC).Format(http.TimeFormat)})
+	if mismatched.Code != http.StatusOK || mismatched.Header().Get("Content-Range") != "" || mismatched.Body.String() != body {
+		t.Fatalf("mismatched response = %d %q %q", mismatched.Code, mismatched.Header().Get("Content-Range"), mismatched.Body.String())
+	}
+}
+
+func TestContextConditionalWeakETagRejected(t *testing.T) {
+	const body = "0123456789"
+	recorder := context_conditionalRequest(t, 0, body, map[string]string{"ETag": `W/"v1"`, "Range": "bytes=0-2", "If-Range": `W/"v1"`})
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("status = %d", recorder.Code)
+	}
+	if got := recorder.Header().Get("Content-Range"); got != "" {
+		t.Fatalf("Content-Range = %q", got)
+	}
+	if got := recorder.Body.String(); got != body {
+		t.Fatalf("body = %q", got)
+	}
+}
+
+func TestContextConditionalDefaultAndCustomMaxRanges(t *testing.T) {
+	const body = "0123456789"
+	defaultRecorder := context_conditionalRequest(t, 0, body, map[string]string{"Range": "bytes=0-0,2-2"})
+	if defaultRecorder.Code != http.StatusPartialContent {
+		t.Fatalf("default status = %d", defaultRecorder.Code)
+	}
+	defaultParts := context_conditionalParts(t, defaultRecorder)
+	if len(defaultParts) != 2 || defaultParts[0] != "bytes 0-0/10|0" || defaultParts[1] != "bytes 2-2/10|2" {
+		t.Fatalf("default parts = %#v", defaultParts)
+	}
+	customRecorder := context_conditionalRequest(t, 2, body, map[string]string{"Range": "bytes=1-1,3-3"})
+	if customRecorder.Code != http.StatusPartialContent {
+		t.Fatalf("custom status = %d", customRecorder.Code)
+	}
+	customParts := context_conditionalParts(t, customRecorder)
+	if len(customParts) != 2 || customParts[0] != "bytes 1-1/10|1" || customParts[1] != "bytes 3-3/10|3" {
+		t.Fatalf("custom parts = %#v", customParts)
+	}
+}
+
+func TestContextConditionalOverLimitFallbackAndPublicRangeAPIs(t *testing.T) {
+	const body = "0123456789"
+	ranges, err := render.ParseRange("bytes=0-0,2-2,4-4", int64(len(body)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	expected := []render.Range{{Start: 0, Length: 1}, {Start: 2, Length: 1}, {Start: 4, Length: 1}}
+	if len(ranges) != len(expected) || ranges[0] != expected[0] || ranges[1] != expected[1] || ranges[2] != expected[2] {
+		t.Fatalf("ranges = %#v", ranges)
+	}
+	if _, err := render.ParseRange("bytes=20-30", int64(len(body))); !errors.Is(err, render.ErrNoOverlap) {
+		t.Fatalf("non-overlap error = %v", err)
+	}
+	recorder := context_conditionalRequest(t, 2, body, map[string]string{"Range": "bytes=0-0,2-2,4-4"})
+	if recorder.Code != http.StatusOK || recorder.Header().Get("Content-Range") != "" || recorder.Header().Get("Content-Type") != "text/plain" || recorder.Body.String() != body {
+		t.Fatalf("response = %d %q %q %q", recorder.Code, recorder.Header().Get("Content-Range"), recorder.Header().Get("Content-Type"), recorder.Body.String())
+	}
+	directory := t.TempDir()
+	if err := os.WriteFile(filepath.Join(directory, "data.txt"), []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	gin.SetMode(gin.TestMode)
+	engine := gin.New()
+	engine.MaxRanges = 1
+	engine.GET("/file", func(context *gin.Context) { context.FileFromFSRange("data.txt", os.DirFS(directory)) })
+	fileRecorder := httptest.NewRecorder()
+	fileRequest := httptest.NewRequest(http.MethodGet, "/file", nil)
+	fileRequest.Header.Set("Range", "bytes=0-0,2-2")
+	engine.ServeHTTP(fileRecorder, fileRequest)
+	if fileRecorder.Code != http.StatusOK || strings.TrimSpace(fileRecorder.Body.String()) != body {
+		t.Fatalf("file response = %d %q", fileRecorder.Code, fileRecorder.Body.String())
+	}
+	_ = render.ReaderRange{ContentType: "text/plain", ContentLength: int64(len(body)), ReadSeeker: bytes.NewReader([]byte(body)), Ranges: ranges, Boundary: "boundary", Headers: map[string]string{"ETag": `"v1"`}}
+}
