+++ b/hiddenrange/file_fs_test.go
@@ -0,0 +1,195 @@
+package hiddenrange_test
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"mime"
+	"mime/multipart"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/gin-gonic/gin/render"
+)
+
+func file_fs_create(t *testing.T, name string, content []byte, modified time.Time) string {
+	t.Helper()
+	directory := t.TempDir()
+	path := filepath.Join(directory, name)
+	if err := os.WriteFile(path, content, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(path, modified, modified); err != nil {
+		t.Fatal(err)
+	}
+	return directory
+}
+
+func file_fs_serve(t *testing.T, directory, name, byteRange string, maxRanges int) *httptest.ResponseRecorder {
+	t.Helper()
+	engine := gin.New()
+	engine.MaxRanges = maxRanges
+	engine.GET("/file", func(context *gin.Context) {
+		context.FileFromFSRange(name, os.DirFS(directory))
+	})
+	request := httptest.NewRequest(http.MethodGet, "/file", nil)
+	if byteRange != "" {
+		request.Header.Set("Range", byteRange)
+	}
+	recorder := httptest.NewRecorder()
+	engine.ServeHTTP(recorder, request)
+	return recorder
+}
+
+func file_fs_equal(t *testing.T, label, got, want string) {
+	t.Helper()
+	if got != want {
+		t.Fatalf("%s = %q, want %q", label, got, want)
+	}
+}
+
+func TestFileFsSingleRange(t *testing.T) {
+	content := []byte("0123456789")
+	modified := time.Date(2020, time.January, 2, 3, 4, 5, 0, time.UTC)
+	directory := file_fs_create(t, "sample.txt", content, modified)
+	recorder := file_fs_serve(t, directory, "sample.txt", "bytes=2-5", 4)
+
+	if recorder.Code != http.StatusPartialContent {
+		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusPartialContent)
+	}
+	file_fs_equal(t, "Accept-Ranges", recorder.Header().Get("Accept-Ranges"), "bytes")
+	file_fs_equal(t, "Content-Range", recorder.Header().Get("Content-Range"), render.FormatContentRange(2, 4, int64(len(content))))
+	file_fs_equal(t, "Content-Length", recorder.Header().Get("Content-Length"), "4")
+	file_fs_equal(t, "Content-Type", recorder.Header().Get("Content-Type"), "text/plain; charset=utf-8")
+	file_fs_equal(t, "Last-Modified", recorder.Header().Get("Last-Modified"), modified.Format(http.TimeFormat))
+	file_fs_equal(t, "body", recorder.Body.String(), "2345")
+}
+
+func TestFileFsMultipleRanges(t *testing.T) {
+	content := []byte("0123456789")
+	modified := time.Date(2021, time.February, 3, 4, 5, 6, 0, time.UTC)
+	directory := file_fs_create(t, "sample.txt", content, modified)
+	recorder := file_fs_serve(t, directory, "sample.txt", "bytes=0-1,8-9", 2)
+
+	if recorder.Code != http.StatusPartialContent {
+		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusPartialContent)
+	}
+	mediaType, parameters, err := mime.ParseMediaType(recorder.Header().Get("Content-Type"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	file_fs_equal(t, "media type", mediaType, "multipart/byteranges")
+	if parameters["boundary"] == "" {
+		t.Fatal("multipart boundary is empty")
+	}
+	file_fs_equal(t, "Accept-Ranges", recorder.Header().Get("Accept-Ranges"), "bytes")
+	file_fs_equal(t, "Content-Length", recorder.Header().Get("Content-Length"), strconv.Itoa(recorder.Body.Len()))
+	file_fs_equal(t, "Last-Modified", recorder.Header().Get("Last-Modified"), modified.Format(http.TimeFormat))
+
+	reader := multipart.NewReader(bytes.NewReader(recorder.Body.Bytes()), parameters["boundary"])
+	first, err := reader.NextPart()
+	if err != nil {
+		t.Fatal(err)
+	}
+	firstBody, err := io.ReadAll(first)
+	if err != nil {
+		t.Fatal(err)
+	}
+	file_fs_equal(t, "first Content-Range", first.Header.Get("Content-Range"), render.FormatContentRange(0, 2, int64(len(content))))
+	file_fs_equal(t, "first Content-Type", first.Header.Get("Content-Type"), "text/plain; charset=utf-8")
+	file_fs_equal(t, "first body", string(firstBody), "01")
+
+	second, err := reader.NextPart()
+	if err != nil {
+		t.Fatal(err)
+	}
+	secondBody, err := io.ReadAll(second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	file_fs_equal(t, "second Content-Range", second.Header.Get("Content-Range"), render.FormatContentRange(8, 2, int64(len(content))))
+	file_fs_equal(t, "second Content-Type", second.Header.Get("Content-Type"), "text/plain; charset=utf-8")
+	file_fs_equal(t, "second body", string(secondBody), "89")
+	if part, err := reader.NextPart(); part != nil || !errors.Is(err, io.EOF) {
+		t.Fatalf("final part = %v, error = %v, want nil, EOF", part, err)
+	}
+}
+
+func TestFileFsRangeNotSatisfiable(t *testing.T) {
+	content := []byte("0123456789")
+	directory := file_fs_create(t, "sample.txt", content, time.Date(2022, time.March, 4, 5, 6, 7, 0, time.UTC))
+	recorder := file_fs_serve(t, directory, "sample.txt", "bytes=20-30", 2)
+
+	if recorder.Code != http.StatusRequestedRangeNotSatisfiable {
+		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusRequestedRangeNotSatisfiable)
+	}
+	file_fs_equal(t, "Content-Range", recorder.Header().Get("Content-Range"), "bytes */10")
+	file_fs_equal(t, "body", recorder.Body.String(), "")
+	if ranges, err := render.ParseRange("bytes=20-30", int64(len(content))); ranges != nil || !errors.Is(err, render.ErrNoOverlap) {
+		t.Fatalf("ParseRange returned %#v, %v; want nil, ErrNoOverlap", ranges, err)
+	}
+}
+
+func TestFileFsMissingFile(t *testing.T) {
+	directory := t.TempDir()
+	recorder := file_fs_serve(t, directory, "missing.txt", "", 3)
+
+	if recorder.Code != http.StatusNotFound {
+		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusNotFound)
+	}
+	file_fs_equal(t, "Content-Length", recorder.Header().Get("Content-Length"), "")
+	file_fs_equal(t, "Content-Range", recorder.Header().Get("Content-Range"), "")
+	file_fs_equal(t, "Last-Modified", recorder.Header().Get("Last-Modified"), "")
+	file_fs_equal(t, "body", recorder.Body.String(), "")
+}
+
+func TestFileFsMimeType(t *testing.T) {
+	content := []byte("\x89PNG\r\n\x1a\n\x00\x00\x00\rIHDR")
+	modified := time.Date(2023, time.April, 5, 6, 7, 8, 0, time.UTC)
+	directory := file_fs_create(t, "image", content, modified)
+	recorder := file_fs_serve(t, directory, "image", "", 3)
+
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusOK)
+	}
+	file_fs_equal(t, "Content-Type", recorder.Header().Get("Content-Type"), "application/octet-stream")
+	file_fs_equal(t, "Content-Length", recorder.Header().Get("Content-Length"), strconv.Itoa(len(content)))
+	file_fs_equal(t, "Last-Modified", recorder.Header().Get("Last-Modified"), modified.Format(http.TimeFormat))
+	if !bytes.Equal(recorder.Body.Bytes(), content) {
+		t.Fatalf("body = %q, want %q", recorder.Body.Bytes(), content)
+	}
+}
+
+func TestFileFsDataFromReaderRangeExactBytes(t *testing.T) {
+	content := []byte{0x00, 0x01, 0x02, 0x03, 0xfe, 0xff, 0x80, 0x7f}
+	engine := gin.New()
+	served := false
+	engine.GET("/data", func(context *gin.Context) {
+		served = context.DataFromReaderRange(http.StatusOK, int64(len(content)), "application/octet-stream", bytes.NewReader(content), map[string]string{"X-Exact": "yes"})
+	})
+	request := httptest.NewRequest(http.MethodGet, "/data", nil)
+	request.Header.Set("Range", "bytes=3-6")
+	recorder := httptest.NewRecorder()
+	engine.ServeHTTP(recorder, request)
+
+	if !served {
+		t.Fatal("DataFromReaderRange returned false")
+	}
+	if recorder.Code != http.StatusPartialContent {
+		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusPartialContent)
+	}
+	file_fs_equal(t, "Accept-Ranges", recorder.Header().Get("Accept-Ranges"), "bytes")
+	file_fs_equal(t, "Content-Range", recorder.Header().Get("Content-Range"), render.FormatContentRange(3, 4, int64(len(content))))
+	file_fs_equal(t, "Content-Length", recorder.Header().Get("Content-Length"), "4")
+	file_fs_equal(t, "Content-Type", recorder.Header().Get("Content-Type"), "application/octet-stream")
+	file_fs_equal(t, "X-Exact", recorder.Header().Get("X-Exact"), "yes")
+	if !bytes.Equal(recorder.Body.Bytes(), content[3:7]) {
+		t.Fatalf("body = %v, want %v", recorder.Body.Bytes(), content[3:7])
+	}
+}
