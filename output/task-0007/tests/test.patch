+package hiddenrange_test
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"mime"
+	"mime/multipart"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/gin-gonic/gin/render"
+)
+
+func context_coreServe(t *testing.T, request *http.Request, length int64, body string, headers map[string]string) (*httptest.ResponseRecorder, bool) {
+	t.Helper()
+	recorder := httptest.NewRecorder()
+	context, _ := gin.CreateTestContext(recorder)
+	context.Request = request
+	served := context.DataFromReaderRange(http.StatusOK, length, "text/plain", bytes.NewReader([]byte(body)), headers)
+	return recorder, served
+}
+
+func TestContextCoreNoRangeParity(t *testing.T) {
+	const body = "0123456789"
+	request := httptest.NewRequest(http.MethodGet, "/data", nil)
+	recorder, served := context_coreServe(t, request, int64(len(body)), body, nil)
+	if served {
+		t.Fatal("DataFromReaderRange returned true without a partial response")
+	}
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusOK)
+	}
+	if got := recorder.Header().Get("Content-Type"); got != "text/plain" {
+		t.Fatalf("Content-Type = %q, want %q", got, "text/plain")
+	}
+	if got := recorder.Header().Get("Content-Length"); got != "10" {
+		t.Fatalf("Content-Length = %q, want %q", got, "10")
+	}
+	if got := recorder.Body.String(); got != body {
+		t.Fatalf("body = %q, want %q", got, body)
+	}
+}
+
+func TestContextCoreAcceptRanges(t *testing.T) {
+	const body = "range capable"
+	request := httptest.NewRequest(http.MethodGet, "/data", nil)
+	recorder, _ := context_coreServe(t, request, int64(len(body)), body, nil)
+	if got := recorder.Header().Get("Accept-Ranges"); got != "bytes" {
+		t.Fatalf("Accept-Ranges = %q, want %q", got, "bytes")
+	}
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusOK)
+	}
+	if got := recorder.Body.String(); got != body {
+		t.Fatalf("body = %q, want %q", got, body)
+	}
+}
+
+func TestContextCoreSingleOpenSuffixRanges(t *testing.T) {
+	const body = "0123456789"
+	singleRequest := httptest.NewRequest(http.MethodGet, "/data", nil)
+	singleRequest.Header.Set("Range", "bytes=2-5")
+	single, _ := context_coreServe(t, singleRequest, int64(len(body)), body, nil)
+	if single.Code != http.StatusPartialContent || single.Header().Get("Content-Range") != "bytes 2-5/10" || single.Header().Get("Content-Length") != "4" || single.Body.String() != "2345" {
+		t.Fatalf("single range response = status %d, Content-Range %q, Content-Length %q, body %q", single.Code, single.Header().Get("Content-Range"), single.Header().Get("Content-Length"), single.Body.String())
+	}
+	openRequest := httptest.NewRequest(http.MethodGet, "/data", nil)
+	openRequest.Header.Set("Range", "bytes=7-")
+	open, _ := context_coreServe(t, openRequest, int64(len(body)), body, nil)
+	if open.Code != http.StatusPartialContent || open.Header().Get("Content-Range") != "bytes 7-9/10" || open.Header().Get("Content-Length") != "3" || open.Body.String() != "789" {
+		t.Fatalf("open range response = status %d, Content-Range %q, Content-Length %q, body %q", open.Code, open.Header().Get("Content-Range"), open.Header().Get("Content-Length"), open.Body.String())
+	}
+	suffixRequest := httptest.NewRequest(http.MethodGet, "/data", nil)
+	suffixRequest.Header.Set("Range", "bytes=-3")
+	suffix, _ := context_coreServe(t, suffixRequest, int64(len(body)), body, nil)
+	if suffix.Code != http.StatusPartialContent || suffix.Header().Get("Content-Range") != "bytes 7-9/10" || suffix.Header().Get("Content-Length") != "3" || suffix.Body.String() != "789" {
+		t.Fatalf("suffix range response = status %d, Content-Range %q, Content-Length %q, body %q", suffix.Code, suffix.Header().Get("Content-Range"), suffix.Header().Get("Content-Length"), suffix.Body.String())
+	}
+	ranges, err := render.ParseRange("bytes=2-5,7-,-3", int64(len(body)))
+	if err != nil {
+		t.Fatalf("ParseRange returned error: %v", err)
+	}
+	want := []render.Range{{Start: 2, Length: 4}, {Start: 7, Length: 3}, {Start: 7, Length: 3}}
+	if len(ranges) != len(want) || ranges[0] != want[0] || ranges[1] != want[1] || ranges[2] != want[2] {
+		t.Fatalf("ParseRange = %#v, want %#v", ranges, want)
+	}
+	if got := render.FormatContentRange(2, 4, 10); got != "bytes 2-5/10" {
+		t.Fatalf("FormatContentRange = %q, want %q", got, "bytes 2-5/10")
+	}
+}
+
+func TestContextCoreUnsatisfiableRange(t *testing.T) {
+	const body = "0123456789"
+	request := httptest.NewRequest(http.MethodGet, "/data", nil)
+	request.Header.Set("Range", "bytes=20-30")
+	recorder, served := context_coreServe(t, request, int64(len(body)), body, nil)
+	if served {
+		t.Fatal("DataFromReaderRange returned true for a 416 response")
+	}
+	if recorder.Code != http.StatusRequestedRangeNotSatisfiable {
+		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusRequestedRangeNotSatisfiable)
+	}
+	if got := recorder.Header().Get("Content-Range"); got != "bytes */10" {
+		t.Fatalf("Content-Range = %q, want %q", got, "bytes */10")
+	}
+	if got := recorder.Body.String(); got != "" {
+		t.Fatalf("body = %q, want empty", got)
+	}
+	_, err := render.ParseRange("bytes=20-30", int64(len(body)))
+	if !errors.Is(err, render.ErrNoOverlap) {
+		t.Fatalf("ParseRange error = %v, want ErrNoOverlap", err)
+	}
+}
+
+func TestContextCoreReturnValueAndMultipart(t *testing.T) {
+	const body = "0123456789"
+	request := httptest.NewRequest(http.MethodGet, "/data", nil)
+	request.Header.Set("Range", "bytes=0-1,8-9")
+	recorder, served := context_coreServe(t, request, int64(len(body)), body, nil)
+	if !served {
+		t.Fatal("DataFromReaderRange returned false")
+	}
+	if recorder.Code != http.StatusPartialContent {
+		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusPartialContent)
+	}
+	mediaType, parameters, err := mime.ParseMediaType(recorder.Header().Get("Content-Type"))
+	if err != nil {
+		t.Fatalf("ParseMediaType returned error: %v", err)
+	}
+	if mediaType != "multipart/byteranges" || parameters["boundary"] == "" {
+		t.Fatalf("Content-Type = %q", recorder.Header().Get("Content-Type"))
+	}
+	reader := multipart.NewReader(bytes.NewReader(recorder.Body.Bytes()), parameters["boundary"])
+	first, err := reader.NextPart()
+	if err != nil {
+		t.Fatalf("first NextPart returned error: %v", err)
+	}
+	firstBody, err := io.ReadAll(first)
+	if err != nil {
+		t.Fatalf("reading first part: %v", err)
+	}
+	if first.Header.Get("Content-Range") != "bytes 0-1/10" || first.Header.Get("Content-Type") != "text/plain" || string(firstBody) != "01" {
+		t.Fatalf("first part = Content-Range %q, Content-Type %q, body %q", first.Header.Get("Content-Range"), first.Header.Get("Content-Type"), firstBody)
+	}
+	second, err := reader.NextPart()
+	if err != nil {
+		t.Fatalf("second NextPart returned error: %v", err)
+	}
+	secondBody, err := io.ReadAll(second)
+	if err != nil {
+		t.Fatalf("reading second part: %v", err)
+	}
+	if second.Header.Get("Content-Range") != "bytes 8-9/10" || second.Header.Get("Content-Type") != "text/plain" || string(secondBody) != "89" {
+		t.Fatalf("second part = Content-Range %q, Content-Type %q, body %q", second.Header.Get("Content-Range"), second.Header.Get("Content-Type"), secondBody)
+	}
+	if _, err := reader.NextPart(); !errors.Is(err, io.EOF) {
+		t.Fatalf("final NextPart error = %v, want EOF", err)
+	}
+}
+
+func TestContextCoreCustomHeadersAndFileFS(t *testing.T) {
+	temporaryDirectory := t.TempDir()
+	if err := os.WriteFile(filepath.Join(temporaryDirectory, "asset.txt"), []byte("abcdefghij"), 0o600); err != nil {
+		t.Fatalf("WriteFile returned error: %v", err)
+	}
+	engine := gin.New()
+	engine.MaxRanges = 4
+	engine.GET("/asset", func(context *gin.Context) {
+		context.Header("X-Route", "file")
+		context.FileFromFSRange("asset.txt", os.DirFS(temporaryDirectory))
+	})
+	request := httptest.NewRequest(http.MethodGet, "/asset", nil)
+	request.Header.Set("Range", "bytes=3-6")
+	recorder := httptest.NewRecorder()
+	engine.ServeHTTP(recorder, request)
+	if recorder.Code != http.StatusPartialContent {
+		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusPartialContent)
+	}
+	if got := recorder.Header().Get("X-Route"); got != "file" {
+		t.Fatalf("X-Route = %q, want %q", got, "file")
+	}
+	if got := recorder.Header().Get("Content-Range"); got != "bytes 3-6/10" {
+		t.Fatalf("Content-Range = %q, want %q", got, "bytes 3-6/10")
+	}
+	if got := strings.TrimSpace(recorder.Body.String()); got != "defg" {
+		t.Fatalf("body = %q, want %q", got, "defg")
+	}
+	customRequest := httptest.NewRequest(http.MethodGet, "/data", nil)
+	customRequest.Header.Set("Range", "bytes=1-2")
+	custom, _ := context_coreServe(t, customRequest, 4, "wxyz", map[string]string{"X-Custom": "present", "Cache-Control": "private"})
+	if custom.Header().Get("X-Custom") != "present" || custom.Header().Get("Cache-Control") != "private" || custom.Body.String() != "xy" {
+		t.Fatalf("custom response = X-Custom %q, Cache-Control %q, body %q", custom.Header().Get("X-Custom"), custom.Header().Get("Cache-Control"), custom.Body.String())
+	}
+}
diff --git a/hiddenrange/file_fs_test.go b/hiddenrange/file_fs_test.go
