+func TestReaderSingleRangeCustomHeaders(t *testing.T) {
+	payload := []byte("reader-range")
+	response := httptest.NewRecorder()
+	readerRange := render.ReaderRange{
+		ContentType:   "text/custom",
+		ContentLength: int64(len(payload)),
+		ReadSeeker:    bytes.NewReader(payload),
+		Ranges:        []render.Range{{Start: 1, Length: 6}},
+		Boundary:      "reader-single-boundary",
+		Headers: map[string]string{
+			"Cache-Control": "private, max-age=0",
+			"X-Reader-Test": "single",
+		},
+	}
+
+	if err := readerRange.Render(response); err != nil {
+		t.Fatalf("Render: %v", err)
+	}
+	if value := response.Header().Get("Cache-Control"); value != "private, max-age=0" {
+		t.Fatalf("Cache-Control = %q, want %q", value, "private, max-age=0")
+	}
+	if value := response.Header().Get("X-Reader-Test"); value != "single" {
+		t.Fatalf("X-Reader-Test = %q, want %q", value, "single")
+	}
+	if value := response.Header().Get("Content-Type"); value != "text/custom" {
+		t.Fatalf("Content-Type = %q, want %q", value, "text/custom")
+	}
+	if value := response.Header().Get("Content-Range"); value != "bytes 1-6/12" {
+		t.Fatalf("Content-Range = %q, want %q", value, "bytes 1-6/12")
+	}
+	if value := response.Header().Get("Content-Length"); value != "6" {
+		t.Fatalf("Content-Length = %q, want %q", value, "6")
+	}
+	if response.Body.String() != "eader-" {
+		t.Fatalf("body = %q, want %q", response.Body.String(), "eader-")
+	}
+}
