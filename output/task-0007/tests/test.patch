+func TestReaderSingleRangeBoundaryConditions(t *testing.T) {
+	suffixRanges, err := render.ParseRange("bytes=-2", 5)
+	if err != nil {
+		t.Fatalf("ParseRange suffix: %v", err)
+	}
+	if len(suffixRanges) != 1 || suffixRanges[0].Start != 3 || suffixRanges[0].Length != 2 {
+		t.Fatalf("suffix range = %#v, want start 3 length 2", suffixRanges)
+	}
+
+	endRanges, err := render.ParseRange("bytes=4-", 5)
+	if err != nil {
+		t.Fatalf("ParseRange open end: %v", err)
+	}
+	if len(endRanges) != 1 || endRanges[0].Start != 4 || endRanges[0].Length != 1 {
+		t.Fatalf("open-ended range = %#v, want start 4 length 1", endRanges)
+	}
+
+	if value := render.FormatContentRange(4, 1, 5); value != "bytes 4-4/5" {
+		t.Fatalf("FormatContentRange = %q, want %q", value, "bytes 4-4/5")
+	}
+
+	engine := gin.New()
+	payload := []byte("abcde")
+	engine.GET("/last", func(context *gin.Context) {
+		context.DataFromReaderRange(http.StatusOK, int64(len(payload)), "text/plain", bytes.NewReader(payload), nil)
+	})
+	request := httptest.NewRequest(http.MethodGet, "/last", nil)
+	request.Header.Set("Range", "bytes=4-4")
+	response := httptest.NewRecorder()
+	engine.ServeHTTP(response, request)
+	if response.Code != http.StatusPartialContent || response.Header().Get("Content-Range") != "bytes 4-4/5" || response.Body.String() != "e" {
+		t.Fatalf("last-byte response: status=%d range=%q body=%q", response.Code, response.Header().Get("Content-Range"), response.Body.String())
+	}
+}
