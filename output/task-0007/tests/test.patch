+func TestReaderMultiRenderExactMultipart(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	recorder := httptest.NewRecorder()
+	context, _ := gin.CreateTestContext(recorder)
+	context.Request = httptest.NewRequest(http.MethodGet, "/", nil)
+	context.Render(http.StatusPartialContent, render.ReaderRange{
+		ContentType:   "text/plain",
+		ContentLength: 10,
+		ReadSeeker:    bytes.NewReader([]byte("0123456789")),
+		Ranges:        []render.Range{{Start: 0, Length: 2}, {Start: 7, Length: 3}},
+		Boundary:      "reader-multi-boundary",
+		Headers:       map[string]string{"X-Scope": "exact"},
+	})
+
+	wantBody := "--reader-multi-boundary\r\nContent-Range: bytes 0-1/10\r\nContent-Type: text/plain\r\n\r\n01\r\n--reader-multi-boundary\r\nContent-Range: bytes 7-9/10\r\nContent-Type: text/plain\r\n\r\n789\r\n--reader-multi-boundary--\r\n"
+	if recorder.Code != http.StatusPartialContent {
+		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusPartialContent)
+	}
+	if got := recorder.Header().Get("Content-Type"); got != "multipart/byteranges; boundary=reader-multi-boundary" {
+		t.Fatalf("Content-Type = %q", got)
+	}
+	if got := recorder.Header().Get("Content-Length"); got != strconv.Itoa(len(wantBody)) {
+		t.Fatalf("Content-Length = %q, want %d", got, len(wantBody))
+	}
+	if got := recorder.Header().Get("X-Scope"); got != "exact" {
+		t.Fatalf("X-Scope = %q, want exact", got)
+	}
+	if got := recorder.Body.String(); got != wantBody {
+		t.Fatalf("body = %q, want %q", got, wantBody)
+	}
+}
+
+func TestReaderMultiMIMEPartHeadersAndOrdering(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	recorder := httptest.NewRecorder()
+	context, _ := gin.CreateTestContext(recorder)
+	context.Request = httptest.NewRequest(http.MethodGet, "/", nil)
+	context.Render(http.StatusPartialContent, render.ReaderRange{
+		ContentType:   "application/octet-stream",
+		ContentLength: 10,
+		ReadSeeker:    bytes.NewReader([]byte("abcdefghij")),
+		Ranges:        []render.Range{{Start: 4, Length: 3}, {Start: 0, Length: 2}},
+		Boundary:      "reader-mime-boundary",
+	})
+
+	wantBody := "--reader-mime-boundary\r\nContent-Range: bytes 4-6/10\r\nContent-Type: application/octet-stream\r\n\r\nefg\r\n--reader-mime-boundary\r\nContent-Range: bytes 0-1/10\r\nContent-Type: application/octet-stream\r\n\r\nab\r\n--reader-mime-boundary--\r\n"
+	if recorder.Code != http.StatusPartialContent {
+		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusPartialContent)
+	}
+	if recorder.Body.String() != wantBody {
+		t.Fatalf("body = %q, want %q", recorder.Body.String(), wantBody)
+	}
+	if got := recorder.Header().Get("Content-Length"); got != strconv.Itoa(len(wantBody)) {
+		t.Fatalf("Content-Length = %q, want %d", got, len(wantBody))
+	}
+
+	mediaType, parameters, err := mime.ParseMediaType(recorder.Header().Get("Content-Type"))
+	if err != nil {
+		t.Fatalf("ParseMediaType returned error: %v", err)
+	}
+	if mediaType != "multipart/byteranges" || parameters["boundary"] != "reader-mime-boundary" {
+		t.Fatalf("media type = %q, parameters = %#v", mediaType, parameters)
+	}
+	reader := multipart.NewReader(bytes.NewReader(recorder.Body.Bytes()), parameters["boundary"])
+	first, err := reader.NextPart()
+	if err != nil {
+		t.Fatalf("first NextPart returned error: %v", err)
+	}
+	firstHeaders := textproto.MIMEHeader{"Content-Range": {"bytes 4-6/10"}, "Content-Type": {"application/octet-stream"}}
+	if !reflect.DeepEqual(first.Header, firstHeaders) {
+		t.Fatalf("first headers = %#v, want %#v", first.Header, firstHeaders)
+	}
+	firstPayload, err := io.ReadAll(first)
+	if err != nil || string(firstPayload) != "efg" {
+		t.Fatalf("first payload = %q, error = %v", firstPayload, err)
+	}
+	second, err := reader.NextPart()
+	if err != nil {
+		t.Fatalf("second NextPart returned error: %v", err)
+	}
+	secondHeaders := textproto.MIMEHeader{"Content-Range": {"bytes 0-1/10"}, "Content-Type": {"application/octet-stream"}}
+	if !reflect.DeepEqual(second.Header, secondHeaders) {
+		t.Fatalf("second headers = %#v, want %#v", second.Header, secondHeaders)
+	}
+	secondPayload, err := io.ReadAll(second)
+	if err != nil || string(secondPayload) != "ab" {
+		t.Fatalf("second payload = %q, error = %v", secondPayload, err)
+	}
+	_, err = reader.NextPart()
+	if !errors.Is(err, io.EOF) {
+		t.Fatalf("final NextPart error = %v, want EOF", err)
+	}
+}
