+	}
+	boundary := parameters["boundary"]
+	wantBody := "--" + boundary + "\r\nContent-Range: bytes 2-3/10\r\nContent-Type: application/octet-stream\r\n\r\ncd\r\n--" + boundary + "\r\nContent-Range: bytes 8-9/10\r\nContent-Type: application/octet-stream\r\n\r\nij\r\n--" + boundary + "--\r\n"
+	if got := recorder.Body.String(); got != wantBody {
+		t.Fatalf("body = %q, want %q", got, wantBody)
+	}
+	if got := recorder.Header().Get("Content-Length"); got != strconv.Itoa(len(wantBody)) {
+		t.Fatalf("Content-Length = %q, want %d", got, len(wantBody))
+	}
+	if got := recorder.Header().Get("X-Context"); got != "range" {
+		t.Fatalf("X-Context = %q, want range", got)
+	}
