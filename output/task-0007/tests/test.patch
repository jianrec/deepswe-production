+func TestReaderMultiParseRangeOrderingAndNoOverlap(t *testing.T) {
+	ranges, err := render.ParseRange("bytes=6-7,0-1,-2", 10)
+	if err != nil {
+		t.Fatalf("ParseRange returned error: %v", err)
+	}
+	want := []render.Range{{Start: 6, Length: 2}, {Start: 0, Length: 2}, {Start: 8, Length: 2}}
+	if !reflect.DeepEqual(ranges, want) {
+		t.Fatalf("ranges = %#v, want %#v", ranges, want)
+	}
+	if got := render.FormatContentRange(ranges[0].Start, ranges[0].Length, 10); got != "bytes 6-7/10" {
+		t.Fatalf("FormatContentRange = %q, want %q", got, "bytes 6-7/10")
+	}
+	_, err = render.ParseRange("bytes=20-30", 10)
+	if !errors.Is(err, render.ErrNoOverlap) {
+		t.Fatalf("ParseRange error = %v, want ErrNoOverlap", err)
+	}
+}
