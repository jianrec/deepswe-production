+// DataFromReaderRange writes the specified reader into the body stream, honoring
+// the request Range header for RFC 7233 partial content. It always advertises
+// "Accept-Ranges: bytes". With no Range header (or a rejected If-Range guard, a
+// malformed Range, or more ranges than the effective Engine.MaxRanges limit) it
+// produces exactly the same output as DataFromReader for the given status code.
+// A single satisfiable range yields a 206 response with a Content-Range header;
+// multiple ranges yield a 206 multipart/byteranges document; a syntactically
+// valid but unsatisfiable range yields 416 with "Content-Range: bytes */<size>"
+// and an empty body. It returns true only when a partial (206) response was sent.
+func (c *Context) DataFromReaderRange(code int, contentLength int64, contentType string, reader io.ReadSeeker, extraHeaders map[string]string) bool {
+	c.Writer.Header().Set("Accept-Ranges", "bytes")
+
+	serveFull := func(status int) {
+		c.Render(status, render.Reader{
+			Headers:       extraHeaders,
+			ContentType:   contentType,
+			ContentLength: contentLength,
+			Reader:        reader,
+		})
+	}
+
+	rangeHeader := c.GetHeader("Range")
+	if rangeHeader == "" {
+		serveFull(code)
+		return false
+	}
+
+	// Respect If-Range: only honor the range when the supplied validator matches.
+	if !ifRangeAllowsPartial(c.GetHeader("If-Range"), extraHeaders) {
+		serveFull(http.StatusOK)
+		return false
+	}
+
+	if requestedRangeCount(rangeHeader) > c.engine.effectiveMaxRanges() {
+		serveFull(http.StatusOK)
+		return false
+	}
+
+	ranges, err := render.ParseRange(rangeHeader, contentLength)
+	if err != nil {
+		if errors.Is(err, render.ErrNoOverlap) {
+			// Syntactically valid but unsatisfiable: emit 416 with an empty body.
+			writeRangeHeaders(c.Writer.Header(), extraHeaders)
+			c.Writer.Header().Set("Content-Range", fmt.Sprintf("bytes */%d", contentLength))
+			c.Writer.Header().Set("Content-Length", "0")
+			c.Status(http.StatusRequestedRangeNotSatisfiable)
+			c.Writer.WriteHeaderNow()
+			return false
+		}
+		// Malformed Range header: ignore it and serve the full representation.
+		serveFull(code)
+		return false
+	}
+
+	// No satisfiable range, or more ranges requested than allowed: serve the full body.
+	if len(ranges) == 0 {
+		serveFull(code)
+		return false
+	}
+
+	c.Render(http.StatusPartialContent, render.ReaderRange{
+		ContentType:   contentType,
+		ContentLength: contentLength,
+		ReadSeeker:    reader,
+		Ranges:        ranges,
+		Headers:       extraHeaders,
+	})
+	return true
+}
+
+// FileFromFSRange serves a file from the given io/fs.FS while honoring the
+// request Range header. It routes seekable files through DataFromReaderRange so
+// that partial-content (206/multipart/416) responses are produced as
+// appropriate, and returns 404 for a missing path.
+func (c *Context) FileFromFSRange(filepath string, root fs.FS) {
+	name := strings.TrimPrefix(filepath, "/")
+	f, err := root.Open(name)
+	if err != nil {
+		c.Writer.WriteHeader(http.StatusNotFound)
+		return
+	}
+	defer f.Close()
+
+	info, err := f.Stat()
+	if err != nil || info.IsDir() {
+		c.Writer.WriteHeader(http.StatusNotFound)
+		return
+	}
+
+	contentType := mime.TypeByExtension(path.Ext(filepath))
+	if contentType == "" {
+		contentType = "application/octet-stream"
+	}
+
+	extraHeaders := map[string]string{
+		"Last-Modified": info.ModTime().UTC().Format(http.TimeFormat),
+	}
+
+	rangeFile, err := filesystem.SeekableFile(f)
+	if err == nil {
+		c.DataFromReaderRange(http.StatusOK, rangeFile.Size(), contentType, rangeFile, extraHeaders)
+		return
+	}
+
+	// The file is not seekable; fall back to serving the full body.
+	c.Writer.Header().Set("Accept-Ranges", "bytes")
+	c.Render(http.StatusOK, render.Reader{
+		Headers:       extraHeaders,
+		ContentType:   contentType,
+		ContentLength: info.Size(),
+		Reader:        f,
+	})
+}
+
