@@ -0,0 +1,89 @@
+// Copyright 2024 Gin Core Team. All rights reserved.
+// Use of this source code is governed by a MIT style
+// license that can be found in the LICENSE file.
+
+package gin
+
+import (
+	"net/http"
+	"strings"
+)
+
+// effectiveMaxRanges returns the maximum number of ranges a single request may
+// ask for. A zero MaxRanges falls back to the internal defaultMaxRanges.
+func (engine *Engine) effectiveMaxRanges() int {
+	if engine != nil && engine.MaxRanges > 0 {
+		return engine.MaxRanges
+	}
+	return defaultMaxRanges
+}
+
+func requestedRangeCount(rangeHeader string) int {
+	const prefix = "bytes="
+	if !strings.HasPrefix(rangeHeader, prefix) {
+		return 0
+	}
+	return strings.Count(rangeHeader[len(prefix):], ",") + 1
+}
+
+func writeRangeHeaders(header http.Header, extraHeaders map[string]string) {
+	for key, value := range extraHeaders {
+		if header.Get(key) == "" {
+			header.Set(key, value)
+		}
+	}
+}
+
+// isETagValidator reports whether s looks like an entity-tag validator (i.e. it
+// is quoted or carries the weak "W/" prefix) rather than an HTTP-date.
+func isETagValidator(s string) bool {
+	return len(s) >= 2 && (s[0] == '"' || strings.HasPrefix(s, "W/"))
+}
+
+// strongETagMatch performs a strong comparison of two entity-tags as required
+// for range requests. Weak validators ("W/"-prefixed) never match.
+func strongETagMatch(a, b string) bool {
+	if a == "" || b == "" {
+		return false
+	}
+	if strings.HasPrefix(a, "W/") || strings.HasPrefix(b, "W/") {
+		return false
+	}
+	return a == b
+}
+
+// ifRangeAllowsPartial evaluates an If-Range request-header value against the
+// representation's validators. It returns true when the Range request should be
+// honored: either there is no If-Range guard, or the supplied ETag / Last-Modified
+// validator matches. Any mismatch or unparsable input causes the caller to serve
+// the full representation instead.
+func ifRangeAllowsPartial(ifRange string, extraHeaders map[string]string) bool {
+	ifRange = strings.TrimSpace(ifRange)
+	if ifRange == "" {
+		return true
+	}
+
+	var etag, lastModified string
+	if extraHeaders != nil {
+		etag = extraHeaders["ETag"]
+		lastModified = extraHeaders["Last-Modified"]
+	}
+
+	if isETagValidator(ifRange) {
+		return strongETagMatch(ifRange, strings.TrimSpace(etag))
+	}
+
+	// Otherwise treat If-Range as an HTTP-date and compare against Last-Modified.
+	if lastModified == "" {
+		return false
+	}
+	lm, err := http.ParseTime(strings.TrimSpace(lastModified))
+	if err != nil {
+		return false
+	}
+	ir, err := http.ParseTime(ifRange)
+	if err != nil {
+		return false
+	}
+	return ir.Equal(lm)
+}
