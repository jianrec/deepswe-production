+// ErrNotSeekable is returned by SeekableFile when the supplied fs.File does not
+// implement io.Seeker and therefore cannot back a Range-aware response. Callers
+// should fall back to serving the full body.
+var ErrNotSeekable = errors.New("gin: fs.File is not seekable")
+
+// RangeFile adapts a seekable fs.File to an io.ReadSeeker while exposing the
+// size and modification time needed to serve RFC 7233 partial-content responses.
+type RangeFile struct {
+	io.ReadSeeker
+	size    int64
+	modTime time.Time
+}
+
+// Size returns the total size of the underlying file in bytes.
+func (f *RangeFile) Size() int64 { return f.size }
+
+// ModTime returns the modification time of the underlying file.
+func (f *RangeFile) ModTime() time.Time { return f.modTime }
+
+// SeekableFile adapts a seekable fs.File to a *RangeFile, reporting its size and
+// modtime. It returns ErrNotSeekable when the file does not implement io.Seeker,
+// so callers can fall back to full-body serving.
+func SeekableFile(f fs.File) (*RangeFile, error) {
+	seeker, ok := f.(io.ReadSeeker)
+	if !ok {
+		return nil, ErrNotSeekable
+	}
+	info, err := f.Stat()
+	if err != nil {
+		return nil, err
+	}
+	return &RangeFile{
+		ReadSeeker: seeker,
+		size:       info.Size(),
+		modTime:    info.ModTime(),
+	}, nil
+}
