index 0000000..bd46278
--- /dev/null
+++ b/render/range.go
@@ -0,0 +1,138 @@
+// Copyright 2024 Gin Core Team. All rights reserved.
+// Use of this source code is governed by a MIT style
+// license that can be found in the LICENSE file.
+
+package render
+
+import (
+	"errors"
+	"strconv"
+	"strings"
+)
+
+// ErrNoOverlap is returned by ParseRange if first-byte-pos of all of the
+// byte-range-spec values is greater than the content size.
+var ErrNoOverlap = errors.New("invalid range: failed to overlap")
+
+var errInvalidRange = errors.New("invalid range")
+
+// byteRangePrefix is the only range unit supported per RFC 7233.
+const byteRangePrefix = "bytes="
+
+// defaultBoundary is used for multipart/byteranges responses when no explicit
+// boundary is supplied.
+const defaultBoundary = "GINBYTERANGEBOUNDARY"
+
+// mimeByteRanges is the base media type used for multi-range responses.
+const mimeByteRanges = "multipart/byteranges"
+
+// Range specifies the byte range to be sent to the client.
+type Range struct {
+	Start  int64
+	Length int64
+}
+
+// FormatContentRange returns the value of a Content-Range header for a single
+// range in the form "bytes <start>-<start+length-1>/<size>".
+func FormatContentRange(start, length, size int64) string {
+	b := strings.Builder{}
+	b.WriteString("bytes ")
+	b.WriteString(strconv.FormatInt(start, 10))
+	b.WriteByte('-')
+	b.WriteString(strconv.FormatInt(start+length-1, 10))
+	b.WriteByte('/')
+	b.WriteString(strconv.FormatInt(size, 10))
+	return b.String()
+}
+
+// ParseRange parses a Range header string as per RFC 7233 against a known
+// content size. It supports the "start-end", "start-" and "-suffix" forms,
+// clamps end to size-1, skips fully out-of-window parts, and returns
+// ErrNoOverlap when no requested part overlaps the content.
+func ParseRange(rangeHeader string, size int64) ([]Range, error) {
+	if rangeHeader == "" {
+		return nil, nil
+	}
+	if size < 0 {
+		return nil, errInvalidRange
+	}
+	if !strings.HasPrefix(rangeHeader, byteRangePrefix) {
+		return nil, errInvalidRange
+	}
+	specs := strings.Split(rangeHeader[len(byteRangePrefix):], ",")
+	if len(specs) == 0 {
+		return nil, errInvalidRange
+	}
+	var ranges []Range
+	noOverlap := false
+	for _, ra := range specs {
+		ra = strings.TrimSpace(ra)
+		if ra == "" {
+			return nil, errInvalidRange
+		}
+		start, end, ok := strings.Cut(ra, "-")
+		if !ok {
+			return nil, errors.New("invalid range: missing dash")
+		}
+		start, end = strings.TrimSpace(start), strings.TrimSpace(end)
+		var r Range
+		if start == "" {
+			// suffix range: -N -> last N bytes.
+			if end == "" {
+				return nil, errors.New("invalid range: empty spec")
+			}
+			i, err := strconv.ParseInt(end, 10, 64)
+			if err != nil {
+				return nil, errors.New("invalid range: bad suffix length")
+			}
+			if i <= 0 {
+				return nil, errors.New("invalid range: negative suffix length")
+			}
+			if size == 0 {
+				noOverlap = true
+				continue
+			}
+			if i > size {
+				i = size
+			}
+			r.Start = size - i
+			r.Length = size - r.Start
+		} else {
+			i, err := strconv.ParseInt(start, 10, 64)
+			if err != nil || i < 0 {
+				return nil, errors.New("invalid range: bad start")
+			}
+			if i >= size {
+				// This range is out of window (start beyond content).
+				noOverlap = true
+				continue
+			}
+			r.Start = i
+			if end == "" {
+				// open-ended range: N-
+				r.Length = size - r.Start
+			} else {
+				j, err := strconv.ParseInt(end, 10, 64)
+				if err != nil || j < 0 {
+					return nil, errors.New("invalid range: bad end")
+				}
+				if j < i {
+					return nil, errors.New("invalid range: inverted range")
+				}
+				// clamp end to size-1
+				if j >= size {
+					j = size - 1
+				}
+				r.Length = j - r.Start + 1
+			}
+		}
+		ranges = append(ranges, r)
+	}
+	if len(ranges) == 0 && noOverlap {
+		return nil, ErrNoOverlap
+	}
+	if len(ranges) == 0 {
+		return nil, errInvalidRange
+	}
+	return ranges, nil
+}
