+	"net/textproto"
 	"strconv"
 )
 
@@ -46,3 +49,134 @@ func (r Reader) writeHeaders(w http.ResponseWriter) {
 		}
 	}
 }
+
+// ReaderRange renders a single or multiple byte range of an io.ReadSeeker as an
+// RFC 7233 compliant partial-content (206) response. When a single range is
+// requested it writes the range body together with a Content-Range header; when
+// multiple ranges are requested it emits a multipart/byteranges document.
+type ReaderRange struct {
+	ContentType   string
+	ContentLength int64
+	ReadSeeker    io.ReadSeeker
+	Ranges        []Range
+	Boundary      string
+	Headers       map[string]string
+}
+
+// countingWriter counts how many bytes have been written to it.
+type countingWriter int64
+
+func (w *countingWriter) Write(p []byte) (int, error) {
+	*w += countingWriter(len(p))
+	return len(p), nil
+}
+
+// boundary returns the multipart boundary, defaulting when none was supplied.
+func (r ReaderRange) boundary() string {
+	if r.Boundary != "" {
+		return r.Boundary
+	}
+	return defaultBoundary
+}
+
+// WriteContentType (ReaderRange) writes the appropriate ContentType: the original
+// content type for a single range, or multipart/byteranges for multiple ranges.
+func (r ReaderRange) WriteContentType(w http.ResponseWriter) {
+	if len(r.Ranges) > 1 {
+		writeContentType(w, []string{mimeByteRanges + "; boundary=" + r.boundary()})
+		return
+	}
+	writeContentType(w, []string{r.ContentType})
+}
+
+// writeHeaders writes custom headers from r.Headers into the response, without
+// overriding headers that are already set.
+func (r ReaderRange) writeHeaders(w http.ResponseWriter) {
+	header := w.Header()
+	for k, v := range r.Headers {
+		if header.Get(k) == "" {
+			header.Set(k, v)
+		}
+	}
+}
+
+// Render (ReaderRange) writes the requested byte range(s) as a 206 response.
+func (r ReaderRange) Render(w http.ResponseWriter) error {
+	if r.ReadSeeker == nil {
+		return errors.New("render: nil range reader")
+	}
+	if len(r.Ranges) == 0 {
+		return errors.New("render: no byte ranges")
+	}
+	for _, ra := range r.Ranges {
+		if ra.Start < 0 || ra.Length <= 0 || ra.Start > r.ContentLength-ra.Length {
+			return errors.New("render: byte range outside content")
+		}
+	}
+
+	r.WriteContentType(w)
+	r.writeHeaders(w)
+	header := w.Header()
+
+	if len(r.Ranges) == 1 {
+		ra := r.Ranges[0]
+		header.Set("Content-Range", FormatContentRange(ra.Start, ra.Length, r.ContentLength))
+		header.Set("Content-Length", strconv.FormatInt(ra.Length, 10))
+		w.WriteHeader(http.StatusPartialContent)
+		if _, err := r.ReadSeeker.Seek(ra.Start, io.SeekStart); err != nil {
+			return err
+		}
+		_, err := io.CopyN(w, r.ReadSeeker, ra.Length)
+		return err
+	}
+
+	boundary := r.boundary()
+
+	// Pre-compute the Content-Length of the multipart/byteranges document.
+	var cw countingWriter
+	sizer := multipart.NewWriter(&cw)
+	if err := sizer.SetBoundary(boundary); err != nil {
+		return err
+	}
+	var partsSize int64
+	for _, ra := range r.Ranges {
+		if _, err := sizer.CreatePart(r.partHeader(ra)); err != nil {
+			return err
+		}
+		partsSize += ra.Length
+	}
+	if err := sizer.Close(); err != nil {
+		return err
+	}
+	header.Set("Content-Length", strconv.FormatInt(int64(cw)+partsSize, 10))
+
+	w.WriteHeader(http.StatusPartialContent)
+
+	mw := multipart.NewWriter(w)
+	if err := mw.SetBoundary(boundary); err != nil {
+		return err
+	}
+	for _, ra := range r.Ranges {
+		part, err := mw.CreatePart(r.partHeader(ra))
+		if err != nil {
+			return err
+		}
+		if _, err := r.ReadSeeker.Seek(ra.Start, io.SeekStart); err != nil {
+			return err
+		}
+		if _, err := io.CopyN(part, r.ReadSeeker, ra.Length); err != nil {
+			return err
+		}
+	}
+	return mw.Close()
+}
+
+// partHeader builds the per-part MIME header for a range in a multipart response.
+func (r ReaderRange) partHeader(ra Range) textproto.MIMEHeader {
+	h := make(textproto.MIMEHeader, 2)
+	if r.ContentType != "" {
+		h.Set("Content-Type", r.ContentType)
+	}
+	h.Set("Content-Range", FormatContentRange(ra.Start, ra.Length, r.ContentLength))
+	return h
+}
