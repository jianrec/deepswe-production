+}
+
+func TestBuildPlanDoesNotCreatePlannedDirectories(t *testing.T) {
+	home := filepath.Join(t.TempDir(), "absent")
+	plan := buildPlan(t, "droid", home, "no-directory-model", testHost)
+	for _, file := range plan.Files {
+		if _, err := os.Stat(filepath.Dir(file.Path)); !os.IsNotExist(err) {
+			t.Fatalf("BuildPlan created directory for %q: %v", file.Path, err)
