+
+func TestExistingDifferentCodexOwnedFileReportsOverwrite(t *testing.T) {
+	home := t.TempDir()
+	initial := buildPlan(t, "codex", home, "overwrite-model", testHost)
+	profile := findFile(t, initial, "ollama-launch.config.toml")
+	if err := os.MkdirAll(filepath.Dir(profile.Path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(profile.Path, []byte("model = \"old\"\n"), 0o644); err != nil {
+		t.Fatal(err)
