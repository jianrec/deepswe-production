+package launchplan_test
+
+import (
+	"encoding/json"
+	"io/fs"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/ollama/ollama/cmd/launch"
+)
+
+func samplePlan() launch.Plan {
+	return launch.Plan{
+		Integration: "codex",
+		Binary: "/tmp/codex",
+		Args: []string{"--model", "sample"},
+		Env: map[string]string{"Z_KEY": "z", "A_KEY": "a", "M_KEY": "m"},
+		Model: "sample",
+		Files: []launch.PlannedFile{
+			{Path: "/tmp/a.json", Contents: "a", Mode: fs.FileMode(0o644), Action: launch.FileCreate},
+			{Path: "/tmp/z.json", Contents: "z", Mode: fs.FileMode(0o600), Action: launch.FileOverwrite},
+		},
+		Notes: []string{"sample note"},
+	}
+}
+
+func TestPlanJSONRoundTrips(t *testing.T) {
+	want := samplePlan()
+	data, err := want.JSON()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got launch.Plan
+	if err := json.Unmarshal(data, &got); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("round trip mismatch\n got: %#v\nwant: %#v", got, want)
+	}
+}
+
+func TestPlanJSONDeterministicRepeatedCalls(t *testing.T) {
+	plan := samplePlan()
+	first, err := plan.JSON()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 25; i++ {
+		next, err := plan.JSON()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if string(next) != string(first) {
+			t.Fatalf("JSON changed between calls:\n%s\n%s", first, next)
+		}
+	}
+}
+
+func TestPlanJSONEnvironmentKeysSorted(t *testing.T) {
+	data, err := samplePlan().JSON()
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(data)
+	a := strings.Index(text, "A_KEY")
+	m := strings.Index(text, "M_KEY")
+	z := strings.Index(text, "Z_KEY")
+	if !(a >= 0 && a < m && m < z) {
+		t.Fatalf("environment keys are not sorted: %s", text)
+	}
+}
+
+func TestBuildPlanFilesSortedByPath(t *testing.T) {
+	for _, name := range launch.RegisteredIntegrations() {
+		plan := buildPlan(t, name, t.TempDir(), "sort-model", testHost)
+		for i := 1; i < len(plan.Files); i++ {
+			if plan.Files[i-1].Path > plan.Files[i].Path {
+				t.Fatalf("%s files not sorted: %q before %q", name, plan.Files[i-1].Path, plan.Files[i].Path)
+			}
+		}
+	}
+}
+
+func TestPlanJSONContainsRequiredPublicFields(t *testing.T) {
+	data, err := samplePlan().JSON()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(data, &object); err != nil {
+		t.Fatal(err)
+	}
+	for _, key := range []string{"integration", "binary", "args", "env", "model", "files"} {
+		if _, ok := object[key]; !ok {
+			t.Fatalf("JSON missing %q: %s", key, data)
+		}
+	}
+}
+
+func TestPlanJSONOmitsEmptyNotes(t *testing.T) {
+	plan := samplePlan()
+	plan.Notes = nil
+	data, err := plan.JSON()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(data, &object); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := object["notes"]; ok {
+		t.Fatalf("empty notes were not omitted: %s", data)
+	}
+}
+
+func TestPlanRenderContainsExecutionDetails(t *testing.T) {
+	text := samplePlan().Render()
+	for _, want := range []string{"codex", "/tmp/codex", "sample", "A_KEY", "a"} {
+		if !strings.Contains(text, want) {
+			t.Fatalf("Render missing %q:\n%s", want, text)
+		}
+	}
+}
+
+func TestPlanRenderContainsFileActionsAndContents(t *testing.T) {
+	text := samplePlan().Render()
+	for _, want := range []string{"/tmp/a.json", "/tmp/z.json", "create", "overwrite", "a", "z"} {
+		if !strings.Contains(text, want) {
+			t.Fatalf("Render missing %q:\n%s", want, text)
+		}
+	}
+}
+
+func TestPlanRenderDeterministicRepeatedCalls(t *testing.T) {
+	plan := samplePlan()
+	first := plan.Render()
+	for i := 0; i < 25; i++ {
+		if next := plan.Render(); next != first {
+			t.Fatalf("Render changed between calls:\n%s\n%s", first, next)
+		}
+	}
+}
