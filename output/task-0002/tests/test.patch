+package launchplan_test
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/ollama/ollama/cmd/launch"
+)
+
+func TestPlanApplyCreatesFileWithExactContents(t *testing.T) {
+	target := filepath.Join(t.TempDir(), "nested", "config.json")
+	binary := writeExecutable(t, "#!/bin/sh\nexit 0\n")
+	plan := launch.Plan{Binary: binary, Args: []string{}, Env: map[string]string{}, Files: []launch.PlannedFile{{Path: target, Contents: "planned bytes\n", Mode: 0o640, Action: launch.FileCreate}}}
+	if err := plan.Apply(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	got, err := os.ReadFile(target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != "planned bytes\n" {
+		t.Fatalf("contents = %q", got)
+	}
+}
+
+func TestPlanApplyUsesPlannedFileMode(t *testing.T) {
+	target := filepath.Join(t.TempDir(), "config.json")
+	plan := launch.Plan{Binary: writeExecutable(t, "#!/bin/sh\nexit 0\n"), Env: map[string]string{}, Files: []launch.PlannedFile{{Path: target, Contents: "x", Mode: 0o600, Action: launch.FileCreate}}}
+	if err := plan.Apply(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != 0o600 {
+		t.Fatalf("mode = %o, want 600", info.Mode().Perm())
+	}
+}
+
+func TestPlanApplyOverwritesExistingFile(t *testing.T) {
+	target := filepath.Join(t.TempDir(), "config.json")
+	if err := os.WriteFile(target, []byte("old"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	plan := launch.Plan{Binary: writeExecutable(t, "#!/bin/sh\nexit 0\n"), Env: map[string]string{}, Files: []launch.PlannedFile{{Path: target, Contents: "new", Mode: 0o644, Action: launch.FileOverwrite}}}
+	if err := plan.Apply(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	got, err := os.ReadFile(target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != "new" {
+		t.Fatalf("contents = %q, want new", got)
+	}
+}
+
+func TestPlanApplyPassesArgumentsExactly(t *testing.T) {
+	output := filepath.Join(t.TempDir(), "args")
+	binary := writeExecutable(t, "#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$PLAN_OUTPUT\"\n")
+	plan := launch.Plan{Binary: binary, Args: []string{"first", "two words", "third"}, Env: map[string]string{"PLAN_OUTPUT": output}, Files: []launch.PlannedFile{}}
+	if err := plan.Apply(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	got, err := os.ReadFile(output)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != "first\ntwo words\nthird\n" {
+		t.Fatalf("arguments = %q", got)
+	}
+}
+
+func TestPlanApplyPassesEnvironmentExactly(t *testing.T) {
+	output := filepath.Join(t.TempDir(), "env")
+	binary := writeExecutable(t, "#!/bin/sh\nprintf '%s|%s' \"$PLAN_ALPHA\" \"$OLLAMA_HOST\" > \"$PLAN_OUTPUT\"\n")
+	plan := launch.Plan{Binary: binary, Env: map[string]string{"PLAN_ALPHA": "beta", "OLLAMA_HOST": testHost, "PLAN_OUTPUT": output}, Files: []launch.PlannedFile{}}
+	if err := plan.Apply(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	got, err := os.ReadFile(output)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != "beta|"+testHost {
+		t.Fatalf("environment = %q", got)
+	}
+}
+
+func TestPlanApplyWritesFilesBeforeProcessStarts(t *testing.T) {
+	dir := t.TempDir()
+	target := filepath.Join(dir, "config")
+	output := filepath.Join(dir, "observed")
+	binary := writeExecutable(t, "#!/bin/sh\ncat \"$PLAN_TARGET\" > \"$PLAN_OUTPUT\"\n")
+	plan := launch.Plan{Binary: binary, Env: map[string]string{"PLAN_TARGET": target, "PLAN_OUTPUT": output}, Files: []launch.PlannedFile{{Path: target, Contents: "visible before exec", Mode: 0o600, Action: launch.FileCreate}}}
+	if err := plan.Apply(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	got, err := os.ReadFile(output)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != "visible before exec" {
+		t.Fatalf("process observed %q", got)
+	}
+}
+
+func TestPlanApplyPropagatesProcessFailure(t *testing.T) {
+	plan := launch.Plan{Binary: writeExecutable(t, "#!/bin/sh\necho planned-failure >&2\nexit 23\n"), Env: map[string]string{}, Files: []launch.PlannedFile{}}
+	err := plan.Apply(context.Background())
+	if err == nil {
+		t.Fatal("Apply returned nil for failed process")
+	}
+	if !strings.Contains(err.Error(), "23") && !strings.Contains(err.Error(), "exit status") {
+		t.Fatalf("unexpected process error: %v", err)
+	}
+}
