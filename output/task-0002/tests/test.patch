@@ -0,0 +1,107 @@
+package launchadapters_test
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/ollama/ollama/cmd/launch"
+)
+
+func droidSettingsFile(t *testing.T, plan launch.Plan) launch.PlannedFile {
+	t.Helper()
+	for _, file := range plan.Files {
+		if filepath.Base(file.Path) == "settings.json" {
+			return file
+		}
+	}
+	t.Fatalf("droid plan has no settings.json: %#v", plan.Files)
+	return launch.PlannedFile{}
+}
+
+func parseObject(t *testing.T, contents string) map[string]any {
+	t.Helper()
+	var object map[string]any
+	if err := json.Unmarshal([]byte(contents), &object); err != nil {
+		t.Fatalf("invalid JSON: %v\n%s", err, contents)
+	}
+	return object
+}
+
+func TestDroidPlanUsesResolvedDroidBinary(t *testing.T) {
+	want := fakeBinary(t, "droid", "#!/bin/sh\nexit 0\n")
+	plan := adapterPlan(t, "droid", "droid-plan-model", "http://127.0.0.1:23301")
+	if plan.Binary != want {
+		t.Fatalf("Binary = %q, want %q", plan.Binary, want)
+	}
+}
+
+func TestDroidPlanCreatesFactorySettingsPath(t *testing.T) {
+	home := t.TempDir()
+	fakeBinary(t, "droid", "#!/bin/sh\nexit 0\n")
+	plan, err := launch.BuildPlan(t.Context(), "droid", launch.PlanOptions{Home: home, Model: "droid-plan-model", Host: "http://127.0.0.1:23302"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	file := droidSettingsFile(t, plan)
+	if file.Path != filepath.Join(home, ".factory", "settings.json") {
+		t.Fatalf("Path = %q", file.Path)
+	}
+	if file.Action != launch.FileCreate {
+		t.Fatalf("Action = %q, want create", file.Action)
+	}
+}
+
+func TestDroidPlanContainsSelectedCustomModel(t *testing.T) {
+	fakeBinary(t, "droid", "#!/bin/sh\nexit 0\n")
+	plan := adapterPlan(t, "droid", "droid-plan-model", "http://127.0.0.1:23303")
+	settings := parseObject(t, droidSettingsFile(t, plan).Contents)
+	models, ok := settings["customModels"].([]any)
+	if !ok || len(models) == 0 {
+		t.Fatalf("customModels = %#v", settings["customModels"])
+	}
+	model, ok := models[0].(map[string]any)
+	if !ok || model["model"] != "droid-plan-model" {
+		t.Fatalf("first custom model = %#v", models[0])
+	}
+}
+
+func TestDroidPlanContainsRequestedHostAndProvider(t *testing.T) {
+	fakeBinary(t, "droid", "#!/bin/sh\nexit 0\n")
+	plan := adapterPlan(t, "droid", "droid-plan-model", "http://127.0.0.1:23304")
+	settings := parseObject(t, droidSettingsFile(t, plan).Contents)
+	models := settings["customModels"].([]any)
+	model := models[0].(map[string]any)
+	if value, _ := model["baseUrl"].(string); !strings.Contains(value, "127.0.0.1:23304") || !strings.HasSuffix(value, "/v1") {
+		t.Fatalf("baseUrl = %q", value)
+	}
+	if model["provider"] != "generic-chat-completion-api" || model["apiKey"] != "ollama" {
+		t.Fatalf("provider fields = %#v", model)
+	}
+}
+
+func TestDroidPlanMergesAndPreservesExistingSettings(t *testing.T) {
+	home := t.TempDir()
+	path := filepath.Join(home, ".factory", "settings.json")
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(`{"theme":"dark","enableHooks":true}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	fakeBinary(t, "droid", "#!/bin/sh\nexit 0\n")
+	plan, err := launch.BuildPlan(t.Context(), "droid", launch.PlanOptions{Home: home, Model: "droid-plan-model", Host: "http://127.0.0.1:23305"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	file := droidSettingsFile(t, plan)
+	if file.Action != launch.FileMerge {
+		t.Fatalf("Action = %q, want merge", file.Action)
+	}
+	settings := parseObject(t, file.Contents)
+	if settings["theme"] != "dark" || settings["enableHooks"] != true {
+		t.Fatalf("existing settings not preserved: %#v", settings)
+	}
+}
