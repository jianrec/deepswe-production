+package launchadapters_test
+
+import (
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/ollama/ollama/cmd/launch"
+)
+
+func codexFile(t *testing.T, plan launch.Plan, base string) launch.PlannedFile {
+	t.Helper()
+	for _, file := range plan.Files {
+		if filepath.Base(file.Path) == base {
+			return file
+		}
+	}
+	t.Fatalf("codex plan has no %s: %#v", base, plan.Files)
+	return launch.PlannedFile{}
+}
+
+func TestCodexPlanUsesResolvedCodexBinary(t *testing.T) {
+	want := fakeBinary(t, "codex", "#!/bin/sh\nexit 0\n")
+	plan := adapterPlan(t, "codex", "codex-plan-model", "http://127.0.0.1:23201")
+	if plan.Binary != want {
+		t.Fatalf("Binary = %q, want %q", plan.Binary, want)
+	}
+}
+
+func TestCodexPlanIncludesManagedProfileArguments(t *testing.T) {
+	fakeBinary(t, "codex", "#!/bin/sh\nexit 0\n")
+	plan := adapterPlan(t, "codex", "codex-plan-model", "http://127.0.0.1:23202")
+	if !slices.Contains(plan.Args, "--profile") || !slices.Contains(plan.Args, "ollama-launch") {
+		t.Fatalf("Args do not select managed profile: %v", plan.Args)
+	}
+	if !slices.Contains(plan.Args, "-m") || !slices.Contains(plan.Args, "codex-plan-model") {
+		t.Fatalf("Args do not select model: %v", plan.Args)
+	}
+}
+
+func TestCodexPlanContainsOwnedProfileConfig(t *testing.T) {
+	fakeBinary(t, "codex", "#!/bin/sh\nexit 0\n")
+	plan := adapterPlan(t, "codex", "codex-plan-model", "http://127.0.0.1:23203")
+	file := codexFile(t, plan, "ollama-launch.config.toml")
+	for _, want := range []string{"codex-plan-model", "ollama-launch", "responses", "127.0.0.1:23203", "/v1/"} {
+		if !strings.Contains(file.Contents, want) {
+			t.Fatalf("profile config missing %q:\n%s", want, file.Contents)
+		}
+	}
+}
+
+func TestCodexPlanContainsModelCatalog(t *testing.T) {
+	fakeBinary(t, "codex", "#!/bin/sh\nexit 0\n")
+	plan := adapterPlan(t, "codex", "codex-plan-model", "http://127.0.0.1:23204")
+	file := codexFile(t, plan, "model.json")
+	if !strings.Contains(file.Contents, `"slug": "codex-plan-model"`) && !strings.Contains(file.Contents, `"slug":"codex-plan-model"`) {
+		t.Fatalf("model catalog missing selected model:\n%s", file.Contents)
+	}
+}
+
+func TestCodexPlanFilesStayInsideRequestedHome(t *testing.T) {
+	home := t.TempDir()
+	fakeBinary(t, "codex", "#!/bin/sh\nexit 0\n")
+	plan, err := launch.BuildPlan(t.Context(), "codex", launch.PlanOptions{Home: home, Model: "codex-plan-model", Host: "http://127.0.0.1:23205"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, file := range plan.Files {
+		rel, err := filepath.Rel(home, file.Path)
+		if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+			t.Fatalf("file outside requested home: %q", file.Path)
+		}
+	}
+}
