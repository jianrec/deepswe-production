@@ -0,0 +1,194 @@
+package launchcli_test
+
+import (
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/ollama/ollama/cmd/launch"
+)
+
+var buildOnce sync.Once
+var binaryPath string
+var binaryBuildError error
+
+func repositoryRoot(t *testing.T) string {
+	t.Helper()
+	cwd, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return filepath.Clean(filepath.Join(cwd, "..", ".."))
+}
+
+func ollamaBinary(t *testing.T) string {
+	t.Helper()
+	buildOnce.Do(func() {
+		dir, err := os.MkdirTemp("", "launch-plan-cli-")
+		if err != nil {
+			binaryBuildError = err
+			return
+		}
+		binaryPath = filepath.Join(dir, "ollama")
+		cmd := exec.Command("go", "build", "-o", binaryPath, ".")
+		cmd.Dir = repositoryRoot(t)
+		cmd.Env = append(os.Environ(), "GOENV=off")
+		output, err := cmd.CombinedOutput()
+		if err != nil {
+			binaryBuildError = &buildError{err: err, output: string(output)}
+		}
+	})
+	if binaryBuildError != nil {
+		t.Fatalf("build ollama: %v", binaryBuildError)
+	}
+	return binaryPath
+}
+
+type buildError struct {
+	err error
+	output string
+}
+
+func (e *buildError) Error() string { return e.err.Error() + ": " + e.output }
+
+func runCLI(t *testing.T, home string, toolBody string, extraEnv []string, args ...string) ([]byte, error) {
+	t.Helper()
+	toolDir := t.TempDir()
+	if toolBody == "" {
+		toolBody = "#!/bin/sh\nexit 0\n"
+	}
+	for _, name := range []string{"claude", "codex", "copilot", "droid", "opencode"} {
+		if err := os.WriteFile(filepath.Join(toolDir, name), []byte(toolBody), 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	cmd := exec.Command(ollamaBinary(t), args...)
+	cmd.Dir = repositoryRoot(t)
+	cmd.Env = append(os.Environ(),
+		"HOME="+home,
+		"USERPROFILE="+home,
+		"PATH="+toolDir+string(os.PathListSeparator)+os.Getenv("PATH"),
+		"OLLAMA_HOST=http://127.0.0.1:24115",
+	)
+	cmd.Env = append(cmd.Env, extraEnv...)
+	return cmd.CombinedOutput()
+}
+
+func TestLaunchDryRunPrintsHumanPlan(t *testing.T) {
+	output, err := runCLI(t, t.TempDir(), "", nil, "launch", "codex", "--dry-run", "--model", "cli-model")
+	if err != nil {
+		t.Fatalf("dry run: %v\n%s", err, output)
+	}
+	for _, want := range []string{"codex", "cli-model", "127.0.0.1:24115"} {
+		if !strings.Contains(string(output), want) {
+			t.Fatalf("human plan missing %q:\n%s", want, output)
+		}
+	}
+}
+
+func TestLaunchDryRunJSONPrintsPlan(t *testing.T) {
+	output, err := runCLI(t, t.TempDir(), "", nil, "launch", "codex", "--dry-run", "--json", "--model", "json-model")
+	if err != nil {
+		t.Fatalf("JSON dry run: %v\n%s", err, output)
+	}
+	var plan launch.Plan
+	if err := json.Unmarshal(output, &plan); err != nil {
+		t.Fatalf("invalid plan JSON: %v\n%s", err, output)
+	}
+	if plan.Integration != "codex" || plan.Model != "json-model" || plan.Binary == "" || plan.Env == nil || plan.Files == nil {
+		t.Fatalf("incomplete JSON plan: %#v", plan)
+	}
+}
+
+func TestLaunchDryRunModelFlagOverridesEnvironment(t *testing.T) {
+	output, err := runCLI(t, t.TempDir(), "", []string{"OLLAMA_LAUNCH_MODEL=environment-model"}, "launch", "copilot", "--dry-run", "--json", "--model", "flag-model")
+	if err != nil {
+		t.Fatalf("dry run: %v\n%s", err, output)
+	}
+	var plan launch.Plan
+	if err := json.Unmarshal(output, &plan); err != nil {
+		t.Fatal(err)
+	}
+	if plan.Model != "flag-model" {
+		t.Fatalf("Model = %q", plan.Model)
+	}
+}
+
+func TestLaunchDryRunUsesEnvironmentModelFallback(t *testing.T) {
+	output, err := runCLI(t, t.TempDir(), "", []string{"OLLAMA_LAUNCH_MODEL=fallback-model"}, "launch", "claude", "--dry-run", "--json")
+	if err != nil {
+		t.Fatalf("dry run: %v\n%s", err, output)
+	}
+	var plan launch.Plan
+	if err := json.Unmarshal(output, &plan); err != nil {
+		t.Fatal(err)
+	}
+	if plan.Model != "fallback-model" {
+		t.Fatalf("Model = %q", plan.Model)
+	}
+}
+
+func TestLaunchDryRunDoesNotExecuteTarget(t *testing.T) {
+	home := t.TempDir()
+	marker := filepath.Join(home, "executed")
+	body := "#!/bin/sh\ntouch \"$EXEC_MARKER\"\n"
+	output, err := runCLI(t, home, body, []string{"EXEC_MARKER=" + marker}, "launch", "codex", "--dry-run", "--model", "no-exec-model")
+	if err != nil {
+		t.Fatalf("dry run: %v\n%s", err, output)
+	}
+	if _, err := os.Stat(marker); !os.IsNotExist(err) {
+		t.Fatalf("dry run executed target: %v", err)
+	}
+}
+
+func TestLaunchDryRunDoesNotCreateMissingHome(t *testing.T) {
+	home := filepath.Join(t.TempDir(), "missing-home")
+	output, err := runCLI(t, home, "", nil, "launch", "droid", "--dry-run", "--model", "no-write-model")
+	if err != nil {
+		t.Fatalf("dry run: %v\n%s", err, output)
+	}
+	if _, err := os.Stat(home); !os.IsNotExist(err) {
+		t.Fatalf("dry run created home: %v", err)
+	}
+}
+
+func TestLaunchDryRunExistingConfigReportsMutationWithoutChangingFile(t *testing.T) {
+	home := t.TempDir()
+	path := filepath.Join(home, ".factory", "settings.json")
+	seed := []byte(`{"theme":"dark"}`)
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, seed, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	output, err := runCLI(t, home, "", nil, "launch", "droid", "--dry-run", "--json", "--model", "dry-existing-model")
+	if err != nil {
+		t.Fatalf("dry run: %v\n%s", err, output)
+	}
+	var plan launch.Plan
+	if err := json.Unmarshal(output, &plan); err != nil {
+		t.Fatal(err)
+	}
+	if len(plan.Files) == 0 || plan.Files[0].Action != launch.FileMerge {
+		t.Fatalf("expected merge action: %#v", plan.Files)
+	}
+	got, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != string(seed) {
+		t.Fatalf("dry run changed config from %q to %q", seed, got)
+	}
+}
+
+func TestLaunchDryRunUnknownIntegrationFails(t *testing.T) {
+	output, err := runCLI(t, t.TempDir(), "", nil, "launch", "not-a-real-integration", "--dry-run", "--model", "m")
+	if err == nil {
+		t.Fatalf("unknown integration succeeded:\n%s", output)
+	}
+}
