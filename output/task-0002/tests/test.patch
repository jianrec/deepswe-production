+package launchplan_test
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/ollama/ollama/cmd/launch"
+)
+
+const testHost = "http://127.0.0.1:22115"
+
+func installFakeTools(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	for _, name := range []string{
+		"chatgpt", "claude", "claude-desktop", "cline", "code", "codex", "copilot",
+		"droid", "hermes", "hermes-desktop", "kimi", "ollama", "omp", "openclaw",
+		"opencode", "pi", "pool", "qwen",
+	} {
+		path := filepath.Join(dir, name)
+		if err := os.WriteFile(path, []byte("#!/bin/sh\nexit 0\n"), 0o755); err != nil {
+			t.Fatalf("write fake %s: %v", name, err)
+		}
+	}
+	t.Setenv("PATH", dir+string(os.PathListSeparator)+os.Getenv("PATH"))
+	return dir
+}
+
+func buildPlan(t *testing.T, name, home, model, host string) launch.Plan {
+	t.Helper()
+	installFakeTools(t)
+	plan, err := launch.BuildPlan(context.Background(), name, launch.PlanOptions{
+		Home: home,
+		Host: host,
+		Model: model,
+	})
+	if err != nil {
+		t.Fatalf("BuildPlan(%q): %v", name, err)
+	}
+	return plan
+}
+
+func findFile(t *testing.T, plan launch.Plan, suffix string) launch.PlannedFile {
+	t.Helper()
+	for _, file := range plan.Files {
+		if filepath.ToSlash(file.Path) == filepath.ToSlash(suffix) || filepath.Base(file.Path) == suffix {
+			return file
+		}
+		if len(file.Path) >= len(suffix) && filepath.ToSlash(file.Path[len(file.Path)-len(suffix):]) == filepath.ToSlash(suffix) {
+			return file
+		}
+	}
+	t.Fatalf("plan for %q has no file ending in %q: %#v", plan.Integration, suffix, plan.Files)
+	return launch.PlannedFile{}
+}
+
+func writeExecutable(t *testing.T, body string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "planned-tool")
+	if err := os.WriteFile(path, []byte(body), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
