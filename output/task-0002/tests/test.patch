+
+	"github.com/ollama/ollama/cmd/launch"
+)
+
+func TestRegisteredIntegrationsNonEmpty(t *testing.T) {
+	if len(launch.RegisteredIntegrations()) == 0 {
+		t.Fatal("RegisteredIntegrations returned no integrations")
+	}
+}
+
+func TestRegisteredIntegrationsSorted(t *testing.T) {
+	got := launch.RegisteredIntegrations()
+	want := slices.Clone(got)
+	slices.Sort(want)
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("RegisteredIntegrations = %v, want sorted %v", got, want)
+	}
+}
+
+func TestRegisteredIntegrationsUnique(t *testing.T) {
+	seen := map[string]bool{}
+	for _, name := range launch.RegisteredIntegrations() {
+		if seen[name] {
+			t.Fatalf("duplicate integration %q", name)
+		}
+		seen[name] = true
+	}
+}
+
+func TestRegisteredIntegrationsContainNoBlankNames(t *testing.T) {
+	for _, name := range launch.RegisteredIntegrations() {
+		if strings.TrimSpace(name) == "" {
+			t.Fatalf("blank integration in %v", launch.RegisteredIntegrations())
+		}
+	}
+}
+
+func TestRegisteredIntegrationsReturnsIndependentSlice(t *testing.T) {
+	first := launch.RegisteredIntegrations()
+	if len(first) == 0 {
+		t.Fatal("empty registry")
+	}
+	original := first[0]
+	first[0] = "mutated-hidden-test"
+	second := launch.RegisteredIntegrations()
+	if second[0] != original {
+		t.Fatalf("registry slice aliases caller mutation: %v", second)
+	}
+}
+
+func TestEveryRegisteredIntegrationBuildsCompletePlan(t *testing.T) {
+	installFakeTools(t)
+	for _, name := range launch.RegisteredIntegrations() {
+		home := t.TempDir()
+		plan, err := launch.BuildPlan(context.Background(), name, launch.PlanOptions{Home: home, Host: testHost, Model: "registry-model"})
+		if err != nil {
+			t.Fatalf("BuildPlan(%q): %v", name, err)
+		}
+		if plan.Integration != name {
+			t.Fatalf("BuildPlan(%q).Integration = %q", name, plan.Integration)
+		}
+		if strings.TrimSpace(plan.Binary) == "" {
+			t.Fatalf("BuildPlan(%q) returned empty Binary", name)
+		}
+		if plan.Model != "registry-model" {
+			t.Fatalf("BuildPlan(%q).Model = %q", name, plan.Model)
+		}
+		if plan.Env == nil || plan.Args == nil || plan.Files == nil {
+			t.Fatalf("BuildPlan(%q) returned nil collection: %#v", name, plan)
+		}
+	}
