+
+func TestExistingIdenticalCodexFilesReportUnchanged(t *testing.T) {
+	home := t.TempDir()
+	initial := buildPlan(t, "codex", home, "same-model", testHost)
+	for _, file := range initial.Files {
+		if err := os.MkdirAll(filepath.Dir(file.Path), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(file.Path, []byte(file.Contents), file.Mode); err != nil {
+			t.Fatal(err)
+		}
+	}
+	plan := buildPlan(t, "codex", home, "same-model", testHost)
+	for _, file := range plan.Files {
+		if file.Action != launch.FileUnchanged {
+			t.Fatalf("%q action = %q, want unchanged", file.Path, file.Action)
+		}
+	}
