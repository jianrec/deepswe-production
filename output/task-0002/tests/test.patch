@@ -0,0 +1,81 @@
+package launchadapters_test
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/ollama/ollama/cmd/launch"
+)
+
+func fakeBinary(t *testing.T, name, body string) string {
+	t.Helper()
+	dir := t.TempDir()
+	path := filepath.Join(dir, name)
+	if err := os.WriteFile(path, []byte(body), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", dir)
+	return path
+}
+
+func adapterPlan(t *testing.T, name, model, host string) launch.Plan {
+	t.Helper()
+	plan, err := launch.BuildPlan(context.Background(), name, launch.PlanOptions{Home: t.TempDir(), Model: model, Host: host})
+	if err != nil {
+		t.Fatalf("BuildPlan(%q): %v", name, err)
+	}
+	return plan
+}
+
+func TestClaudePlanUsesResolvedClaudeBinary(t *testing.T) {
+	want := fakeBinary(t, "claude", "#!/bin/sh\nexit 0\n")
+	plan := adapterPlan(t, "claude", "claude-plan-model", "http://127.0.0.1:23001")
+	if plan.Binary != want {
+		t.Fatalf("Binary = %q, want %q", plan.Binary, want)
+	}
+}
+
+func TestClaudePlanIncludesModelArguments(t *testing.T) {
+	fakeBinary(t, "claude", "#!/bin/sh\nexit 0\n")
+	plan := adapterPlan(t, "claude", "claude-plan-model", "http://127.0.0.1:23002")
+	if !slices.Equal(plan.Args, []string{"--model", "claude-plan-model"}) {
+		t.Fatalf("Args = %v", plan.Args)
+	}
+}
+
+func TestClaudePlanUsesRequestedAnthropicBaseURL(t *testing.T) {
+	fakeBinary(t, "claude", "#!/bin/sh\nexit 0\n")
+	host := "http://127.0.0.1:23003"
+	plan := adapterPlan(t, "claude", "claude-plan-model", host)
+	if plan.Env["ANTHROPIC_BASE_URL"] != host {
+		t.Fatalf("ANTHROPIC_BASE_URL = %q, want %q", plan.Env["ANTHROPIC_BASE_URL"], host)
+	}
+}
+
+func TestClaudePlanIncludesEstablishedAuthenticationEnvironment(t *testing.T) {
+	fakeBinary(t, "claude", "#!/bin/sh\nexit 0\n")
+	plan := adapterPlan(t, "claude", "claude-plan-model", "http://127.0.0.1:23004")
+	if plan.Env["ANTHROPIC_AUTH_TOKEN"] != "ollama" {
+		t.Fatalf("ANTHROPIC_AUTH_TOKEN = %q", plan.Env["ANTHROPIC_AUTH_TOKEN"])
+	}
+	if value, ok := plan.Env["ANTHROPIC_API_KEY"]; !ok || value != "" {
+		t.Fatalf("ANTHROPIC_API_KEY missing or nonempty: %q, %v", value, ok)
+	}
+}
+
+func TestClaudePlanIncludesModelEnvironmentForAllModelClasses(t *testing.T) {
+	fakeBinary(t, "claude", "#!/bin/sh\nexit 0\n")
+	plan := adapterPlan(t, "claude", "claude-plan-model", "http://127.0.0.1:23005")
+	for _, key := range []string{"ANTHROPIC_DEFAULT_OPUS_MODEL", "ANTHROPIC_DEFAULT_SONNET_MODEL", "ANTHROPIC_DEFAULT_HAIKU_MODEL", "CLAUDE_CODE_SUBAGENT_MODEL"} {
+		if value := plan.Env[key]; value != "claude-plan-model" {
+			t.Fatalf("%s = %q", key, value)
+		}
+	}
+	if strings.TrimSpace(plan.Model) != "claude-plan-model" {
+		t.Fatalf("Model = %q", plan.Model)
+	}
+}
