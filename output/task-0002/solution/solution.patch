+package launch
+
+import "strings"
+
+func updateDroidPlanHost(settings map[string]any, host string) map[string]any {
+	baseURL := strings.TrimRight(strings.TrimSpace(host), "/")
+	if baseURL == "" {
+		return settings
+	}
+	baseURL += "/v1"
+
+	models, ok := settings["customModels"].([]any)
+	if !ok {
+		return settings
+	}
+	for index, raw := range models {
+		switch model := raw.(type) {
+		case modelEntry:
+			if model.APIKey == "ollama" {
+				model.BaseURL = baseURL
+				models[index] = model
+			}
+		case map[string]any:
+			if model["apiKey"] == "ollama" {
+				model["baseUrl"] = baseURL
+			}
+		}
+	}
+	return settings
+}
