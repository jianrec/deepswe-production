@@ -0,0 +1,34 @@
+package launch
+
+import "context"
+
+// Plan returns the side-effect-free launch plan for Qwen Code. Qwen is pointed
+// at the local Ollama server through OpenAI-compatible environment variables.
+func (q *Qwen) Plan(_ context.Context, opts PlanOptions) (Plan, error) {
+	binary := "qwen"
+	if p, err := q.findPath(); err == nil {
+		binary = p
+	}
+
+	var args []string
+	if opts.Model != "" {
+		args = append(args, "--model", opts.Model)
+	}
+
+	env := map[string]string{}
+	if opts.Host != "" {
+		env["OPENAI_BASE_URL"] = opts.Host + "/v1"
+		env["OPENAI_API_KEY"] = "ollama"
+		if opts.Model != "" {
+			env["OPENAI_MODEL"] = opts.Model
+		}
+	}
+
+	return Plan{
+		Integration: "qwen",
+		Binary:      binary,
+		Args:        args,
+		Env:         env,
+		Model:       opts.Model,
+	}, nil
+}
