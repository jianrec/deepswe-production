diff --git a/cmd/launch/plan.go b/cmd/launch/plan.go
new file mode 100644
index 0000000..218c451
--- /dev/null
+++ b/cmd/launch/plan.go
@@ -0,0 +1,214 @@
+package launch
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io/fs"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/ollama/ollama/envconfig"
+)
+
+// FileAction describes what applying a PlannedFile would do to the filesystem.
+type FileAction string
+
+const (
+	FileCreate    FileAction = "create"
+	FileMerge     FileAction = "merge"
+	FileOverwrite FileAction = "overwrite"
+	FileUnchanged FileAction = "unchanged"
+)
+
+// PlannedFile describes a single config file a launch plan would materialize.
+type PlannedFile struct {
+	Path     string      `json:"path"`
+	Contents string      `json:"contents"`
+	Mode     fs.FileMode `json:"mode"`
+	Action   FileAction  `json:"action"`
+}
+
+// Plan is a side-effect-free description of what `ollama launch` would do.
+type Plan struct {
+	Integration string            `json:"integration"`
+	Binary      string            `json:"binary"`
+	Args        []string          `json:"args"`
+	Env         map[string]string `json:"env"`
+	Model       string            `json:"model"`
+	Files       []PlannedFile     `json:"files"`
+	Notes       []string          `json:"notes,omitempty"`
+}
+
+// PlanOptions controls how a plan is computed.
+type PlanOptions struct {
+	Model string
+	Home  string
+	Host  string
+}
+
+// Planner is implemented by integrations that can compute a launch Plan.
+type Planner interface {
+	Plan(ctx context.Context, opts PlanOptions) (Plan, error)
+}
+
+// resolvePlanModel resolves the model precedence: --model, then
+// OLLAMA_LAUNCH_MODEL, then the existing default recommendation.
+func resolvePlanModel(explicit string) string {
+	if strings.TrimSpace(explicit) != "" {
+		return explicit
+	}
+	if m := envconfig.LaunchModel(); m != "" {
+		return m
+	}
+	return launchDefaultModelName()
+}
+
+// resolveBinary resolves a command name to an absolute path when it exists on
+// PATH, falling back to the bare command name otherwise.
+func resolveBinary(name string) string {
+	if p, err := exec.LookPath(name); err == nil {
+		return p
+	}
+	return name
+}
+
+// genericPlan builds a resolved-model-only plan for integrations that do not
+// implement Planner, so BuildPlan never fails for a registered name. The plan
+// still carries the target OLLAMA host and a usable binary name.
+func genericPlan(name string, runner Runner, opts PlanOptions) Plan {
+	env := map[string]string{}
+	if opts.Host != "" {
+		env["OLLAMA_HOST"] = opts.Host
+	}
+	var args []string
+	if opts.Model != "" {
+		args = append(args, "--model", opts.Model)
+	}
+	return Plan{
+		Integration: name,
+		Binary:      resolveBinary(name),
+		Args:        args,
+		Env:         env,
+		Model:       opts.Model,
+		Notes:       []string{fmt.Sprintf("%s does not expose a detailed launch plan; resolved model only", runner.String())},
+	}
+}
+
+// classifyAction decides the action for a file without modifying it. It reads
+// the existing file (if present) and compares final contents so callers never
+// need to touch the filesystem to know whether a launch would change it.
+func classifyAction(path, contents string, merge bool) FileAction {
+	existing, err := os.ReadFile(path)
+	if err != nil {
+		return FileCreate
+	}
+	if string(existing) == contents {
+		return FileUnchanged
+	}
+	if merge {
+		return FileMerge
+	}
+	return FileOverwrite
+}
+
+// Render returns a deterministic human-readable description of the plan.
+func (p Plan) Render() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "Integration: %s\n", p.Integration)
+	fmt.Fprintf(&b, "Model:       %s\n", p.Model)
+	fmt.Fprintf(&b, "Binary:      %s\n", p.Binary)
+	fmt.Fprintf(&b, "Args:        %s\n", strings.Join(p.Args, " "))
+
+	b.WriteString("Env:\n")
+	for _, k := range sortedEnvKeys(p.Env) {
+		fmt.Fprintf(&b, "  %s=%s\n", k, p.Env[k])
+	}
+
+	if len(p.Files) > 0 {
+		b.WriteString("Files:\n")
+		for _, f := range sortedPlannedFiles(p.Files) {
+			fmt.Fprintf(&b, "  [%s] %s (mode %o)\n", f.Action, f.Path, uint32(f.Mode.Perm()))
+		}
+	}
+
+	for _, note := range p.Notes {
+		fmt.Fprintf(&b, "Note: %s\n", note)
+	}
+	return b.String()
+}
+
+// JSON returns the plan as deterministic JSON. Map keys are emitted in sorted
+// order by encoding/json, and the Files slice is preserved in the order the
+// caller supplied so the value round-trips exactly. BuildPlan is responsible
+// for producing files in stable sorted order.
+func (p Plan) JSON() ([]byte, error) {
+	if p.Env == nil {
+		p.Env = map[string]string{}
+	}
+	return json.MarshalIndent(p, "", "  ")
+}
+
+// Apply materializes the plan's files and execs its binary. Files marked
+// unchanged are skipped so applying a freshly built plan reproduces the
+// pre-change on-disk and environment results exactly.
+func (p Plan) Apply(ctx context.Context) error {
+	for _, f := range sortedPlannedFiles(p.Files) {
+		if f.Action == FileUnchanged {
+			continue
+		}
+		if err := os.MkdirAll(filepath.Dir(f.Path), 0o755); err != nil {
+			return err
+		}
+		if err := os.WriteFile(f.Path, []byte(f.Contents), f.Mode); err != nil {
+			return err
+		}
+	}
+
+	if p.Binary == "" {
+		return nil
+	}
+
+	cmd := exec.CommandContext(ctx, p.Binary, p.Args...)
+	cmd.Stdin = os.Stdin
+	cmd.Stdout = os.Stdout
+	cmd.Stderr = os.Stderr
+	cmd.Env = append(os.Environ(), envSlice(p.Env)...)
+	return cmd.Run()
+}
+
+func envMapFromPairs(pairs []string) map[string]string {
+	env := make(map[string]string, len(pairs))
+	for _, pair := range pairs {
+		k, v, _ := strings.Cut(pair, "=")
+		env[k] = v
+	}
+	return env
+}
+
+func envSlice(env map[string]string) []string {
+	out := make([]string, 0, len(env))
+	for _, k := range sortedEnvKeys(env) {
+		out = append(out, k+"="+env[k])
+	}
+	return out
+}
+
+func sortedEnvKeys(m map[string]string) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func sortedPlannedFiles(files []PlannedFile) []PlannedFile {
+	out := make([]PlannedFile, len(files))
+	copy(out, files)
+	sort.SliceStable(out, func(i, j int) bool { return out[i].Path < out[j].Path })
+	return out
+}
