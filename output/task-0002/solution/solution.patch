 func (c *Codex) String() string { return "Codex" }
 
+// Plan returns the side-effect-free launch plan for Codex. It renders the same
+// model catalog and launch profile that ensureCodexConfig writes, but only in
+// memory, and classifies each file's action against any existing on-disk copy.
+func (c *Codex) Plan(_ context.Context, opts PlanOptions) (Plan, error) {
+	binary := "codex"
+	if p, err := exec.LookPath("codex"); err == nil {
+		binary = p
+	}
+
+	configPath := filepath.Join(opts.Home, ".codex", "config.toml")
+	catalogPath := codexModelCatalogPathForConfig(configPath)
+	profilePath := codexProfileConfigPathForConfig(configPath)
+
+	catalogData, err := codexModelCatalogContent(opts.Model, nil)
+	if err != nil {
+		return Plan{}, err
+	}
+	baseURL := strings.TrimRight(opts.Host, "/") + "/v1/"
+	profileText := codexProfileConfigText(opts.Model, catalogPath, baseURL)
+
+	args, err := c.args(opts.Model, catalogPath, nil)
+	if err != nil {
+		return Plan{}, err
+	}
+
+	files := []PlannedFile{
+		{
+			Path:     catalogPath,
+			Contents: string(catalogData),
+			Mode:     0o644,
+			Action:   classifyAction(catalogPath, string(catalogData), false),
+		},
+		{
+			Path:     profilePath,
+			Contents: profileText,
+			Mode:     0o644,
+			Action:   classifyAction(profilePath, profileText, false),
+		},
+	}
+
+	return Plan{
+		Integration: "codex",
+		Binary:      binary,
+		Args:        args,
+		Env:         map[string]string{"OPENAI_API_KEY": "ollama"},
+		Model:       opts.Model,
+		Files:       files,
+	}, nil
+}
+
+// codexModelCatalogContent renders the Codex model catalog JSON in memory,
+// byte-identical to writeCodexModelCatalog.
+func codexModelCatalogContent(modelName string, models []LaunchModel) ([]byte, error) {
+	entry := buildCodexModelEntry(codexCatalogModel(modelName, models))
+	catalog := map[string]any{
+		"models": []any{entry},
+	}
+	return json.MarshalIndent(catalog, "", "  ")
+}
+
+// codexProfileConfigText renders the Codex launch profile TOML in memory,
+// byte-identical to writeCodexNamedProfileConfig for the managed profile. The
+// provider base_url is threaded from the requested host.
+func codexProfileConfigText(model, modelCatalogPath, baseURL string) string {
+	var lines []string
+	if strings.TrimSpace(model) != "" {
+		lines = append(lines, fmt.Sprintf("%s = %q", codexRootModelKey, model))
+	}
+	lines = append(lines, fmt.Sprintf("%s = %q", codexRootModelProviderKey, codexProfileName))
+	if strings.TrimSpace(modelCatalogPath) != "" {
+		lines = append(lines, fmt.Sprintf("%s = %q", codexRootModelCatalogJSONKey, modelCatalogPath))
+	}
+	text := strings.Join(lines, "\n") + "\n\n"
+	text += strings.Join([]string{
+		codexProviderHeaderFor(codexProfileName),
+		fmt.Sprintf("name = %q", codexProviderName),
+		fmt.Sprintf("base_url = %q", baseURL),
+		`wire_api = "responses"`,
+		"",
+	}, "\n")
+	return text
+}
+
 const (
 	codexProfileName           = "ollama-launch"
 	codexProviderName          = "Ollama"
