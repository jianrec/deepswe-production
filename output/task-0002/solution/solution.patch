+package envconfig
+
+import "os"
+
+// LaunchModel returns the default model used by `ollama launch` plans and
+// launches when no --model flag is provided. It reads OLLAMA_LAUNCH_MODEL so
+// that plans are deterministic offline.
+func LaunchModel() string {
+	return os.Getenv("OLLAMA_LAUNCH_MODEL")
+}
