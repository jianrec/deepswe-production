+// BuildPlan computes the launch Plan for a registered integration without
+// writing any file, creating any directory, or executing any process. Unknown
+// integration names return a clear error rather than panicking. A canceled
+// context is honored before any planning work is performed.
+func BuildPlan(ctx context.Context, name string, opts PlanOptions) (Plan, error) {
+	if ctx != nil {
+		if err := ctx.Err(); err != nil {
+			return Plan{}, err
+		}
+	}
+
+	canonical, runner, err := LookupIntegration(name)
+	if err != nil {
+		return Plan{}, err
+	}
+
+	if opts.Home == "" {
+		if home, herr := os.UserHomeDir(); herr == nil {
+			opts.Home = home
+		}
+	}
+	if opts.Host == "" {
+		opts.Host = strings.TrimRight(envconfig.Host().String(), "/")
+	}
+	opts.Model = resolvePlanModel(opts.Model)
+
+	var plan Plan
+	if planner, ok := runner.(Planner); ok {
+		plan, err = planner.Plan(ctx, opts)
+		if err != nil {
+			return Plan{}, err
+		}
+	} else {
+		plan = genericPlan(canonical, runner, opts)
+	}
+
+	if plan.Integration == "" {
+		plan.Integration = canonical
+	}
+	if plan.Binary == "" {
+		plan.Binary = resolveBinary(canonical)
+	}
+	if plan.Model == "" {
+		plan.Model = opts.Model
+	}
+
+	if plan.Args == nil {
+		plan.Args = []string{}
+	}
+	if plan.Env == nil {
+		plan.Env = map[string]string{}
+	}
+	if plan.Notes == nil {
+		plan.Notes = []string{}
+	}
+	if opts.Host != "" {
+		if _, ok := plan.Env["OLLAMA_HOST"]; !ok {
+			plan.Env["OLLAMA_HOST"] = opts.Host
+		}
+	}
+	plan.Files = sortedPlannedFiles(plan.Files)
+	return plan, nil
+}
+
+// RegisteredIntegrations returns the sorted set of canonical integration names.
+func RegisteredIntegrations() []string {
+	names := make([]string, 0, len(integrationSpecs))
+	for _, spec := range integrationSpecs {
+		names = append(names, spec.Name)
+	}
+	sort.Strings(names)
+	return names
+}
