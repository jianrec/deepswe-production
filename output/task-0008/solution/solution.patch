index 0000000..cfe75d2
--- /dev/null
+++ b/sorts/comparator.py
@@ -0,0 +1,135 @@
+"""
+A dependency-free comparison core shared by searches, sorts, and strings.
+
+This module provides an opt-in ordering toolkit so that algorithms can order or
+search *by a derived key* (like Python's ``sorted(key=...)``) instead of always
+comparing raw elements. It has no dependencies on any other module and can be
+used independently of the algorithms it powers.
+
+For doctests run the following command:
+python3 -m doctest -v comparator.py
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from typing import Any, Callable
+
+
+def _compare_key_values(a: Any, b: Any, *, reverse: bool = False) -> int:
+    """Compare two already-resolved keys without invoking a key function."""
+    result = (a > b) - (a < b)
+    return -result if reverse and result else result
+
+
+def _key_values(
+    collection: Sequence[Any],
+    key: Callable[[Any], Any] | None,
+) -> list[Any]:
+    """Resolve one key per element, preserving positional correspondence."""
+    resolved = resolve_key(key)
+    return [resolved(value) for value in collection]
+
+
+def identity(value: Any) -> Any:
+    """Return ``value`` unchanged.
+
+    This is the default key: comparing by the element itself.
+
+    >>> identity(5)
+    5
+    >>> identity('abc')
+    'abc'
+    >>> obj = object()
+    >>> identity(obj) is obj
+    True
+    """
+    return value
+
+
+def resolve_key(key: Callable[[Any], Any] | None) -> Callable[[Any], Any]:
+    """Resolve an optional key callable to a concrete callable.
+
+    ``None`` means identity; any other callable is returned unchanged.
+
+    >>> resolve_key(None) is identity
+    True
+    >>> resolve_key(len)('abc')
+    3
+    >>> resolve_key(abs)(-4)
+    4
+    """
+    return identity if key is None else key
+
+
+def compare(
+    a: Any,
+    b: Any,
+    *,
+    key: Callable[[Any], Any] | None = None,
+    reverse: bool = False,
+) -> int:
+    """Three-way comparison returning ``-1``, ``0`` or ``1``.
+
+    Consistent with ``<``, ``==`` and ``>`` applied to the resolved keys.
+    With ``key``, ``key(a)`` and ``key(b)`` are compared instead of ``a`` and
+    ``b``. With ``reverse=True`` the sign is flipped for unequal values while
+    ``0`` stays ``0``.
+
+    >>> compare(1, 2)
+    -1
+    >>> compare(2, 2)
+    0
+    >>> compare(3, 2)
+    1
+    >>> compare('aa', 'b', key=len)
+    1
+    >>> compare(1, 2, reverse=True)
+    1
+    >>> compare(2, 2, reverse=True)
+    0
+    """
+    resolved = resolve_key(key)
+    ka = resolved(a)
+    kb = resolved(b)
+    return _compare_key_values(ka, kb, reverse=reverse)
+
+
+def is_sorted(
+    collection: Sequence[Any],
+    *,
+    key: Callable[[Any], Any] | None = None,
+    reverse: bool = False,
+) -> bool:
+    """Return ``True`` when ``collection`` is ordered under the key/reverse rule.
+
+    Ascending means every adjacent pair is non-decreasing; ``reverse=True``
+    means every adjacent pair is non-increasing, both under the resolved key.
+    Empty and single-element collections are considered sorted.
+
+    >>> is_sorted([])
+    True
+    >>> is_sorted([42])
+    True
+    >>> is_sorted([1, 1, 2, 3])
+    True
+    >>> is_sorted([1, 3, 2])
+    False
+    >>> is_sorted([3, 2, 1], reverse=True)
+    True
+    >>> is_sorted(['a', 'bb', 'ccc'], key=len)
+    True
+    >>> is_sorted(['ccc', 'bb', 'a'], key=len, reverse=True)
+    True
+    """
+    keys = _key_values(collection, key)
+    for index in range(len(keys) - 1):
+        if _compare_key_values(keys[index], keys[index + 1], reverse=reverse) > 0:
+            return False
+    return True
+
+
+if __name__ == "__main__":
+    import doctest
+
+    doctest.testmod()
