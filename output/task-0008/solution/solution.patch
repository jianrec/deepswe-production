--- /dev/null
+++ b/strings/natural_key.py
@@ -0,0 +1,127 @@
+"""
+Human / natural ordering primitives.
+
+The normal lexicographic ordering of strings puts ``"img10"`` before ``"img2"``
+because it compares code points character by character. Humans expect ``"img2"``
+to come first. This module provides dependency-free primitives to build a total
+ordering key that orders strings the way people expect, usable directly as a
+``key=`` argument for the sorts and searches in this repository (and for the
+built-in ``sorted``).
+
+The chunks produced by :func:`natural_sort_key` are *type-tagged* so that integer
+chunks and text chunks are never compared against each other; this guarantees the
+key never raises ``TypeError`` on mixed inputs such as ``"2a"`` versus ``"a2"``.
+
+For doctests run the following command:
+python3 -m doctest -v natural_key.py
+"""
+
+from __future__ import annotations
+
+import re
+
+_DIGITS = re.compile(r"(\d+)")
+
+
+def natural_chunks(text: str, *, case_sensitive: bool = False) -> list[int | str]:
+    """Split ``text`` into alternating integer and text chunks.
+
+    Runs of digits become ``int`` chunks; everything else stays as ``str``.
+    Text chunks are lower-cased unless ``case_sensitive`` is ``True``. Empty
+    fragments (which ``re.split`` produces at the boundaries) are dropped.
+
+    >>> natural_chunks('img10.png')
+    ['img', 10, '.png']
+    >>> natural_chunks('img2')
+    ['img', 2]
+    >>> natural_chunks('100')
+    [100]
+    >>> natural_chunks('')
+    []
+    >>> natural_chunks('IMG2')
+    ['img', 2]
+    >>> natural_chunks('IMG2', case_sensitive=True)
+    ['IMG', 2]
+    """
+    chunks: list[int | str] = []
+    for fragment in _DIGITS.split(text):
+        if fragment == "":
+            continue
+        if fragment.isdigit():
+            chunks.append(int(fragment))
+        else:
+            chunks.append(fragment if case_sensitive else fragment.lower())
+    return chunks
+
+
+def natural_sort_key(
+    text: str, *, case_sensitive: bool = False
+) -> tuple[tuple[int, int | str], ...]:
+    """Build a total-ordering sort key for natural (human) ordering.
+
+    Each chunk is wrapped as ``(0, int)`` for digit runs and ``(1, str)`` for
+    text runs. Because the leading tag differs, an integer chunk and a text
+    chunk are never compared directly, so the key never raises ``TypeError``.
+
+    Case-insensitive by default; pass ``case_sensitive=True`` to keep case.
+
+    >>> natural_sort_key('img2')
+    ((1, 'img'), (0, 2))
+    >>> natural_sort_key('')
+    ()
+    >>> sorted(['img10', 'img2', 'img1'], key=natural_sort_key)
+    ['img1', 'img2', 'img10']
+    >>> natural_sort_key('IMG2') == natural_sort_key('img2')
+    True
+    >>> natural_sort_key('IMG2', case_sensitive=True) == natural_sort_key('img2', case_sensitive=True)
+    False
+    >>> natural_sort_key('2a') < natural_sort_key('a2')  # never raises on mixed chunks
+    True
+    """
+    key: list[tuple[int, int | str]] = []
+    for chunk in natural_chunks(text, case_sensitive=case_sensitive):
+        if isinstance(chunk, int):
+            key.append((0, chunk))
+        else:
+            key.append((1, chunk))
+    return tuple(key)
+
+
+def natural_compare(a: str, b: str, *, case_sensitive: bool = False) -> int:
+    """Three-way natural comparison returning ``-1``, ``0`` or ``1``.
+
+    >>> natural_compare('img2', 'img10')
+    -1
+    >>> natural_compare('img10', 'img2')
+    1
+    >>> natural_compare('img2', 'img2')
+    0
+    >>> natural_compare('img2', 'IMG2')
+    0
+    >>> natural_compare('img2', 'IMG2', case_sensitive=True)
+    1
+    """
+    ka = natural_sort_key(a, case_sensitive=case_sensitive)
+    kb = natural_sort_key(b, case_sensitive=case_sensitive)
+    return (ka > kb) - (ka < kb)
+
+
+def _natural_sort_demo() -> None:
+    """Cross-module integration: natural ordering drives ``merge_sort``.
+
+    ``natural_sort_key`` plugs straight into the keyed sorts, and equal-under-key
+    inputs keep their input order thanks to merge sort's stability.
+
+    >>> from sorts.merge_sort import merge_sort
+    >>> files = ['img10.png', 'img2.png', 'img1.png', 'img2.png']
+    >>> merge_sort(files, key=natural_sort_key)
+    ['img1.png', 'img2.png', 'img2.png', 'img10.png']
+    >>> merge_sort(files, key=natural_sort_key, reverse=True)
+    ['img10.png', 'img2.png', 'img2.png', 'img1.png']
+    """
