@@ -0,0 +1,52 @@
+import inspect
+
+
+def _position(record):
+    return record["position"]
+
+
+def test_interpolation_search_accepts_keyword_only_key_parameter():
+    from searches.interpolation_search import interpolation_search
+
+    parameters = inspect.signature(interpolation_search).parameters
+    assert parameters["key"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert parameters["key"].default is None
+    assert "reverse" not in parameters
+
+
+def test_interpolation_search_maps_collection_and_target_through_key():
+    from searches.interpolation_search import interpolation_search
+
+    values = [
+        {"position": 10},
+        {"position": 20},
+        {"position": 30},
+        {"position": 40},
+    ]
+    assert interpolation_search(values, {"position": 30}, key=_position) == 2
+
+
+def test_interpolation_search_key_preserves_none_when_absent():
+    from searches.interpolation_search import interpolation_search
+
+    values = [{"position": 10}, {"position": 20}, {"position": 30}]
+    assert interpolation_search(values, {"position": 25}, key=_position) is None
+
+
+def test_interpolation_search_key_handles_empty_collection():
+    from searches.interpolation_search import interpolation_search
+
+    assert interpolation_search([], {"position": 10}, key=_position) is None
+
+
+def test_interpolation_search_key_handles_equal_numeric_values():
+    from searches.interpolation_search import interpolation_search
+
+    values = [
+        {"position": 5, "name": "a"},
+        {"position": 5, "name": "b"},
+        {"position": 5, "name": "c"},
+    ]
+    index = interpolation_search(values, {"position": 5}, key=_position)
+    assert index is not None
+    assert _position(values[index]) == 5
