diff --git a/hidden_tests/test_merge_sort_ordering.py b/hidden_tests/test_merge_sort_ordering.py
new file mode 100644
index 0000000..1911bee
--- /dev/null
+++ b/hidden_tests/test_merge_sort_ordering.py
@@ -0,0 +1,54 @@
+import inspect
+
+
+class Record:
+    def __init__(self, rank, label):
+        self.rank = rank
+        self.label = label
+
+
+def test_merge_sort_accepts_keyword_only_ordering_parameters():
+    from sorts.merge_sort import merge_sort
+
+    parameters = inspect.signature(merge_sort).parameters
+    assert parameters["key"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert parameters["key"].default is None
+    assert parameters["reverse"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert parameters["reverse"].default is False
+
+
+def test_merge_sort_orders_noncomparable_records_by_key():
+    from sorts.merge_sort import merge_sort
+
+    values = [Record(3, "c"), Record(1, "a"), Record(2, "b")]
+    assert [item.label for item in merge_sort(values, key=lambda item: item.rank)] == [
+        "a",
+        "b",
+        "c",
+    ]
+
+
+def test_merge_sort_supports_reverse_key_order():
+    from sorts.merge_sort import merge_sort
+
+    values = [Record(1, "a"), Record(3, "c"), Record(2, "b")]
+    result = merge_sort(values, key=lambda item: item.rank, reverse=True)
+    assert [item.rank for item in result] == [3, 2, 1]
+
+
+def test_merge_sort_is_stable_for_equal_keys():
+    from sorts.merge_sort import merge_sort
+
+    values = [Record(2, "first"), Record(1, "middle"), Record(2, "second")]
+    result = merge_sort(values, key=lambda item: item.rank)
+    assert [item.label for item in result] == ["middle", "first", "second"]
+
+
+def test_merge_sort_is_stable_in_reverse_and_does_not_mutate_input():
+    from sorts.merge_sort import merge_sort
+
+    values = [Record(2, "first"), Record(1, "middle"), Record(2, "second")]
+    original_ids = [id(item) for item in values]
+    result = merge_sort(values, key=lambda item: item.rank, reverse=True)
+    assert [item.label for item in result] == ["first", "second", "middle"]
+    assert [id(item) for item in values] == original_ids
diff --git a/hidden_tests/test_natural_ordering.py b/hidden_tests/test_natural_ordering.py
new file mode 100644
index 0000000..85c218f
--- /dev/null
+++ b/hidden_tests/test_natural_ordering.py
@@ -0,0 +1,63 @@
+def test_natural_chunks_splits_alternating_text_and_integers():
+    from strings.natural_key import natural_chunks
+
+    assert natural_chunks("file12part3") == ["file", 12, "part", 3]
+
+
+def test_natural_chunks_is_case_insensitive_by_default():
+    from strings.natural_key import natural_chunks
+
+    assert natural_chunks("AbC12xY") == ["abc", 12, "xy"]
+
+
+def test_natural_chunks_preserves_case_when_requested():
+    from strings.natural_key import natural_chunks
+
+    assert natural_chunks("AbC12xY", case_sensitive=True) == ["AbC", 12, "xY"]
+
+
+def test_natural_sort_key_orders_human_number_sequences():
+    from strings.natural_key import natural_sort_key
+
+    values = ["img10", "img2", "img1"]
+    assert sorted(values, key=natural_sort_key) == ["img1", "img2", "img10"]
+
+
+def test_natural_sort_key_type_tags_mixed_chunks():
+    from strings.natural_key import natural_sort_key
+
+    key = natural_sort_key("a12b")
+    assert all(isinstance(chunk, tuple) and len(chunk) == 2 for chunk in key)
+    assert all(isinstance(chunk[0], int) for chunk in key)
+    assert key[0][0] != key[1][0]
+    assert key[1][0] != key[2][0]
+
+
+def test_natural_sort_key_never_cross_compares_int_and_text():
+    from strings.natural_key import natural_sort_key
+
+    values = ["12alpha", "alpha12", "2", "beta", "", "٣cats", "cats٣"]
+    result = sorted(values, key=natural_sort_key)
+    assert sorted(result) == sorted(values)
+
+
+def test_natural_sort_key_case_sensitive_mode_changes_order():
+    from strings.natural_key import natural_sort_key
+
+    values = ["a2", "A1"]
+    assert sorted(values, key=natural_sort_key) == ["A1", "a2"]
+    assert sorted(
+        values, key=lambda value: natural_sort_key(value, case_sensitive=True)
+    ) == ["A1", "a2"]
+    assert natural_sort_key("A", case_sensitive=True) != natural_sort_key(
+        "a", case_sensitive=True
+    )
+
+
+def test_natural_compare_returns_normalized_results_in_both_modes():
+    from strings.natural_key import natural_compare
+
+    assert natural_compare("img2", "img10") == -1
+    assert natural_compare("img10", "img2") == 1
+    assert natural_compare("IMG2", "img2") == 0
+    assert natural_compare("A", "a", case_sensitive=True) == -1
diff --git a/hidden_tests/test_ordering_comparator.py b/hidden_tests/test_ordering_comparator.py
new file mode 100644
index 0000000..3afec0d
--- /dev/null
+++ b/hidden_tests/test_ordering_comparator.py
@@ -0,0 +1,74 @@
+import inspect
+
+
+def test_identity_returns_same_object():
+    from sorts.comparator import identity
+
+    value = object()
+    assert identity(value) is value
+
+
+def test_resolve_key_none_returns_identity_behavior():
+    from sorts.comparator import resolve_key
+
+    value = object()
+    assert resolve_key(None)(value) is value
+
+
+def test_resolve_key_returns_supplied_callable():
+    from sorts.comparator import resolve_key
+
+    key = lambda value: value["rank"]
+    assert resolve_key(key) is key
+
+
+def test_compare_returns_normalized_three_way_results():
+    from sorts.comparator import compare
+
+    assert compare(1, 2) == -1
+    assert compare(2, 2) == 0
+    assert compare(3, 2) == 1
+
+
+def test_compare_uses_key_without_comparing_raw_objects():
+    from sorts.comparator import compare
+
+    low = {"rank": 1}
+    high = {"rank": 9}
+    assert compare(low, high, key=lambda value: value["rank"]) == -1
+
+
+def test_compare_reverse_flips_only_unequal_results():
+    from sorts.comparator import compare
+
+    assert compare(1, 2, reverse=True) == 1
+    assert compare(2, 1, reverse=True) == -1
+    assert compare(2, 2, reverse=True) == 0
+
+
+def test_is_sorted_handles_boundaries_and_key_order():
+    from sorts.comparator import is_sorted
+
+    assert is_sorted([])
+    assert is_sorted([{"rank": 1}])
+    assert is_sorted(
+        [{"rank": 1}, {"rank": 1}, {"rank": 3}],
+        key=lambda value: value["rank"],
+    )
+    assert not is_sorted(
+        [{"rank": 1}, {"rank": 3}, {"rank": 2}],
+        key=lambda value: value["rank"],
+    )
+
+
+def test_is_sorted_supports_reverse_and_exact_keyword_only_api():
+    from sorts.comparator import compare, is_sorted
+
+    assert is_sorted([5, 5, 3, 1], reverse=True)
+    assert not is_sorted([5, 3, 4, 1], reverse=True)
+    compare_parameters = inspect.signature(compare).parameters
+    sorted_parameters = inspect.signature(is_sorted).parameters
+    assert compare_parameters["key"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert compare_parameters["reverse"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert sorted_parameters["key"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert sorted_parameters["reverse"].kind is inspect.Parameter.KEYWORD_ONLY
