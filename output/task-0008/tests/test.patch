+import inspect
+
+
+class Record:
+    def __init__(self, rank, label):
+        self.rank = rank
+        self.label = label
+
+
+def test_insertion_sort_accepts_keyword_only_ordering_parameters():
+    from sorts.insertion_sort import insertion_sort
+
+    parameters = inspect.signature(insertion_sort).parameters
+    assert parameters["key"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert parameters["key"].default is None
+    assert parameters["reverse"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert parameters["reverse"].default is False
+
+
+def test_insertion_sort_orders_noncomparable_records_by_key():
+    from sorts.insertion_sort import insertion_sort
+
+    values = [Record(3, "c"), Record(1, "a"), Record(2, "b")]
+    result = insertion_sort(values, key=lambda item: item.rank)
+    assert [item.label for item in result] == ["a", "b", "c"]
+
+
+def test_insertion_sort_supports_reverse_key_order():
+    from sorts.insertion_sort import insertion_sort
+
+    values = [Record(1, "a"), Record(3, "c"), Record(2, "b")]
+    result = insertion_sort(values, key=lambda item: item.rank, reverse=True)
+    assert [item.rank for item in result] == [3, 2, 1]
+
+
+def test_insertion_sort_is_stable_for_equal_keys():
+    from sorts.insertion_sort import insertion_sort
+
+    values = [Record(2, "first"), Record(1, "middle"), Record(2, "second")]
+    result = insertion_sort(values, key=lambda item: item.rank)
+    assert [item.label for item in result] == ["middle", "first", "second"]
+
+
+def test_insertion_sort_reverse_stability_and_in_place_identity():
+    from sorts.insertion_sort import insertion_sort
+
+    values = [Record(2, "first"), Record(1, "middle"), Record(2, "second")]
+    result = insertion_sort(values, key=lambda item: item.rank, reverse=True)
+    assert result is values
+    assert [item.label for item in result] == ["first", "second", "middle"]
