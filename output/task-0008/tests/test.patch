+++ b/hidden_tests/test_binary_search_ordering.py
@@ -0,0 +1,50 @@
+import inspect
+
+
+def _rank(record):
+    return record["rank"]
+
+
+def test_binary_search_accepts_keyword_only_ordering_parameters():
+    from searches.binary_search import binary_search
+
+    parameters = inspect.signature(binary_search).parameters
+    assert parameters["key"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert parameters["key"].default is None
+    assert parameters["reverse"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert parameters["reverse"].default is False
+
+
+def test_binary_search_maps_collection_and_target_through_key():
+    from searches.binary_search import binary_search
+
+    values = [{"rank": 1}, {"rank": 4}, {"rank": 9}]
+    target = {"rank": 4}
+    assert binary_search(values, target, key=_rank) == 1
+
+
+def test_binary_search_key_returns_minus_one_when_absent():
+    from searches.binary_search import binary_search
+
+    values = [{"rank": 1}, {"rank": 4}, {"rank": 9}]
+    assert binary_search(values, {"rank": 5}, key=_rank) == -1
+
+
+def test_binary_search_supports_reverse_sorted_collections():
+    from searches.binary_search import binary_search
+
+    values = [{"rank": 9}, {"rank": 4}, {"rank": 1}]
+    assert binary_search(values, {"rank": 9}, key=_rank, reverse=True) == 0
+    assert binary_search(values, {"rank": 1}, key=_rank, reverse=True) == 2
+
+
+def test_binary_search_validates_sortedness_under_key_and_reverse():
+    from searches.binary_search import binary_search
+
+    values = [{"rank": 9}, {"rank": 1}, {"rank": 4}]
+    try:
+        binary_search(values, {"rank": 4}, key=_rank, reverse=True)
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("binary_search accepted a collection not reverse-sorted by key")
diff --git a/hidden_tests/test_heap_sort_ordering.py b/hidden_tests/test_heap_sort_ordering.py
