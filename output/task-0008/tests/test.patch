index 0000000..973bbe5
--- /dev/null
+++ b/hidden_tests/test_heap_sort_ordering.py
@@ -0,0 +1,55 @@
+import inspect
+
+
+class Record:
+    def __init__(self, rank, label):
+        self.rank = rank
+        self.label = label
+
+
+def test_heap_sort_accepts_keyword_only_ordering_parameters():
+    from sorts.heap_sort import heap_sort
+
+    parameters = inspect.signature(heap_sort).parameters
+    assert parameters["key"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert parameters["key"].default is None
+    assert parameters["reverse"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert parameters["reverse"].default is False
+
+
+def test_heap_sort_orders_noncomparable_records_by_key():
+    from sorts.heap_sort import heap_sort
+
+    values = [Record(3, "c"), Record(1, "a"), Record(2, "b")]
+    result = heap_sort(values, key=lambda item: item.rank)
+    assert [item.rank for item in result] == [1, 2, 3]
+
+
+def test_heap_sort_supports_reverse_key_order():
+    from sorts.heap_sort import heap_sort
+
+    values = [Record(1, "a"), Record(3, "c"), Record(2, "b")]
+    result = heap_sort(values, key=lambda item: item.rank, reverse=True)
+    assert [item.rank for item in result] == [3, 2, 1]
+
+
+def test_heap_sort_preserves_in_place_return_contract_with_key():
+    from sorts.heap_sort import heap_sort
+
+    values = [Record(2, "b"), Record(1, "a")]
+    result = heap_sort(values, key=lambda item: item.rank)
+    assert result is values
+    assert [item.label for item in values] == ["a", "b"]
+
+
+def test_heap_sort_integrates_with_natural_sort_key():
+    from sorts.heap_sort import heap_sort
+    from strings.natural_key import natural_sort_key
+
+    values = ["img10", "img2", "img1", "img20"]
+    assert heap_sort(values, key=natural_sort_key) == [
+        "img1",
+        "img2",
+        "img10",
+        "img20",
+    ]
