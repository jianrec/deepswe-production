--- /dev/null
+++ b/hidden-tests/support/HarborJunitReporter.js
@@ -0,0 +1,38 @@
+const fs = require('fs');
+const path = require('path');
+
+const escapeXml = (value) => String(value)
+  .replace(/&/g, '&amp;')
+  .replace(/</g, '&lt;')
+  .replace(/>/g, '&gt;')
+  .replace(/"/g, '&quot;')
+  .replace(/'/g, '&apos;');
+
+class HarborJunitReporter {
+  onRunComplete(contexts, results) {
+    const outputPath = process.env.HARBOR_JUNIT_PATH;
+    if (!outputPath) return;
+
+    const cases = [];
+    results.testResults.forEach((suite) => {
+      suite.testResults.forEach((assertion) => {
+        const name = escapeXml(assertion.fullName || assertion.title);
+        const className = escapeXml(path.relative(process.cwd(), suite.testFilePath));
+        const duration = Number.isFinite(assertion.duration) ? assertion.duration / 1000 : 0;
+        let body = '';
+        if (assertion.status === 'failed') {
+          body = `<failure message="test failed">${escapeXml(assertion.failureMessages.join('\n'))}</failure>`;
+        } else if (assertion.status === 'pending' || assertion.status === 'todo' || assertion.status === 'disabled') {
+          body = '<skipped />';
+        }
+        cases.push(`<testcase classname="${className}" name="${name}" time="${duration}">${body}</testcase>`);
+      });
+    });
+
+    const xml = `<?xml version="1.0" encoding="UTF-8"?>\n<testsuites tests="${results.numTotalTests}" failures="${results.numFailedTests}" skipped="${results.numPendingTests}" time="${results.runExecError ? 0 : results.startTime}"><testsuite name="jest" tests="${results.numTotalTests}" failures="${results.numFailedTests}" skipped="${results.numPendingTests}">${cases.join('')}</testsuite></testsuites>\n`;
+    fs.mkdirSync(path.dirname(outputPath), { recursive: true });
+    fs.writeFileSync(outputPath, xml);
+  }
+}
+
+module.exports = HarborJunitReporter;
