+++ b/hidden-tests/alphabetCodec.feature.test.js
@@ -0,0 +1,48 @@
+import AlphabetCodec from '../src/algorithms/cryptography/alphabet/AlphabetCodec';
+
+test('AlphabetCodec rejects an empty alphabet', () => {
+  expect(() => new AlphabetCodec('')).toThrow(Error);
+});
+
+test('AlphabetCodec rejects duplicate symbols', () => {
+  expect(() => new AlphabetCodec('ABCA')).toThrow(Error);
+});
+
+test('AlphabetCodec encodes symbols as zero-based indices', () => {
+  const codec = new AlphabetCodec('WXYZ');
+  expect(codec.encode('ZWWY')).toEqual([3, 0, 0, 2]);
+});
+
+test('AlphabetCodec decodes indices using configured symbol case', () => {
+  const codec = new AlphabetCodec('aBcD');
+  expect(codec.decode([0, 1, 2, 3])).toBe('aBcD');
+});
+
+test('AlphabetCodec indexOf returns configured positions', () => {
+  const codec = new AlphabetCodec('QWER');
+  expect(codec.indexOf('Q')).toBe(0);
+  expect(codec.indexOf('E')).toBe(2);
+});
+
+test('AlphabetCodec symbolAt normalizes negative indices', () => {
+  const codec = new AlphabetCodec('ABCD');
+  expect(codec.symbolAt(-1)).toBe('D');
+});
+
+test('AlphabetCodec symbolAt normalizes indices beyond the alphabet', () => {
+  const codec = new AlphabetCodec('ABCD');
+  expect(codec.symbolAt(10)).toBe('C');
+});
+
+test('AlphabetCodec rejects unknown symbols by default', () => {
+  const codec = new AlphabetCodec('ABC');
+  expect(() => codec.encode('AB!C')).toThrow(Error);
+});
+
+test('AlphabetCodec decode does not mutate index arrays', () => {
+  const codec = new AlphabetCodec('ABC');
+  const indices = [2, 0, 1];
+  const snapshot = indices.slice();
+  expect(codec.decode(indices)).toBe('CAB');
+  expect(indices).toEqual(snapshot);
+});
