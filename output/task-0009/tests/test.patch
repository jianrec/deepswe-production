@@ -0,0 +1,117 @@
+import {
+  mod,
+  extendedEuclidean,
+  modularInverse,
+} from '../src/algorithms/math/modular-arithmetic/modularArithmetic';
+
+test('mod normalizes negative dividends', () => {
+  expect(mod(-27, 5)).toBe(3);
+});
+
+test('mod accepts a negative modulus by magnitude', () => {
+  expect(mod(-27, -5)).toBe(3);
+});
+
+test('mod normalizes arbitrarily large safe operands', () => {
+  expect(mod(Number.MAX_SAFE_INTEGER - 1, 97)).toBe(30);
+});
+
+test('mod rejects a zero modulus', () => {
+  expect(() => mod(4, 0)).toThrow(Error);
+});
+
+test('mod rejects unsafe integer operands', () => {
+  expect(() => mod(Number.MAX_SAFE_INTEGER + 1, 7)).toThrow(Error);
+});
+
+test('extendedEuclidean returns a valid Bezout identity for positive inputs', () => {
+  const result = extendedEuclidean(240, 46);
+  expect(result.gcd).toBe(2);
+  expect((240 * result.x) + (46 * result.y)).toBe(result.gcd);
+});
+
+test('extendedEuclidean normalizes signed inputs', () => {
+  const result = extendedEuclidean(-99, 78);
+  expect(result.gcd).toBe(3);
+  expect((-99 * result.x) + (78 * result.y)).toBe(result.gcd);
+});
+
+test('extendedEuclidean rejects unsafe integers', () => {
+  expect(() => extendedEuclidean(Number.POSITIVE_INFINITY, 2)).toThrow(Error);
+});
+
+test('modularInverse returns normalized inverses', () => {
+  expect(modularInverse(3, 26)).toBe(9);
+  expect(modularInverse(-3, 11)).toBe(7);
+});
+
+test('modularInverse rejects non-coprime values', () => {
+  expect(() => modularInverse(6, 26)).toThrow(Error);
+});
+
+test('modularInverse rejects zero modulus deterministically', () => {
+  const firstError = (() => {
+    try { modularInverse(3, 0); } catch (error) { return error.message; }
+    return null;
+  })();
+  const secondError = (() => {
+    try { modularInverse(3, 0); } catch (error) { return error.message; }
+    return null;
+  })();
+  expect(firstError).toEqual(expect.any(String));
+  expect(secondError).toBe(firstError);
+});
+
+test('mod rejects a fractional dividend', () => {
+  expect(() => mod(1.5, 7)).toThrow(Error);
+});
+
+test('mod rejects a fractional modulus', () => {
+  expect(() => mod(7, 1.5)).toThrow(Error);
+});
+
+test('extendedEuclidean handles both negative operands', () => {
+  const result = extendedEuclidean(-240, -46);
+  expect(result.gcd).toBe(2);
+  expect((-240 * result.x) + (-46 * result.y)).toBe(result.gcd);
+});
+
+test('modularInverse normalizes a value larger than the modulus', () => {
+  expect(modularInverse(29, 26)).toBe(9);
+});
+
+test('modularInverse supports a negative modulus', () => {
+  expect(modularInverse(3, -26)).toBe(9);
+});
+
+test('modularInverse rejects an unsafe modulus', () => {
+  expect(() => modularInverse(3, Number.MAX_SAFE_INTEGER + 1)).toThrow(Error);
+});
+
+test('mod accepts a zero dividend', () => {
+  expect(mod(0, 7)).toBe(0);
+});
+
+test('mod normalizes a dividend below negative modulus', () => {
+  expect(mod(-1, 26)).toBe(25);
+});
+
+test('modularInverse returns one for a unit value', () => {
+  expect(modularInverse(1, 26)).toBe(1);
+});
+
+test('modularInverse returns the final residue inverse', () => {
+  expect(modularInverse(25, 26)).toBe(25);
+});
+
+test('extendedEuclidean handles a zero second operand', () => {
+  const result = extendedEuclidean(17, 0);
+  expect(result.gcd).toBe(17);
+  expect(17 * result.x).toBe(result.gcd);
+});
+
+test('extendedEuclidean handles a zero first operand', () => {
+  const result = extendedEuclidean(0, 17);
+  expect(result.gcd).toBe(17);
+  expect(17 * result.y).toBe(result.gcd);
+});
diff --git a/hidden-tests/polynomialHashResidues.feature.test.js b/hidden-tests/polynomialHashResidues.feature.test.js
