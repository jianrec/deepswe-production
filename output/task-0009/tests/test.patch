+++ b/hidden-tests/polynomialHashResidues.feature.test.js
@@ -0,0 +1,43 @@
+import PolynomialHash from '../src/algorithms/cryptography/polynomial-hash/PolynomialHash';
+
+test('PolynomialHash rolling residues stay non-negative for low trailing symbols', () => {
+  const polynomialHash = new PolynomialHash({ base: 37, modulus: 101 });
+  const words = ['za', 'a\u0000', '\u0000b', 'bc', 'c\u0000'];
+  let rollingHash = polynomialHash.hash(words[0]);
+  for (let index = 1; index < words.length; index += 1) {
+    rollingHash = polynomialHash.roll(rollingHash, words[index - 1], words[index]);
+    expect(rollingHash).toBeGreaterThanOrEqual(0);
+    expect(rollingHash).toBeLessThan(101);
+    expect(rollingHash).toBe(polynomialHash.hash(words[index]));
+  }
+});
+
+test('PolynomialHash remains normalized after deletion and re-append operations', () => {
+  const polynomialHash = new PolynomialHash({ base: 17, modulus: 97 });
+  const text = 'z\u0000az\u0000a';
+  const frameSize = 2;
+  let previousWord = text.slice(0, frameSize);
+  let previousHash = polynomialHash.hash(previousWord);
+  for (let offset = 1; offset <= text.length - frameSize; offset += 1) {
+    const currentWord = text.slice(offset, offset + frameSize);
+    const currentHash = polynomialHash.roll(previousHash, previousWord, currentWord);
+    expect(currentHash).toBeGreaterThanOrEqual(0);
+    expect(currentHash).toBeLessThan(97);
+    expect(currentHash).toBe(polynomialHash.hash(currentWord));
+    previousWord = currentWord;
+    previousHash = currentHash;
+  }
+});
+
+test('PolynomialHash configured modulus bounds direct and rolling hashes', () => {
+  const polynomialHash = new PolynomialHash({ base: 31, modulus: 13 });
+  const previousWord = '耀A';
+  const currentWord = 'A\u0000';
+  const previousHash = polynomialHash.hash(previousWord);
+  const rollingHash = polynomialHash.roll(previousHash, previousWord, currentWord);
+  expect(previousHash).toBeGreaterThanOrEqual(0);
+  expect(previousHash).toBeLessThan(13);
+  expect(rollingHash).toBeGreaterThanOrEqual(0);
+  expect(rollingHash).toBeLessThan(13);
+  expect(rollingHash).toBe(polynomialHash.hash(currentWord));
+});
