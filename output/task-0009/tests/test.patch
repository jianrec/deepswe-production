+import {
+  caesarCipherEncrypt,
+  caesarCipherDecrypt,
+} from '../src/algorithms/cryptography/caesar-cipher/caesarCipher';
+
+test('Caesar normalizes very large positive shifts', () => {
+  expect(caesarCipherEncrypt('xyz', (26 * 1000000) + 1)).toBe('yza');
+});
+
+test('Caesar normalizes very large negative shifts', () => {
+  expect(caesarCipherEncrypt('abc', (-26 * 1000000) - 1)).toBe('zab');
+});
+
+test('Caesar decrypt normalizes large signed shifts', () => {
+  const shift = (-26 * 123456) - 5;
+  const encrypted = caesarCipherEncrypt('Attack at dawn!', shift);
+  expect(caesarCipherDecrypt(encrypted, shift)).toBe('attack at dawn!');
+});
+
+test('Caesar keeps default lowercase and unknown-character pass-through behavior', () => {
+  expect(caesarCipherEncrypt('AZ 19!', 1)).toBe('ba 19!');
+});
+
+test('Caesar supports an existing custom alphabet argument', () => {
+  const alphabet = ['0', '1', '2', '3'];
+  expect(caesarCipherEncrypt('301-x', 5, alphabet)).toBe('012-x');
+  expect(caesarCipherDecrypt('012-x', 5, alphabet)).toBe('301-x');
+});
diff --git a/hidden-tests/hillCipherRoundTrip.feature.test.js b/hidden-tests/hillCipherRoundTrip.feature.test.js
new file mode 100644
index 0000000..a027efb
--- /dev/null
+++ b/hidden-tests/hillCipherRoundTrip.feature.test.js
@@ -0,0 +1,81 @@
+import {
+  hillCipherEncrypt,
+  hillCipherDecrypt,
+} from '../src/algorithms/cryptography/hill-cipher/hillCipher';
+
+const key = 'GYBNQKURP';
+
+test('Hill encryption preserves the classic uppercase one-block result', () => {
+  expect(hillCipherEncrypt('ACT', key)).toBe('POH');
+});
+
+test('Hill decryption supports the classic uppercase one-block result', () => {
+  expect(hillCipherDecrypt('POH', key)).toBe('ACT');
+});
+
+test('Hill encryption processes multiple complete blocks', () => {
+  expect(hillCipherEncrypt('ACTACT', key)).toBe('POHPOH');
+});
+
+test('Hill decryption processes multiple complete blocks', () => {
+  expect(hillCipherDecrypt('POHPOH', key)).toBe('ACTACT');
+});
+
+test('Hill round trips a multi-block default alphabet message', () => {
+  const message = 'SECRETMESSAGE';
+  const options = { padding: true, stripPadding: true };
+  const encrypted = hillCipherEncrypt(message, key, options);
+  expect(hillCipherDecrypt(encrypted, key, options)).toBe(message);
+});
+
+test('Hill encryption pads a partial block with the alphabet first symbol', () => {
+  const encrypted = hillCipherEncrypt('ACTA', key, { padding: true });
+  expect(encrypted).toHaveLength(6);
+  expect(hillCipherDecrypt(encrypted, key)).toBe('ACTAAA');
+});
+
+test('Hill supports caller-selected deterministic padding', () => {
+  const options = { padding: 'X', stripPadding: 'X' };
+  const encrypted = hillCipherEncrypt('ACTA', key, options);
+  expect(hillCipherDecrypt(encrypted, key, options)).toBe('ACTA');
+});
+
+test('Hill decryption does not silently strip legitimate trailing symbols', () => {
+  const encrypted = hillCipherEncrypt('DATAAA', key);
+  expect(hillCipherDecrypt(encrypted, key)).toBe('DATAAA');
+});
+
+test('Hill supports custom alphabets and multiple blocks', () => {
+  const options = { alphabet: 'ABCDE' };
+  const customKey = 'BCDA';
+  const message = 'ABCDEA';
+  const encrypted = hillCipherEncrypt(message, customKey, options);
+  expect(hillCipherDecrypt(encrypted, customKey, options)).toBe(message);
+});
+
+test('Hill preserves the configured alphabet symbol case', () => {
+  const options = { alphabet: 'abcde' };
+  const customKey = 'bcda';
+  const encrypted = hillCipherEncrypt('abcdea', customKey, options);
+  expect(hillCipherDecrypt(encrypted, customKey, options)).toBe('abcdea');
+});
+
+test('Hill rejects key lengths that are not perfect squares', () => {
+  expect(() => hillCipherEncrypt('ACT', 'ABCDE')).toThrow(Error);
+  expect(() => hillCipherDecrypt('ACT', 'ABCDE')).toThrow(Error);
+});
+
+test('Hill rejects message and key symbols outside the alphabet', () => {
+  expect(() => hillCipherEncrypt('AC!', key)).toThrow(Error);
+  expect(() => hillCipherEncrypt('ACT', 'GYBNQKUR!')).toThrow(Error);
+  expect(() => hillCipherDecrypt('PO!', key)).toThrow(Error);
+});
+
+test('Hill rejects non-invertible key matrices in both directions', () => {
+  expect(() => hillCipherEncrypt('AB', 'AAAA')).toThrow(Error);
+  expect(() => hillCipherDecrypt('AB', 'AAAA')).toThrow(Error);
+});
+
+test('Hill rejects ciphertext whose length is not block aligned', () => {
+  expect(() => hillCipherDecrypt('POHA', key)).toThrow(Error);
+});
