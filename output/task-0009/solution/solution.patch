+/**
+ * AlphabetCodec centralizes alphabet validation and the conversion between
+ * symbols and their numeric indices for classical ciphers.
+ *
+ * It owns:
+ *   - validation of a non-empty alphabet with unique symbols,
+ *   - conversion of symbols to numeric indices (`encode`, `indexOf`),
+ *   - reconstruction of symbols from indices while preserving the configured
+ *     case (`decode`, `symbolAt`),
+ *   - a case policy (case-sensitive matching or case-insensitive matching that
+ *     always reconstructs symbols using the alphabet's own case),
+ *   - an unknown-symbol policy that either preserves characters outside the
+ *     alphabet (pass-through) or rejects them with an explicit error.
+ *
+ * The codec is deterministic and never mutates its inputs.
+ */
+export default class AlphabetCodec {
+  /**
+   * @param {string|string[]} alphabet - Ordered collection of unique symbols.
+   * @param {object} [options]
+   * @param {boolean} [options.caseSensitive=true] - When false, symbol matching
+   *   ignores case and reconstructed symbols always use the alphabet's own case.
+   * @param {boolean} [options.preserveUnknown=false] - When true, characters
+   *   outside the alphabet are passed through unchanged; when false, they are
+   *   rejected with an explicit error.
+   */
+  constructor(alphabet, options = {}) {
+    const symbols = typeof alphabet === 'string' ? alphabet.split('') : alphabet;
+
+    if (!Array.isArray(symbols) || symbols.length === 0) {
+      throw new Error('Alphabet must be a non-empty string or array of symbols');
+    }
+
+    if (symbols.some((symbol) => typeof symbol !== 'string' || symbol.length !== 1)) {
+      throw new Error('Alphabet must only contain single-character symbols');
+    }
+
+    const { caseSensitive = true, preserveUnknown = false } = options;
+
+    // Build the index lookup, honoring the case policy, and validate uniqueness.
+    const lookup = new Map();
+    symbols.forEach((symbol, index) => {
+      const key = caseSensitive ? symbol : symbol.toLowerCase();
+      if (lookup.has(key)) {
+        throw new Error('Alphabet symbols must be unique');
+      }
+      lookup.set(key, index);
+    });
+
+    this.symbols = [...symbols];
+    this.size = this.symbols.length;
+    this.caseSensitive = caseSensitive;
+    this.preserveUnknown = preserveUnknown;
+    this.lookup = lookup;
+  }
+
+  /**
+   * Returns the index of a symbol within the alphabet, or -1 when the symbol is
+   * not part of the alphabet. Honors the configured case policy.
+   *
+   * @param {string} symbol
+   * @return {number}
+   */
+  indexOf(symbol) {
+    if (typeof symbol !== 'string' || symbol.length !== 1) {
+      return -1;
+    }
+    const key = this.caseSensitive ? symbol : symbol.toLowerCase();
+    return this.lookup.has(key) ? this.lookup.get(key) : -1;
+  }
+
+  /**
+   * Reconstructs the symbol located at a given index. The index is normalized
+   * into [0, size) so callers may pass residues from modular arithmetic. The
+   * returned symbol always preserves the alphabet's configured case.
+   *
+   * @param {number} index
+   * @return {string}
+   * @throws {Error}
+   */
+  symbolAt(index) {
+    if (typeof index !== 'number' || !Number.isInteger(index)) {
+      throw new Error('Symbol index must be an integer');
+    }
+    const normalized = ((index % this.size) + this.size) % this.size;
+    return this.symbols[normalized];
+  }
+
+  /**
+   * Encodes a piece of text into an array of tokens. In-alphabet symbols become
+   * their numeric indices. Out-of-alphabet characters are either passed through
+   * unchanged (as strings) or rejected, depending on the unknown-symbol policy.
+   *
+   * @param {string} text
+   * @return {Array<number|string>}
+   * @throws {Error}
+   */
+  encode(text) {
+    if (typeof text !== 'string') {
+      throw new Error('Text to encode must be a string');
+    }
+    return text.split('').map((character) => {
+      const index = this.indexOf(character);
+      if (index !== -1) {
+        return index;
+      }
+      if (this.preserveUnknown) {
+        return character;
+      }
+      throw new Error(`Symbol "${character}" is not part of the alphabet`);
+    });
+  }
+
+  /**
+   * Decodes an array of tokens back into a string. Numeric tokens are converted
+   * into symbols; string tokens (previously preserved characters) are passed
+   * through unchanged.
+   *
+   * @param {Array<number|string>} indices
+   * @return {string}
+   * @throws {Error}
+   */
+  decode(indices) {
+    if (!Array.isArray(indices)) {
+      throw new Error('Indices to decode must be an array');
+    }
+    return indices
+      .map((token) => {
+        if (typeof token === 'number') {
+          return this.symbolAt(token);
+        }
+        if (typeof token === 'string') {
+          if (!this.preserveUnknown && this.indexOf(token) === -1) {
+            throw new Error(`Symbol "${token}" is not part of the alphabet`);
+          }
+          return token;
+        }
+        throw new Error('Each token must be a number or a string');
+      })
+      .join('');
+  }
+}
