+/**
+ * Reusable, deterministic modular-arithmetic helpers.
+ *
+ * All helpers operate on ordinary JavaScript numbers and validate that their
+ * operands are safe integers so that modular multiplication used by callers
+ * (e.g. the Hill cipher) can never silently become ambiguous. None of the
+ * helpers mutate their inputs.
+ */
+
+/**
+ * Ensures the provided value is a safe integer.
+ *
+ * @param {number} value
+ * @param {string} [name] - Human readable operand name for error messages.
+ * @throws {Error}
+ */
+const assertSafeInteger = (value, name = 'value') => {
+  if (typeof value !== 'number' || !Number.isSafeInteger(value)) {
+    throw new Error(`Expected ${name} to be a safe integer`);
+  }
+};
+
+/**
+ * Canonical modulo that always returns a non-negative residue in [0, modulus).
+ * Unlike the native `%` operator it normalizes negative operands.
+ *
+ * @param {number} value
+ * @param {number} modulus - A non-zero safe integer.
+ * @return {number}
+ * @throws {Error}
+ */
+export const mod = (value, modulus) => {
+  assertSafeInteger(value, 'value');
+  assertSafeInteger(modulus, 'modulus');
+  if (modulus === 0) {
+    throw new Error('Modulus must not be zero');
+  }
+  const absModulus = Math.abs(modulus);
+  const remainder = value % absModulus;
+  return remainder < 0 ? remainder + absModulus : remainder;
+};
+
+/**
+ * Iterative extended Euclidean algorithm.
+ *
+ * Returns the greatest common divisor of `a` and `b` together with the Bézout
+ * coefficients `x` and `y` such that `a * x + b * y === gcd`.
+ *
+ * @param {number} a
+ * @param {number} b
+ * @return {{ gcd: number, x: number, y: number }}
+ * @throws {Error}
+ */
+export const extendedEuclidean = (a, b) => {
+  assertSafeInteger(a, 'a');
+  assertSafeInteger(b, 'b');
+
+  let oldR = a;
+  let r = b;
+  let oldS = 1;
+  let s = 0;
+  let oldT = 0;
+  let t = 1;
+
+  while (r !== 0) {
+    const quotient = Math.floor(oldR / r);
+
+    [oldR, r] = [r, oldR - quotient * r];
+    [oldS, s] = [s, oldS - quotient * s];
+    [oldT, t] = [t, oldT - quotient * t];
+  }
+
+  // Normalize the sign of the gcd so it is always non-negative.
+  if (oldR < 0) {
+    return { gcd: -oldR, x: -oldS, y: -oldT };
+  }
+
+  return { gcd: oldR, x: oldS, y: oldT };
+};
+
+/**
+ * Computes the modular multiplicative inverse of `value` modulo `modulus`.
+ *
+ * The inverse exists only when `value` and `modulus` are coprime. Otherwise an
+ * explicit error is thrown. The result is normalized into [0, modulus).
+ *
+ * @param {number} value
+ * @param {number} modulus - A non-zero safe integer.
+ * @return {number}
+ * @throws {Error}
+ */
+export const modularInverse = (value, modulus) => {
+  assertSafeInteger(value, 'value');
+  assertSafeInteger(modulus, 'modulus');
+  if (modulus === 0) {
+    throw new Error('Modulus must not be zero');
+  }
+
+  const absModulus = Math.abs(modulus);
+  const normalizedValue = mod(value, absModulus);
+  const { gcd, x } = extendedEuclidean(normalizedValue, absModulus);
+
+  if (gcd !== 1) {
+    throw new Error(`${value} has no modular inverse modulo ${modulus}`);
+  }
+
+  return mod(x, absModulus);
+};
