+from sorts.selection_sort import selection_sort
+
+
+def test_selection_sort_accepts_key_for_records():
+    values = [(8, "h"), (2, "b"), (6, "f")]
+    assert selection_sort(values, key=lambda value: value[0]) == [(2, "b"), (6, "f"), (8, "h")]
+
+
+def test_selection_sort_supports_reverse():
+    assert selection_sort([3, 1, 4, 2], reverse=True) == [4, 3, 2, 1]
+
+
+def test_selection_sort_is_stable_ascending():
+    values = [(2, "first"), (1, "only"), (2, "second")]
+    assert selection_sort(values, key=lambda value: value[0]) == [(1, "only"), (2, "first"), (2, "second")]
+
+
+def test_selection_sort_is_stable_descending():
+    values = [(2, "first"), (1, "only"), (2, "second")]
+    assert selection_sort(values, key=lambda value: value[0], reverse=True) == [(2, "first"), (2, "second"), (1, "only")]
+
+
+def test_selection_sort_handles_key_with_strings():
+    assert selection_sort(["long", "x", "mid"], key=len, reverse=True) == ["long", "mid", "x"]
+
+
+def test_selection_sort_handles_empty_input():
+    assert selection_sort([], reverse=True) == []
+
+
+def test_selection_sort_handles_single_element_input():
+    assert selection_sort([42], key=lambda value: -value) == [42]
