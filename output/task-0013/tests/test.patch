+
+def test_insertion_sort_is_stable_descending():
+    values = [(2, "x"), (1, "a"), (2, "y"), (1, "b")]
+    assert insertion_sort(values, key=lambda value: value[0], reverse=True) == [(2, "x"), (2, "y"), (1, "a"), (1, "b")]
+
+
+def test_insertion_sort_handles_strings_with_key():
+    assert insertion_sort(["bbb", "a", "cc"], key=len) == ["a", "cc", "bbb"]
+
+
+def test_insertion_sort_handles_empty_input():
+    assert insertion_sort([], reverse=True) == []
+
+
+def test_insertion_sort_handles_single_item():
+    item = {"rank": 1}
+    assert insertion_sort([item], key=lambda value: value["rank"]) == [item]
