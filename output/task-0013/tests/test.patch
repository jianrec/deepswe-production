+from sorts.merge_sort import merge_sort
+
+
+def test_merge_sort_accepts_key_for_records():
+    values = [(5, "e"), (1, "a"), (3, "c")]
+    assert merge_sort(values, key=lambda value: value[0]) == [(1, "a"), (3, "c"), (5, "e")]
+
+
+def test_merge_sort_supports_reverse():
+    assert merge_sort([2, 5, 1, 4], reverse=True) == [5, 4, 2, 1]
+
+
+def test_merge_sort_is_stable_ascending():
+    values = [(3, "a"), (2, "b"), (3, "c"), (1, "d")]
+    assert merge_sort(values, key=lambda value: value[0]) == [(1, "d"), (2, "b"), (3, "a"), (3, "c")]
+
+
+def test_merge_sort_is_stable_descending():
+    values = [(3, "a"), (2, "b"), (3, "c"), (1, "d")]
+    assert merge_sort(values, key=lambda value: value[0], reverse=True) == [(3, "a"), (3, "c"), (2, "b"), (1, "d")]
+
+
+def test_merge_sort_uses_key_without_comparing_records():
+    values = [{"value": 3}, {"value": 1}, {"value": 2}]
+    assert merge_sort(values, key=lambda value: value["value"]) == [{"value": 1}, {"value": 2}, {"value": 3}]
+
+
+def test_merge_sort_handles_empty_input():
+    assert merge_sort([], key=len) == []
+
+
+def test_merge_sort_handles_all_equal_keys():
+    values = [(0, "one"), (0, "two"), (0, "three")]
+    assert merge_sort(values, key=lambda value: value[0], reverse=True) == values
