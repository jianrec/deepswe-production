+import pytest
+
+from sorts.bubble_sort import bubble_sort
+
+
+def test_bubble_sort_accepts_key_for_records():
+    values = [(3, "c"), (1, "a"), (2, "b")]
+    assert bubble_sort(values, key=lambda value: value[0]) == [(1, "a"), (2, "b"), (3, "c")]
+
+
+def test_bubble_sort_supports_reverse():
+    assert bubble_sort([1, 3, 2], reverse=True) == [3, 2, 1]
+
+
+def test_bubble_sort_is_stable_ascending():
+    values = [(1, "first"), (2, "middle"), (1, "second")]
+    assert bubble_sort(values, key=lambda value: value[0]) == [(1, "first"), (1, "second"), (2, "middle")]
+
+
+def test_bubble_sort_is_stable_descending():
+    values = [(1, "first"), (2, "middle"), (1, "second")]
+    assert bubble_sort(values, key=lambda value: value[0], reverse=True) == [(2, "middle"), (1, "first"), (1, "second")]
+
+
+def test_bubble_sort_does_not_mutate_record_values():
+    values = [{"score": 2}, {"score": 1}]
+    before = [record.copy() for record in values]
+    assert bubble_sort(values, key=lambda record: record["score"]) == [{"score": 1}, {"score": 2}]
+    assert values == before
+
+
+def test_bubble_sort_handles_empty_input_with_key():
+    assert bubble_sort([], key=lambda value: value) == []
+
+
+def test_bubble_sort_handles_all_equal_keys():
+    values = [(1, "a"), (1, "b"), (1, "c")]
+    assert bubble_sort(values, key=lambda value: value[0], reverse=True) == values
