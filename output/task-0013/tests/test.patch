+++ b/tests/test_hidden_search_ordering.py
@@ -0,0 +1,50 @@
+import pytest
+
+from searches.binary_search import binary_search
+from searches.jump_search import jump_search
+from searches.linear_search import linear_search
+
+
+RECORDS_ASC = [(1, "a"), (2, "b"), (2, "c"), (4, "d"), (7, "e")]
+RECORDS_DESC = list(reversed(RECORDS_ASC))
+
+
+def test_binary_search_accepts_key_and_returns_first_equal_index():
+    assert binary_search(RECORDS_ASC, (2, "target"), key=lambda value: value[0]) == 1
+
+
+def test_binary_search_supports_descending_records():
+    assert binary_search(RECORDS_DESC, (4, "target"), key=lambda value: value[0], reverse=True) == 1
+
+
+def test_binary_search_returns_minus_one_for_absent_key():
+    assert binary_search(RECORDS_ASC, (3, "target"), key=lambda value: value[0]) == -1
+
+
+def test_binary_search_rejects_wrong_ordering():
+    assert binary_search(RECORDS_DESC, (4, "target"), key=lambda value: value[0]) == -1
+
+
+def test_binary_search_handles_empty_input():
+    assert binary_search([], 1) == -1
+
+
+def test_jump_search_accepts_key_and_returns_first_equal_index():
+    assert jump_search(RECORDS_ASC, (2, "target"), key=lambda value: value[0]) == 1
+
+
+def test_jump_search_supports_descending_records():
+    assert jump_search(RECORDS_DESC, (2, "target"), key=lambda value: value[0], reverse=True) == 2
+
+
+def test_jump_search_returns_minus_one_for_absent_key():
+    assert jump_search(RECORDS_ASC, (6, "target"), key=lambda value: value[0]) == -1
+
+
+def test_jump_search_rejects_wrong_ordering():
+    assert jump_search(RECORDS_ASC, (4, "target"), key=lambda value: value[0], reverse=True) == -1
+
+
+def test_linear_search_returns_first_matching_key_index():
+    values = [(3, "x"), (1, "a"), (3, "y"), (2, "b")]
+    assert linear_search(values, (3, "target"), key=lambda value: value[0]) == 0
