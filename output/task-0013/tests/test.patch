+from sorts.insertion_sort import insertion_sort
+
+
+def test_insertion_sort_accepts_key_for_records():
+    values = [(4, "d"), (2, "b"), (3, "c"), (1, "a")]
+    assert insertion_sort(values, key=lambda value: value[0]) == [(1, "a"), (2, "b"), (3, "c"), (4, "d")]
+
+
+def test_insertion_sort_supports_reverse():
+    assert insertion_sort([1, 4, 2, 3], reverse=True) == [4, 3, 2, 1]
+
+
+def test_insertion_sort_is_stable_ascending():
+    values = [(2, "x"), (1, "a"), (2, "y"), (1, "b")]
+    assert insertion_sort(values, key=lambda value: value[0]) == [(1, "a"), (1, "b"), (2, "x"), (2, "y")]
