@@ -0,0 +1,60 @@
+import pytest
+
+from searches.binary_search import binary_search
+from searches.jump_search import jump_search
+from searches.linear_search import linear_search
+from sorts.bubble_sort import bubble_sort
+from sorts.insertion_sort import insertion_sort
+from sorts.merge_sort import merge_sort
+from sorts.selection_sort import selection_sort
+from strings.top_k_frequent_words import top_k_frequent_words
+
+
+def test_sorting_key_is_keyword_only():
+    for function in (bubble_sort, insertion_sort, merge_sort, selection_sort):
+        with pytest.raises(TypeError):
+            function([2, 1], lambda value: value)
+
+
+def test_search_key_is_keyword_only():
+    with pytest.raises(TypeError):
+        linear_search([1, 2], 1, lambda value: value)
+    with pytest.raises(TypeError):
+        binary_search([1, 2], 1, lambda value: value)
+    with pytest.raises(TypeError):
+        jump_search([1, 2], 1, lambda value: value)
+
+
+def test_top_k_key_is_keyword_only():
+    with pytest.raises(TypeError):
+        top_k_frequent_words(["a"], 1, lambda value: value)
+
+
+def test_non_callable_key_is_rejected_by_all_sorting_functions():
+    for function in (bubble_sort, insertion_sort, merge_sort, selection_sort):
+        with pytest.raises(TypeError):
+            function([2, 1], key=object())
+
+
+def test_non_callable_key_is_rejected_by_all_search_functions():
+    with pytest.raises(TypeError):
+        linear_search([1, 2], 1, key=object())
+    with pytest.raises(TypeError):
+        binary_search([1, 2], 1, key=object())
+    with pytest.raises(TypeError):
+        jump_search([1, 2], 1, key=object())
+
+
+def test_non_callable_key_is_rejected_by_top_k():
+    with pytest.raises(TypeError):
+        top_k_frequent_words(["a"], 1, key=object())
+
+
+def test_linear_search_handles_empty_and_missing_values():
+    assert linear_search([], 1, key=lambda value: value) == -1
+    assert linear_search([2, 4], 3, key=lambda value: value) == -1
+
+
+def test_sorting_preserves_list_result_type():
+    for function in (bubble_sort, insertion_sort, merge_sort, selection_sort):
+        assert type(function([2, 1])) is list
