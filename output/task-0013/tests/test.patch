@@ -0,0 +1,42 @@
+from strings.top_k_frequent_words import top_k_frequent_words
+
+
+def test_top_k_defaults_to_frequency_then_lexicographic_tie_break():
+    words = ["pear", "apple", "pear", "apple", "banana", "banana", "cherry"]
+    assert top_k_frequent_words(words, 4) == ["apple", "banana", "pear", "cherry"]
+
+
+def test_top_k_uses_custom_key_for_frequency_ties():
+    words = ["pear", "apple", "pear", "apple", "banana", "banana", "cherry"]
+    order = {"cherry": 0, "pear": 1, "banana": 2, "apple": 3}
+    assert top_k_frequent_words(words, 4, key=lambda word: order[word]) == ["banana", "apple", "pear", "cherry"]
+
+
+def test_top_k_reverse_flips_final_result():
+    words = ["pear", "apple", "pear", "apple", "banana", "banana", "cherry"]
+    assert top_k_frequent_words(words, 4, reverse=True) == ["cherry", "pear", "banana", "apple"]
+
+
+def test_top_k_custom_key_and_reverse_flip_final_result():
+    words = ["pear", "apple", "pear", "apple", "banana", "banana", "cherry"]
+    order = {"cherry": 0, "pear": 1, "banana": 2, "apple": 3}
+    result = top_k_frequent_words(words, 4, key=lambda word: order[word], reverse=True)
+    assert result == ["cherry", "pear", "apple", "banana"]
+
+
+def test_top_k_respects_k_value():
+    assert top_k_frequent_words(["a", "b", "b", "c", "c", "c"], 2) == ["c", "b"]
+
+
+def test_top_k_handles_empty_words():
+    assert top_k_frequent_words([], 3) == []
+
+
+def test_top_k_handles_all_equal_frequency_words():
+    assert top_k_frequent_words(["z", "x", "y"], 3) == ["x", "y", "z"]
+
+
+def test_top_k_key_is_applied_to_words():
+    words = ["aa", "b", "aa", "b", "c"]
+    order = {"c": 0, "b": 1, "aa": 2}
+    assert top_k_frequent_words(words, 3, key=lambda word: order[word]) == ["b", "aa", "c"]
