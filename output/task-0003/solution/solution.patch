diff --git a/tests/agent/test_spend_budget.py b/tests/agent/test_spend_budget.py
new file mode 100644
index 0000000..93c4a65
--- /dev/null
+++ b/tests/agent/test_spend_budget.py
@@ -0,0 +1,151 @@
+"""Tests for the deterministic spend-budget subsystem (agent/spend_budget.py).
+
+Covers the tracker (accumulation, one-shot warn/exceeded, daily reset with an
+injected clock, snapshot/remaining/is_exceeded), config parsing, formatting,
+the additive ``turn_cost_usd`` pricing helper, and the ``budget.threshold``
+telemetry payload shape.
+"""
+
+from __future__ import annotations
+
+from agent.spend_budget import (
+    BudgetEvent,
+    BudgetLimit,
+    BudgetStatus,
+    SpendBudgetTracker,
+    format_budget_status,
+    parse_budget_config,
+)
+
+
+def _tracker(**limits):
+    clock = limits.pop("clock", None)
+    lims = [BudgetLimit(scope=scope, limit_usd=val, warn_ratio=0.8) for scope, val in limits.items()]
+    return SpendBudgetTracker(lims, clock=clock)
+
+
+def test_warn_fires_once():
+    t = _tracker(session=10.0)
+    assert t.record_usage(scope="session", cost_usd=7.0) == []
+    events = t.record_usage(scope="session", cost_usd=1.5)  # 8.5 >= 8.0 warn
+    assert [e.kind for e in events] == ["warn"]
+    more = t.record_usage(scope="session", cost_usd=0.5)
+    assert [e.kind for e in more] == []
+
+
+def test_exceeded_fires_once():
+    t = _tracker(session=10.0)
+    t.record_usage(scope="session", cost_usd=8.0)  # warn
+    events = t.record_usage(scope="session", cost_usd=2.0)  # exceeded
+    assert [e.kind for e in events] == ["exceeded"]
+    assert t.is_exceeded("session") is True
+    assert t.record_usage(scope="session", cost_usd=5.0) == []
+
+
+def test_direct_jump_emits_warn_then_exceeded():
+    t = _tracker(session=10.0)
+    events = t.record_usage(scope="session", cost_usd=25.0)
+    assert [e.kind for e in events] == ["warn", "exceeded"]
+
+
+def test_remaining_and_snapshot():
+    t = _tracker(total=20.0)
+    t.record_usage(scope="total", cost_usd=5.0)
+    assert abs(t.remaining("total") - 15.0) < 1e-9
+    assert t.remaining("session") is None
+    snap = t.snapshot()
+    assert set(snap) == {"total"}
+    assert isinstance(snap["total"], BudgetStatus)
+    assert abs(snap["total"].ratio - 0.25) < 1e-9
+
+
+def test_daily_reset_on_midnight():
+    day = [1_000_000.0]  # arbitrary fixed epoch
+    t = SpendBudgetTracker([BudgetLimit(scope="daily", limit_usd=10.0)], clock=lambda: day[0])
+    t.record_usage(scope="daily", cost_usd=6.0)
+    assert abs(t.remaining("daily") - 4.0) < 1e-9
+    day[0] += 60 * 60 * 48  # > 1 day → crosses local midnight
+    events = t.record_usage(scope="daily", cost_usd=1.0)
+    assert "reset" in [e.kind for e in events]
+    assert abs(t.remaining("daily") - 9.0) < 1e-9
+
+
+def test_session_and_total_never_autoreset():
+    day = [1_000_000.0]
+    t = SpendBudgetTracker(
+        [BudgetLimit(scope="session", limit_usd=10.0), BudgetLimit(scope="total", limit_usd=10.0)],
+        clock=lambda: day[0],
+    )
+    t.record_usage(scope="session", cost_usd=3.0)
+    t.record_usage(scope="total", cost_usd=3.0)
+    day[0] += 60 * 60 * 72
+    t.record_usage(scope="session", cost_usd=1.0)
+    t.record_usage(scope="total", cost_usd=1.0)
+    assert abs(t.remaining("session") - 6.0) < 1e-9
+    assert abs(t.remaining("total") - 6.0) < 1e-9
+
+
+def test_parse_config_disabled_and_malformed():
+    assert parse_budget_config(None) == []
+    assert parse_budget_config({}) == []
+    assert parse_budget_config({"enabled": False, "session_limit_usd": 5.0}) == []
+    limits = parse_budget_config(
+        {
+            "enabled": True,
+            "session_limit_usd": 5.0,
+            "daily_limit_usd": -1.0,
+            "total_limit_usd": "not-a-number",
+            "warn_ratio": 0.5,
+        }
+    )
+    assert [lim.scope for lim in limits] == ["session"]
+    assert limits[0].warn_ratio == 0.5
+
+
+def test_parse_config_warn_ratio_clamped():
+    over = parse_budget_config({"enabled": True, "session_limit_usd": 5.0, "warn_ratio": 5.0})
+    assert over[0].warn_ratio == 1.0
+    under = parse_budget_config({"enabled": True, "session_limit_usd": 5.0, "warn_ratio": -1.0})
+    assert under == []
+
+
+def test_format_status_locale_independent():
+    status = BudgetStatus(
+        scope="session", spent_usd=1.5, limit_usd=5.0, ratio=0.3,
+        remaining_usd=3.5, warned=False, exceeded=False,
+    )
+    line = format_budget_status(status, use_color=False)
+    assert "budget[session]" in line
+    assert "$1.50/$5.00" in line
+    assert "left" in line
+
+
+def test_format_status_exceeded_color():
+    status = BudgetStatus(
+        scope="total", spent_usd=12.0, limit_usd=10.0, ratio=1.2,
+        remaining_usd=0.0, warned=True, exceeded=True,
+    )
+    assert "EXCEEDED" in format_budget_status(status, use_color=False)
+    assert format_budget_status(status, use_color=True).startswith("\033[31m")
+
+
+def test_turn_cost_usd_additive():
+    from agent.usage_pricing import turn_cost_usd
+    usage = {"input_tokens": 1_000_000, "output_tokens": 1_000_000}
+    pricing = {"input_cost_per_million": 5.0, "output_cost_per_million": 25.0}
+    assert abs(turn_cost_usd(usage, pricing) - 30.0) < 1e-9
+    assert turn_cost_usd(usage, None) == 0.0
+    assert turn_cost_usd(usage, {}) == 0.0
+
+
+def test_budget_threshold_payload_shape():
+    from agent.monitoring.events import BUDGET_THRESHOLD_EVENT, budget_threshold_payload
+    assert BUDGET_THRESHOLD_EVENT == "budget.threshold"
+    ev = BudgetEvent(kind="warn", scope="session", spent_usd=8.0, limit_usd=10.0, ratio=0.8, ts=123.0)
+    payload = budget_threshold_payload(ev, session_id="sess-1")
+    assert set(payload) == {"scope", "kind", "spent_usd", "limit_usd", "ratio", "session_id", "ts"}
+    assert payload["spent_usd"] == 8.0
+    assert payload["session_id"] == "sess-1"
+    # No secret-bearing keys leak into the telemetry payload.
+    for banned in ("api_key", "apikey", "token", "account", "credential", "secret"):
+        assert banned not in payload
