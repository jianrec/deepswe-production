diff --git a/agent/spend_budget.py b/agent/spend_budget.py
new file mode 100644
index 0000000..4759409
--- /dev/null
+++ b/agent/spend_budget.py
@@ -0,0 +1,303 @@
+"""Deterministic spend-budget subsystem for Hermes.
+
+Operators configure one or more USD budgets scoped to ``session``, ``daily``,
+or ``total``. As turns finalize, per-turn USD cost (derived from the existing
+usage/pricing path) is accumulated per scope. Crossing a warn threshold
+(default 80% of the limit) emits a one-shot ``warn`` event; reaching or
+exceeding the limit emits a one-shot ``exceeded`` event. The ``daily`` scope
+resets at the local-midnight boundary using an injectable clock so behaviour
+is deterministic under test.
+
+This module is pure, dependency-free, and side-effect-free: it never performs
+I/O, never imports agent runtime code, and all monetary math is float USD.
+Ratios are clamped to ``[0, +inf)`` and formatting is locale-independent.
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import time
+from dataclasses import dataclass
+from typing import Any, Callable, Mapping, Optional
+
+logger = logging.getLogger(__name__)
+
+SCOPES = ("session", "daily", "total")
+
+
+@dataclass(frozen=True)
+class BudgetLimit:
+    scope: str
+    limit_usd: float
+    warn_ratio: float = 0.8
+
+
+@dataclass(frozen=True)
+class BudgetStatus:
+    scope: str
+    spent_usd: float
+    limit_usd: float
+    ratio: float
+    remaining_usd: float
+    warned: bool
+    exceeded: bool
+
+
+@dataclass(frozen=True)
+class BudgetEvent:
+    kind: str  # 'warn' | 'exceeded' | 'reset'
+    scope: str
+    spent_usd: float
+    limit_usd: float
+    ratio: float
+    ts: float
+
+
+class _Accumulator:
+    """Mutable per-scope spend state; never exposed directly to callers."""
+
+    __slots__ = ("limit", "spent", "warned", "exceeded", "day_key")
+
+    def __init__(self, limit: BudgetLimit) -> None:
+        self.limit = limit
+        self.spent = 0.0
+        self.warned = False
+        self.exceeded = False
+        self.day_key: Optional[tuple[int, int, int]] = None
+
+
+def _clamp_ratio(value: float) -> float:
+    """Clamp a ratio to ``[0, +inf)``; NaN/non-numeric → 0.0."""
+    if not isinstance(value, (int, float)) or not math.isfinite(value):
+        return 0.0
+    return float(value) if value > 0.0 else 0.0
+
+
+def _coerce_cost(value: Any) -> float:
+    """Coerce a per-turn cost to a non-negative finite float; bad input → 0.0."""
+    try:
+        cost = float(value)
+    except (TypeError, ValueError):
+        return 0.0
+    if not math.isfinite(cost) or cost < 0.0:
+        return 0.0
+    return cost
+
+
+class SpendBudgetTracker:
+    """Accumulate per-scope spend and emit one-shot threshold events."""
+
+    def __init__(self, limits: list[BudgetLimit], *, clock: Callable[[], float] | None = None) -> None:
+        self._clock: Callable[[], float] = clock or time.time
+        self._accs: dict[str, _Accumulator] = {}
+        for limit in limits or ():
+            if limit is None:
+                continue
+            if limit.scope not in SCOPES:
+                continue
+            if not isinstance(limit.limit_usd, (int, float)):
+                continue
+            if not math.isfinite(limit.limit_usd) or limit.limit_usd <= 0:
+                continue
+            self._accs[limit.scope] = _Accumulator(limit)
+        # Seed the daily day-key so the first record never spuriously resets.
+        daily = self._accs.get("daily")
+        if daily is not None:
+            daily.day_key = self._day_key()
+
+    # ── internal ────────────────────────────────────────
+    def _day_key(self) -> tuple[int, int, int]:
+        lt = time.localtime(self._clock())
+        return (lt.tm_year, lt.tm_mon, lt.tm_mday)
+
+    def _ratio(self, acc: _Accumulator) -> float:
+        limit = acc.limit.limit_usd
+        if limit <= 0:
+            return 0.0
+        return _clamp_ratio(acc.spent / limit)
+
+    def _status(self, acc: _Accumulator) -> BudgetStatus:
+        limit = acc.limit.limit_usd
+        remaining = limit - acc.spent
+        if remaining < 0.0:
+            remaining = 0.0
+        return BudgetStatus(
+            scope=acc.limit.scope,
+            spent_usd=acc.spent,
+            limit_usd=limit,
+            ratio=self._ratio(acc),
+            remaining_usd=remaining,
+            warned=acc.warned,
+            exceeded=acc.exceeded,
+        )
+
+    def _maybe_daily_reset(self, acc: _Accumulator) -> list[BudgetEvent]:
+        current = self._day_key()
+        if acc.day_key is None:
+            acc.day_key = current
+            return []
+        if current == acc.day_key:
+            return []
+        acc.spent = 0.0
+        acc.warned = False
+        acc.exceeded = False
+        acc.day_key = current
+        return [BudgetEvent("reset", acc.limit.scope, 0.0, acc.limit.limit_usd, 0.0, self._clock())]
+
+    # ── public API ─────────────────────────────────────
+    def record_usage(self, *, scope: str, cost_usd: float, session_id: str | None = None) -> list[BudgetEvent]:
+        acc = self._accs.get(scope)
+        if acc is None:
+            return []
+        events: list[BudgetEvent] = []
+        if scope == "daily":
+            events.extend(self._maybe_daily_reset(acc))
+        acc.spent += _coerce_cost(cost_usd)
+        ratio = self._ratio(acc)
+        limit = acc.limit.limit_usd
+        warn_at = limit * acc.limit.warn_ratio
+        if acc.spent >= warn_at and not acc.warned:
+            acc.warned = True
+            events.append(BudgetEvent("warn", scope, acc.spent, limit, ratio, self._clock()))
+        if acc.spent >= limit and not acc.exceeded:
+            acc.exceeded = True
+            acc.warned = True
+            events.append(BudgetEvent("exceeded", scope, acc.spent, limit, ratio, self._clock()))
+        return events
+
+    def snapshot(self) -> dict[str, BudgetStatus]:
+        return {scope: self._status(acc) for scope, acc in self._accs.items()}
+
+    def remaining(self, scope: str) -> float | None:
+        acc = self._accs.get(scope)
+        if acc is None:
+            return None
+        remaining = acc.limit.limit_usd - acc.spent
+        return remaining if remaining > 0.0 else 0.0
+
+    def is_exceeded(self, scope: str) -> bool:
+        acc = self._accs.get(scope)
+        return bool(acc.exceeded) if acc is not None else False
+
+    def reset(self, scope: str) -> None:
+        acc = self._accs.get(scope)
+        if acc is None:
+            return
+        acc.spent = 0.0
+        acc.warned = False
+        acc.exceeded = False
+        if scope == "daily":
+            acc.day_key = self._day_key()
+
+
+# ── config parsing ──────────────────────────────────────
+
+
+def _as_bool(value: Any, default: bool = False) -> bool:
+    if isinstance(value, bool):
+        return value
+    if value is None:
+        return default
+    if isinstance(value, (int, float)):
+        return value != 0
+    if isinstance(value, str):
+        return value.strip().lower() in ("1", "true", "yes", "on")
+    return default
+
+
+def _coerce_ratio(value: Any, default: float = 0.8) -> float | None:
+    if value is None:
+        return default
+    try:
+        ratio = float(value)
+    except (TypeError, ValueError):
+        logger.warning("spend_budget ▸ invalid warn ratio: %r", value)
+        return None
+    if not math.isfinite(ratio) or ratio <= 0.0:
+        logger.warning("spend_budget ▸ invalid warn ratio: %r", value)
+        return None
+    return 1.0 if ratio > 1.0 else ratio
+
+
+def _coerce_limit(scope: str, value: Any) -> float | None:
+    if value is None:
+        return None
+    try:
+        limit = float(value)
+    except (TypeError, ValueError):
+        logger.warning("spend_budget ▸ ignoring non-numeric %s limit: %r", scope, value)
+        return None
+    if not math.isfinite(limit) or limit <= 0.0:
+        logger.warning("spend_budget ▸ ignoring non-positive %s limit: %r", scope, value)
+        return None
+    return limit
+
+
+def parse_budget_config(raw: dict[str, Any] | None) -> list[BudgetLimit]:
+    """Parse the ``budget.*`` mapping into a list of BudgetLimit.
+
+    Returns ``[]`` (disabled) when the mapping is absent, ``enabled`` is falsey,
+    or no scope has a valid positive limit. Malformed/negative limits are
+    skipped with a logged warning; the function never raises.
+    """
+    if not isinstance(raw, dict):
+        return []
+    try:
+        if "budget" in raw:
+            section = raw.get("budget")
+            if not isinstance(section, Mapping):
+                logger.warning("spend_budget ▸ malformed budget section, disabling")
+                return []
+            raw = dict(section)
+        if not _as_bool(raw.get("enabled"), False):
+            return []
+        warn_ratio = _coerce_ratio(raw.get("warn_ratio"), 0.8)
+        if warn_ratio is None:
+            return []
+        limits: list[BudgetLimit] = []
+        for scope, key in (
+            ("session", "session_limit_usd"),
+            ("daily", "daily_limit_usd"),
+            ("total", "total_limit_usd"),
+        ):
+            limit = _coerce_limit(scope, raw.get(key))
+            if limit is None:
+                continue
+            limits.append(BudgetLimit(scope=scope, limit_usd=limit, warn_ratio=warn_ratio))
+        return limits
+    except Exception:
+        logger.warning("spend_budget ▸ malformed budget config, disabling", exc_info=True)
+        return []
+
+
+# ── formatting ──────────────────────────────────────────
+
+
+def _fmt_usd(value: float) -> str:
+    try:
+        amount = float(value)
+    except (TypeError, ValueError):
+        amount = 0.0
+    if not math.isfinite(amount):
+        amount = 0.0
+    return f"${amount:.2f}"
+
+
+def format_budget_status(status: BudgetStatus, *, use_color: bool = True) -> str:
+    """Render a compact, locale-independent one-line budget status string."""
+    spent = _fmt_usd(status.spent_usd)
+    limit = _fmt_usd(status.limit_usd)
+    pct = int(round(_clamp_ratio(status.ratio) * 100))
+    if status.exceeded:
+        core = f"budget[{status.scope}] {spent}/{limit} ({pct}%) EXCEEDED"
+    else:
+        remaining = _fmt_usd(status.remaining_usd)
+        core = f"budget[{status.scope}] {spent}/{limit} ({pct}%) · {remaining} left"
+    if not use_color:
+        return core
+    if status.exceeded:
+        return f"\033[31m{core}\033[0m"
+    if status.warned:
+        return f"\033[33m{core}\033[0m"
+    return core
