+def _usage_tokens(usage: Any, *keys: str) -> int:
+    """Read a token count from a usage dict or object; missing/bad → 0."""
+    for key in keys:
+        value = usage.get(key) if isinstance(usage, dict) else getattr(usage, key, None)
+        if value is not None:
+            try:
+                return int(value)
+            except (TypeError, ValueError):
+                return 0
+    return 0
+
+
+def _price_per_token(pricing: Any, *keys: str) -> float:
+    """Read a per-token USD price from a pricing mapping/object.
+
+    Keys containing ``million`` are divided by 1e6; bare ``input``/``output``
+    keys are treated as already per-token (matching ``DEFAULT_PRICING``).
+    Missing/unparseable → 0.0.
+    """
+    for key in keys:
+        value = pricing.get(key) if isinstance(pricing, dict) else getattr(pricing, key, None)
+        if value is None:
+            continue
+        try:
+            rate = float(value)
+        except (TypeError, ValueError):
+            return 0.0
+        if "million" in key:
+            rate = rate / 1_000_000.0
+        return rate
+    return 0.0
+
+
+def turn_cost_usd(usage: dict[str, Any] | Any, pricing: dict[str, Any] | Any) -> float:
+    """Additive: compute one turn's USD cost from a usage + pricing record.
+
+    Backward-compatible helper used by the spend-budget subsystem. Reads input
+    and output token counts and multiplies by per-token USD prices. Returns
+    ``0.0`` when pricing is unknown/missing or on any parse error — never
+    raises, and never touches the existing pricing functions.
+    """
+    if usage is None or pricing is None:
+        return 0.0
+    try:
+        in_tokens = _usage_tokens(usage, "input_tokens", "prompt_tokens")
+        out_tokens = _usage_tokens(usage, "output_tokens", "completion_tokens")
+        cache_read_tokens = _usage_tokens(usage, "cache_read_tokens", "cached_tokens")
+        cache_write_tokens = _usage_tokens(usage, "cache_write_tokens")
+        request_count = _usage_tokens(usage, "request_count")
+        in_rate = _price_per_token(pricing, "input_cost_per_million", "input")
+        out_rate = _price_per_token(pricing, "output_cost_per_million", "output")
+        cache_read_rate = _price_per_token(pricing, "cache_read_cost_per_million")
+        cache_write_rate = _price_per_token(pricing, "cache_write_cost_per_million")
+        request_rate = _price_per_token(pricing, "request_cost")
+    except Exception:
+        return 0.0
+    cost = (
+        in_tokens * in_rate
+        + out_tokens * out_rate
+        + cache_read_tokens * cache_read_rate
+        + cache_write_tokens * cache_write_rate
+        + request_count * request_rate
+    )
+    # Guard NaN/inf without importing math into this module's namespace.
+    if cost != cost or cost in (float("inf"), float("-inf")):
+        return 0.0
+    if cost < 0.0:
+        return 0.0
+    return float(cost)
+
+
 # Official docs snapshot entries. Models whose published pricing and cache
 # semantics are stable enough to encode exactly.
 _OFFICIAL_DOCS_PRICING: Dict[tuple[str, str], PricingEntry] = {
