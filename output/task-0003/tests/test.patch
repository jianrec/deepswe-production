+import shutil
+import subprocess
+import sys
+
+from hermes_cli.config import DEFAULT_CONFIG
+
+
+def _run_config_set(tmp_path, key, value):
+    section, option = key.split(".", 1)
+    assert option in DEFAULT_CONFIG.get(section, {})
+    executable = shutil.which("hermes")
+    assert executable is not None, "the repository CLI entry point must be installed"
+    result = subprocess.run(
+        [executable, "config", "set", key, value],
+        cwd=str(tmp_path),
+        env={"HOME": str(tmp_path), "PATH": shutil.os.environ.get("PATH", "")},
+        capture_output=True,
+        text=True,
+        timeout=30,
+        check=False,
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
+
+
+def test_budget_defaults_section_has_exact_contract_values():
+    assert DEFAULT_CONFIG["budget"] == {
+        "enabled": False,
+        "session_limit_usd": None,
+        "daily_limit_usd": None,
+        "total_limit_usd": None,
+        "warn_ratio": 0.8,
+        "enforce": False,
+    }
+
+
+def test_budget_enabled_defaults_false():
+    assert DEFAULT_CONFIG["budget"]["enabled"] is False
+
+
+def test_budget_limit_defaults_are_none():
+    budget = DEFAULT_CONFIG["budget"]
+    assert budget["session_limit_usd"] is None
+    assert budget["daily_limit_usd"] is None
+    assert budget["total_limit_usd"] is None
+
+
+def test_cli_sets_session_budget_limit(tmp_path):
+    _run_config_set(tmp_path, "budget.session_limit_usd", "12.5")
+
+
+def test_cli_sets_daily_budget_limit(tmp_path):
+    _run_config_set(tmp_path, "budget.daily_limit_usd", "20")
+
+
+def test_cli_sets_total_budget_limit(tmp_path):
+    _run_config_set(tmp_path, "budget.total_limit_usd", "100")
+
+
+def test_cli_sets_budget_warn_ratio(tmp_path):
+    _run_config_set(tmp_path, "budget.warn_ratio", "0.7")
+
+
+def test_cli_sets_budget_enforcement_flag(tmp_path):
+    _run_config_set(tmp_path, "budget.enforce", "true")
+
+
+def test_run_agent_help_exposes_budget_limit_flag():
+    result = subprocess.run(
+        [sys.executable, "run_agent.py", "--help"],
+        capture_output=True,
+        text=True,
+        timeout=30,
+        check=False,
+    )
+    assert result.returncode == 0, result.stderr
+    combined = result.stdout + result.stderr
+    assert "--budget-limit" in combined
+
+
+def test_budget_limit_help_identifies_usd_value():
+    assert "session_limit_usd" in DEFAULT_CONFIG.get("budget", {})
+    result = subprocess.run(
+        [sys.executable, "run_agent.py", "--help"],
+        capture_output=True,
+        text=True,
+        timeout=30,
+        check=False,
+    )
+    combined = result.stdout + result.stderr
+    line = next(line for line in combined.splitlines() if "--budget-limit" in line)
+    assert "USD" in line.upper() or "DOLLAR" in line.upper()
