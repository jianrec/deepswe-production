+import importlib
+
+
+def _render(scope, spent, limit, ratio, remaining, warned, exceeded, *, color=False):
+    module = importlib.import_module("agent.spend_budget")
+    status = module.BudgetStatus(scope, spent, limit, ratio, remaining, warned, exceeded)
+    return module.format_budget_status(status, use_color=color)
+
+
+def test_format_budget_status_contains_scope_spent_limit_and_remaining():
+    rendered = _render("session", 2.5, 10.0, 0.25, 7.5, False, False)
+    assert "session" in rendered.lower()
+    assert "2.50" in rendered
+    assert "10.00" in rendered
+    assert "7.50" in rendered
+
+
+def test_format_budget_status_without_color_has_no_ansi_sequences():
+    rendered = _render("daily", 8.0, 10.0, 0.8, 2.0, True, False)
+    assert "\x1b[" not in rendered
+
+
+def test_format_budget_warned_status_is_compact():
+    rendered = _render("daily", 8.25, 10.0, 0.825, 1.75, True, False)
+    assert "\n" not in rendered
+    assert len(rendered) <= 120
+    assert "1.75" in rendered
+
+
+def test_format_budget_exceeded_status_shows_zero_remaining():
+    rendered = _render("total", 12.0, 10.0, 1.2, 0.0, True, True)
+    assert "total" in rendered.lower()
+    assert "0.00" in rendered
+
+
+def test_format_budget_color_mode_preserves_all_amount_text():
+    plain = _render("session", 9.0, 10.0, 0.9, 1.0, True, False, color=False)
+    colored = _render("session", 9.0, 10.0, 0.9, 1.0, True, False, color=True)
+    for fragment in ("9.00", "10.00", "1.00"):
+        assert fragment in plain
+        assert fragment in colored
