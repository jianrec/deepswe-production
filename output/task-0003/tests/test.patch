@@ -0,0 +1,102 @@
+from datetime import datetime
+import importlib
+import os
+import time
+
+import pytest
+
+
+class MutableClock:
+    def __init__(self, value):
+        self.value = value
+
+    def __call__(self):
+        return self.value
+
+
+@pytest.fixture(autouse=True)
+def utc_local_timezone():
+    previous = os.environ.get("TZ")
+    os.environ["TZ"] = "UTC"
+    if hasattr(time, "tzset"):
+        time.tzset()
+    yield
+    if previous is None:
+        os.environ.pop("TZ", None)
+    else:
+        os.environ["TZ"] = previous
+    if hasattr(time, "tzset"):
+        time.tzset()
+
+
+def _timestamp(year, month, day, hour, minute=0):
+    return datetime(year, month, day, hour, minute).timestamp()
+
+
+def _daily_tracker(clock, limit=10.0):
+    module = importlib.import_module("agent.spend_budget")
+    return module.SpendBudgetTracker([module.BudgetLimit("daily", limit)], clock=clock)
+
+
+def test_daily_does_not_reset_before_local_midnight():
+    clock = MutableClock(_timestamp(2025, 1, 1, 23, 50))
+    tracker = _daily_tracker(clock)
+    tracker.record_usage(scope="daily", cost_usd=3.0)
+    clock.value = _timestamp(2025, 1, 1, 23, 59)
+    assert tracker.record_usage(scope="daily", cost_usd=2.0) == []
+    assert tracker.snapshot()["daily"].spent_usd == pytest.approx(5.0)
+
+
+def test_daily_resets_when_clock_crosses_local_midnight():
+    clock = MutableClock(_timestamp(2025, 1, 1, 23, 59))
+    tracker = _daily_tracker(clock)
+    tracker.record_usage(scope="daily", cost_usd=3.0)
+    clock.value = _timestamp(2025, 1, 2, 0, 1)
+    events = tracker.record_usage(scope="daily", cost_usd=2.0)
+    assert [event.kind for event in events] == ["reset"]
+    assert tracker.snapshot()["daily"].spent_usd == pytest.approx(2.0)
+
+
+def test_daily_reset_event_reports_zeroed_status_and_injected_time():
+    clock = MutableClock(_timestamp(2025, 2, 2, 22, 0))
+    tracker = _daily_tracker(clock, limit=7.0)
+    tracker.record_usage(scope="daily", cost_usd=6.0)
+    clock.value = _timestamp(2025, 2, 3, 1, 0)
+    event = tracker.record_usage(scope="daily", cost_usd=0.0)[0]
+    assert (event.kind, event.scope) == ("reset", "daily")
+    assert event.spent_usd == 0.0
+    assert event.limit_usd == 7.0
+    assert event.ratio == 0.0
+    assert event.ts == clock.value
+
+
+def test_daily_reset_rearms_warn_and_exceeded_events():
+    clock = MutableClock(_timestamp(2025, 3, 1, 12, 0))
+    tracker = _daily_tracker(clock)
+    assert [event.kind for event in tracker.record_usage(scope="daily", cost_usd=10.0)] == [
+        "warn", "exceeded"
+    ]
+    clock.value = _timestamp(2025, 3, 2, 12, 0)
+    assert [event.kind for event in tracker.record_usage(scope="daily", cost_usd=10.0)] == [
+        "reset", "warn", "exceeded"
+    ]
+
+
+def test_session_scope_never_auto_resets_at_midnight():
+    module = importlib.import_module("agent.spend_budget")
+    clock = MutableClock(_timestamp(2025, 4, 1, 23, 59))
+    tracker = module.SpendBudgetTracker([module.BudgetLimit("session", 20.0)], clock=clock)
+    tracker.record_usage(scope="session", cost_usd=3.0)
+    clock.value = _timestamp(2025, 4, 3, 1, 0)
+    tracker.record_usage(scope="session", cost_usd=2.0)
+    assert tracker.snapshot()["session"].spent_usd == pytest.approx(5.0)
+
+
+def test_total_scope_never_auto_resets_at_midnight():
+    module = importlib.import_module("agent.spend_budget")
+    clock = MutableClock(_timestamp(2025, 5, 1, 23, 59))
+    tracker = module.SpendBudgetTracker([module.BudgetLimit("total", 20.0)], clock=clock)
+    tracker.record_usage(scope="total", cost_usd=4.0)
+    clock.value = _timestamp(2025, 6, 1, 1, 0)
+    tracker.record_usage(scope="total", cost_usd=1.0)
+    assert tracker.snapshot()["total"].spent_usd == pytest.approx(5.0)
diff --git a/tests/hidden_spend_budget/test_spend_budget_tracker.py b/tests/hidden_spend_budget/test_spend_budget_tracker.py
new file mode 100644
index 0000000..6b681f2
--- /dev/null
+++ b/tests/hidden_spend_budget/test_spend_budget_tracker.py
@@ -0,0 +1,114 @@
+import importlib
+
+import pytest
+
+
+def _tracker(*limits, clock=None):
+    module = importlib.import_module("agent.spend_budget")
+    configured = [module.BudgetLimit(*limit) for limit in limits]
+    return module.SpendBudgetTracker(configured, clock=clock)
+
+
+def test_record_usage_accumulates_configured_scope():
+    tracker = _tracker(("session", 10.0))
+    assert tracker.record_usage(scope="session", cost_usd=2.5) == []
+    status = tracker.snapshot()["session"]
+    assert status.spent_usd == pytest.approx(2.5)
+    assert status.ratio == pytest.approx(0.25)
+    assert status.remaining_usd == pytest.approx(7.5)
+
+
+def test_record_usage_accumulates_multiple_turns():
+    tracker = _tracker(("session", 10.0))
+    tracker.record_usage(scope="session", cost_usd=1.25)
+    tracker.record_usage(scope="session", cost_usd=2.75)
+    assert tracker.snapshot()["session"].spent_usd == pytest.approx(4.0)
+
+
+def test_warn_event_fires_at_warn_threshold():
+    tracker = _tracker(("session", 10.0, 0.8), clock=lambda: 42.0)
+    events = tracker.record_usage(scope="session", cost_usd=8.0, session_id="s-1")
+    assert len(events) == 1
+    event = events[0]
+    assert (event.kind, event.scope, event.ts) == ("warn", "session", 42.0)
+    assert event.spent_usd == pytest.approx(8.0)
+    assert event.limit_usd == pytest.approx(10.0)
+    assert event.ratio == pytest.approx(0.8)
+
+
+def test_warn_event_is_one_shot_until_reset():
+    tracker = _tracker(("session", 10.0))
+    assert [event.kind for event in tracker.record_usage(scope="session", cost_usd=8.0)] == ["warn"]
+    assert tracker.record_usage(scope="session", cost_usd=0.5) == []
+
+
+def test_exceeded_event_fires_at_exact_limit():
+    tracker = _tracker(("session", 10.0))
+    tracker.record_usage(scope="session", cost_usd=8.0)
+    events = tracker.record_usage(scope="session", cost_usd=2.0)
+    assert [event.kind for event in events] == ["exceeded"]
+    assert events[0].ratio == pytest.approx(1.0)
+
+
+def test_single_turn_crossing_both_thresholds_emits_warn_then_exceeded():
+    tracker = _tracker(("total", 5.0), clock=lambda: 100.0)
+    events = tracker.record_usage(scope="total", cost_usd=6.0)
+    assert [event.kind for event in events] == ["warn", "exceeded"]
+    assert all(event.ts == 100.0 for event in events)
+
+
+def test_exceeded_event_is_one_shot_until_reset():
+    tracker = _tracker(("session", 1.0))
+    tracker.record_usage(scope="session", cost_usd=1.0)
+    assert tracker.record_usage(scope="session", cost_usd=3.0) == []
+    assert tracker.snapshot()["session"].spent_usd == pytest.approx(4.0)
+
+
+def test_snapshot_reports_independent_scopes():
+    tracker = _tracker(("session", 10.0), ("daily", 20.0), ("total", 30.0))
+    tracker.record_usage(scope="session", cost_usd=1.0)
+    tracker.record_usage(scope="daily", cost_usd=2.0)
+    tracker.record_usage(scope="total", cost_usd=3.0)
+    snapshot = tracker.snapshot()
+    assert set(snapshot) == {"session", "daily", "total"}
+    assert snapshot["session"].spent_usd == pytest.approx(1.0)
+    assert snapshot["daily"].spent_usd == pytest.approx(2.0)
+    assert snapshot["total"].spent_usd == pytest.approx(3.0)
+
+
+def test_remaining_clamps_to_zero_after_limit():
+    tracker = _tracker(("session", 4.0))
+    tracker.record_usage(scope="session", cost_usd=5.0)
+    assert tracker.remaining("session") == pytest.approx(0.0)
+
+
+def test_is_exceeded_reflects_current_accumulation():
+    tracker = _tracker(("session", 4.0))
+    assert tracker.is_exceeded("session") is False
+    tracker.record_usage(scope="session", cost_usd=4.0)
+    assert tracker.is_exceeded("session") is True
+
+
+def test_unconfigured_scope_is_ignored():
+    tracker = _tracker(("session", 5.0))
+    assert tracker.record_usage(scope="weekly", cost_usd=10.0) == []
+    assert tracker.remaining("weekly") is None
+    assert tracker.is_exceeded("weekly") is False
+    assert set(tracker.snapshot()) == {"session"}
+
+
+def test_zero_cost_does_not_emit_or_change_status():
+    tracker = _tracker(("session", 5.0))
+    assert tracker.record_usage(scope="session", cost_usd=0.0) == []
+    assert tracker.snapshot()["session"].spent_usd == 0.0
+
+
+def test_explicit_reset_clears_spend_and_one_shot_flags():
+    tracker = _tracker(("session", 10.0))
+    tracker.record_usage(scope="session", cost_usd=10.0)
+    tracker.reset("session")
+    status = tracker.snapshot()["session"]
+    assert status.spent_usd == 0.0
+    assert status.warned is False
+    assert status.exceeded is False
+    assert [event.kind for event in tracker.record_usage(scope="session", cost_usd=8.0)] == ["warn"]
