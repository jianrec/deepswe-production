+import importlib
+import logging
+
+
+def _symbols():
+    module = importlib.import_module("agent.spend_budget")
+    return module.BudgetLimit, module.parse_budget_config
+
+
+def test_parse_none_disables_budgets():
+    _, parse_budget_config = _symbols()
+    assert parse_budget_config(None) == []
+
+
+def test_parse_empty_mapping_disables_budgets():
+    _, parse_budget_config = _symbols()
+    assert parse_budget_config({}) == []
+
+
+def test_parse_disabled_mapping_ignores_configured_limits():
+    _, parse_budget_config = _symbols()
+    assert parse_budget_config({"budget": {"enabled": False, "session_limit_usd": 4.0}}) == []
+
+
+def test_parse_session_limit_uses_default_warn_ratio():
+    BudgetLimit, parse_budget_config = _symbols()
+    assert parse_budget_config({"budget": {"enabled": True, "session_limit_usd": 12.5}}) == [
+        BudgetLimit("session", 12.5, 0.8)
+    ]
+
+
+def test_parse_all_scopes_in_contract_order():
+    BudgetLimit, parse_budget_config = _symbols()
+    result = parse_budget_config({"budget": {
+        "enabled": True,
+        "session_limit_usd": 1.0,
+        "daily_limit_usd": 2.0,
+        "total_limit_usd": 3.0,
+    }})
+    assert result == [
+        BudgetLimit("session", 1.0, 0.8),
+        BudgetLimit("daily", 2.0, 0.8),
+        BudgetLimit("total", 3.0, 0.8),
+    ]
+
+
+def test_parse_custom_warn_ratio_applies_to_every_scope():
+    BudgetLimit, parse_budget_config = _symbols()
+    result = parse_budget_config({"budget": {
+        "enabled": True,
+        "session_limit_usd": 10,
+        "daily_limit_usd": 20,
+        "warn_ratio": 0.65,
+    }})
+    assert result == [BudgetLimit("session", 10.0, 0.65), BudgetLimit("daily", 20.0, 0.65)]
+
+
+def test_parse_unknown_budget_keys_yields_no_limits():
+    _, parse_budget_config = _symbols()
+    assert parse_budget_config({"budget": {"enabled": True, "weekly_limit_usd": 9.0}}) == []
+
+
+def test_parse_malformed_budget_section_returns_empty_and_logs(caplog):
+    _, parse_budget_config = _symbols()
+    with caplog.at_level(logging.WARNING):
+        result = parse_budget_config({"budget": "invalid"})
+    assert result == []
+    assert caplog.records
+
+
+def test_parse_negative_limit_ignores_only_bad_scope_and_logs(caplog):
+    BudgetLimit, parse_budget_config = _symbols()
+    with caplog.at_level(logging.WARNING):
+        result = parse_budget_config({"budget": {
+            "enabled": True,
+            "session_limit_usd": -1,
+            "daily_limit_usd": 4,
+        }})
+    assert result == [BudgetLimit("daily", 4.0, 0.8)]
+    assert any("session" in record.getMessage().lower() for record in caplog.records)
+
+
+def test_parse_non_numeric_limit_ignores_only_bad_scope_and_logs(caplog):
+    BudgetLimit, parse_budget_config = _symbols()
+    with caplog.at_level(logging.WARNING):
+        result = parse_budget_config({"budget": {
+            "enabled": True,
+            "session_limit_usd": "many",
+            "total_limit_usd": 7,
+        }})
+    assert result == [BudgetLimit("total", 7.0, 0.8)]
+    assert caplog.records
+
+
+def test_parse_non_finite_limits_are_ignored_and_logged(caplog):
+    _, parse_budget_config = _symbols()
+    with caplog.at_level(logging.WARNING):
+        result = parse_budget_config({"budget": {
+            "enabled": True,
+            "session_limit_usd": float("nan"),
+            "daily_limit_usd": float("inf"),
+        }})
+    assert result == []
+    assert caplog.records
+
+
+def test_parse_malformed_warn_ratio_disables_without_raising(caplog):
+    _, parse_budget_config = _symbols()
+    with caplog.at_level(logging.WARNING):
+        result = parse_budget_config({"budget": {
+            "enabled": True,
+            "session_limit_usd": 5,
+            "warn_ratio": "invalid",
+        }})
+    assert result == []
+    assert caplog.records
