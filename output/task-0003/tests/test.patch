@@ -0,0 +1,74 @@
+import importlib
+import json
+
+from agent.context_compressor import _redact_compaction_text
+
+
+def test_budget_threshold_event_constant_has_contract_value():
+    events = importlib.import_module("agent.monitoring.events")
+    assert events.BUDGET_THRESHOLD_EVENT == "budget.threshold"
+
+
+def test_budget_event_forms_exact_monitoring_payload_shape():
+    budget = importlib.import_module("agent.spend_budget")
+    event = budget.BudgetEvent("warn", "session", 8.0, 10.0, 0.8, 1234.5)
+    payload = {
+        "scope": event.scope,
+        "kind": event.kind,
+        "spent_usd": event.spent_usd,
+        "limit_usd": event.limit_usd,
+        "ratio": event.ratio,
+        "session_id": "session-123",
+        "ts": event.ts,
+    }
+    assert set(payload) == {
+        "scope", "kind", "spent_usd", "limit_usd", "ratio", "session_id", "ts"
+    }
+
+
+def test_budget_payload_amounts_survive_strict_redaction():
+    events = importlib.import_module("agent.monitoring.events")
+    payload = {
+        "event": events.BUDGET_THRESHOLD_EVENT,
+        "scope": "daily",
+        "kind": "exceeded",
+        "spent_usd": 12.75,
+        "limit_usd": 10.0,
+        "ratio": 1.275,
+        "session_id": "safe-session",
+        "ts": 1730000000.0,
+    }
+    decoded = json.loads(_redact_compaction_text(json.dumps(payload, sort_keys=True)))
+    assert decoded["spent_usd"] == 12.75
+    assert decoded["limit_usd"] == 10.0
+    assert decoded["ratio"] == 1.275
+    assert decoded["ts"] == 1730000000.0
+
+
+def test_budget_payload_redaction_removes_incidental_secret_but_keeps_amounts():
+    events = importlib.import_module("agent.monitoring.events")
+    secret = "sk-proj-" + "a" * 40
+    payload = {
+        "event": events.BUDGET_THRESHOLD_EVENT,
+        "scope": "total",
+        "kind": "warn",
+        "spent_usd": 4.0,
+        "limit_usd": 5.0,
+        "ratio": 0.8,
+        "session_id": "session-safe",
+        "ts": 100.0,
+        "diagnostic": secret,
+    }
+    redacted = _redact_compaction_text(json.dumps(payload, sort_keys=True))
+    assert secret not in redacted
+    decoded = json.loads(redacted)
+    assert decoded["spent_usd"] == 4.0
+    assert decoded["limit_usd"] == 5.0
+
+
+def test_budget_contract_payload_keys_contain_no_secret_fields():
+    events = importlib.import_module("agent.monitoring.events")
+    assert events.BUDGET_THRESHOLD_EVENT == "budget.threshold"
+    allowed = {"scope", "kind", "spent_usd", "limit_usd", "ratio", "session_id", "ts"}
+    forbidden = {"key", "token", "authorization", "password", "credential"}
+    assert all(not any(fragment in key.lower() for fragment in forbidden) for key in allowed)
