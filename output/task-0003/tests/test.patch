@@ -0,0 +1,84 @@
+from decimal import Decimal
+import importlib
+from types import SimpleNamespace
+
+import pytest
+
+
+def _pricing_api():
+    module = importlib.import_module("agent.usage_pricing")
+    return module.PricingEntry, module.turn_cost_usd
+
+
+def test_turn_cost_adds_input_and_output_costs_for_mappings():
+    _, turn_cost_usd = _pricing_api()
+    usage = {"input_tokens": 1_000_000, "output_tokens": 500_000}
+    pricing = {"input_cost_per_million": 2.0, "output_cost_per_million": 6.0}
+    assert turn_cost_usd(usage, pricing) == pytest.approx(5.0)
+
+
+def test_turn_cost_supports_attribute_usage_and_pricing_objects():
+    _, turn_cost_usd = _pricing_api()
+    usage = SimpleNamespace(input_tokens=250_000, output_tokens=100_000)
+    pricing = SimpleNamespace(input_cost_per_million=4.0, output_cost_per_million=10.0)
+    assert turn_cost_usd(usage, pricing) == pytest.approx(2.0)
+
+
+def test_turn_cost_supports_existing_pricing_entry():
+    PricingEntry, turn_cost_usd = _pricing_api()
+    pricing = PricingEntry(
+        input_cost_per_million=Decimal("1"),
+        output_cost_per_million=Decimal("3"),
+    )
+    usage = {"input_tokens": 2_000_000, "output_tokens": 1_000_000}
+    assert turn_cost_usd(usage, pricing) == pytest.approx(5.0)
+
+
+def test_turn_cost_includes_cache_read_and_cache_write_rates():
+    _, turn_cost_usd = _pricing_api()
+    usage = {
+        "input_tokens": 100_000,
+        "output_tokens": 0,
+        "cache_read_tokens": 1_000_000,
+        "cache_write_tokens": 2_000_000,
+    }
+    pricing = {
+        "input_cost_per_million": 2.0,
+        "output_cost_per_million": 8.0,
+        "cache_read_cost_per_million": 0.2,
+        "cache_write_cost_per_million": 2.5,
+    }
+    assert turn_cost_usd(usage, pricing) == pytest.approx(5.4)
+
+
+def test_turn_cost_includes_per_request_price():
+    _, turn_cost_usd = _pricing_api()
+    usage = {"input_tokens": 0, "output_tokens": 0, "request_count": 3}
+    pricing = {"request_cost": 0.125}
+    assert turn_cost_usd(usage, pricing) == pytest.approx(0.375)
+
+
+def test_turn_cost_unknown_pricing_returns_zero():
+    _, turn_cost_usd = _pricing_api()
+    assert turn_cost_usd({"input_tokens": 1_000_000}, None) == 0.0
+    assert turn_cost_usd({"input_tokens": 1_000_000}, {}) == 0.0
+
+
+def test_turn_cost_missing_usage_returns_zero():
+    _, turn_cost_usd = _pricing_api()
+    pricing = {"input_cost_per_million": 5.0, "output_cost_per_million": 10.0}
+    assert turn_cost_usd(None, pricing) == 0.0
+    assert turn_cost_usd({}, pricing) == 0.0
+
+
+def test_turn_cost_result_drives_budget_thresholds():
+    _, turn_cost_usd = _pricing_api()
+    budget = importlib.import_module("agent.spend_budget")
+    cost = turn_cost_usd(
+        {"input_tokens": 1_000_000, "output_tokens": 1_000_000},
+        {"input_cost_per_million": 2.0, "output_cost_per_million": 3.0},
+    )
+    tracker = budget.SpendBudgetTracker([budget.BudgetLimit("session", 5.0)])
+    events = tracker.record_usage(scope="session", cost_usd=cost, session_id="turn-1")
+    assert [event.kind for event in events] == ["warn", "exceeded"]
+    assert tracker.is_exceeded("session") is True
