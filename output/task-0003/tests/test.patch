+import importlib
+from types import ModuleType
+
+
+def _module_references(module, target):
+    for value in vars(module).values():
+        if value is target:
+            return True
+        if isinstance(value, ModuleType) and getattr(value, target.__name__, None) is target:
+            return True
+    return False
+
+
+def test_credits_tracker_is_wired_to_turn_cost_helper():
+    credits = importlib.import_module("agent.credits_tracker")
+    credits._budget_tracker = None
+    credits._budget_tracker_key = None
+    config = {"budget": {"enabled": True, "session_limit_usd": 10.0}}
+    credits.record_turn_budget({"input_tokens": 1_000_000, "output_tokens": 0}, {"input_cost_per_million": 2.0, "output_cost_per_million": 0.0}, config)
+    status = credits.get_budget_tracker(config).snapshot()["session"]
+    assert status.spent_usd == 2.0
+
+
+def test_credits_tracker_is_wired_to_spend_budget_tracker():
+    credits = importlib.import_module("agent.credits_tracker")
+    credits._budget_tracker = None
+    credits._budget_tracker_key = None
+    config = {"budget": {"enabled": True, "session_limit_usd": 5.0}}
+    events = credits.record_turn_budget({"input_tokens": 1_000_000}, {"input_cost_per_million": 5.0}, config)
+    assert [event.kind for event in events] == ["warn", "exceeded"]
+    assert credits.get_budget_tracker(config).is_exceeded("session") is True
+
+
+def test_billing_view_is_wired_to_budget_status_formatter():
+    budget = importlib.import_module("agent.spend_budget")
+    billing_view = importlib.import_module("agent.billing_view")
+    tracker = budget.SpendBudgetTracker([budget.BudgetLimit("session", 10.0)])
+    tracker.record_usage(scope="session", cost_usd=2.0)
+    lines = billing_view.build_budget_lines(tracker, use_color=False)
+    assert len(lines) == 1
+    assert "session" in lines[0].lower() and "2.00" in lines[0] and "10.00" in lines[0]
+
+
+def test_display_is_wired_to_budget_status_formatter():
+    budget = importlib.import_module("agent.spend_budget")
+    display = importlib.import_module("agent.display")
+    status = budget.BudgetStatus("session", 2.0, 10.0, 0.2, 8.0, False, False)
+    rendered = display.format_budget_display(status, use_color=False)
+    assert rendered == budget.format_budget_status(status, use_color=False)
+
+
+def test_gateway_runtime_footer_is_wired_to_budget_status_formatter():
+    credits = importlib.import_module("agent.credits_tracker")
+    footer = importlib.import_module("gateway.runtime_footer")
+    credits._budget_tracker = None
+    credits._budget_tracker_key = None
+    config = {"budget": {"enabled": True, "session_limit_usd": 10.0}}
+    rendered = footer.build_footer_line(user_config=config, platform_key=None, model=None, context_tokens=0, context_length=None)
+    assert "session" in rendered.lower()
+    assert "0.00" in rendered and "10.00" in rendered
