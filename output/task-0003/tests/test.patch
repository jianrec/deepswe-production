@@ -0,0 +1,82 @@
+from dataclasses import FrozenInstanceError, fields
+import importlib
+import inspect
+
+import pytest
+
+
+def _api():
+    module = importlib.import_module("agent.spend_budget")
+    return (
+        module.BudgetLimit,
+        module.BudgetStatus,
+        module.BudgetEvent,
+        module.SpendBudgetTracker,
+        module.parse_budget_config,
+        module.format_budget_status,
+    )
+
+
+def test_budget_limit_has_exact_public_fields_and_default():
+    BudgetLimit, _, _, _, _, _ = _api()
+    value = BudgetLimit(scope="session", limit_usd=10.0)
+    assert [field.name for field in fields(BudgetLimit)] == ["scope", "limit_usd", "warn_ratio"]
+    assert (value.scope, value.limit_usd, value.warn_ratio) == ("session", 10.0, 0.8)
+
+
+def test_budget_limit_is_frozen():
+    BudgetLimit, _, _, _, _, _ = _api()
+    value = BudgetLimit("daily", 5.0)
+    with pytest.raises(FrozenInstanceError):
+        value.limit_usd = 6.0
+
+
+def test_budget_status_has_exact_public_fields_and_is_frozen():
+    _, BudgetStatus, _, _, _, _ = _api()
+    value = BudgetStatus("total", 2.0, 8.0, 0.25, 6.0, False, False)
+    assert [field.name for field in fields(BudgetStatus)] == [
+        "scope", "spent_usd", "limit_usd", "ratio", "remaining_usd", "warned", "exceeded"
+    ]
+    with pytest.raises(FrozenInstanceError):
+        value.warned = True
+
+
+def test_budget_event_has_exact_public_fields_and_is_frozen():
+    _, _, BudgetEvent, _, _, _ = _api()
+    value = BudgetEvent("warn", "session", 8.0, 10.0, 0.8, 123.0)
+    assert [field.name for field in fields(BudgetEvent)] == [
+        "kind", "scope", "spent_usd", "limit_usd", "ratio", "ts"
+    ]
+    with pytest.raises(FrozenInstanceError):
+        value.kind = "exceeded"
+
+
+def test_tracker_constructor_signature_matches_contract():
+    _, _, _, SpendBudgetTracker, _, _ = _api()
+    signature = inspect.signature(SpendBudgetTracker)
+    assert list(signature.parameters) == ["limits", "clock"]
+    assert signature.parameters["clock"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert signature.parameters["clock"].default is None
+
+
+def test_tracker_methods_match_keyword_contract():
+    _, _, _, SpendBudgetTracker, _, _ = _api()
+    record = inspect.signature(SpendBudgetTracker.record_usage)
+    assert list(record.parameters) == ["self", "scope", "cost_usd", "session_id"]
+    assert record.parameters["scope"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert record.parameters["cost_usd"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert record.parameters["session_id"].default is None
+    assert list(inspect.signature(SpendBudgetTracker.snapshot).parameters) == ["self"]
+    assert list(inspect.signature(SpendBudgetTracker.remaining).parameters) == ["self", "scope"]
+    assert list(inspect.signature(SpendBudgetTracker.is_exceeded).parameters) == ["self", "scope"]
+    assert list(inspect.signature(SpendBudgetTracker.reset).parameters) == ["self", "scope"]
+
+
+def test_parse_and_format_function_signatures_match_contract():
+    _, _, _, _, parse_budget_config, format_budget_status = _api()
+    parse_signature = inspect.signature(parse_budget_config)
+    assert list(parse_signature.parameters) == ["raw"]
+    format_signature = inspect.signature(format_budget_status)
+    assert list(format_signature.parameters) == ["status", "use_color"]
+    assert format_signature.parameters["use_color"].kind is inspect.Parameter.KEYWORD_ONLY
+    assert format_signature.parameters["use_color"].default is True
