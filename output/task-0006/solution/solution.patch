--- /dev/null
+++ b/src/vanilla/history.ts
@@ -0,0 +1,305 @@
+import { createStore } from '../vanilla.ts'
+import type { StateCreator, StoreApi } from '../vanilla.ts'
+
+export interface TemporalState<T> {
+  pastStates: Partial<T>[]
+  futureStates: Partial<T>[]
+  undo: (steps?: number) => void
+  redo: (steps?: number) => void
+  clear: () => void
+  isTracking: boolean
+  pause: () => void
+  resume: () => void
+}
+
+export interface HistoryOptions<T, PartialTState = T> {
+  limit?: number
+  equality?: (pastState: PartialTState, currentState: PartialTState) => boolean
+  partialize?: (state: T) => PartialTState
+  onSave?: (pastState: T, currentState: T) => void
+  handleSet?: (handleSet: StoreApi<T>['setState']) => StoreApi<T>['setState']
+  wrapTemporal?: (
+    initializer: StateCreator<TemporalState<T>, [], []>,
+  ) => StateCreator<TemporalState<T>, [], []>
+}
+
+export interface TemporalStore<T, PartialTState = T>
+  extends StoreApi<TemporalState<T>> {
+  record: (pastState: T, currentState: T) => void
+  isApplying: () => boolean
+  getTrackedState: (state: T) => PartialTState
+}
+
+type Snapshot<T> = Partial<T>
+
+type TemporalStacks<T> = Pick<
+  TemporalState<T>,
+  'pastStates' | 'futureStates'
+>
+
+type TemporalTransition<T> = TemporalStacks<T> & {
+  target: Snapshot<T>
+}
+
+const identity = <T>(state: T): T => state
+
+const normalizeLimit = (limit: number | undefined): number | undefined => {
+  if (limit === undefined || !Number.isFinite(limit)) {
+    return undefined
+  }
+  return Math.max(0, Math.floor(limit))
+}
+
+const normalizeSteps = (steps: number | undefined): number => {
+  if (steps === undefined) {
+    return 1
+  }
+  if (!Number.isFinite(steps)) {
+    return 0
+  }
+  return Math.max(0, Math.floor(steps))
+}
+
+const cloneStack = <T>(stack: Snapshot<T>[]): Snapshot<T>[] => stack.slice()
+
+const appendPastState = <T>(
+  pastStates: Snapshot<T>[],
+  snapshot: Snapshot<T>,
+  limit: number | undefined,
+): Snapshot<T>[] => {
+  if (limit === 0) {
+    return []
+  }
+
+  const nextPastStates = [...pastStates, snapshot]
+  if (limit === undefined || nextPastStates.length <= limit) {
+    return nextPastStates
+  }
+
+  return nextPastStates.slice(nextPastStates.length - limit)
+}
+
+const buildUndoTransition = <T>(
+  pastStates: Snapshot<T>[],
+  futureStates: Snapshot<T>[],
+  currentState: Snapshot<T>,
+  requestedSteps: number,
+): TemporalTransition<T> | undefined => {
+  const stepCount = Math.min(requestedSteps, pastStates.length)
+  if (stepCount === 0) {
+    return undefined
+  }
+
+  const nextPastStates = cloneStack(pastStates)
+  const removedPastStates = nextPastStates.splice(
+    nextPastStates.length - stepCount,
+    stepCount,
+  )
+  const target = removedPastStates[0]
+  if (!target) {
+    return undefined
+  }
+
+  const skippedStates = removedPastStates.slice(1).reverse()
+  const nextFutureStates = [
+    ...futureStates,
+    currentState,
+    ...skippedStates,
+  ]
+
+  return {
+    target,
+    pastStates: nextPastStates,
+    futureStates: nextFutureStates,
+  }
+}
+
+const buildRedoTransition = <T>(
+  pastStates: Snapshot<T>[],
+  futureStates: Snapshot<T>[],
+  currentState: Snapshot<T>,
+  requestedSteps: number,
+  limit: number | undefined,
+): TemporalTransition<T> | undefined => {
+  const stepCount = Math.min(requestedSteps, futureStates.length)
+  if (stepCount === 0) {
+    return undefined
+  }
+
+  const nextFutureStates = cloneStack(futureStates)
+  const removedFutureStates = nextFutureStates.splice(
+    nextFutureStates.length - stepCount,
+    stepCount,
+  )
+  const statesInApplicationOrder = removedFutureStates.reverse()
+  const target = statesInApplicationOrder.at(-1)
+  if (!target) {
+    return undefined
+  }
+
+  let nextPastStates = appendPastState(pastStates, currentState, limit)
+  for (const intermediateState of statesInApplicationOrder.slice(0, -1)) {
+    nextPastStates = appendPastState(
+      nextPastStates,
+      intermediateState,
+      limit,
+    )
+  }
+
+  return {
+    target,
+    pastStates: nextPastStates,
+    futureStates: nextFutureStates,
+  }
+}
+
+const stacksChanged = <T>(
+  current: TemporalStacks<T>,
+  next: TemporalStacks<T>,
+): boolean =>
+  current.pastStates !== next.pastStates ||
+  current.futureStates !== next.futureStates
+
+export const createTemporalStore = <T, PartialTState = T>(
+  userSet: StoreApi<T>['setState'],
+  userGet: StoreApi<T>['getState'],
+  options: HistoryOptions<T, PartialTState> = {},
+): TemporalStore<T, PartialTState> => {
+  const limit = normalizeLimit(options.limit)
+  const partialize = options.partialize ?? (identity as (state: T) => PartialTState)
+  const equality = options.equality
+  const onSave = options.onSave
+  const wrapTemporal = options.wrapTemporal ?? identity
+  let applyingDepth = 0
+
+  const getTrackedState = (state: T): PartialTState => partialize(state)
+
+  const toSnapshot = (state: T): Snapshot<T> =>
+    getTrackedState(state) as unknown as Snapshot<T>
+
+  const runWhileApplying = (apply: () => void): void => {
+    applyingDepth += 1
+    try {
+      apply()
+    } finally {
+      applyingDepth -= 1
+    }
+  }
+
+  const applyTransition = (
+    transition: TemporalTransition<T> | undefined,
+    setTemporalState: StoreApi<TemporalState<T>>['setState'],
+  ): void => {
+    if (!transition) {
+      return
+    }
+
+    runWhileApplying(() => {
+      userSet(transition.target)
+    })
+    setTemporalState({
+      pastStates: transition.pastStates,
+      futureStates: transition.futureStates,
+    })
+  }
+
+  const initializer: StateCreator<TemporalState<T>, [], []> = (set, get) => ({
+    pastStates: [],
+    futureStates: [],
+    undo: (steps) => {
+      const requestedSteps = normalizeSteps(steps)
+      if (requestedSteps === 0) {
+        return
+      }
+
+      const temporalState = get()
+      applyTransition(
+        buildUndoTransition(
+          temporalState.pastStates,
+          temporalState.futureStates,
+          toSnapshot(userGet()),
+          requestedSteps,
+        ),
+        set,
+      )
+    },
+    redo: (steps) => {
+      const requestedSteps = normalizeSteps(steps)
+      if (requestedSteps === 0) {
+        return
+      }
+
+      const temporalState = get()
+      applyTransition(
+        buildRedoTransition(
+          temporalState.pastStates,
+          temporalState.futureStates,
+          toSnapshot(userGet()),
+          requestedSteps,
+          limit,
+        ),
+        set,
+      )
+    },
+    clear: () => {
+      const temporalState = get()
+      if (
+        temporalState.pastStates.length === 0 &&
+        temporalState.futureStates.length === 0
+      ) {
+        return
+      }
+      set({ pastStates: [], futureStates: [] })
+    },
+    isTracking: true,
+    pause: () => {
+      if (get().isTracking) {
+        set({ isTracking: false })
+      }
+    },
+    resume: () => {
+      if (!get().isTracking) {
+        set({ isTracking: true })
+      }
+    },
+  })
+
+  const temporalStore = createStore<TemporalState<T>>(
+    wrapTemporal(initializer),
+  ) as TemporalStore<T, PartialTState>
+
+  temporalStore.record = (pastState, currentState) => {
+    if (applyingDepth > 0 || !temporalStore.getState().isTracking) {
+      return
+    }
+    if (Object.is(pastState, currentState)) {
+      return
+    }
+
+    const trackedPastState = getTrackedState(pastState)
+    const trackedCurrentState = getTrackedState(currentState)
+    if (equality?.(trackedPastState, trackedCurrentState)) {
+      return
+    }
+
+    const temporalState = temporalStore.getState()
+    const nextStacks: TemporalStacks<T> = {
+      pastStates: appendPastState(
+        temporalState.pastStates,
+        trackedPastState as unknown as Snapshot<T>,
+        limit,
+      ),
+      futureStates: [],
+    }
+
+    if (stacksChanged(temporalState, nextStacks)) {
+      temporalStore.setState(nextStacks)
+    }
+    onSave?.(pastState, currentState)
+  }
+
+  temporalStore.isApplying = () => applyingDepth > 0
+  temporalStore.getTrackedState = getTrackedState
+
+  return temporalStore
+}
