+import { createTemporalStore } from '../vanilla/history.ts'
+import type {
+  HistoryOptions,
+  TemporalState,
+  TemporalStore,
+} from '../vanilla/history.ts'
+import type {
+  ExtractState,
+  StateCreator,
+  StoreApi,
+  StoreMutatorIdentifier,
+} from '../vanilla.ts'
+
+type Write<T, U> = Omit<T, keyof U> & U
+
+type WithHistory<S> = Write<
+  S,
+  { temporal: StoreApi<TemporalState<ExtractState<S>>> }
+>
+
+declare module '../vanilla' {
+  // eslint-disable-next-line @typescript-eslint/no-unused-vars
+  interface StoreMutators<S, A> {
+    'zustand/history': WithHistory<S>
+  }
+}
+
+type History = <
+  T,
+  Mps extends [StoreMutatorIdentifier, unknown][] = [],
+  Mcs extends [StoreMutatorIdentifier, unknown][] = [],
+  U = T,
+  PartialTState = T,
+>(
+  initializer: StateCreator<T, [...Mps, ['zustand/history', never]], Mcs, U>,
+  options?: HistoryOptions<T, PartialTState>,
+) => StateCreator<T, Mps, [['zustand/history', never], ...Mcs], U>
+
+type HistoryImpl = (
+  initializer: StateCreator<any, [], []>,
+  options?: HistoryOptions<any, any>,
+) => StateCreator<any, [], []>
+
+type AnySetState<T> = (
+  state:
+    | T
+    | Partial<T>
+    | ((state: T) => T | Partial<T>),
+  replace?: boolean,
+  ...args: unknown[]
+) => unknown
+
+type RecordingContext<T> = {
+  temporal: TemporalStore<T>
+  getState: StoreApi<T>['getState']
+  mutationDepth: number
+}
+
+const callSetState = <T>(
+  setState: AnySetState<T>,
+  args: Parameters<AnySetState<T>>,
+): unknown => setState(...args)
+
+const createRecordingSet = <T>(
+  context: RecordingContext<T>,
+  setState: AnySetState<T>,
+): AnySetState<T> => {
+  return (...args) => {
+    if (context.temporal.isApplying() || context.mutationDepth > 0) {
+      return callSetState(setState, args)
+    }
+
+    const previousState = context.getState()
+    context.mutationDepth += 1
+    let result: unknown
+    try {
+      result = callSetState(setState, args)
+    } finally {
+      context.mutationDepth -= 1
+    }
+    const currentState = context.getState()
+    context.temporal.record(previousState, currentState)
+    return result
+  }
+}
+
+const applyHandleSet = <T>(
+  setState: AnySetState<T>,
+  handleSet: HistoryOptions<T>['handleSet'],
+): AnySetState<T> => {
+  if (!handleSet) {
+    return setState
+  }
+  return handleSet(
+    setState as StoreApi<T>['setState'],
+  ) as AnySetState<T>
+}
+
+const historyImpl: HistoryImpl =
+  (
+    initializer: StateCreator<any, [], []>,
+    options: HistoryOptions<any, any> = {},
+  ) =>
+  (set, get, api) => {
+    const temporal = createTemporalStore<any, any>(
+      (state) => {
+        const currentSetState = api.setState as AnySetState<any>
+        currentSetState(state)
+      },
+      get,
+      options,
+    )
+
+    const context: RecordingContext<any> = {
+      temporal,
+      getState: get,
+      mutationDepth: 0,
+    }
+
+    const initializerRecordingSet = createRecordingSet(
+      context,
+      set as AnySetState<any>,
+    )
+    const initializerSet = applyHandleSet(
+      initializerRecordingSet,
+      options.handleSet,
+    )
+
+    ;(
+      api as StoreApi<any> & { temporal: StoreApi<TemporalState<any>> }
+    ).temporal = temporal
+    api.setState = initializerSet as StoreApi<any>['setState']
+
+    const initialState = initializer(
+      initializerSet as typeof set,
+      get,
+      api,
+    )
+
+    const configuredSetState = api.setState as AnySetState<any>
+    if (configuredSetState !== initializerSet) {
+      const externalRecordingSet = createRecordingSet(
+        context,
+        configuredSetState,
+      )
+      api.setState = applyHandleSet(
+        externalRecordingSet,
+        options.handleSet,
+      ) as StoreApi<any>['setState']
+    }
+
+    return initialState
+  }
+
+export const history = historyImpl as unknown as History
+
+export type { HistoryOptions, TemporalState }
