new file mode 100644
index 0000000..cd7d54f
--- /dev/null
+++ b/tests/history.controls.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, it, vi } from 'vitest'
+import { history } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+
+const makeStore = (limit?: number) => createStore(history(() => ({ count: 0 }), { limit }))
+
+describe('history controls and limits', () => {
+  it('history_clear_empties_both_stacks', () => {
+    const store = makeStore()
+    store.setState({ count: 1 })
+    store.setState({ count: 2 })
+    store.temporal.getState().undo()
+    store.temporal.getState().clear()
+    expect(store.temporal.getState().pastStates).toEqual([])
+    expect(store.temporal.getState().futureStates).toEqual([])
+  })
+
+  it('history_clear_does_not_change_main_state', () => {
+    const store = makeStore()
+    store.setState({ count: 7 })
+    store.temporal.getState().clear()
+    expect(store.getState().count).toBe(7)
+  })
+
+  it('history_pause_disables_tracking', () => {
+    const store = makeStore()
+    store.temporal.getState().pause()
+    expect(store.temporal.getState().isTracking).toBe(false)
+    store.setState({ count: 3 })
+    expect(store.temporal.getState().pastStates).toEqual([])
+  })
+
+  it('history_resume_reenables_tracking_from_current_state', () => {
+    const store = makeStore()
+    store.temporal.getState().pause()
+    store.setState({ count: 3 })
+    store.temporal.getState().resume()
+    store.setState({ count: 4 })
+    expect(store.temporal.getState().isTracking).toBe(true)
+    expect(store.temporal.getState().pastStates.map((state) => state.count)).toEqual([3])
+  })
+
+  it('history_limit_discards_oldest_entries_first', () => {
+    const store = makeStore(2)
+    store.setState({ count: 1 })
+    store.setState({ count: 2 })
+    store.setState({ count: 3 })
+    expect(store.temporal.getState().pastStates.map((state) => state.count)).toEqual([1, 2])
+  })
+
+  it('history_limit_one_keeps_only_latest_past_state', () => {
+    const store = makeStore(1)
+    store.setState({ count: 1 })
+    store.setState({ count: 2 })
+    expect(store.temporal.getState().pastStates).toHaveLength(1)
+    expect(store.temporal.getState().pastStates[0]?.count).toBe(1)
+  })
+
+  it('history_without_limit_keeps_unbounded_entries', () => {
+    const store = makeStore()
+    for (let count = 1; count <= 25; count += 1) store.setState({ count })
+    expect(store.temporal.getState().pastStates).toHaveLength(25)
+    expect(store.temporal.getState().pastStates[0]?.count).toBe(0)
+    expect(store.temporal.getState().pastStates[24]?.count).toBe(24)
+  })
+
+  it('history_empty_undo_redo_and_clear_do_not_notify_main_store', () => {
+    const store = makeStore()
+    const listener = vi.fn()
+    store.subscribe(listener)
+    store.temporal.getState().undo()
+    store.temporal.getState().redo()
+    store.temporal.getState().clear()
+    expect(listener).not.toHaveBeenCalled()
+    expect(store.getState().count).toBe(0)
+  })
+})
diff --git a/tests/history.core.test.ts b/tests/history.core.test.ts
new file mode 100644
index 0000000..aed969e
--- /dev/null
+++ b/tests/history.core.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, it, vi } from 'vitest'
+import { create } from 'zustand'
+import { history } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+
+type Counter = { count: number; label: string; inc: () => void }
+
+const initializer = (set: (partial: Partial<Counter> | ((state: Counter) => Partial<Counter>)) => void) => ({
+  count: 0,
+  label: 'initial',
+  inc: () => set((state: Counter) => ({ count: state.count + 1 })),
+})
+
+describe('history core API', () => {
+  it('history_create_exposes_temporal_on_bound_store', () => {
+    const store = create<Counter>()(history(initializer))
+    expect(store.temporal).toBeDefined()
+    expect(store.temporal.getState().pastStates).toEqual([])
+    expect(store.temporal.getState().futureStates).toEqual([])
+  })
+
+  it('history_createStore_exposes_temporal_on_vanilla_store', () => {
+    const store = createStore<Counter>()(history(initializer))
+    expect(store.temporal).toBeDefined()
+    expect(store.temporal.getState().isTracking).toBe(true)
+  })
+
+  it('history_temporal_is_a_full_store_api', () => {
+    const store = createStore<Counter>()(history(initializer))
+    expect(store.temporal.getState).toEqual(expect.any(Function))
+    expect(store.temporal.getInitialState).toEqual(expect.any(Function))
+    expect(store.temporal.setState).toEqual(expect.any(Function))
+    expect(store.temporal.subscribe).toEqual(expect.any(Function))
+  })
+
+  it('history_temporal_store_has_independent_subscriptions', () => {
+    const store = createStore<Counter>()(history(initializer))
+    const temporalListener = vi.fn()
+    const mainListener = vi.fn()
+    store.temporal.subscribe(temporalListener)
+    store.subscribe(mainListener)
+    store.temporal.setState({ isTracking: false })
+    expect(temporalListener).toHaveBeenCalledTimes(1)
+    expect(mainListener).not.toHaveBeenCalled()
+    expect(store.temporal.getState().isTracking).toBe(false)
+  })
+
+  it('history_records_updates_made_by_initializer_set', () => {
+    const store = createStore<Counter>()(history(initializer))
+    store.getState().inc()
+    store.getState().inc()
+    expect(store.getState().count).toBe(2)
+    expect(store.temporal.getState().pastStates.map((state) => state.count)).toEqual([0, 1])
+  })
+
+  it('history_records_updates_made_by_api_setState', () => {
+    const store = createStore<Counter>()(history(initializer))
+    store.setState({ count: 4 })
+    store.setState((state) => ({ count: state.count + 3 }))
+    expect(store.getState().count).toBe(7)
+    expect(store.temporal.getState().pastStates.map((state) => state.count)).toEqual([0, 4])
+    expect(store.temporal.getState().futureStates).toEqual([])
+  })
+})
diff --git a/tests/history.integration.test.ts b/tests/history.integration.test.ts
