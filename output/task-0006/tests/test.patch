+++ b/tests/history.types.test.tsx
@@ -0,0 +1,66 @@
+import { describe, expect, expectTypeOf, it } from 'vitest'
+import { create, useTemporal } from 'zustand'
+import type { StoreApi } from 'zustand'
+import { devtools, history, persist, subscribeWithSelector } from 'zustand/middleware'
+import type { HistoryOptions, TemporalState } from 'zustand/middleware'
+import { immer } from 'zustand/middleware/immer'
+import { useTemporalWithEqualityFn } from 'zustand/traditional'
+import { createStore } from 'zustand/vanilla'
+
+type Counter = { count: number; name: string }
+
+describe('history public types', () => {
+  it('history_types_infer_temporal_on_create', () => {
+    const store = create<Counter>()(history(() => ({ count: 0, name: 'bear' })))
+    expectTypeOf(store.temporal).toEqualTypeOf<StoreApi<TemporalState<Counter>>>()
+    expectTypeOf(store.temporal.getState().pastStates).toEqualTypeOf<Partial<Counter>[]>()
+    expect(store).toBeDefined()
+  })
+
+  it('history_types_infer_temporal_on_createStore', () => {
+    const store = createStore(history(() => ({ count: 0, name: 'bear' })))
+    expectTypeOf(store.temporal.getState().undo).toEqualTypeOf<(steps?: number) => void>()
+    expectTypeOf(store.temporal.getState().redo).toEqualTypeOf<(steps?: number) => void>()
+    expect(store).toBeDefined()
+  })
+
+  it('history_types_expose_HistoryOptions_and_TemporalState', () => {
+    const options: HistoryOptions<Counter, Pick<Counter, 'count'>> = {
+      limit: 3,
+      partialize: (state) => ({ count: state.count }),
+      equality: (past, current) => past.count === current.count,
+    }
+    const temporal: TemporalState<Counter> = {
+      pastStates: [], futureStates: [], undo: () => {}, redo: () => {}, clear: () => {},
+      isTracking: true, pause: () => {}, resume: () => {},
+    }
+    expect(history).toBeTypeOf('function')
+    expect(temporal.isTracking).toBe(true)
+  })
+
+  it('history_types_infer_react_binding_results', () => {
+    const store = create<Counter>()(history(() => ({ count: 0, name: 'bear' })))
+    const Component = () => {
+      expectTypeOf(useTemporal(store.temporal, (state) => state.pastStates.length)).toEqualTypeOf<number>()
+      expectTypeOf(useTemporalWithEqualityFn(store.temporal, (state) => state.isTracking, Object.is)).toEqualTypeOf<boolean>()
+      return null
+    }
+    expect(Component).toBeDefined()
+  })
+
+  it('history_types_compose_in_middleware_mutator_chains', () => {
+    const first = createStore(devtools(history(immer(() => ({ count: 0, name: 'bear' })))))
+    const second = createStore(history(subscribeWithSelector(persist(() => ({ count: 0, name: 'bear' }), { name: 'typed' }))))
+    expectTypeOf(first.temporal).toEqualTypeOf<StoreApi<TemporalState<Counter>>>()
+    expectTypeOf(second.temporal.getState().clear).toEqualTypeOf<() => void>()
+    expect(first).toBeDefined()
+    expect(second).toBeDefined()
+  })
+
+  it('history_types_preserve_main_state_setState_shape', () => {
+    const store = createStore<Counter>()(history(() => ({ count: 0, name: 'bear' })))
+    expectTypeOf<Parameters<typeof store.setState>[0]>().toMatchTypeOf<Counter | Partial<Counter> | ((state: Counter) => Counter | Partial<Counter>)>()
+    store.setState({ count: 1 })
+    expect(store.getState().count).toBe(1)
+  })
+})
diff --git a/tests/history.undo-redo.test.ts b/tests/history.undo-redo.test.ts
new file mode 100644
index 0000000..72631f6
--- /dev/null
+++ b/tests/history.undo-redo.test.ts
@@ -0,0 +1,92 @@
+import { describe, expect, it, vi } from 'vitest'
+import { history } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+
+const makeStore = () => createStore(history(() => ({ count: 0, name: 'bear' })))
+
+describe('history undo and redo', () => {
+  it('history_undo_restores_immediately_preceding_state', () => {
+    const store = makeStore()
+    store.setState({ count: 1 })
+    store.setState({ count: 2 })
+    store.temporal.getState().undo()
+    expect(store.getState().count).toBe(1)
+    expect(store.temporal.getState().pastStates.map((state) => state.count)).toEqual([0])
+  })
+
+  it('history_undo_moves_current_state_to_future', () => {
+    const store = makeStore()
+    store.setState({ count: 1 })
+    store.temporal.getState().undo()
+    expect(store.temporal.getState().futureStates.map((state) => state.count)).toEqual([1])
+  })
+
+  it('history_undo_multiple_steps_is_atomic', () => {
+    const store = makeStore()
+    store.setState({ count: 1 })
+    store.setState({ count: 2 })
+    store.setState({ count: 3 })
+    const listener = vi.fn()
+    store.subscribe(listener)
+    store.temporal.getState().undo(2)
+    expect(store.getState().count).toBe(1)
+    expect(listener).toHaveBeenCalledTimes(1)
+    expect(store.temporal.getState().futureStates.map((state) => state.count)).toEqual([3, 2])
+  })
+
+  it('history_redo_reapplies_most_recently_undone_state', () => {
+    const store = makeStore()
+    store.setState({ count: 1 })
+    store.setState({ count: 2 })
+    store.temporal.getState().undo(2)
+    store.temporal.getState().redo()
+    expect(store.getState().count).toBe(1)
