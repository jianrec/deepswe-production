+++ b/tests/history.react.test.tsx
@@ -0,0 +1,92 @@
+import { act, render, screen } from '@testing-library/react'
+import { describe, expect, it } from 'vitest'
+import { create, useTemporal } from 'zustand'
+import { history } from 'zustand/middleware'
+import { useTemporalWithEqualityFn } from 'zustand/traditional'
+
+const makeStore = () => create(history(() => ({ count: 0 })))
+
+describe('history React bindings', () => {
+  it('history_useTemporal_reads_selected_temporal_state', () => {
+    const store = makeStore()
+    function Component() {
+      const length = useTemporal(store.temporal, (state) => state.pastStates.length)
+      return <div>past:{length}</div>
+    }
+    render(<Component />)
+    expect(screen.getByText('past:0')).toBeInTheDocument()
+    act(() => store.setState({ count: 1 }))
+    expect(screen.getByText('past:1')).toBeInTheDocument()
+  })
+
+  it('history_useTemporal_rerenders_only_for_selected_slice', () => {
+    const store = makeStore()
+    let renders = 0
+    function Component() {
+      const tracking = useTemporal(store.temporal, (state) => state.isTracking)
+      renders += 1
+      return <div>{String(tracking)}</div>
+    }
+    render(<Component />)
+    act(() => store.setState({ count: 1 }))
+    expect(renders).toBe(1)
+    act(() => store.temporal.getState().pause())
+    expect(renders).toBe(2)
+  })
+
+  it('history_useTemporal_without_selector_returns_temporal_state', () => {
+    const store = makeStore()
+    function Component() {
+      const temporal = useTemporal(store.temporal)
+      return <div>{temporal.isTracking ? 'tracking' : 'paused'}</div>
+    }
+    render(<Component />)
+    expect(screen.getByText('tracking')).toBeInTheDocument()
+  })
+
+  it('history_useTemporalWithEqualityFn_honors_custom_equality', () => {
+    const store = makeStore()
+    let renders = 0
+    function Component() {
+      const length = useTemporalWithEqualityFn(
+        store.temporal,
+        (state) => state.pastStates.length,
+        () => true,
+      )
+      renders += 1
+      return <div>length:{length}</div>
+    }
+    render(<Component />)
+    act(() => store.setState({ count: 1 }))
+    expect(renders).toBe(1)
+    expect(screen.getByText('length:0')).toBeInTheDocument()
+  })
+
+  it('history_bound_store_temporal_api_drives_components', () => {
+    const store = makeStore()
+    function Component() {
+      const canUndo = useTemporal(store.temporal, (state) => state.pastStates.length > 0)
+      return <div>{canUndo ? 'can undo' : 'cannot undo'}</div>
+    }
+    render(<Component />)
+    act(() => store.setState({ count: 1 }))
+    expect(screen.getByText('can undo')).toBeInTheDocument()
+    act(() => store.temporal.getState().undo())
+    expect(screen.getByText('cannot undo')).toBeInTheDocument()
+  })
+
+  it('history_useTemporalWithEqualityFn_updates_when_equality_returns_false', () => {
+    const store = makeStore()
+    function Component() {
+      const length = useTemporalWithEqualityFn(
+        store.temporal,
+        (state) => state.pastStates.length,
+        Object.is,
+      )
+      return <div>entries:{length}</div>
+    }
+    render(<Component />)
+    act(() => store.setState({ count: 1 }))
+    expect(screen.getByText('entries:1')).toBeInTheDocument()
+  })
+})
diff --git a/tests/history.types.test.tsx b/tests/history.types.test.tsx
new file mode 100644
index 0000000..1609c07
