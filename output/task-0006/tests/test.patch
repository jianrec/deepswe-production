--- /dev/null
+++ b/tests/history.integration.test.ts
@@ -0,0 +1,87 @@
+import { describe, expect, it, vi } from 'vitest'
+import { devtools, history, persist, subscribeWithSelector } from 'zustand/middleware'
+import { immer } from 'zustand/middleware/immer'
+import { createStore } from 'zustand/vanilla'
+
+const memoryStorage = {
+  getItem: vi.fn(() => null),
+  setItem: vi.fn(),
+  removeItem: vi.fn(),
+}
+
+describe('history middleware composition', () => {
+  it('history_composes_outside_and_inside_immer', () => {
+    const outer = createStore(history(immer(() => ({ count: 0 }))))
+    outer.setState((state) => { state.count += 1 })
+    outer.temporal.getState().undo()
+    expect(outer.getState().count).toBe(0)
+
+    const inner = createStore(immer(history(() => ({ count: 0 }))))
+    inner.setState((state) => { state.count += 1 })
+    inner.temporal.getState().undo()
+    expect(inner.getState().count).toBe(0)
+  })
+
+  it('history_composes_outside_and_inside_persist', () => {
+    const outer = createStore(history(persist(() => ({ count: 0 }), { name: 'outer', storage: memoryStorage })))
+    outer.setState({ count: 1 })
+    outer.temporal.getState().undo()
+    expect(outer.getState().count).toBe(0)
+
+    const inner = createStore(persist(history(() => ({ count: 0 })), { name: 'inner', storage: memoryStorage }))
+    inner.setState({ count: 1 })
+    inner.temporal.getState().undo()
+    expect(inner.getState().count).toBe(0)
+  })
+
+  it('history_composes_outside_and_inside_subscribeWithSelector', () => {
+    const outer = createStore(history(subscribeWithSelector(() => ({ count: 0 }))))
+    const outerSpy = vi.fn()
+    outer.subscribe((state) => state.count, outerSpy)
+    outer.setState({ count: 1 })
+    outer.temporal.getState().undo()
+    expect(outerSpy).toHaveBeenCalledTimes(2)
+
+    const inner = createStore(subscribeWithSelector(history(() => ({ count: 0 }))))
+    const innerSpy = vi.fn()
+    inner.subscribe((state) => state.count, innerSpy)
+    inner.setState({ count: 1 })
+    inner.temporal.getState().undo()
+    expect(innerSpy).toHaveBeenCalledTimes(2)
+  })
+
+  it('history_composes_outside_and_inside_devtools', () => {
+    const outer = createStore(history(devtools(() => ({ count: 0 }), { enabled: false })))
+    outer.setState({ count: 1 })
+    outer.temporal.getState().undo()
+    expect(outer.getState().count).toBe(0)
+
+    const inner = createStore(devtools(history(() => ({ count: 0 })), { enabled: false }))
+    inner.setState({ count: 1 })
+    inner.temporal.getState().undo()
+    expect(inner.getState().count).toBe(0)
+  })
+
+  it('history_undo_and_redo_trigger_normal_subscriptions', () => {
+    const store = createStore(history(() => ({ count: 0 })))
+    store.setState({ count: 1 })
+    const listener = vi.fn()
+    store.subscribe(listener)
+    store.temporal.getState().undo()
+    store.temporal.getState().redo()
+    expect(listener).toHaveBeenCalledTimes(2)
+    expect(listener.mock.calls[0]?.[0]).toEqual({ count: 0 })
+    expect(listener.mock.calls[1]?.[0]).toEqual({ count: 1 })
+  })
+
+  it('history_temporal_subscribers_observe_stack_changes', () => {
+    const store = createStore(history(() => ({ count: 0 })))
+    const listener = vi.fn()
+    store.temporal.subscribe(listener)
+    store.setState({ count: 1 })
+    store.temporal.getState().undo()
+    store.temporal.getState().redo()
+    expect(listener).toHaveBeenCalledTimes(3)
+    expect(store.temporal.getState().pastStates).toHaveLength(1)
+  })
+})
diff --git a/tests/history.options.test.ts b/tests/history.options.test.ts
new file mode 100644
index 0000000..cd85b18
--- /dev/null
+++ b/tests/history.options.test.ts
@@ -0,0 +1,88 @@
+import { describe, expect, it, vi } from 'vitest'
+import type { HistoryOptions } from 'zustand/middleware'
+import { history } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+
+type State = { count: number; name: string }
+
+describe('history options', () => {
+  it('history_partialize_records_only_selected_keys', () => {
+    const store = createStore(history<State>(() => ({ count: 0, name: 'a' }), {
+      partialize: (state) => ({ count: state.count }),
+    }))
+    store.setState({ count: 1, name: 'b' })
+    expect(store.temporal.getState().pastStates).toEqual([{ count: 0 }])
+  })
+
+  it('history_partialize_restores_only_selected_keys', () => {
+    const store = createStore(history<State>(() => ({ count: 0, name: 'a' }), {
+      partialize: (state) => ({ count: state.count }),
+    }))
+    store.setState({ count: 1, name: 'b' })
+    store.temporal.getState().undo()
+    expect(store.getState()).toEqual({ count: 0, name: 'b' })
+  })
+
+  it('history_equality_skips_unchanged_tracked_slice', () => {
+    const equality = vi.fn((past: { count: number }, current: { count: number }) => past.count === current.count)
+    const options: HistoryOptions<State, { count: number }> = {
+      partialize: (state) => ({ count: state.count }),
+      equality,
+    }
+    const store = createStore(history<State>(() => ({ count: 0, name: 'a' }), options))
+    store.setState({ name: 'b' })
+    expect(equality).toHaveBeenCalledTimes(1)
+    expect(store.temporal.getState().pastStates).toEqual([])
+  })
+
+  it('history_equality_records_changed_tracked_slice', () => {
+    const options: HistoryOptions<State, { count: number }> = {
+      partialize: (state) => ({ count: state.count }),
+      equality: (past, current) => past.count === current.count,
+    }
+    const store = createStore(history<State>(() => ({ count: 0, name: 'a' }), options))
+    store.setState({ count: 1 })
+    expect(store.temporal.getState().pastStates).toEqual([{ count: 0 }])
+  })
+
+  it('history_onSave_runs_once_per_recorded_change', () => {
+    const onSave = vi.fn()
+    const store = createStore(history<State>(() => ({ count: 0, name: 'a' }), { onSave }))
+    store.setState({ count: 1 })
+    store.setState({ count: 2 })
+    expect(onSave).toHaveBeenCalledTimes(2)
+    expect(onSave).toHaveBeenNthCalledWith(1, expect.objectContaining({ count: 0 }), expect.objectContaining({ count: 1 }))
+    expect(onSave).toHaveBeenNthCalledWith(2, expect.objectContaining({ count: 1 }), expect.objectContaining({ count: 2 }))
+  })
+
+  it('history_onSave_does_not_run_for_equality_skipped_change', () => {
+    const onSave = vi.fn()
+    const store = createStore(history<State>(() => ({ count: 0, name: 'a' }), {
+      partialize: (state) => ({ count: state.count }),
+      equality: (past, current) => past.count === current.count,
+      onSave,
+    }))
+    store.setState({ name: 'b' })
+    expect(onSave).not.toHaveBeenCalled()
+  })
+
+  it('history_handleSet_wraps_main_store_updates', () => {
+    const wrappedSet = vi.fn()
+    const store = createStore(history<State>(() => ({ count: 0, name: 'a' }), {
+      handleSet: (setState) => (partial, replace) => {
+        wrappedSet()
+        return setState(partial as State, replace as true)
+      },
+    }))
+    store.setState({ count: 1 })
+    expect(wrappedSet).toHaveBeenCalledTimes(1)
+    expect(store.temporal.getState().pastStates).toHaveLength(1)
+  })
+
+  it('history_wrapTemporal_wraps_temporal_initializer', () => {
+    const wrapper = vi.fn((initializer) => initializer)
+    const store = createStore(history<State>(() => ({ count: 0, name: 'a' }), { wrapTemporal: wrapper }))
+    expect(wrapper).toHaveBeenCalledTimes(1)
+    expect(store.temporal.getState().isTracking).toBe(true)
+  })
+})
diff --git a/tests/history.react.test.tsx b/tests/history.react.test.tsx
