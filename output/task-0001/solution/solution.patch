--- /dev/null
+++ b/api/src/daily-coding-challenge/utils/streak.ts
@@ -0,0 +1,114 @@
+import { computeStreak, type StreakResult } from '../../utils/streak.js';
+
+export interface DailyCodingChallengeCompletion {
+  completedDate: number;
+}
+
+export interface PersistedDailyCodingChallengeStreak {
+  currentDailyCodingChallengeStreak?: number | null;
+  longestDailyCodingChallengeStreak?: number | null;
+  lastDailyCodingChallengeCompletionDay?: string | null;
+}
+
+export interface DailyCodingChallengeStreakUpdate {
+  currentDailyCodingChallengeStreak: number;
+  longestDailyCodingChallengeStreak: number;
+  lastDailyCodingChallengeCompletionDay: string | null;
+}
+
+export const EMPTY_DAILY_CODING_CHALLENGE_STREAK: StreakResult = Object.freeze({
+  currentStreak: 0,
+  longestStreak: 0,
+  lastCompletionDay: null
+});
+
+/** Extract completion timestamps without exposing persistence details. */
+export function getDailyCodingChallengeCompletionDays(
+  completions: ReadonlyArray<DailyCodingChallengeCompletion>
+): number[] {
+  return completions.map(({ completedDate }) => completedDate);
+}
+
+/** Derive the canonical streak from the complete persisted history. */
+export function computeDailyCodingChallengeStreak(
+  completions: ReadonlyArray<DailyCodingChallengeCompletion>,
+  now: number | string | Date = new Date()
+): StreakResult {
+  return computeStreak(getDailyCodingChallengeCompletionDays(completions), now);
+}
+
+/** Map the public result to the additive Prisma user fields. */
+export function toDailyCodingChallengeStreakUpdate(
+  streak: StreakResult
+): DailyCodingChallengeStreakUpdate {
+  return {
+    currentDailyCodingChallengeStreak: streak.currentStreak,
+    longestDailyCodingChallengeStreak: streak.longestStreak,
+    lastDailyCodingChallengeCompletionDay: streak.lastCompletionDay
+  };
+}
+
+function normalizeCount(value: number | null | undefined): number {
+  return Number.isInteger(value) && value != null && value >= 0 ? value : 0;
+}
+
+/**
+ * Convert nullable legacy persistence fields to the stable public response.
+ * The invariants are enforced even for records written before this feature.
+ */
+export function fromPersistedDailyCodingChallengeStreak(
+  persisted: PersistedDailyCodingChallengeStreak | null | undefined
+): StreakResult {
+  if (!persisted) return { ...EMPTY_DAILY_CODING_CHALLENGE_STREAK };
+
+  const currentStreak = normalizeCount(
+    persisted.currentDailyCodingChallengeStreak
+  );
+  const longestStreak = Math.max(
+    currentStreak,
+    normalizeCount(persisted.longestDailyCodingChallengeStreak)
+  );
+  const lastCompletionDay =
+    typeof persisted.lastDailyCodingChallengeCompletionDay === 'string'
+      ? persisted.lastDailyCodingChallengeCompletionDay
+      : null;
+
+  return { currentStreak, longestStreak, lastCompletionDay };
+}
+
+function sameStreak(left: StreakResult, right: StreakResult): boolean {
+  return (
+    left.currentStreak === right.currentStreak &&
+    left.longestStreak === right.longestStreak &&
+    left.lastCompletionDay === right.lastCompletionDay
+  );
+}
+
+/**
+ * Resolve a response from history, falling back to persisted values only when
+ * a caller intentionally omits the history. This keeps existing users correct
+ * before they submit their next challenge and repairs stale derived fields.
+ */
+export function resolveDailyCodingChallengeStreak(
+  completions: ReadonlyArray<DailyCodingChallengeCompletion> | undefined,
+  persisted: PersistedDailyCodingChallengeStreak | null | undefined,
+  now: number | string | Date = new Date()
+): StreakResult {
+  if (completions) {
+    return computeDailyCodingChallengeStreak(completions, now);
+  }
+
+  return fromPersistedDailyCodingChallengeStreak(persisted);
+}
+
+/** Return true when a history-derived value should be written to the user. */
+export function dailyCodingChallengeStreakNeedsUpdate(
+  completions: ReadonlyArray<DailyCodingChallengeCompletion>,
+  persisted: PersistedDailyCodingChallengeStreak | null | undefined,
+  now: number | string | Date = new Date()
+): boolean {
+  return !sameStreak(
+    computeDailyCodingChallengeStreak(completions, now),
+    fromPersistedDailyCodingChallengeStreak(persisted)
+  );
+}
