diff --git a/api/src/utils/streak.ts b/api/src/utils/streak.ts
new file mode 100644
index 00000000..ea15961d
--- /dev/null
+++ b/api/src/utils/streak.ts
@@ -0,0 +1,258 @@
+/**
+ * Values returned by the Daily Coding Challenge streak calculator.
+ */
+export interface StreakResult {
+  currentStreak: number;
+  longestStreak: number;
+  lastCompletionDay: string | null;
+}
+
+/** A supported completion timestamp or UTC calendar day. */
+export type StreakInput = number | string | Date;
+
+interface CompletionRun {
+  start: number;
+  end: number;
+  length: number;
+}
+
+/** A canonical consecutive run, suitable for diagnostics and backfills. */
+export interface StreakRun {
+  startDay: string;
+  endDay: string;
+  length: number;
+}
+
+/** Normalized completion history with its consecutive runs. */
+export interface StreakTimeline {
+  completionDays: string[];
+  runs: StreakRun[];
+}
+
+const UTC_DAY_PATTERN = /^(\d{4})-(\d{2})-(\d{2})$/;
+const MS_PER_DAY = 86_400_000;
+
+function dateFromInput(input: StreakInput): Date {
+  if (input instanceof Date) {
+    return new Date(input.getTime());
+  }
+
+  if (typeof input === 'number' && !Number.isFinite(input)) {
+    throw new TypeError('Completion timestamps must be finite numbers.');
+  }
+
+  const date = new Date(input);
+  if (Number.isNaN(date.getTime())) {
+    throw new TypeError('Completion timestamps must be valid dates.');
+  }
+
+  return date;
+}
+
+function padDatePart(value: number): string {
+  return String(value).padStart(2, '0');
+}
+
+function formatUtcDay(date: Date): string {
+  return [
+    String(date.getUTCFullYear()).padStart(4, '0'),
+    padDatePart(date.getUTCMonth() + 1),
+    padDatePart(date.getUTCDate())
+  ].join('-');
+}
+
+function validateUtcDayString(day: string): string {
+  const match = UTC_DAY_PATTERN.exec(day);
+  if (!match) {
+    throw new TypeError('Completion day strings must use YYYY-MM-DD.');
+  }
+
+  const year = Number(match[1]);
+  const month = Number(match[2]);
+  const date = Number(match[3]);
+  const parsed = new Date(Date.UTC(year, month - 1, date));
+
+  if (
+    parsed.getUTCFullYear() !== year ||
+    parsed.getUTCMonth() !== month - 1 ||
+    parsed.getUTCDate() !== date
+  ) {
+    throw new TypeError('Completion day strings must be real UTC dates.');
+  }
+
+  return day;
+}
+
+/**
+ * Convert a timestamp, Date, ISO timestamp, or UTC date string to YYYY-MM-DD.
+ * Invalid dates fail loudly so corrupt completion data cannot alter a streak.
+ */
+export function toUtcDayString(input: StreakInput): string {
+  if (typeof input === 'string' && UTC_DAY_PATTERN.test(input)) {
+    return validateUtcDayString(input);
+  }
+
+  return formatUtcDay(dateFromInput(input));
+}
+
+/** Convert a validated YYYY-MM-DD value to a UTC day ordinal. */
+export function utcDayToOrdinal(day: string): number {
+  const validDay = validateUtcDayString(day);
+  const [year, month, date] = validDay.split('-').map(Number) as [
+    number,
+    number,
+    number
+  ];
+
+  return Math.floor(Date.UTC(year, month - 1, date) / MS_PER_DAY);
+}
+
+/** Convert a UTC day ordinal back to the canonical YYYY-MM-DD form. */
+export function ordinalToUtcDay(ordinal: number): string {
+  if (!Number.isInteger(ordinal)) {
+    throw new TypeError('UTC day ordinals must be integers.');
+  }
+
+  return formatUtcDay(new Date(ordinal * MS_PER_DAY));
+}
+
+/**
+ * Normalize, deduplicate, and sort completion inputs by UTC calendar day.
+ */
+export function normalizeCompletionDays(
+  completions: ReadonlyArray<StreakInput>
+): string[] {
+  if (!Array.isArray(completions)) {
+    throw new TypeError('Completions must be an array.');
+  }
+
+  return [...new Set(completions.map(toUtcDayString))].sort();
+}
+
+function collectRuns(ordinals: readonly number[]): CompletionRun[] {
+  if (ordinals.length === 0) return [];
+
+  const runs: CompletionRun[] = [];
+  let start = ordinals[0]!;
+  let previous = start;
+
+  for (const ordinal of ordinals.slice(1)) {
+    if (ordinal === previous + 1) {
+      previous = ordinal;
+      continue;
+    }
+
+    runs.push({ start, end: previous, length: previous - start + 1 });
+    start = ordinal;
+    previous = ordinal;
+  }
+
+  runs.push({ start, end: previous, length: previous - start + 1 });
+  return runs;
+}
+
+/**
+ * Build the canonical timeline used by the streak summary. Exposing this
+ * representation lets migration and debugging code inspect gaps without
+ * reimplementing UTC normalization.
+ */
+export function buildStreakTimeline(
+  completions: ReadonlyArray<StreakInput>
+): StreakTimeline {
+  const completionDays = normalizeCompletionDays(completions);
+  const ordinalRuns = collectRuns(completionDays.map(utcDayToOrdinal));
+  const runs = ordinalRuns.map(({ start, end, length }) => ({
+    startDay: ordinalToUtcDay(start),
+    endDay: ordinalToUtcDay(end),
+    length
+  }));
+
+  return { completionDays, runs };
+}
+
+/** Return a new UTC day string shifted by a whole number of days. */
+export function shiftUtcDay(day: string, amount: number): string {
+  if (!Number.isInteger(amount)) {
+    throw new TypeError('UTC day shifts must be integers.');
+  }
+
+  return ordinalToUtcDay(utcDayToOrdinal(day) + amount);
+}
+
+function longestRun(runs: readonly CompletionRun[]): number {
+  return runs.reduce((longest, run) => Math.max(longest, run.length), 0);
+}
+
+function currentRun(
+  runs: readonly CompletionRun[],
+  todayOrdinal: number
+): number {
+  const latest = runs.at(-1);
+  if (!latest) return 0;
+
+  const isCurrent =
+    latest.end === todayOrdinal || latest.end === todayOrdinal - 1;
+  return isCurrent ? latest.length : 0;
+}
+
+/**
+ * Validate invariants before a result crosses a schema or persistence
+ * boundary. This is intentionally exported for one-off repair jobs.
+ */
+export function assertValidStreakResult(
+  result: StreakResult
+): asserts result is StreakResult {
+  const counts = [result.currentStreak, result.longestStreak];
+  if (counts.some(value => !Number.isInteger(value) || value < 0)) {
+    throw new TypeError('Streak counts must be non-negative integers.');
+  }
+
+  if (result.currentStreak > result.longestStreak) {
+    throw new TypeError('The current streak cannot exceed the longest streak.');
+  }
+
+  if (result.lastCompletionDay !== null) {
+    validateUtcDayString(result.lastCompletionDay);
+  }
+
+  if (result.longestStreak === 0 && result.lastCompletionDay !== null) {
+    throw new TypeError('An empty streak cannot have a last completion day.');
+  }
+
+  if (result.longestStreak > 0 && result.lastCompletionDay === null) {
+    throw new TypeError('A non-empty streak requires a last completion day.');
+  }
+}
+
+/**
+ * Compute Daily Coding Challenge streaks from completion timestamps.
+ *
+ * A UTC calendar day can contribute at most once. The current streak remains
+ * active when its last completion is today or yesterday, and expires only
+ * after a full missed UTC day. The longest streak is independent of recency.
+ *
+ * `now` is injectable so tests, migrations, and backfills remain deterministic.
+ */
+export function computeStreak(
+  completions: ReadonlyArray<StreakInput>,
+  now: StreakInput = new Date()
+): StreakResult {
+  const days = normalizeCompletionDays(completions);
+  if (days.length === 0) {
+    return { currentStreak: 0, longestStreak: 0, lastCompletionDay: null };
+  }
+
+  const ordinals = days.map(utcDayToOrdinal);
+  const runs = collectRuns(ordinals);
+  const todayOrdinal = utcDayToOrdinal(toUtcDayString(now));
+  const currentStreak = currentRun(runs, todayOrdinal);
+  const longestStreak = longestRun(runs);
+
+  const result = {
+    currentStreak,
+    longestStreak: Math.max(currentStreak, longestStreak),
+    lastCompletionDay: days.at(-1)!
+  };
+  assertValidStreakResult(result);
+  return result;
+}
