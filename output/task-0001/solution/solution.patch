+  currentStreak: nonNegativeInteger,
+  longestStreak: nonNegativeInteger,
+  lastCompletionDay: nullableCompletionDay
+};
+
+/** Optional form for additive fields on existing challenge GET responses. */
+export const optionalDailyCodingChallengeStreakProperties = {
+  currentStreak: Type.Optional(nonNegativeInteger),
+  longestStreak: Type.Optional(nonNegativeInteger),
+  lastCompletionDay: Type.Optional(nullableCompletionDay)
+};
+
+export const dailyCodingChallengeStreakSchema = Type.Object(
+  dailyCodingChallengeStreakProperties
+);
+
+export type DailyCodingChallengeStreakResponse = Static<
+  typeof dailyCodingChallengeStreakSchema
+>;
