index 00000000..903a5d06
--- /dev/null
+++ b/api/src/utils/streak.boundary.test.ts
@@ -0,0 +1,97 @@
+import { describe, it, expect } from 'vitest';
+import { computeStreak } from './streak.js';
+
+const DAY_MS = 86400000;
+const toUtcDay = (d: Date) => d.toISOString().slice(0, 10);
+
+describe('computeStreak boundary and timezone edge cases', () => {
+  it('completion at exact UTC midnight boundary counts as that day', () => {
+    // 2025-06-15T00:00:00.000Z
+    const midnight = new Date('2025-06-15T00:00:00.000Z');
+    const result = computeStreak([midnight.getTime()]);
+    expect(result.lastCompletionDay).toBe('2025-06-15');
+  });
+
+  it('completion one ms before UTC midnight counts as previous day', () => {
+    const justBefore = new Date('2025-06-15T23:59:59.999Z');
+    const result = computeStreak([justBefore.getTime()]);
+    expect(result.lastCompletionDay).toBe('2025-06-15');
+  });
+
+  it('two completions on same UTC day different local times deduplicate', () => {
+    const day1a = new Date('2025-06-15T01:00:00.000Z').getTime();
+    const day1b = new Date('2025-06-15T23:00:00.000Z').getTime();
+    const result = computeStreak([day1a, day1b]);
+    expect(result.currentStreak).toBeLessThanOrEqual(1);
+    expect(result.longestStreak).toBe(1);
+  });
+
+  it('consecutive UTC days across month boundary', () => {
+    const jan31 = new Date('2025-01-31T12:00:00.000Z').getTime();
+    const feb1 = new Date('2025-02-01T12:00:00.000Z').getTime();
+    const result = computeStreak([jan31, feb1]);
+    expect(result.longestStreak).toBe(2);
+  });
+
+  it('consecutive UTC days across year boundary', () => {
+    const dec31 = new Date('2024-12-31T12:00:00.000Z').getTime();
+    const jan1 = new Date('2025-01-01T12:00:00.000Z').getTime();
+    const result = computeStreak([dec31, jan1]);
+    expect(result.longestStreak).toBe(2);
+  });
+
+  it('leap year Feb 29 handled correctly', () => {
+    const feb28 = new Date('2024-02-28T12:00:00.000Z').getTime();
+    const feb29 = new Date('2024-02-29T12:00:00.000Z').getTime();
+    const mar1 = new Date('2024-03-01T12:00:00.000Z').getTime();
+    const result = computeStreak([feb28, feb29, mar1]);
+    expect(result.longestStreak).toBe(3);
+  });
+
+  it('empty array returns deterministic zero state', () => {
+    const r1 = computeStreak([]);
+    const r2 = computeStreak([]);
+    expect(r1).toEqual(r2);
+    expect(r1.currentStreak).toBe(0);
+    expect(r1.longestStreak).toBe(0);
+    expect(r1.lastCompletionDay).toBeNull();
+  });
+
+  it('single element array always yields longestStreak 1', () => {
+    const result = computeStreak([new Date('2020-03-15T00:00:00Z').getTime()]);
+    expect(result.longestStreak).toBe(1);
+  });
+
+  it('currentStreak 0 when gap of exactly 2 days from today', () => {
+    const twoDaysAgo = toUtcDay(new Date(Date.now() - 2 * DAY_MS));
+    const result = computeStreak([twoDaysAgo]);
+    expect(result.currentStreak).toBe(0);
+  });
+
+  it('currentStreak 1 when gap of exactly 1 day from today (yesterday)', () => {
+    const yesterday = toUtcDay(new Date(Date.now() - 1 * DAY_MS));
+    const result = computeStreak([yesterday]);
+    expect(result.currentStreak).toBe(1);
+  });
+
+  it('very long streak (365 days) computes correctly', () => {
+    const days: string[] = [];
+    for (let i = 0; i < 365; i++) {
+      days.push(toUtcDay(new Date(Date.now() - i * DAY_MS)));
+    }
+    const result = computeStreak(days);
+    expect(result.currentStreak).toBe(365);
+    expect(result.longestStreak).toBe(365);
+  });
+
+  it('interleaved duplicates in long streak do not affect result', () => {
+    const days: string[] = [];
+    for (let i = 0; i < 30; i++) {
+      const d = toUtcDay(new Date(Date.now() - i * DAY_MS));
+      days.push(d, d, d);
+    }
+    const result = computeStreak(days);
+    expect(result.currentStreak).toBe(30);
+    expect(result.longestStreak).toBe(30);
+  });
+});
diff --git a/api/src/utils/streak.property.test.ts b/api/src/utils/streak.property.test.ts
new file mode 100644
index 00000000..24dac6ba
--- /dev/null
+++ b/api/src/utils/streak.property.test.ts
@@ -0,0 +1,97 @@
+import { describe, it, expect } from 'vitest';
+import { computeStreak } from './streak.js';
+
+const DAY_MS = 86400000;
+const toUtcDay = (d: Date) => d.toISOString().slice(0, 10);
+
+// Deterministic PRNG (xorshift32)
+function createRng(seed: number) {
+  let state = seed >>> 0;
+  return () => {
+    state ^= state << 13;
+    state ^= state >> 17;
+    state ^= state << 5;
+    return (state >>> 0) / 4294967296;
+  };
+}
+
+function generateCompletionDays(
+  rng: () => number,
+  count: number,
+  maxDaysAgo: number
+): string[] {
+  const days: string[] = [];
+  for (let i = 0; i < count; i++) {
+    const daysAgo = Math.floor(rng() * maxDaysAgo);
+    const d = new Date(Date.now() - daysAgo * DAY_MS);
+    days.push(toUtcDay(d));
+  }
+  return days;
+}
+
+describe('computeStreak property-based regression suite', () => {
+  const seeds = Array.from({ length: 50 }, (_, i) => i * 7 + 13);
+
+  for (const seed of seeds) {
+    it(`seed=${seed}: streak invariants hold`, () => {
+      const rng = createRng(seed);
+      const days = generateCompletionDays(
+        rng,
+        20 + Math.floor(rng() * 30),
+        400
+      );
+      const result = computeStreak(days);
+
+      // Non-negative integers
+      expect(result.currentStreak).toBeGreaterThanOrEqual(0);
+      expect(result.longestStreak).toBeGreaterThanOrEqual(0);
+      expect(Number.isInteger(result.currentStreak)).toBe(true);
+      expect(Number.isInteger(result.longestStreak)).toBe(true);
+
+      // longest >= current
+      expect(result.longestStreak).toBeGreaterThanOrEqual(result.currentStreak);
+
+      // lastCompletionDay format or null
+      if (result.lastCompletionDay !== null) {
+        expect(result.lastCompletionDay).toMatch(/^\d{4}-\d{2}-\d{2}$/);
+      }
+
+      // Idempotency: duplicating all entries yields same result
+      const duplicated = [...days, ...days];
+      const resultDup = computeStreak(duplicated);
+      expect(resultDup).toEqual(result);
+
+      // Adding a very old day doesn't increase currentStreak
+      const veryOld = toUtcDay(new Date(Date.now() - 1000 * DAY_MS));
+      const withOld = computeStreak([...days, veryOld]);
+      expect(withOld.currentStreak).toBeLessThanOrEqual(result.currentStreak);
+    });
+  }
+
+  const edgeSeeds = Array.from({ length: 50 }, (_, i) => i * 31 + 997);
+  for (const seed of edgeSeeds) {
+    it(`edge-seed=${seed}: boundary and duplicate stress`, () => {
+      const rng = createRng(seed);
+      // Generate many duplicates of few days
+      const uniqueCount = 1 + Math.floor(rng() * 5);
+      const baseDays: string[] = [];
+      for (let i = 0; i < uniqueCount; i++) {
+        const daysAgo = Math.floor(rng() * 10);
+        baseDays.push(toUtcDay(new Date(Date.now() - daysAgo * DAY_MS)));
+      }
+      // Duplicate each 3-10 times
+      const expanded: string[] = [];
+      for (const d of baseDays) {
+        const reps = 3 + Math.floor(rng() * 8);
+        for (let r = 0; r < reps; r++) expanded.push(d);
+      }
+
+      const result = computeStreak(expanded);
+      const resultUnique = computeStreak(baseDays);
+
+      expect(result).toEqual(resultUnique);
+      expect(result.currentStreak).toBeGreaterThanOrEqual(0);
+      expect(result.longestStreak).toBeGreaterThanOrEqual(result.currentStreak);
+    });
+  }
+});
