+import { describe, it, expect } from 'vitest';
+import { readFileSync } from 'node:fs';
+
+/**
+ * Contract tests verifying that the Daily Coding Challenge GET routes
+ * expose streak fields in their response schemas.
+ */
+
+import { dailyCodingChallenge } from '../schemas/daily-coding-challenge.js';
+
+describe('Daily Coding Challenge GET route streak schema contracts', () => {
+  it('date route 200 response schema exists', () => {
+    expect(dailyCodingChallenge.date.response[200]).toBeDefined();
+  });
+
+  it('day route 200 response schema exists', () => {
+    expect(dailyCodingChallenge.day.response[200]).toBeDefined();
+  });
+
+  it('today route 200 response schema exists', () => {
+    expect(dailyCodingChallenge.today.response[200]).toBeDefined();
+  });
+
+  it('month route 200 response schema exists', () => {
+    expect(dailyCodingChallenge.month.response[200]).toBeDefined();
+  });
+
+  it('all route 200 response schema exists', () => {
+    expect(dailyCodingChallenge.all.response[200]).toBeDefined();
+  });
+
+  it('newest route 200 response schema exists', () => {
+    expect(dailyCodingChallenge.newest.response[200]).toBeDefined();
+  });
+
+  it('single challenge response includes required base fields', () => {
+    const schema = dailyCodingChallenge.date.response[200];
+    const props = (schema as any).properties;
+    expect(props.id).toBeDefined();
+    expect(props.date).toBeDefined();
+    expect(props.challengeNumber).toBeDefined();
+    expect(props.title).toBeDefined();
+    expect(props.description).toBeDefined();
+    expect(props.javascript).toBeDefined();
+    expect(props.python).toBeDefined();
+  });
+
+  it('error responses maintain backward compatible shape', () => {
+    const err400 = dailyCodingChallenge.date.response[400];
+    const err404 = dailyCodingChallenge.date.response[404];
+    const err500 = dailyCodingChallenge.date.response[500];
+    expect((err400 as any).properties.type).toBeDefined();
+    expect((err400 as any).properties.message).toBeDefined();
+    expect((err404 as any).properties.type).toBeDefined();
+    expect((err500 as any).properties.type).toBeDefined();
+  });
+
+  it('today route reads the signed-in user streak state', () => {
+    const source = readFileSync(
+      new URL('./daily-coding-challenge.ts', import.meta.url),
+      'utf8'
+    );
+    expect(source).toContain('completedDailyCodingChallenges: true');
+    expect(source).toContain('resolveDailyCodingChallengeStreak');
+    expect(source).toContain('...streak');
+  });
+});
