+import { describe, it, expect } from 'vitest';
+import { computeStreak } from './streak.js';
+
+const DAY_MS = 86400000;
+const toUtcDay = (d: Date) => d.toISOString().slice(0, 10);
+const daysAgo = (n: number) => new Date(Date.now() - n * DAY_MS);
+
+describe('computeStreak pure utility', () => {
+  it('returns zeros and null for empty history', () => {
+    const result = computeStreak([]);
+    expect(result.currentStreak).toBe(0);
+    expect(result.longestStreak).toBe(0);
+    expect(result.lastCompletionDay).toBeNull();
+  });
+
+  it('handles single completion today', () => {
+    const today = toUtcDay(new Date());
+    const result = computeStreak([today]);
+    expect(result.currentStreak).toBe(1);
+    expect(result.longestStreak).toBe(1);
+    expect(result.lastCompletionDay).toBe(today);
+  });
+
+  it('handles single completion yesterday', () => {
+    const yesterday = toUtcDay(daysAgo(1));
+    const result = computeStreak([yesterday]);
+    expect(result.currentStreak).toBe(1);
+    expect(result.longestStreak).toBe(1);
+    expect(result.lastCompletionDay).toBe(yesterday);
+  });
+
+  it('returns currentStreak 0 when last completion is older than yesterday', () => {
+    const twoDaysAgo = toUtcDay(daysAgo(2));
+    const result = computeStreak([twoDaysAgo]);
+    expect(result.currentStreak).toBe(0);
+    expect(result.longestStreak).toBe(1);
+    expect(result.lastCompletionDay).toBe(twoDaysAgo);
+  });
+
+  it('counts consecutive days ending today correctly', () => {
+    const days = [0, 1, 2, 3].map(n => toUtcDay(daysAgo(n)));
+    const result = computeStreak(days);
+    expect(result.currentStreak).toBe(4);
+    expect(result.longestStreak).toBe(4);
+  });
+
+  it('counts consecutive days ending yesterday correctly', () => {
+    const days = [1, 2, 3, 4].map(n => toUtcDay(daysAgo(n)));
+    const result = computeStreak(days);
+    expect(result.currentStreak).toBe(4);
+    expect(result.longestStreak).toBe(4);
+  });
+
+  it('deduplicates same-day completions', () => {
+    const today = toUtcDay(new Date());
+    const result = computeStreak([today, today, today]);
+    expect(result.currentStreak).toBe(1);
+    expect(result.longestStreak).toBe(1);
+  });
+
+  it('computes longestStreak across gaps', () => {
+    const base = new Date('2025-01-10T00:00:00Z');
+    const days = [
+      toUtcDay(new Date(base.getTime() - 0 * DAY_MS)),
+      toUtcDay(new Date(base.getTime() - 1 * DAY_MS)),
+      toUtcDay(new Date(base.getTime() - 2 * DAY_MS)),
+      // gap
+      toUtcDay(new Date(base.getTime() - 5 * DAY_MS)),
+      toUtcDay(new Date(base.getTime() - 6 * DAY_MS)),
+      toUtcDay(new Date(base.getTime() - 7 * DAY_MS)),
+      toUtcDay(new Date(base.getTime() - 8 * DAY_MS))
+    ];
+    const result = computeStreak(days);
+    expect(result.longestStreak).toBe(4);
+    expect(result.currentStreak).toBe(0); // old dates
+  });
+
+  it('longestStreak >= currentStreak always', () => {
+    const days = [0, 1, 3, 4, 5, 6].map(n => toUtcDay(daysAgo(n)));
+    const result = computeStreak(days);
+    expect(result.longestStreak).toBeGreaterThanOrEqual(result.currentStreak);
+  });
+
+  it('handles timestamps as numbers (ms since epoch)', () => {
+    const now = Date.now();
+    const result = computeStreak([now, now - DAY_MS, now - 2 * DAY_MS]);
+    expect(result.currentStreak).toBe(3);
+    expect(result.longestStreak).toBe(3);
+  });
+
+  it('handles mixed timestamp formats', () => {
+    const today = toUtcDay(new Date());
+    const yesterdayMs = Date.now() - DAY_MS;
+    const result = computeStreak([today, yesterdayMs]);
+    expect(result.currentStreak).toBe(2);
+  });
+
+  it('is idempotent for duplicate inputs', () => {
+    const days = [0, 1, 2].map(n => toUtcDay(daysAgo(n)));
+    const r1 = computeStreak(days);
+    const r2 = computeStreak([...days, ...days]);
+    expect(r1).toEqual(r2);
+  });
+
+  it('never returns negative streaks', () => {
+    const result = computeStreak(['2020-01-01']);
+    expect(result.currentStreak).toBeGreaterThanOrEqual(0);
+    expect(result.longestStreak).toBeGreaterThanOrEqual(0);
+  });
+
+  it('returns integer streak values', () => {
+    const days = [0, 1, 2, 4, 5].map(n => toUtcDay(daysAgo(n)));
+    const result = computeStreak(days);
+    expect(Number.isInteger(result.currentStreak)).toBe(true);
+    expect(Number.isInteger(result.longestStreak)).toBe(true);
+  });
+
+  it('lastCompletionDay is ISO date string format YYYY-MM-DD', () => {
+    const result = computeStreak([Date.now()]);
+    expect(result.lastCompletionDay).toMatch(/^\d{4}-\d{2}-\d{2}$/);
+  });
+
+  it('handles unsorted input', () => {
+    const days = [2, 0, 1].map(n => toUtcDay(daysAgo(n)));
+    const result = computeStreak(days);
+    expect(result.currentStreak).toBe(3);
+    expect(result.longestStreak).toBe(3);
+  });
+
+  it('handles large gap between completions', () => {
+    const days = [toUtcDay(daysAgo(0)), toUtcDay(daysAgo(365))];
+    const result = computeStreak(days);
+    expect(result.currentStreak).toBe(1);
+    expect(result.longestStreak).toBe(1);
+  });
+
+  it('timezone boundary: UTC day change does not leak local time', () => {
+    // A timestamp that is "tomorrow" in some timezone but still today in UTC
+    const utcNow = new Date();
+    const utcTodayStr = toUtcDay(utcNow);
+    const result = computeStreak([utcTodayStr]);
+    expect(result.lastCompletionDay).toBe(utcTodayStr);
+  });
+
+  it('property: adding an older day never increases currentStreak', () => {
+    const days = [0, 1, 2].map(n => toUtcDay(daysAgo(n)));
+    const before = computeStreak(days);
+    const after = computeStreak([...days, toUtcDay(daysAgo(10))]);
+    expect(after.currentStreak).toBe(before.currentStreak);
+  });
+
+  it('property: adding a duplicate day never changes streak values', () => {
+    const days = [0, 1, 2, 3].map(n => toUtcDay(daysAgo(n)));
+    const before = computeStreak(days);
+    const after = computeStreak([...days, days[0]!]);
+    expect(after).toEqual(before);
+  });
+
+  it('property: longestStreak is monotonic with added unique consecutive days', () => {
+    const days = [3, 2, 1].map(n => toUtcDay(daysAgo(n)));
+    const r1 = computeStreak(days);
+    const r2 = computeStreak([...days, toUtcDay(daysAgo(0))]);
+    expect(r2.longestStreak).toBeGreaterThanOrEqual(r1.longestStreak);
+  });
+});
