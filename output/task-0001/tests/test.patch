@@ -0,0 +1,109 @@
+import { describe, it, expect } from 'vitest';
+import { computeStreak } from './streak.js';
+
+const DAY_MS = 86400000;
+const toUtcDay = (d: Date) => d.toISOString().slice(0, 10);
+
+/**
+ * Regression tests ensuring specific known scenarios produce correct results.
+ * These serve as pinned acceptance criteria checks.
+ */
+describe('computeStreak regression pinning tests', () => {
+  it('AC: empty history yields zeros and null', () => {
+    const r = computeStreak([]);
+    expect(r).toEqual({
+      currentStreak: 0,
+      longestStreak: 0,
+      lastCompletionDay: null
+    });
+  });
+
+  it('AC: duplicate completions same day do not increase streak', () => {
+    const today = toUtcDay(new Date());
+    const r = computeStreak([today, today, today, today]);
+    expect(r.currentStreak).toBe(1);
+    expect(r.longestStreak).toBe(1);
+  });
+
+  it('AC: currentStreak counts consecutive ending today', () => {
+    const days = [0, 1, 2].map(n =>
+      toUtcDay(new Date(Date.now() - n * DAY_MS))
+    );
+    const r = computeStreak(days);
+    expect(r.currentStreak).toBe(3);
+  });
+
+  it('AC: currentStreak counts consecutive ending yesterday', () => {
+    const days = [1, 2, 3].map(n =>
+      toUtcDay(new Date(Date.now() - n * DAY_MS))
+    );
+    const r = computeStreak(days);
+    expect(r.currentStreak).toBe(3);
+  });
+
+  it('AC: currentStreak 0 when latest > yesterday', () => {
+    const old = toUtcDay(new Date(Date.now() - 3 * DAY_MS));
+    const r = computeStreak([old]);
+    expect(r.currentStreak).toBe(0);
+  });
+
+  it('AC: longestStreak equals max consecutive run', () => {
+    const base = new Date('2025-03-01T00:00:00Z');
+    const days = [
+      toUtcDay(new Date(base.getTime())),
+      toUtcDay(new Date(base.getTime() + DAY_MS)),
+      toUtcDay(new Date(base.getTime() + 2 * DAY_MS)),
+      // gap
+      toUtcDay(new Date(base.getTime() + 5 * DAY_MS)),
+      toUtcDay(new Date(base.getTime() + 6 * DAY_MS))
+    ];
+    const r = computeStreak(days);
+    expect(r.longestStreak).toBe(3);
+  });
+
+  it('AC: longestStreak >= currentStreak invariant', () => {
+    const days = [0, 1, 5, 6, 7, 8, 9].map(n =>
+      toUtcDay(new Date(Date.now() - n * DAY_MS))
+    );
+    const r = computeStreak(days);
+    expect(r.longestStreak).toBeGreaterThanOrEqual(r.currentStreak);
+  });
+
+  it('AC: recomputation idempotency', () => {
+    const days = [0, 1, 2, 3].map(n =>
+      toUtcDay(new Date(Date.now() - n * DAY_MS))
+    );
+    const r1 = computeStreak(days);
+    const r2 = computeStreak([...days, days[0]!, days[1]!]);
+    expect(r1).toEqual(r2);
+  });
+
+  it('AC: accepts numeric timestamps', () => {
+    const now = Date.now();
+    const r = computeStreak([now, now - DAY_MS]);
+    expect(r.currentStreak).toBe(2);
+    expect(r.longestStreak).toBe(2);
+  });
+
+  it('AC: accepts ISO date strings', () => {
+    const today = toUtcDay(new Date());
+    const r = computeStreak([today]);
+    expect(r.lastCompletionDay).toBe(today);
+  });
+
+  it('AC: streak values are non-negative integers', () => {
+    const r = computeStreak([Date.now()]);
+    expect(Number.isInteger(r.currentStreak)).toBe(true);
+    expect(Number.isInteger(r.longestStreak)).toBe(true);
+    expect(r.currentStreak).toBeGreaterThanOrEqual(0);
+    expect(r.longestStreak).toBeGreaterThanOrEqual(0);
+  });
+
+  it('AC: lastCompletionDay is YYYY-MM-DD or null', () => {
+    const r1 = computeStreak([]);
+    expect(r1.lastCompletionDay).toBeNull();
+
+    const r2 = computeStreak([Date.now()]);
+    expect(r2.lastCompletionDay).toMatch(/^\d{4}-\d{2}-\d{2}$/);
+  });
+});
diff --git a/api/src/utils/streak.test.ts b/api/src/utils/streak.test.ts
