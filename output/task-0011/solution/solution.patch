+// Co-located re-exports for the computed feature, mirroring `src/shallow.ts`.
+//
+// This module surfaces both halves of the computed feature from a single
+// import path:
+//
+//   - `computed` and `ComputedOptions` come from the vanilla middleware layer
+//     (`src/middleware/computed.ts`). `computed` wraps a state creator with a
+//     `compute(state) => C` function whose result is merged read-only into the
+//     store state so computed keys are visible through `getState()`, selectors,
+//     and every existing consumer.
+//
+//   - `useComputed` comes from the React layer (`src/react/computed.ts`). It
+//     derives a value from a store inside a component, memoizing across renders
+//     with an equality function (default `shallow`) and is concurrent-safe via
+//     `useSyncExternalStore`.
+//
+// Both are built on the same shared memoization core in
+// `src/vanilla/shallow.ts` (`createComputeMemo`) so referential stability is
+// consistent between the store layer and the React layer.
+
+export { computed, type ComputedOptions } from './middleware/computed.ts'
+export { useComputed } from './react/computed.ts'
