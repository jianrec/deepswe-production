+/**
+ * Shared type-level helpers used by the computed middleware public signature.
+ *
+ * These aliases are declared globally (ambient) so that the middleware's public
+ * types can reference a single canonical implementation without importing it at
+ * runtime. They intentionally do not affect any existing public API surface or
+ * runtime behavior; they only provide precise inference for computed keys.
+ */
+
+/**
+ * Overlay the keys of `U` onto `T`. Keys present in `U` take precedence over
+ * base keys of the same name. The computed middleware relies on this to expose
+ * computed keys through `getState()`, selectors, and `subscribe` state while
+ * still preserving the untouched keys of the base state.
+ */
+declare type Write<T, U> = Omit<T, keyof U> & U
+
+/**
+ * Compute the union of keys shared between two object types. Used to reason
+ * about which base keys may be shadowed by computed keys.
+ */
+declare type SharedKeys<T, U> = Extract<keyof T, keyof U>
+
+/**
+ * Merge a base state `T` with computed keys `C`, ensuring that computed keys
+ * are always the read-only authoritative source for any overlapping key. This
+ * mirrors the runtime behavior where computed values are merged last inside the
+ * wrapped `setState` cycle.
+ */
+declare type MergeComputed<T, C> = Write<T, C>
+
+/**
+ * Extract the computed portion `C` produced by a `compute(state) => C` function
+ * signature. Retained as a shared helper so the middleware and any downstream
+ * type tests can reference a single canonical extractor.
+ */
+declare type ComputeResult<F> = F extends (state: any) => infer C ? C : never
+
+/**
+ * The equality function shape used for per-key referential stability of
+ * computed values. Defaults conceptually to `Object.is` at runtime; this type
+ * only constrains user-provided equality functions.
+ */
+declare type ComputedEqualityFn<C> = (
+  a: C[keyof C],
+  b: C[keyof C],
+) => boolean
+
+/**
