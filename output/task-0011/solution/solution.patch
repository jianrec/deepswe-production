+++ b/src/react/computed.ts
@@ -0,0 +1,158 @@
+import React from 'react'
+import { shallow } from '../vanilla/shallow.ts'
+import type { ExtractState } from '../vanilla.ts'
+
+/**
+ * The minimal read-only store contract that {@link useComputed} depends on. It
+ * mirrors the same `getState` / `getInitialState` / `subscribe` surface used by
+ * `useStore`, so any store created by `create` or `createStore` (with or
+ * without middleware, including the `computed` middleware) satisfies it.
+ */
+type ReadonlyStoreApi<T> = {
+  getState: () => T
+  getInitialState: () => T
+  subscribe: (listener: (state: T) => void) => () => void
+}
+
+/**
+ * Internal reference cell holding the last derived value. `hasValue` guards the
+ * first render where there is no previous value to compare against, avoiding a
+ * spurious equality check against `undefined`.
+ */
+type ComputedRef<U> = {
+  hasValue: boolean
+  value: U
+  /**
+   * The state instance the cached value was derived from. Used purely as a
+   * fast-path so repeated snapshot reads within a single commit that observe
+   * the exact same state reference can skip recomputation entirely.
+   */
+  state: unknown
+}
+
+const createRef = <U>(): ComputedRef<U> => ({
+  hasValue: false,
+  value: undefined as unknown as U,
+  state: Symbol('uninitialized'),
+})
+
+/**
+ * Derive a value from a store inside a React component.
+ *
+ * `useComputed` reads state through the same subscribe/getState contract used
+ * by `useStore` and is concurrent-safe via `useSyncExternalStore`. The derived
+ * value is memoized across renders using `equalityFn` (default `shallow`) so a
+ * component only re-renders when the derived output actually changes. When the
+ * recomputed result is equal under `equalityFn`, the previous reference is
+ * preserved, keeping referential stability for downstream consumers.
+ *
+ * @param api - a store api exposing `getState`, `getInitialState`, `subscribe`.
+ * @param compute - selector/derivation invoked with the current store state.
+ * @param equalityFn - equality used to decide whether the derived value
+ *   changed. Defaults to the shared {@link shallow} implementation.
+ */
+export function useComputed<
+  S extends {
+    getState: () => unknown
+    getInitialState: () => unknown
+    subscribe: (listener: (state: unknown) => void) => () => void
+  },
+  U,
+>(
+  api: S,
+  compute: (state: ExtractState<S>) => U,
+  equalityFn: (a: U, b: U) => boolean = shallow,
+): U {
+  const store = api as unknown as ReadonlyStoreApi<ExtractState<S>>
+
+  // A single mutable ref cell survives across renders and holds the last value
+  // returned to React. `useSyncExternalStore` requires snapshot functions to be
+  // referentially stable when possible and to return the *same* value when the
+  // underlying data has not changed, otherwise React tears or loops. We satisfy
+  // that by caching and reusing the previous reference whenever the equality
+  // function says the derived output is unchanged.
+  const ref = React.useRef<ComputedRef<U>>(undefined as never)
+  if (ref.current === undefined) {
+    ref.current = createRef<U>()
+  }
+
+  // Reset the cache whenever the compute or equality function identity changes.
+  // Holding onto a value derived by a stale compute would return incorrect
+  // results, so we invalidate `hasValue` and force a fresh derivation.
+  const depsRef = React.useRef<{
+    compute: (state: ExtractState<S>) => U
+    equalityFn: (a: U, b: U) => boolean
+  }>(undefined as never)
+  if (
+    depsRef.current === undefined ||
+    depsRef.current.compute !== compute ||
+    depsRef.current.equalityFn !== equalityFn
+  ) {
+    depsRef.current = { compute, equalityFn }
+    ref.current = createRef<U>()
+  }
+
+  /**
+   * Shared derivation used by both the client and server snapshots. Given the
+   * current state, it recomputes the value and either returns the cached
+   * reference (when equal under `equalityFn`) or stores and returns the new
+   * value.
+   */
+  const derive = React.useCallback(
+    (state: ExtractState<S>): U => {
+      const cache = ref.current
+
+      // Fast path: identical state reference and an existing cached value means
+      // the derived output cannot have changed. This avoids invoking `compute`
+      // repeatedly for the many snapshot reads React performs per commit.
+      if (cache.hasValue && Object.is(cache.state, state)) {
+        return cache.value
+      }
+
+      const nextValue = compute(state)
+
+      if (cache.hasValue && equalityFn(cache.value, nextValue)) {
+        // Unchanged under the equality function: preserve the prior reference so
+        // React sees a stable snapshot and skips the re-render.
+        cache.state = state
+        return cache.value
+      }
+
+      cache.hasValue = true
+      cache.value = nextValue
+      cache.state = state
+      return nextValue
+    },
+    [compute, equalityFn],
+  )
+
+  const getSnapshot = React.useCallback(
+    () => derive(store.getState()),
+    [store, derive],
+  )
+
+  const getServerSnapshot = React.useCallback(
+    () => derive(store.getInitialState()),
+    [store, derive],
+  )
+
+  // `subscribe` is typed with a state argument, but `useSyncExternalStore`
+  // expects an arity-0 `onStoreChange` listener. The extra argument is simply
+  // ignored by the store, so the cast is safe.
+  const subscribe = React.useCallback(
+    (onStoreChange: () => void) =>
+      store.subscribe(onStoreChange as (state: ExtractState<S>) => void),
+    [store],
+  )
+
+  const slice = React.useSyncExternalStore(
+    subscribe,
+    getSnapshot,
+    getServerSnapshot,
+  )
+
+  React.useDebugValue(slice)
+  return slice
+}
+
+export default useComputed
