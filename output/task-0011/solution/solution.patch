+import type {
+  StateCreator,
+  StoreApi,
+  StoreMutatorIdentifier,
+} from '../vanilla.ts'
+import { createComputeMemo, shallow } from '../vanilla/shallow.ts'
+
+/**
+ * Write helper: overlay the computed keys `U` onto the base state shape `T`.
+ * Computed keys take precedence over any base keys with the same name because
+ * they are always re-merged last inside the wrapped setState cycle.
+ */
+type Write<T, U> = Omit<T, keyof U> & U
+
+/**
+ * Options accepted by the {@link computed} middleware.
+ *
+ * - `equalityFn` controls per-key referential stability. When a recomputed
+ *   value is equal to the previous value under this function, the previous
+ *   reference is preserved so downstream selectors and React components do not
+ *   re-render spuriously. Defaults to `Object.is`.
+ * - `keys` restricts which base-state keys trigger recomputation. When
+ *   provided, the derived values are only recomputed if one of the listed base
+ *   keys changed (shallow compared). When omitted, recomputation runs on every
+ *   update.
+ */
+export interface ComputedOptions<C extends object> {
+  equalityFn?: (a: C[keyof C], b: C[keyof C]) => boolean
+  keys?: (keyof C)[]
+}
+
+/**
+ * The store mutator produced by the computed middleware. It writes the computed
+ * keys `A` onto the state exposed by `getState`, `getInitialState`, and
+ * `subscribe`, while preserving the existing `setState` overloads untouched so
+ * that composition with other middleware keeps working.
+ */
+type WithComputed<S, A> = S extends {
+  getState: () => infer T
+  setState: infer SetState
+}
+  ? Write<
+      S,
+      {
+        getState: () => Write<T, A>
+        getInitialState: () => Write<T, A>
+        setState: SetState
+        subscribe: (
+          listener: (state: Write<T, A>, prevState: Write<T, A>) => void,
+        ) => () => void
+      }
+    >
+  : S extends { getState: () => infer T }
+    ? Write<
+        S,
+        {
+          getState: () => Write<T, A>
+          getInitialState: () => Write<T, A>
+          subscribe: (
+            listener: (state: Write<T, A>, prevState: Write<T, A>) => void,
+          ) => () => void
+        }
+      >
+    : never
+
+declare module '../vanilla.ts' {
+  // eslint-disable-next-line @typescript-eslint/no-unused-vars, @typescript-eslint/no-empty-object-type
+  interface StoreMutators<S, A> {
+    'zustand/computed': WithComputed<S, A>
+  }
+}
+
+/**
+ * Public type signature for the computed middleware. It threads the computed
+ * mutator through the mutator chain so that the resulting store exposes the
+ * computed keys `C` in both selector state and `getState()` types, for both
+ * `create` and `createStore`.
+ */
+type Computed = <
+  T,
+  C extends object,
+  Mps extends [StoreMutatorIdentifier, unknown][] = [],
+  Mcs extends [StoreMutatorIdentifier, unknown][] = [],
+  U = T,
+>(
+  initializer: StateCreator<T, [...Mps, ['zustand/computed', C]], Mcs, U>,
+  compute: (state: T) => C,
+  options?: ComputedOptions<C>,
+) => StateCreator<Write<T & U, C>, Mps, [['zustand/computed', C], ...Mcs]>
+
+type AnyState = Record<string | number | symbol, unknown>
+
+type ComputedImpl = <T, C extends object>(
+  initializer: StateCreator<T, [], []>,
+  compute: (state: T) => C,
+  options?: ComputedOptions<C>,
+) => StateCreator<T, [], []>
+
+/**
+ * Determine whether a value should be treated as a mergeable object. Non-object
+ * values (primitives, null) are replaced wholesale by `setState`, mirroring the
+ * behavior of the vanilla store.
+ */
+const isMergeableObject = (value: unknown): value is AnyState =>
+  typeof value === 'object' && value !== null
+
+/**
+ * Compute the set of tracked base-state keys used to gate recomputation. Only
+ * the keys listed in `options.keys` are captured; every other change is
+ * ignored for the purpose of deciding whether to recompute.
+ */
+const pickTracked = (
+  state: AnyState,
+  keys: readonly (string | number | symbol)[],
+): AnyState => {
+  const tracked: AnyState = {}
+  for (let i = 0; i < keys.length; i++) {
+    const key = keys[i] as keyof AnyState
+    tracked[key] = state[key]
+  }
+  return tracked
+}
+
+const computedImpl: ComputedImpl =
+  (initializer, compute, options = {}) =>
+  (set, get, api) => {
+    const equalityFn = (options.equalityFn ?? Object.is) as (
+      a: unknown,
+      b: unknown,
+    ) => boolean
+
+    // The shared memoization core preserves per-key referential stability for
+    // computed values whose recomputed result is equal under `equalityFn`.
+    const memo = createComputeMemo(
+      compute as (state: unknown) => AnyState,
+      equalityFn as (a: unknown, b: unknown) => boolean,
+    )
+
+    const trackedKeys = (options.keys ?? undefined) as
+      | readonly (keyof AnyState)[]
+      | undefined
+
+    // Snapshot of the tracked base-state keys from the last recomputation. Used
+    // to decide whether a subsequent update actually touched a tracked key.
+    let lastTracked: AnyState | undefined
+
+    // Set of computed keys produced by the most recent recomputation. Used to
+    // guarantee computed keys are read-only: any direct write to them is
+    // overridden by the freshly computed value.
+    let computedKeys: Set<string | number | symbol> = new Set()
+
+    // Persist can use this non-public marker to distinguish derived fields
+    // from user-owned state when its default partialize function is active.
+    // It is deliberately kept on the store API rather than state so computed
+    // keys are never serialized by accident.
+    ;(api as StoreApi<unknown> & { __zustandComputedKeys?: Set<PropertyKey> })
+      .__zustandComputedKeys = computedKeys
+
+    /**
+     * Recompute derived values and merge them read-only onto `state`.
+     *
+     * When `options.keys` is provided and `force` is false, recomputation is
+     * skipped if none of the tracked base keys changed since the previous run;
+     * in that case the previously computed values are re-applied so they remain
+     * present and read-only even when a direct write attempted to change them.
+     */
+    const applyComputed = (state: unknown, force: boolean): unknown => {
+      if (!isMergeableObject(state)) {
+        // Non-object base states cannot carry computed keys; return as-is.
+        return state
+      }
+
+      let recompute = true
+      if (trackedKeys && !force) {
+        const nextTracked = pickTracked(state, trackedKeys)
+        if (lastTracked !== undefined && shallow(lastTracked, nextTracked)) {
+          recompute = false
+        } else {
+          lastTracked = nextTracked
+        }
+      } else if (trackedKeys) {
+        lastTracked = pickTracked(state, trackedKeys)
+      }
+
+      // Always run the memo so referential stability is maintained. When gating
+      // says we should not recompute due to unchanged tracked keys, the memo
+      // still returns the previous computed object because its own compute is
+      // invoked with a state whose tracked inputs are unchanged. To make the
+      // gate authoritative and avoid running arbitrary compute work, we only
+      // call the memo when recomputation is warranted; otherwise we reuse the
+      // last computed object captured below.
+      let computedValues: AnyState
+      if (recompute) {
+        computedValues = memo(state)
+        lastComputed = computedValues
+      } else {
+        computedValues = lastComputed ?? memo(state)
+        lastComputed = computedValues
+      }
+
+      // Track which keys are computed so that direct writes to them can be
+      // detected and overridden on the next cycle.
+      const nextComputedKeys = new Set<string | number | symbol>()
+      for (const key in computedValues) {
+        nextComputedKeys.add(key)
+      }
+      computedKeys = nextComputedKeys
+      ;(
+        api as StoreApi<unknown> & { __zustandComputedKeys?: Set<PropertyKey> }
+      ).__zustandComputedKeys = computedKeys
+
+      // Merge computed keys last so they override any user-provided writes to
+      // the same keys, enforcing read-only semantics.
+      return Object.assign({}, state, computedValues)
+    }
+
+    // The last computed object, retained so gated (skipped) recomputations can
+    // still re-apply computed keys read-only without invoking compute.
+    let lastComputed: AnyState | undefined
+
+    /**
+     * Wrapped setState. It resolves the user's partial/replace update against
+     * the current state, recomputes derived values, merges them read-only, and
+     * commits everything through the underlying store in a single `set` call
+     * (with `replace: true`) so subscribers are notified exactly once.
+     */
+    const setState: StoreApi<unknown>['setState'] = (
+      partial: unknown,
+      replace?: boolean,
+    ) => {
+      const prevState = get() as unknown
+
+      const partialState =
+        typeof partial === 'function'
+          ? (partial as (state: unknown) => unknown)(prevState)
+          : partial
+
+      // Nothing changed; still ensure computed keys stay consistent by letting
+      // the underlying store's Object.is short-circuit handle the no-op.
+      if (Object.is(partialState, prevState)) {
+        return
+      }
+
+      let nextState: unknown
+      const shouldReplace =
+        replace ?? !isMergeableObject(partialState)
+
+      if (shouldReplace) {
+        // replace:true re-establishes state from scratch; computed keys are
+        // re-merged afterwards so they are never lost by a replacing write.
+        nextState = partialState
+      } else if (isMergeableObject(prevState)) {
+        nextState = Object.assign({}, prevState, partialState as AnyState)
+      } else {
+        nextState = partialState
+      }
+
+      // Strip any user-provided values for computed keys before recomputation so
+      // that a direct write to a computed key cannot leak through even for a
+      // single frame; the authoritative computed values are merged next.
+      if (isMergeableObject(nextState) && computedKeys.size) {
+        for (const key of computedKeys) {
+          if (
+            isMergeableObject(prevState) &&
+            key in (prevState as AnyState)
+          ) {
+            ;(nextState as AnyState)[key] = (prevState as AnyState)[key]
+          }
+        }
+      }
+
+      const merged = applyComputed(nextState, false)
+
+      // Commit once with replace:true. `merged` is a fully-formed next state
+      // (base + computed), so replacing avoids a second shallow merge and keeps
+      // subscriber notification to exactly one per update.
+      ;(set as (state: unknown, replace: true) => void)(merged, true)
+    }
+
+    // Expose the wrapped setState on the store api so that other middleware and
+    // consumers that read `api.setState` observe computed behavior too.
+    api.setState = setState as StoreApi<unknown>['setState']
+
+    // Build the base initial state using the wrapped setState/getState so that
+    // inner initializers (immer, combine, persist, ...) see a consistent api.
+    const baseInitialState = initializer(
+      setState as Parameters<typeof initializer>[0],
+      get,
+      api,
+    )
+
+    // Seed computed values into the initial state so getState() and
+    // getInitialState() (SSR) already include the derived keys.
+    return applyComputed(baseInitialState, true) as ReturnType<
+      typeof initializer
+    >
+  }
+
+export const computed = computedImpl as unknown as Computed
