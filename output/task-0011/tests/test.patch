@@ -0,0 +1,49 @@
+import { expect, it } from 'vitest'
+import { computed } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+
+it('computed includes derived values in getInitialState', () => {
+  const store = createStore(
+    computed(
+      () => ({ count: 2 }),
+      (state) => ({ doubled: state.count * 2 }),
+    ),
+  )
+  expect(store.getInitialState()).toMatchObject({ count: 2, doubled: 4 })
+})
+
+it('computed getInitialState remains unchanged after updates', () => {
+  const store = createStore(
+    computed(
+      () => ({ count: 2 }),
+      (state) => ({ doubled: state.count * 2 }),
+    ),
+  )
+  store.setState({ count: 8 })
+  expect(store.getInitialState()).toMatchObject({ count: 2, doubled: 4 })
+  expect(store.getState()).toMatchObject({ count: 8, doubled: 16 })
+})
+
+it('computed getInitialState retains the initial computed reference', () => {
+  const store = createStore(
+    computed(
+      () => ({ count: 1 }),
+      (state) => ({ record: { count: state.count } }),
+    ),
+  )
+  const initialRecord = store.getInitialState().record
+  store.setState({ count: 2 })
+  expect(store.getInitialState().record).toBe(initialRecord)
+  expect(store.getState().record).not.toBe(initialRecord)
+})
+
+it('computed initial state overwrites initializer-provided computed keys', () => {
+  const store = createStore(
+    computed(
+      () => ({ count: 3, doubled: 999 }),
+      (state) => ({ doubled: state.count * 2 }),
+    ),
+  )
+  expect(store.getInitialState().doubled).toBe(6)
+  expect(store.getState().doubled).toBe(6)
+})
