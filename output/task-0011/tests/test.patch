+import { expect, it, vi } from 'vitest'
+import { combine, computed, devtools, subscribeWithSelector } from 'zustand/middleware'
+import { immer } from 'zustand/middleware/immer'
+import { createStore } from 'zustand/vanilla'
+
+it('computed composes outside immer', () => {
+  const store = createStore(
+    computed(
+      immer<{ count: number; increment: () => void }>((set) => ({
+        count: 1,
+        increment: () => set((state) => void state.count++),
+      })),
+      (state) => ({ doubled: state.count * 2 }),
+    ),
+  )
+  store.getState().increment()
+  expect(store.getState().doubled).toBe(4)
+})
+
+it('computed composes inside immer', () => {
+  const store = createStore(
+    immer(
+      computed(
+        (set) => ({
+          count: 1,
+          increment: () => set((state) => ({ count: state.count + 1 })),
+        }),
+        (state) => ({ doubled: state.count * 2 }),
+      ),
+    ),
+  )
+  store.getState().increment()
+  expect(store.getState().doubled).toBe(4)
+})
+
+it('computed composes outside devtools', () => {
+  const store = createStore(
+    computed(
+      devtools(() => ({ count: 2 }), { name: 'computed-outer' }),
+      (state) => ({ doubled: state.count * 2 }),
+    ),
+  )
+  store.setState({ count: 3 })
+  expect(store.getState().doubled).toBe(6)
+})
+
+it('computed composes inside devtools', () => {
+  const store = createStore(
+    devtools(
+      computed(
+        () => ({ count: 2 }),
+        (state) => ({ doubled: state.count * 2 }),
+      ),
+      { name: 'computed-inner' },
+    ),
+  )
+  store.setState({ count: 4 }, false, 'change')
+  expect(store.getState().doubled).toBe(8)
+})
+
+it('computed composes outside subscribeWithSelector', () => {
+  const store = createStore(
+    computed(
+      subscribeWithSelector(() => ({ count: 1, other: 0 })),
+      (state) => ({ doubled: state.count * 2 }),
+    ),
+  )
+  const listener = vi.fn()
+  store.subscribe((state) => state.doubled, listener)
+  store.setState({ count: 2 })
+  expect(listener).toHaveBeenCalledWith(4, 2)
+})
+
+it('computed composes inside subscribeWithSelector', () => {
+  const store = createStore(
+    subscribeWithSelector(
+      computed(
+        () => ({ count: 1, other: 0 }),
+        (state) => ({ doubled: state.count * 2 }),
+      ),
+    ),
+  )
+  const listener = vi.fn()
+  store.subscribe((state) => state.doubled, listener)
+  store.setState({ count: 3 })
+  expect(listener).toHaveBeenCalledTimes(1)
+  expect(listener).toHaveBeenCalledWith(6, 2)
+})
+
+it('computed composes outside combine', () => {
+  const store = createStore(
+    computed(
+      combine({ count: 1 }, (set) => ({
+        increment: () => set((state) => ({ count: state.count + 1 })),
+      })),
+      (state) => ({ doubled: state.count * 2 }),
+    ),
+  )
+  store.getState().increment()
+  expect(store.getState().doubled).toBe(4)
+})
+
+it('computed composes inside combine-produced state creators', () => {
+  const initializer = combine({ count: 1 }, (set) => ({
+    increment: () => set((state) => ({ count: state.count + 1 })),
+  }))
+  const store = createStore(
+    computed(initializer, (state) => ({ label: `count:${state.count}` })),
+  )
+  store.setState({ count: 5 })
+  expect(store.getState().label).toBe('count:5')
+})
diff --git a/tests/hidden/computed.keys.test.ts b/tests/hidden/computed.keys.test.ts
