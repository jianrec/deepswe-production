+import { expect, expectTypeOf, it } from 'vitest'
+import { useComputed } from 'zustand'
+import type { ExtractState, StateCreator } from 'zustand'
+import { computed } from 'zustand/middleware'
+import type { ComputedOptions } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+
+type Base = { count: number; name: string }
+type Derived = { doubled: number; display: string }
+
+const initializer: StateCreator<
+  Base,
+  [['zustand/computed', Derived]],
+  [],
+  Base
+> = () => ({ count: 1, name: 'one' })
+
+const store = createStore(
+  computed<Base, Derived>(initializer, (state) => ({
+    doubled: state.count * 2,
+    display: `${state.name}:${state.count}`,
+  })),
+)
+
+it('computed types expose computed keys through getState', () => {
+  expectTypeOf(store.getState().doubled).toEqualTypeOf<number>()
+  expectTypeOf(store.getState().display).toEqualTypeOf<string>()
+  expect(store).toBeDefined()
+})
+
+it('computed types expose computed keys through getInitialState', () => {
+  expectTypeOf(store.getInitialState().doubled).toEqualTypeOf<number>()
+  expectTypeOf(store.getInitialState().display).toEqualTypeOf<string>()
+  expect(store).toBeDefined()
+})
+
+it('computed types expose computed keys to subscribe listeners', () => {
+  store.subscribe((state, previousState) => {
+    expectTypeOf(state.doubled).toEqualTypeOf<number>()
+    expectTypeOf(previousState.display).toEqualTypeOf<string>()
+  })
+  expect(store).toBeDefined()
+})
+
+it('computed preserves usable setState overloads for base state', () => {
+  store.setState({ count: 3 })
+  store.setState((state) => ({ name: state.name.toUpperCase() }))
+  expect(store.getState().doubled).toBe(6)
+})
+
+it('ComputedOptions exposes equalityFn and keys', () => {
+  const options: ComputedOptions<Derived> = {
+    equalityFn: (left, right) => Object.is(left, right),
+    keys: ['doubled'],
+  }
+  expectTypeOf(options).toMatchTypeOf<ComputedOptions<Derived>>()
+  expect(options.keys).toEqual(['doubled'])
+})
+
+it('useComputed infers state and output from the store api', () => {
+  const Component = () => {
+    const result = useComputed(store, (state) => state.display.length)
+    expectTypeOf(result).toEqualTypeOf<number>()
+    return <>{result}</>
+  }
+  expect(Component).toBeDefined()
+})
+
+it('computed mutator changes ExtractState to include derived keys', () => {
+  type StoreState = ExtractState<typeof store>
+  expectTypeOf<StoreState>().toExtend<Base & Derived>()
+  expect(store).toBeDefined()
+})
