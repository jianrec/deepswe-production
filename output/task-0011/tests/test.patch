index 0000000..7eb8edd
--- /dev/null
+++ b/tests/hidden/computed.keys.test.ts
@@ -0,0 +1,76 @@
+import { expect, it, vi } from 'vitest'
+import { computed } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+
+type State = { count: number; name: string; token: object }
+type Derived = { doubled: number }
+
+const createKeyedStore = (compute = vi.fn((state: State) => ({ doubled: state.count * 2 }))) => {
+  const store = createStore(
+    computed<State, Derived>(
+      () => ({ count: 1, name: 'one', token: {} }),
+      compute,
+      { keys: ['count' as never] },
+    ),
+  )
+  return { compute, store }
+}
+
+it('computed keys option computes the initial value', () => {
+  const { compute, store } = createKeyedStore()
+  expect(store.getState().doubled).toBe(2)
+  expect(compute).toHaveBeenCalledTimes(1)
+})
+
+it('computed keys option skips an unrelated base-state update', () => {
+  const { compute, store } = createKeyedStore()
+  store.setState({ name: 'changed' })
+  expect(compute).toHaveBeenCalledTimes(1)
+  expect(store.getState().doubled).toBe(2)
+})
+
+it('computed keys option recomputes a listed base-state update', () => {
+  const { compute, store } = createKeyedStore()
+  store.setState({ count: 3 })
+  expect(compute).toHaveBeenCalledTimes(2)
+  expect(store.getState().doubled).toBe(6)
+})
+
+it('computed keys compare listed values with Object.is', () => {
+  const { compute, store } = createKeyedStore()
+  store.setState({ count: 1 })
+  expect(compute).toHaveBeenCalledTimes(1)
+})
+
+it('computed keys detect changed object references', () => {
+  const compute = vi.fn((state: State) => ({ doubled: state.count * 2 }))
+  const store = createStore(
+    computed<State, Derived>(
+      () => ({ count: 1, name: 'one', token: {} }),
+      compute,
+      { keys: ['token' as never] },
+    ),
+  )
+  store.setState({ token: {} })
+  expect(compute).toHaveBeenCalledTimes(2)
+})
+
+it('computed keys support multiple relevant base-state keys', () => {
+  const compute = vi.fn((state: State) => ({ doubled: state.count * 2 }))
+  const store = createStore(
+    computed<State, Derived>(
+      () => ({ count: 1, name: 'one', token: {} }),
+      compute,
+      { keys: ['count' as never, 'name' as never] },
+    ),
+  )
+  store.setState({ name: 'two' })
+  store.setState({ count: 2 })
+  expect(compute).toHaveBeenCalledTimes(3)
+})
+
+it('computed keys cannot allow a forged computed value to survive', () => {
+  const { store } = createKeyedStore()
+  ;(store.setState as (state: object) => void)({ doubled: 500 })
+  expect(store.getState().doubled).toBe(2)
+})
diff --git a/tests/hidden/computed.notifications.test.ts b/tests/hidden/computed.notifications.test.ts
new file mode 100644
index 0000000..013c485
--- /dev/null
+++ b/tests/hidden/computed.notifications.test.ts
@@ -0,0 +1,90 @@
+import { expect, it, vi } from 'vitest'
+import { computed } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+
+type State = { count: number; other: number; increment: () => void }
+type Derived = { record: { parity: number }; doubled: number }
+
+const createNotificationStore = (equalityFn?: (a: unknown, b: unknown) => boolean) =>
+  createStore(
+    computed<State, Derived>(
+      (set) => ({
+        count: 0,
+        other: 0,
+        increment: () => set((state) => ({ count: state.count + 1 })),
+      }),
+      (state) => ({
+        record: { parity: state.count % 2 },
+        doubled: state.count * 2,
+      }),
+      equalityFn ? { equalityFn } : undefined,
+    ),
+  )
+
+it('computed notifies exactly once for external setState', () => {
+  const store = createNotificationStore()
+  const listener = vi.fn()
+  store.subscribe(listener)
+  store.setState({ count: 1 })
+  expect(listener).toHaveBeenCalledTimes(1)
+})
+
+it('computed notifies exactly once for an initializer action', () => {
+  const store = createNotificationStore()
+  const listener = vi.fn()
+  store.subscribe(listener)
+  store.getState().increment()
+  expect(listener).toHaveBeenCalledTimes(1)
+})
+
+it('computed notifies exactly once for replace true', () => {
+  const store = createNotificationStore()
+  const listener = vi.fn()
+  store.subscribe(listener)
+  ;(store.setState as (state: State, replace: true) => void)(
+    { count: 2, other: 1, increment: vi.fn() },
+    true,
+  )
+  expect(listener).toHaveBeenCalledTimes(1)
+})
+
+it('computed subscribers receive the final computed state', () => {
+  const store = createNotificationStore()
+  const states: Array<ReturnType<typeof store.getState>> = []
+  store.subscribe((state) => states.push(state))
+  store.setState({ count: 3 })
+  expect(states).toHaveLength(1)
+  expect(states[0]).toMatchObject({ count: 3, doubled: 6 })
+})
+
+it('computed subscribers receive the prior computed state', () => {
+  const store = createNotificationStore()
+  const previousStates: Array<ReturnType<typeof store.getState>> = []
+  store.subscribe((_state, previousState) => previousStates.push(previousState))
+  store.setState({ count: 2 })
+  expect(previousStates).toHaveLength(1)
+  expect(previousStates[0]).toMatchObject({ count: 0, doubled: 0 })
+})
+
+it('computed preserves each equal value with a custom equality function', () => {
+  const store = createNotificationStore((left, right) =>
+    JSON.stringify(left) === JSON.stringify(right),
+  )
+  const initialRecord = store.getState().record
+  store.setState({ count: 2 })
+  expect(store.getState().record).toBe(initialRecord)
+  expect(store.getState().doubled).toBe(4)
+})
+
+it('computed defaults to Object.is for value memoization', () => {
+  const stableRecord = { parity: 0 }
+  const store = createStore(
+    computed(
+      () => ({ count: 0, other: 0 }),
+      (state) => ({ stableRecord, doubled: state.count * 2 }),
+    ),
+  )
+  const initialRecord = store.getState().stableRecord
+  store.setState({ other: 1 })
+  expect(store.getState().stableRecord).toBe(initialRecord)
+})
diff --git a/tests/hidden/computed.persistence.test.ts b/tests/hidden/computed.persistence.test.ts
new file mode 100644
index 0000000..4572a0e
--- /dev/null
+++ b/tests/hidden/computed.persistence.test.ts
@@ -0,0 +1,86 @@
+import { expect, it } from 'vitest'
+import { computed, createJSONStorage, persist } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+
+const createMemoryStorage = () => {
+  const values = new Map<string, string>()
+  return {
+    getItem: (name: string) => values.get(name) ?? null,
+    setItem: (name: string, value: string) => void values.set(name, value),
+    removeItem: (name: string) => void values.delete(name),
+    read: (name: string) => values.get(name),
+  }
+}
+
+it('computed outside persist excludes computed keys by default', () => {
+  const memory = createMemoryStorage()
+  const store = createStore(
+    computed(
+      persist(() => ({ count: 1 }), {
+        name: 'outer-computed',
+        storage: createJSONStorage(() => memory),
+      }),
+      (state) => ({ doubled: state.count * 2 }),
+    ),
+  )
+  store.setState({ count: 2 })
+  const persisted = JSON.parse(memory.read('outer-computed') as string)
+  expect(persisted.state).toEqual({ count: 2 })
+})
+
+it('computed inside persist excludes computed keys by default', () => {
+  const memory = createMemoryStorage()
+  const store = createStore(
+    persist(
+      computed(
+        () => ({ count: 1 }),
+        (state) => ({ doubled: state.count * 2 }),
+      ),
+      {
+        name: 'inner-computed',
+        storage: createJSONStorage(() => memory),
+      },
+    ),
+  )
+  store.setState({ count: 3 })
+  const persisted = JSON.parse(memory.read('inner-computed') as string)
+  expect(persisted.state).toEqual({ count: 3 })
+})
+
+it('computed persistence includes a computed key when partialize selects it', () => {
+  const memory = createMemoryStorage()
+  const store = createStore(
+    persist(
+      computed(
+        () => ({ count: 1 }),
+        (state) => ({ doubled: state.count * 2 }),
+      ),
+      {
+        name: 'explicit-computed',
+        storage: createJSONStorage(() => memory),
+        partialize: (state) => ({ count: state.count, doubled: state.doubled }),
+      },
+    ),
+  )
+  store.setState({ count: 4 })
+  const persisted = JSON.parse(memory.read('explicit-computed') as string)
+  expect(persisted.state).toEqual({ count: 4, doubled: 8 })
+})
+
+it('computed recomputes hydrated persisted base state', () => {
+  const memory = createMemoryStorage()
+  memory.setItem(
+    'hydrated-computed',
+    JSON.stringify({ state: { count: 5 }, version: 0 }),
+  )
+  const store = createStore(
+    computed(
+      persist(() => ({ count: 1 }), {
+        name: 'hydrated-computed',
+        storage: createJSONStorage(() => memory),
+      }),
+      (state) => ({ doubled: state.count * 2 }),
+    ),
+  )
+  expect(store.getState()).toMatchObject({ count: 5, doubled: 10 })
+})
diff --git a/tests/hidden/computed.react.test.tsx b/tests/hidden/computed.react.test.tsx
new file mode 100644
index 0000000..7c2e8ee
--- /dev/null
+++ b/tests/hidden/computed.react.test.tsx
@@ -0,0 +1,116 @@
+import { StrictMode, useState } from 'react'
+import { act, fireEvent, render, screen } from '@testing-library/react'
+import { renderToString } from 'react-dom/server'
+import { expect, it, vi } from 'vitest'
+import { create, useComputed } from 'zustand'
+import { createStore } from 'zustand/vanilla'
+
+it('useComputed is importable from zustand and derives store state', () => {
+  const store = createStore(() => ({ count: 2 }))
+  const Component = () => <div>{useComputed(store, (state) => state.count * 3)}</div>
+  render(<Component />)
+  expect(screen.getByText('6')).toBeInTheDocument()
+})
+
+it('useComputed updates when its derived primitive changes', () => {
+  const store = createStore(() => ({ count: 1 }))
+  const Component = () => <div>{useComputed(store, (state) => state.count * 2)}</div>
+  render(<Component />)
+  act(() => store.setState({ count: 4 }))
+  expect(screen.getByText('8')).toBeInTheDocument()
+})
+
+it('useComputed defaults to shallow equality for object outputs', () => {
+  const store = createStore(() => ({ count: 0, other: 0 }))
+  let renders = 0
+  const Component = () => {
+    const value = useComputed(store, (state) => ({ parity: state.count % 2 }))
+    renders++
+    return <div>{value.parity}</div>
+  }
+  render(<Component />)
+  act(() => store.setState({ count: 2, other: 1 }))
+  expect(renders).toBe(1)
+})
+
+it('useComputed re-renders when a shallow object field changes', () => {
+  const store = createStore(() => ({ count: 0 }))
+  let renders = 0
+  const Component = () => {
+    const value = useComputed(store, (state) => ({ parity: state.count % 2 }))
+    renders++
+    return <div>{value.parity}</div>
+  }
+  render(<Component />)
+  act(() => store.setState({ count: 1 }))
+  expect(renders).toBe(2)
+  expect(screen.getByText('1')).toBeInTheDocument()
+})
+
+it('useComputed honors a custom equality function', () => {
+  const store = createStore(() => ({ count: 0 }))
+  let renders = 0
+  const Component = () => {
+    const count = useComputed(store, (state) => state.count, () => true)
+    renders++
+    return <div>{count}</div>
+  }
+  render(<Component />)
+  act(() => store.setState({ count: 1 }))
+  expect(renders).toBe(1)
+  expect(screen.getByText('0')).toBeInTheDocument()
+})
+
+it('useComputed accepts a bound store api', () => {
+  const useBoundStore = create(() => ({ count: 3 }))
+  const Component = () => <div>{useComputed(useBoundStore, (state) => state.count + 1)}</div>
+  render(<Component />)
+  expect(screen.getByText('4')).toBeInTheDocument()
+})
+
+it('useComputed updates when the compute closure changes', () => {
+  const store = createStore(() => ({ count: 2 }))
+  const Component = () => {
+    const [factor, setFactor] = useState(2)
+    const result = useComputed(store, (state) => state.count * factor)
+    return <button onClick={() => setFactor(3)}>{result}</button>
+  }
+  render(<Component />)
+  fireEvent.click(screen.getByRole('button'))
+  expect(screen.getByRole('button')).toHaveTextContent('6')
+})
+
+it('useComputed uses getInitialState for server rendering', () => {
+  const api = {
+    getState: () => ({ count: 9 }),
+    getInitialState: () => ({ count: 2 }),
+    subscribe: () => () => undefined,
+  }
+  const Component = () => <span>{useComputed(api, (state) => state.count)}</span>
+  expect(renderToString(<Component />)).toContain('2')
+})
+
+it('useComputed unsubscribes when the component unmounts', () => {
+  const unsubscribe = vi.fn()
+  const api = {
+    getState: () => ({ count: 1 }),
+    getInitialState: () => ({ count: 1 }),
+    subscribe: vi.fn(() => unsubscribe),
+  }
+  const Component = () => <div>{useComputed(api, (state) => state.count)}</div>
+  const result = render(<Component />)
+  expect(api.subscribe).toHaveBeenCalled()
+  result.unmount()
+  expect(unsubscribe).toHaveBeenCalledTimes(1)
+})
+
+it('useComputed remains usable in React StrictMode', () => {
+  const store = createStore(() => ({ count: 1 }))
+  const Component = () => <div>{useComputed(store, (state) => state.count + 4)}</div>
+  render(
+    <StrictMode>
+      <Component />
+    </StrictMode>,
+  )
+  expect(screen.getByText('5')).toBeInTheDocument()
+})
diff --git a/tests/hidden/computed.types.test.tsx b/tests/hidden/computed.types.test.tsx
