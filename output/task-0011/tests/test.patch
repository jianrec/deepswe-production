diff --git a/tests/hidden/computed.basic.test.ts b/tests/hidden/computed.basic.test.ts
new file mode 100644
index 0000000..0dbdb4e
--- /dev/null
+++ b/tests/hidden/computed.basic.test.ts
@@ -0,0 +1,88 @@
+import { expect, it, vi } from 'vitest'
+import { computed } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+
+type CounterState = {
+  count: number
+  label: string
+  increment: () => void
+}
+
+type CounterComputed = {
+  doubled: number
+  summary: string
+}
+
+const createCounterStore = () =>
+  createStore(
+    computed<CounterState, CounterComputed>(
+      (set) => ({
+        count: 1,
+        label: 'one',
+        increment: () => set((state) => ({ count: state.count + 1 })),
+      }),
+      (state) => ({
+        doubled: state.count * 2,
+        summary: `${state.label}:${state.count}`,
+      }),
+    ),
+  )
+
+it('computed exports middleware and exposes initial computed values', () => {
+  const store = createCounterStore()
+  expect(store.getState()).toMatchObject({ doubled: 2, summary: 'one:1' })
+})
+
+it('computed recomputes after an initializer action', () => {
+  const store = createCounterStore()
+  store.getState().increment()
+  expect(store.getState()).toMatchObject({ count: 2, doubled: 4 })
+})
+
+it('computed recomputes after an external partial setState', () => {
+  const store = createCounterStore()
+  store.setState({ count: 4 })
+  expect(store.getState()).toMatchObject({ count: 4, doubled: 8 })
+})
+
+it('computed recomputes after an external functional setState', () => {
+  const store = createCounterStore()
+  store.setState((state) => ({ count: state.count + 4 }))
+  expect(store.getState()).toMatchObject({ count: 5, doubled: 10 })
+})
+
+it('computed overwrites a direct partial write to a computed key', () => {
+  const store = createCounterStore()
+  ;(store.setState as (state: object) => void)({ count: 3, doubled: 999 })
+  expect(store.getState()).toMatchObject({ count: 3, doubled: 6 })
+})
+
+it('computed overwrites a direct functional write to a computed key', () => {
+  const store = createCounterStore()
+  ;(store.setState as (state: (value: object) => object) => void)(() => ({
+    count: 6,
+    summary: 'forged',
+  }))
+  expect(store.getState()).toMatchObject({ count: 6, summary: 'one:6' })
+})
+
+it('computed re-merges computed keys for replace true', () => {
+  const store = createCounterStore()
+  ;(store.setState as (state: object, replace: true) => void)(
+    { count: 7, label: 'seven', increment: vi.fn(), doubled: -1 },
+    true,
+  )
+  expect(store.getState()).toMatchObject({
+    count: 7,
+    label: 'seven',
+    doubled: 14,
+    summary: 'seven:7',
+  })
+})
+
+it('computed publishes every key returned by compute', () => {
+  const store = createCounterStore()
+  store.setState({ count: 9, label: 'nine' })
+  expect(store.getState().doubled).toBe(18)
+  expect(store.getState().summary).toBe('nine:9')
+})
diff --git a/tests/hidden/computed.initial-state.test.ts b/tests/hidden/computed.initial-state.test.ts
