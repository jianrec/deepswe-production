+
+import {checkKeyStringCoercion} from 'shared/CheckStringCoercion';
+import {enableOptimisticKey} from 'shared/ReactFeatureFlags';
+import {REACT_OPTIMISTIC_KEY} from 'shared/ReactSymbols';
+
+// The separators used to build up the fully-qualified traversal key that React
+// assigns to each flattened child. `SEPARATOR` prefixes a top-level key while
+// `SUBSEPARATOR` joins nested levels. These are shared between the existing
+// `React.Children` utilities (map/forEach/count/toArray/only) and the newer
+// functional traversal utilities (reduce/filter/find/toKeyedArray) so that
+// every helper keys elements bit-for-bit identically.
+export const SEPARATOR: string = '.';
+export const SUBSEPARATOR: string = ':';
+
+/**
+ * Escape and wrap key so it is safe to use as a reactid
+ *
+ * @param {string} key to be escaped.
+ * @return {string} the escaped key.
+ */
+function escape(key: string): string {
+  const escapeRegex = /[=:]/g;
+  const escaperLookup = {
+    '=': '=0',
+    ':': '=2',
+  };
+  const escapedString = key.replace(escapeRegex, function (match) {
+    // $FlowFixMe[invalid-computed-prop]
+    return escaperLookup[match];
+  });
+
+  return '$' + escapedString;
+}
+
+const userProvidedKeyEscapeRegex = /\/+/g;
+
+/**
+ * Escape a user-provided key so it can be safely embedded as a prefix within a
+ * larger traversal key. Every run of `/` characters is doubled so the escaped
+ * value round-trips through the `/`-delimited prefix accumulation performed by
+ * the mapping traversal.
+ *
+ * @param {string} text
+ * @return {string}
+ */
+export function escapeUserProvidedKey(text: string): string {
+  return text.replace(userProvidedKeyEscapeRegex, '$&/');
+}
+
+/**
+ * Generate a key string that identifies a element within a set.
+ *
+ * @param {*} element A element that could contain a manual key.
+ * @param {number} index Index that is used if a manual key is not provided.
+ * @return {string}
+ */
+export function getElementKey(element: any, index: number): string {
+  // Do some typechecking here since we call this blindly. We want to ensure
+  // that we don't block potential future ES APIs.
+  if (typeof element === 'object' && element !== null && element.key != null) {
+    if (enableOptimisticKey && element.key === REACT_OPTIMISTIC_KEY) {
+      // For React.Children purposes this is treated as just null.
+      if (__DEV__) {
+        console.error("React.Children helpers don't support optimisticKey.");
+      }
+      return index.toString(36);
+    }
+    // Explicit key
+    if (__DEV__) {
+      checkKeyStringCoercion(element.key);
+    }
+    return escape('' + element.key);
+  }
+  // Implicit key determined by the index in the set
+  return index.toString(36);
+}
