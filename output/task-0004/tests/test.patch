@@ -0,0 +1,94 @@
+'use strict';
+
+let React;
+
+beforeEach(() => {
+  jest.resetModules();
+  React = require('react');
+});
+
+it('reduce folds primitive children in traversal order', () => {
+  const result = React.Children.reduce(
+    [1, 2, 3],
+    (sum, child) => sum + child,
+    4,
+  );
+  expect(result).toBe(10);
+});
+
+it('reduce passes a running flattened index', () => {
+  const calls = [];
+  React.Children.reduce(
+    ['a', ['b', ['c']], 'd'],
+    (value, child, index) => {
+      calls.push([child, index]);
+      return value;
+    },
+    null,
+  );
+  expect(calls).toEqual([
+    ['a', 0],
+    ['b', 1],
+    ['c', 2],
+    ['d', 3],
+  ]);
+});
+
+it('reduce returns the identical initial value for empty children', () => {
+  const initial = {stable: true};
+  expect(React.Children.reduce([], () => null, initial)).toBe(initial);
+});
+
+it('reduce skips null undefined and boolean children', () => {
+  const calls = [];
+  const result = React.Children.reduce(
+    [null, undefined, false, true, 'value', 7],
+    (items, child, index) => {
+      calls.push([child, index]);
+      items.push(child);
+      return items;
+    },
+    [],
+  );
+  expect(result).toEqual(['value', 7]);
+  expect(calls).toEqual([
+    ['value', 0],
+    [7, 1],
+  ]);
+});
+
+it('reduce traverses a single non-array child once', () => {
+  const calls = [];
+  const result = React.Children.reduce(
+    'single',
+    (value, child, index) => {
+      calls.push([child, index]);
+      return value + child;
+    },
+    '',
+  );
+  expect(result).toBe('single');
+  expect(calls).toEqual([['single', 0]]);
+});
+
+it('reduce traverses iterable children in iterator order', () => {
+  const iterable = new Set(['first', 'second', 'third']);
+  const result = React.Children.reduce(
+    iterable,
+    (value, child) => value + child[0],
+    '',
+  );
+  expect(result).toBe('fst');
+});
+
+it('reduce supports accumulator type changes returned by the reducer', () => {
+  const result = React.Children.reduce(
+    ['a', 'bb', 'ccc'],
+    (accumulator, child, index) => ({
+      total: accumulator.total + child.length,
+      lastIndex: index,
+    }),
+    {total: 0, lastIndex: -1},
+  );
+  expect(result).toEqual({total: 6, lastIndex: 2});
+});
diff --git a/packages/react/src/__tests__/ReactChildrenToKeyedArray-hidden-test.js b/packages/react/src/__tests__/ReactChildrenToKeyedArray-hidden-test.js
