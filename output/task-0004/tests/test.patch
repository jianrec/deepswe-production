+++ b/packages/react/src/__tests__/ReactChildrenToKeyedArray-hidden-test.js
@@ -0,0 +1,64 @@
+'use strict';
+
+let React;
+
+beforeEach(() => {
+  jest.resetModules();
+  React = require('react');
+});
+
+it('toKeyedArray assigns positional top-level keys', () => {
+  expect(React.Children.toKeyedArray(['a', 'b'])).toEqual([
+    {key: '.0', node: 'a'},
+    {key: '.1', node: 'b'},
+  ]);
+});
+
+it('toKeyedArray joins nested array paths with subseparators', () => {
+  const result = React.Children.toKeyedArray(['a', ['b', 'c']]);
+  expect(result.map(item => item.key)).toEqual(['.0', '.1:0', '.1:1']);
+});
+
+it('toKeyedArray retains every nested level in the key path', () => {
+  const result = React.Children.toKeyedArray([[['deep']]]);
+  expect(result).toEqual([{key: '.0:0:0', node: 'deep'}]);
+});
+
+it('toKeyedArray uses escaped user element keys', () => {
+  const element = React.createElement('div', {key: 'a:b=c'});
+  const result = React.Children.toKeyedArray([element]);
+  expect(result[0].key).toBe('.$a=2b=0c');
+});
+
+it('toKeyedArray uses base36 positional keys', () => {
+  const children = Array.from({length: 37}, (_, index) => String(index));
+  const result = React.Children.toKeyedArray(children);
+  expect(result[35].key).toBe('.z');
+  expect(result[36].key).toBe('.10');
+});
+
+it('toKeyedArray element nodes carry the keys used by toArray', () => {
+  const children = [
+    React.createElement('i'),
+    [React.createElement('b', {key: 'bold'})],
+  ];
+  const keyed = React.Children.toKeyedArray(children);
+  const array = React.Children.toArray(children);
+  expect(keyed.map(item => item.node.key)).toEqual(
+    array.map(node => node.key),
+  );
+  expect(keyed.map(item => item.key)).toEqual(array.map(node => node.key));
+});
+
+it('toKeyedArray preserves primitive nodes unchanged', () => {
+  expect(
+    React.Children.toKeyedArray(['text', 12]).map(item => item.node),
+  ).toEqual(['text', 12]);
+});
+
+it('toKeyedArray flattens iterables and preserves positional gaps', () => {
+  const children = new Set([null, 'value', false, 8]);
+  const result = React.Children.toKeyedArray(children);
+  expect(result.map(item => item.node)).toEqual(['value', 8]);
+  expect(result.map(item => item.key)).toEqual(['.1', '.3']);
+});
