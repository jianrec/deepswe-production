@@ -0,0 +1,44 @@
+'use strict';
+
+let React;
+let KeyPath;
+
+beforeEach(() => {
+  jest.resetModules();
+  React = require('react');
+  KeyPath = require('shared/ReactChildKeyPath');
+});
+
+it('key path module exports traversal separators', () => {
+  expect(KeyPath.SEPARATOR).toBe('.');
+  expect(KeyPath.SUBSEPARATOR).toBe(':');
+});
+
+it('getElementKey returns base36 positional keys', () => {
+  expect(KeyPath.getElementKey('leaf', 0)).toBe('0');
+  expect(KeyPath.getElementKey('leaf', 35)).toBe('z');
+  expect(KeyPath.getElementKey('leaf', 36)).toBe('10');
+});
+
+it('getElementKey escapes explicit element keys', () => {
+  const element = React.createElement('div', {key: 'a:b=c'});
+  expect(KeyPath.getElementKey(element, 9)).toBe('$a=2b=0c');
+});
+
+it('getElementKey prefers an explicit key over its position', () => {
+  const element = React.createElement('div', {key: 'fixed'});
+  expect(KeyPath.getElementKey(element, 0)).toBe('$fixed');
+  expect(KeyPath.getElementKey(element, 100)).toBe('$fixed');
+});
+
+it('escapeUserProvidedKey doubles every slash run', () => {
+  expect(KeyPath.escapeUserProvidedKey('a/b//c')).toBe('a//b///c');
+});
+
+it('shared getElementKey agrees with public traversal keys', () => {
+  const element = React.createElement('div', {key: 'shared:key'});
+  const result = React.Children.toKeyedArray([element]);
+  expect(result[0].key).toBe(
+    KeyPath.SEPARATOR + KeyPath.getElementKey(element, 0),
+  );
+});
