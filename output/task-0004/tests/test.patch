@@ -0,0 +1,89 @@
+'use strict';
+
+let React;
+
+beforeEach(() => {
+  jest.resetModules();
+  React = require('react');
+});
+
+it('find returns the first matching primitive child', () => {
+  expect(React.Children.find([1, 4, 6], child => child % 2 === 0)).toBe(4);
+});
+
+it('find returns undefined when no child matches', () => {
+  expect(
+    React.Children.find(['a', 'b'], child => child === 'z'),
+  ).toBeUndefined();
+});
+
+it('find stops pulling an iterable immediately after a match', () => {
+  const pulled = [];
+  const iterable = {
+    [Symbol.iterator]() {
+      let index = 0;
+      return {
+        next() {
+          pulled.push(index);
+          return index < 5
+            ? {value: index++, done: false}
+            : {value: undefined, done: true};
+        },
+      };
+    },
+  };
+  expect(React.Children.find(iterable, child => child === 1)).toBe(1);
+  expect(pulled).toEqual([0, 1]);
+});
+
+it('find returns the original unrekeyed element', () => {
+  const target = React.createElement('div', {key: 'target'});
+  const found = React.Children.find(
+    [React.createElement('i'), target],
+    child => child === target,
+  );
+  expect(found).toBe(target);
+  expect(found.key).toBe('target');
+});
+
+it('find binds predicate context and supplies indexes', () => {
+  const context = {wanted: 2};
+  const calls = [];
+  const found = React.Children.find(
+    [0, [1, 2]],
+    function (child, index) {
+      expect(this).toBe(context);
+      calls.push(index);
+      return child === this.wanted;
+    },
+    context,
+  );
+  expect(found).toBe(2);
+  expect(calls).toEqual([0, 1, 2]);
+});
+
+it('find ignores null undefined and booleans', () => {
+  const visited = [];
+  const found = React.Children.find(
+    [null, true, undefined, false, 'match'],
+    child => {
+      visited.push(child);
+      return true;
+    },
+  );
+  expect(found).toBe('match');
+  expect(visited).toEqual(['match']);
+});
+
+it('find does not visit nested siblings after a nested match', () => {
+  const visited = [];
+  const found = React.Children.find(
+    ['before', ['target', 'nested-after'], 'outer-after'],
+    child => {
+      visited.push(child);
+      return child === 'target';
+    },
+  );
+  expect(found).toBe('target');
+  expect(visited).toEqual(['before', 'target']);
+});
diff --git a/packages/react/src/__tests__/ReactChildrenFunctionalTraversal-hidden-test.js b/packages/react/src/__tests__/ReactChildrenFunctionalTraversal-hidden-test.js
