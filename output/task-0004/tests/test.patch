+  expect(typeof React.Children.filter).toBe('function');
+  expect(typeof React.Children.find).toBe('function');
+  expect(typeof React.Children.toKeyedArray).toBe('function');
+});
+
+it('ReactChildren module provides the contracted named exports', () => {
+  const ReactChildren = require('../ReactChildren');
+  expect(typeof ReactChildren.reduceChildren).toBe('function');
+  expect(typeof ReactChildren.filterChildren).toBe('function');
+  expect(typeof ReactChildren.findChild).toBe('function');
+  expect(typeof ReactChildren.toKeyedArray).toBe('function');
+});
+
+it('ReactClient aggregates the new Children utilities', () => {
+  const {Children} = require('../ReactClient');
+  expect(typeof Children.reduce).toBe('function');
+  expect(typeof Children.filter).toBe('function');
+  expect(typeof Children.find).toBe('function');
+  expect(typeof Children.toKeyedArray).toBe('function');
+});
+
+it('ReactServer aggregates the new Children utilities', () => {
+  const {Children} = require('../ReactServer');
+  expect(typeof Children.reduce).toBe('function');
+  expect(typeof Children.filter).toBe('function');
+  expect(typeof Children.find).toBe('function');
+  expect(typeof Children.toKeyedArray).toBe('function');
