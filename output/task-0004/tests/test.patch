@@ -0,0 +1,86 @@
+'use strict';
+
+let React;
+
+beforeEach(() => {
+  jest.resetModules();
+  React = require('react');
+});
+
+it('filter selects primitive children into a flat array', () => {
+  expect(
+    React.Children.filter([1, [2, 3], 4], child => child % 2 === 0),
+  ).toEqual([2, 4]);
+});
+
+it('filter passes flattened indexes to its predicate', () => {
+  const calls = [];
+  React.Children.filter(['a', ['b', 'c']], (child, index) => {
+    calls.push([child, index]);
+    return true;
+  });
+  expect(calls).toEqual([
+    ['a', 0],
+    ['b', 1],
+    ['c', 2],
+  ]);
+});
+
+it('filter binds the optional predicate context', () => {
+  const context = {minimum: 3};
+  const result = React.Children.filter(
+    [1, 3, 5],
+    function (child) {
+      expect(this).toBe(context);
+      return child >= this.minimum;
+    },
+    context,
+  );
+  expect(result).toEqual([3, 5]);
+});
+
+it('filter rekeys surviving elements exactly like toArray', () => {
+  const children = [
+    React.createElement('span', {key: 'drop'}, 'drop'),
+    [React.createElement('span', null, 'keep')],
+    React.createElement('span', {key: 'also'}, 'also'),
+  ];
+  const flattened = React.Children.toArray(children);
+  const filtered = React.Children.filter(
+    children,
+    child => child.props.children !== 'drop',
+  );
+  expect(filtered.map(child => child.key)).toEqual([
+    flattened[1].key,
+    flattened[2].key,
+  ]);
+});
+
+it('filter leaves surviving strings and numbers unchanged', () => {
+  const text = 'text';
+  const result = React.Children.filter([text, 0, 2], () => true);
+  expect(result).toEqual(['text', 0, 2]);
+  expect(result[0]).toBe(text);
+  expect(typeof result[1]).toBe('number');
+});
+
+it('filter skips empty child values without invoking predicate', () => {
+  const visited = [];
+  const result = React.Children.filter(
+    [null, false, undefined, true, 'kept'],
+    child => {
+      visited.push(child);
+      return true;
+    },
+  );
+  expect(result).toEqual(['kept']);
+  expect(visited).toEqual(['kept']);
+});
+
+it('filter returns a new empty array when no child survives', () => {
+  const first = React.Children.filter([1, 2], () => false);
+  const second = React.Children.filter([1, 2], () => false);
+  expect(first).toEqual([]);
+  expect(second).toEqual([]);
+  expect(first).not.toBe(second);
+});
diff --git a/packages/react/src/__tests__/ReactChildrenFind-hidden-test.js b/packages/react/src/__tests__/ReactChildrenFind-hidden-test.js
