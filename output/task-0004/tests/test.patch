@@ -0,0 +1,100 @@
+'use strict';
+
+let React;
+
+beforeEach(() => {
+  jest.resetModules();
+  React = require('react');
+});
+
+function captureTraversal(run) {
+  const errors = [];
+  const warnings = [];
+  const originalError = console.error;
+  const originalWarn = console.warn;
+  console.error = (...args) => errors.push(args);
+  console.warn = (...args) => warnings.push(args);
+  let thrown;
+  try {
+    run();
+  } catch (error) {
+    thrown = error;
+  } finally {
+    console.error = originalError;
+    console.warn = originalWarn;
+  }
+  return {errors, warnings, thrown};
+}
+
+it('reduce follows the existing invalid plain-object path', () => {
+  const child = {invalid: true};
+  const baseline = captureTraversal(() =>
+    React.Children.forEach(child, () => {}),
+  );
+  const result = captureTraversal(() =>
+    React.Children.reduce(child, value => value, 0),
+  );
+  expect(Boolean(result.thrown)).toBe(Boolean(baseline.thrown));
+  expect(result.thrown && result.thrown.message).toBe(
+    baseline.thrown && baseline.thrown.message,
+  );
+  expect(result.errors).toEqual(baseline.errors);
+  expect(result.warnings).toEqual(baseline.warnings);
+});
+
+it('filter follows the existing invalid function-child path', () => {
+  const child = function InvalidChild() {};
+  const baseline = captureTraversal(() =>
+    React.Children.forEach(child, () => {}),
+  );
+  const result = captureTraversal(() =>
+    React.Children.filter(child, () => true),
+  );
+  expect(Boolean(result.thrown)).toBe(Boolean(baseline.thrown));
+  expect(result.errors).toEqual(baseline.errors);
+  expect(result.warnings).toEqual(baseline.warnings);
+});
+
+it('find preserves invalid plain-object diagnostics', () => {
+  const child = {first: 1, second: 2};
+  const baseline = captureTraversal(() => React.Children.toArray(child));
+  const result = captureTraversal(() =>
+    React.Children.find(child, () => false),
+  );
+  expect(Boolean(result.thrown)).toBe(Boolean(baseline.thrown));
+  expect(result.thrown && result.thrown.message).toBe(
+    baseline.thrown && baseline.thrown.message,
+  );
+  expect(result.errors).toEqual(baseline.errors);
+  expect(result.warnings).toEqual(baseline.warnings);
+});
+
+it('toKeyedArray preserves invalid plain-object diagnostics', () => {
+  const child = {first: 1, second: 2};
+  const baseline = captureTraversal(() => React.Children.toArray(child));
+  const result = captureTraversal(() =>
+    React.Children.toKeyedArray(child),
+  );
+  expect(Boolean(result.thrown)).toBe(Boolean(baseline.thrown));
+  expect(result.thrown && result.thrown.message).toBe(
+    baseline.thrown && baseline.thrown.message,
+  );
+  expect(result.errors).toEqual(baseline.errors);
+  expect(result.warnings).toEqual(baseline.warnings);
+});
+
+it('new utilities do not invoke callbacks for a function child', () => {
+  const child = function FunctionChild() {};
+  const reduceCallback = jest.fn();
+  const filterCallback = jest.fn();
+  const findCallback = jest.fn();
+  expect(React.Children.reduce(child, reduceCallback, 'initial')).toBe(
+    'initial',
+  );
+  expect(React.Children.filter(child, filterCallback)).toEqual([]);
+  expect(React.Children.find(child, findCallback)).toBeUndefined();
+  expect(React.Children.toKeyedArray(child)).toEqual([]);
+  expect(reduceCallback).not.toHaveBeenCalled();
+  expect(filterCallback).not.toHaveBeenCalled();
+  expect(findCallback).not.toHaveBeenCalled();
+});
diff --git a/packages/react/src/__tests__/ReactChildrenReduce-hidden-test.js b/packages/react/src/__tests__/ReactChildrenReduce-hidden-test.js
