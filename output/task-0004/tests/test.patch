+'use strict';
+
+let React;
+
+beforeEach(() => {
+  jest.resetModules();
+  React = require('react');
+});
+
+it('all functional utilities flatten nested arrays consistently', () => {
+  const children = ['a', [['b']], 'c'];
+  expect(
+    React.Children.reduce(
+      children,
+      (items, child) => items.concat(child),
+      [],
+    ),
+  ).toEqual(['a', 'b', 'c']);
+  expect(React.Children.filter(children, () => true)).toEqual([
+    'a',
+    'b',
+    'c',
+  ]);
+  expect(React.Children.find(children, child => child === 'b')).toBe('b');
+  expect(
+    React.Children.toKeyedArray(children).map(item => item.node),
+  ).toEqual(['a', 'b', 'c']);
+});
+
+it('all functional utilities handle a single numeric child', () => {
+  expect(React.Children.reduce(9, (sum, child) => sum + child, 1)).toBe(10);
+  expect(React.Children.filter(9, () => true)).toEqual([9]);
+  expect(React.Children.find(9, () => true)).toBe(9);
+  expect(React.Children.toKeyedArray(9)).toEqual([{key: '.0', node: 9}]);
+});
+
+it('all functional utilities produce empty results for null children', () => {
+  expect(React.Children.reduce(null, count => count + 1, 0)).toBe(0);
+  expect(React.Children.filter(null, () => true)).toEqual([]);
+  expect(React.Children.find(null, () => true)).toBeUndefined();
+  expect(React.Children.toKeyedArray(null)).toEqual([]);
+});
+
+it('callback indexes agree across reduce filter and find', () => {
+  const children = ['x', ['y', 'z']];
+  const reduceIndexes = [];
+  const filterIndexes = [];
+  const findIndexes = [];
+  React.Children.reduce(
+    children,
+    (value, child, index) => {
+      reduceIndexes.push(index);
+      return value;
+    },
+    null,
+  );
+  React.Children.filter(children, (child, index) => {
+    filterIndexes.push(index);
+    return true;
+  });
+  React.Children.find(children, (child, index) => {
+    findIndexes.push(index);
+    return false;
+  });
+  expect(reduceIndexes).toEqual([0, 1, 2]);
+  expect(filterIndexes).toEqual(reduceIndexes);
+  expect(findIndexes).toEqual(reduceIndexes);
+});
+
+it('new callback indexes match forEach over non-empty leaves', () => {
+  const children = ['x', ['y'], 3];
+  const expected = [];
+  const actual = [];
+  React.Children.forEach(children, (child, index) => {
+    expected.push([child, index]);
+  });
+  React.Children.reduce(
+    children,
+    (value, child, index) => {
+      actual.push([child, index]);
+      return value;
+    },
+    null,
+  );
+  expect(actual).toEqual(expected);
+});
+
+it('filter and toKeyedArray agree with toArray element keying', () => {
+  const children = [
+    React.createElement('div', {key: 'one'}),
+    [React.createElement('span')],
+  ];
+  const expected = React.Children.toArray(children);
+  const filtered = React.Children.filter(children, () => true);
+  const keyed = React.Children.toKeyedArray(children);
+  expect(filtered.map(child => child.key)).toEqual(
+    expected.map(child => child.key),
+  );
+  expect(keyed.map(item => item.node.key)).toEqual(
+    expected.map(child => child.key),
+  );
+});
diff --git a/packages/react/src/__tests__/ReactChildrenInvalidInputs-hidden-test.js b/packages/react/src/__tests__/ReactChildrenInvalidInputs-hidden-test.js
