+++ b/test_operations/gin/format_test.go
@@ -0,0 +1,34 @@
+package gin_test
+
+import (
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+)
+
+func contextWithAccept(accept string) *gin.Context { c, _ := gin.CreateTestContext(httptest.NewRecorder()); c.Request = httptest.NewRequest("GET", "/", nil); c.Request.Header.Set("Accept", accept); return c }
+
+func TestNegotiateFormatUsesQuality(t *testing.T) {
+	if got := contextWithAccept("text/plain;q=0.2, application/json;q=0.9").NegotiateFormat("text/plain", "application/json"); got != "application/json" { t.Fatalf("got %q", got) }
+}
+
+func TestNegotiateFormatUsesSubtypeWildcard(t *testing.T) {
+	if got := contextWithAccept("application/*").NegotiateFormat("text/plain", "application/json"); got != "application/json" { t.Fatalf("got %q", got) }
+}
+
+func TestNegotiateFormatUsesGlobalWildcard(t *testing.T) {
+	if got := contextWithAccept("*/*").NegotiateFormat("application/json", "text/plain"); got != "application/json" { t.Fatalf("got %q", got) }
+}
+
+func TestNegotiateFormatReturnsEmptyWhenExcluded(t *testing.T) {
+	if got := contextWithAccept("text/plain;q=0").NegotiateFormat("text/plain"); got != "" { t.Fatalf("got %q", got) }
+}
+
+func TestNegotiateFormatHonorsExplicitRejection(t *testing.T) {
+	if got := contextWithAccept("*/*;q=1, application/json;q=0").NegotiateFormat("application/json"); got != "" { t.Fatalf("got %q", got) }
+}
+
+func TestNegotiateFormatPreservesOfferOrder(t *testing.T) {
+	if got := contextWithAccept("application/*;q=1").NegotiateFormat("application/xml", "application/json"); got != "application/xml" { t.Fatalf("got %q", got) }
+}
diff --git a/test_operations/gin/negotiate_render_test.go b/test_operations/gin/negotiate_render_test.go
new file mode 100644
index 0000000..296506c
--- /dev/null
+++ b/test_operations/gin/negotiate_render_test.go
@@ -0,0 +1,53 @@
+package gin_test
+
+import (
+	"encoding/xml"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/gin-gonic/gin/render"
+)
+
+type xmlPayload struct {
+	XMLName xml.Name `xml:"item"`
+	OK      string   `xml:"ok"`
+}
+
+// The root element makes the XML renderer input valid for encoding/xml.
+
+func TestNegotiateRenderWritesJSON(t *testing.T) {
+	r := httptest.NewRecorder(); c, _ := gin.CreateTestContext(r); c.Request = httptest.NewRequest("GET", "/", nil); c.Request.Header.Set("Accept", "application/json")
+	if !c.NegotiateRender(http.StatusCreated, map[string]string{"ok": "yes"}, render.NewNegotiator(render.DefaultOffers()...)) { t.Fatal("negotiation failed") }
+	if r.Code != http.StatusCreated || r.Header().Get("Content-Type") == "" { t.Fatalf("unexpected response: %d %q", r.Code, r.Header().Get("Content-Type")) }
+}
+
+func TestNegotiateRenderWritesXML(t *testing.T) {
+	r := httptest.NewRecorder(); c, _ := gin.CreateTestContext(r); c.Request = httptest.NewRequest("GET", "/", nil); c.Request.Header.Set("Accept", "application/xml")
+	if !c.NegotiateRender(http.StatusAccepted, xmlPayload{OK: "yes"}, render.NewNegotiator(render.DefaultOffers()...)) { t.Fatal("negotiation failed") }
+	if r.Code != http.StatusAccepted || r.Header().Get("Content-Type") == "" { t.Fatalf("unexpected response: %d", r.Code) }
+}
+
+func TestNegotiateRenderReturnsNotAcceptable(t *testing.T) {
+	r := httptest.NewRecorder(); c, _ := gin.CreateTestContext(r); c.Request = httptest.NewRequest("GET", "/", nil); c.Request.Header.Set("Accept", "image/png")
+	if c.NegotiateRender(http.StatusOK, "value", render.NewNegotiator(render.DefaultOffers()...)) { t.Fatal("unexpected successful negotiation") }
+	if r.Code != http.StatusNotAcceptable { t.Fatalf("got status %d", r.Code) }
+}
+
+func TestNegotiateRenderUsesEngineNegotiator(t *testing.T) {
+	router := gin.New(); router.Negotiator = render.NewNegotiator(render.Offer{MediaType: "application/json", Factory: func(data any) render.Render { return &render.JSON{Data: data} }})
+	router.GET("/", func(c *gin.Context) { if !c.NegotiateRender(http.StatusOK, "value", nil) { t.Fatal("negotiation failed") } })
+	r := httptest.NewRecorder(); req := httptest.NewRequest("GET", "/", nil); req.Header.Set("Accept", "application/json"); router.ServeHTTP(r, req)
+	if r.Code != http.StatusOK { t.Fatalf("got status %d", r.Code) }
+}
+
+func TestNegotiateRenderUsesDefaultOffersWhenEngineUnset(t *testing.T) {
+	router := gin.New(); router.GET("/", func(c *gin.Context) { if !c.NegotiateRender(http.StatusOK, map[string]string{"ok": "yes"}, nil) { t.Fatal("negotiation failed") } })
+	r := httptest.NewRecorder(); req := httptest.NewRequest("GET", "/", nil); req.Header.Set("Accept", "application/json"); router.ServeHTTP(r, req)
+	if r.Code != http.StatusOK { t.Fatalf("got status %d", r.Code) }
+}
+
+func TestNegotiateRenderExposesNotAcceptableError(t *testing.T) {
+	if gin.ErrNotAcceptable == nil || gin.ErrNotAcceptable.Error() != "gin: no acceptable content type offered" { t.Fatal("unexpected error value") }
+}
diff --git a/test_operations/render/negotiator_test.go b/test_operations/render/negotiator_test.go
new file mode 100644
index 0000000..54c83dc
--- /dev/null
+++ b/test_operations/render/negotiator_test.go
@@ -0,0 +1,52 @@
+package render_test
+
+import (
+	"testing"
+
+	"github.com/gin-gonic/gin/render"
+)
+
+func TestNewNegotiatorMatchesQuality(t *testing.T) {
+	n := render.NewNegotiator(render.Offer{MediaType: "application/json", Factory: func(data any) render.Render { return &render.JSON{Data: data} }}, render.Offer{MediaType: "text/plain", Factory: func(data any) render.Render { return &render.String{Format: "%v", Data: []any{data}} }})
+	got, ok := n.Match("text/plain;q=0.2, application/json;q=0.9")
+	if !ok || got.MediaType != "application/json" || got.Factory == nil {
+		t.Fatalf("unexpected offer: %#v %v", got, ok)
+	}
+}
+
+func TestNegotiatorMatchesWildcards(t *testing.T) {
+	n := render.NewNegotiator(render.Offer{MediaType: "application/json", Factory: func(data any) render.Render { return &render.JSON{Data: data} }})
+	got, ok := n.Match("application/*")
+	if !ok || got.MediaType != "application/json" {
+		t.Fatalf("unexpected offer: %#v %v", got, ok)
+	}
+}
+
+func TestNegotiatorRejectsUnacceptable(t *testing.T) {
+	n := render.NewNegotiator(render.Offer{MediaType: "application/json", Factory: func(data any) render.Render { return &render.JSON{Data: data} }})
+	if _, ok := n.Match("text/plain"); ok {
+		t.Fatal("unacceptable media type matched")
+	}
+}
+
+func TestNegotiatorOffersReturnsRegistry(t *testing.T) {
+	offers := []render.Offer{{MediaType: "application/custom", Factory: func(data any) render.Render { return &render.JSON{Data: data} }}}
+	got := render.NewNegotiator(offers...).Offers()
+	if len(got) != 1 || got[0].MediaType != offers[0].MediaType || got[0].Factory == nil {
+		t.Fatalf("unexpected offers: %#v", got)
+	}
+}
+
+func TestDefaultOffersContainJSONXMLYAML(t *testing.T) {
+	seen := map[string]bool{}
+	for _, offer := range render.DefaultOffers() { seen[offer.MediaType] = offer.Factory != nil }
+	for _, mediaType := range []string{"application/json", "application/xml", "application/yaml", "application/toml", "text/plain"} {
+		if !seen[mediaType] { t.Fatalf("missing default offer %q", mediaType) }
+	}
+}
+
+func TestDefaultOffersMatchJSON(t *testing.T) {
+	n := render.NewNegotiator(render.DefaultOffers()...)
+	got, ok := n.Match("application/json")
+	if !ok || got.MediaType != "application/json" { t.Fatalf("unexpected offer: %#v %v", got, ok) }
+}
