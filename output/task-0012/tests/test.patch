@@ -0,0 +1,50 @@
+package binding_test
+
+import (
+	"net/http"
+	"testing"
+
+	"github.com/gin-gonic/gin/binding"
+)
+
+func TestPreferredJSONParameters(t *testing.T) {
+	if binding.Preferred("application/json; charset=utf-8") != binding.JSON {
+		t.Fatal("parameterized JSON was not preferred")
+	}
+}
+
+func TestPreferredXMLParameters(t *testing.T) {
+	if binding.Preferred("application/xml; charset=utf-8") != binding.XML {
+		t.Fatal("parameterized XML was not preferred")
+	}
+}
+
+func TestPreferredYAMLParameters(t *testing.T) {
+	if binding.Preferred("application/yaml; charset=utf-8") != binding.YAML {
+		t.Fatal("parameterized YAML was not preferred")
+	}
+}
+
+func TestPreferredUnknownReturnsNil(t *testing.T) {
+	if binding.Preferred("application/x-unknown") != nil {
+		t.Fatal("unknown type returned a binding")
+	}
+}
+
+func TestDefaultParameterizedJSON(t *testing.T) {
+	if binding.Default(http.MethodPost, "application/json; charset=utf-8") != binding.JSON {
+		t.Fatal("Default did not strip JSON parameters")
+	}
+}
+
+func TestDefaultParameterizedFormFallsBack(t *testing.T) {
+	if binding.Default(http.MethodPost, "application/x-www-form-urlencoded; charset=utf-8") != binding.Form {
+		t.Fatal("parameterized form did not preserve form binding")
+	}
+}
+
+func TestDefaultGetStillUsesForm(t *testing.T) {
+	if binding.Default(http.MethodGet, "application/json; charset=utf-8") != binding.Form {
+		t.Fatal("GET did not preserve form binding")
+	}
+}
