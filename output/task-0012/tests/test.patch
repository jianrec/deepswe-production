@@ -0,0 +1,39 @@
+package gin_test
+
+import (
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/gin-gonic/gin/render"
+)
+
+func TestEngineNegotiatorFieldIsConfigurable(t *testing.T) {
+	engine := gin.New(); negotiator := render.NewNegotiator(render.DefaultOffers()...); engine.Negotiator = negotiator
+	if engine.Negotiator != negotiator { t.Fatal("engine negotiator was not retained") }
+}
+
+func TestNegotiateFormatHandlesEmptyAccept(t *testing.T) {
+	c, _ := gin.CreateTestContext(httptest.NewRecorder()); c.Request = httptest.NewRequest("GET", "/", nil)
+	if got := c.NegotiateFormat("application/json", "text/plain"); got != "application/json" { t.Fatalf("got %q", got) }
+}
+
+func TestNegotiateFormatHandlesMalformedAccept(t *testing.T) {
+	c, _ := gin.CreateTestContext(httptest.NewRecorder()); c.Request = httptest.NewRequest("GET", "/", nil); c.Request.Header.Set("Accept", "broken, text/plain;q=0")
+	if got := c.NegotiateFormat("text/plain"); got != "" { t.Fatalf("got %q", got) }
+}
+
+func TestNegotiateFormatRanksSpecificRange(t *testing.T) {
+	c, _ := gin.CreateTestContext(httptest.NewRecorder()); c.Request = httptest.NewRequest("GET", "/", nil); c.Request.Header.Set("Accept", "*/*;q=1, application/json;q=1")
+	if got := c.NegotiateFormat("text/plain", "application/json"); got != "application/json" { t.Fatalf("got %q", got) }
+}
+
+func TestNegotiateFormatDoesNotMatchDifferentType(t *testing.T) {
+	c, _ := gin.CreateTestContext(httptest.NewRecorder()); c.Request = httptest.NewRequest("GET", "/", nil); c.Request.Header.Set("Accept", "application/*")
+	if got := c.NegotiateFormat("text/plain"); got != "" { t.Fatalf("got %q", got) }
+}
+
+func TestNegotiateFormatSupportsParameterizedAccept(t *testing.T) {
+	c, _ := gin.CreateTestContext(httptest.NewRecorder()); c.Request = httptest.NewRequest("GET", "/", nil); c.Request.Header.Set("Accept", "application/json; profile=compact")
+	if got := c.NegotiateFormat("application/json"); got != "application/json" { t.Fatalf("got %q", got) }
+}
diff --git a/test_operations/gin/format_test.go b/test_operations/gin/format_test.go
