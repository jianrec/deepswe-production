+++ b/test_operations/accept/match_test.go
@@ -0,0 +1,63 @@
+package accept_test
+
+import (
+	"testing"
+
+	"github.com/gin-gonic/gin/internal/accept"
+)
+
+func TestMediaRangeMatchesExactType(t *testing.T) {
+	m := accept.ParseAccept("application/json")[0]
+	if !m.Matches("application/json") {
+		t.Fatal("exact media type did not match")
+	}
+}
+
+func TestMediaRangeMatchesSubtypeWildcard(t *testing.T) {
+	m := accept.ParseAccept("application/*")[0]
+	if !m.Matches("application/xml") || m.Matches("text/xml") {
+		t.Fatal("subtype wildcard matching is incorrect")
+	}
+}
+
+func TestMediaRangeMatchesGlobalWildcard(t *testing.T) {
+	m := accept.ParseAccept("*/*")[0]
+	if !m.Matches("text/plain") || !m.Matches("application/json") {
+		t.Fatal("global wildcard did not match")
+	}
+}
+
+func TestMediaRangeZeroQualityRejects(t *testing.T) {
+	m := accept.ParseAccept("application/json;q=0")[0]
+	if m.Matches("application/json") {
+		t.Fatal("zero-quality range matched")
+	}
+}
+
+func TestNegotiateQualityPreference(t *testing.T) {
+	got := accept.Negotiate("text/plain;q=0.4, application/json;q=0.8", []string{"text/plain", "application/json"})
+	if got != "application/json" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestNegotiateOfferOrderTieBreak(t *testing.T) {
+	got := accept.Negotiate("*/*;q=1", []string{"text/plain", "application/json"})
+	if got != "text/plain" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestNegotiateRejectsZeroQualityOffer(t *testing.T) {
+	got := accept.Negotiate("*/*;q=1, application/json;q=0", []string{"application/json", "text/plain"})
+	if got != "text/plain" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestNegotiateEmptyHeaderUsesFirstOffer(t *testing.T) {
+	got := accept.Negotiate("", []string{"application/json", "text/plain"})
+	if got != "application/json" {
+		t.Fatalf("got %q", got)
+	}
+}
diff --git a/test_operations/accept/parse_test.go b/test_operations/accept/parse_test.go
new file mode 100644
index 0000000..3693aed
--- /dev/null
+++ b/test_operations/accept/parse_test.go
@@ -0,0 +1,48 @@
+package accept_test
+
+import (
+	"testing"
+
+	"github.com/gin-gonic/gin/internal/accept"
+)
+
+func TestParseAcceptQualityOrdering(t *testing.T) {
+	got := accept.ParseAccept("text/*;q=0.5, application/json;q=0.9, */*;q=0.1")
+	if len(got) != 3 || got[0].Type != "application" || got[0].Quality != 0.9 || got[1].Subtype != "*" || got[2].Type != "*" {
+		t.Fatalf("unexpected ranges: %#v", got)
+	}
+}
+
+func TestParseAcceptSpecificityOrdering(t *testing.T) {
+	got := accept.ParseAccept("*/*;q=1, application/*;q=1, application/json;q=1")
+	if len(got) != 3 || got[0].Subtype != "json" || got[1].Subtype != "*" || got[2].Type != "*" {
+		t.Fatalf("unexpected specificity order: %#v", got)
+	}
+}
+
+func TestParseAcceptParameters(t *testing.T) {
+	got := accept.ParseAccept("application/json; charset=utf-8; profile=compact;q=0.7")
+	if len(got) != 1 || got[0].Params["charset"] != "utf-8" || got[0].Params["profile"] != "compact" || got[0].Quality != 0.7 {
+		t.Fatalf("unexpected parsed parameters: %#v", got)
+	}
+}
+
+func TestParseAcceptWildcardRanges(t *testing.T) {
+	got := accept.ParseAccept("application/*, */*")
+	if len(got) != 2 || got[0].Type != "application" || got[0].Subtype != "*" || got[1].Type != "*" {
+		t.Fatalf("unexpected wildcards: %#v", got)
+	}
+}
+
+func TestParseAcceptSkipsMalformedSegments(t *testing.T) {
+	got := accept.ParseAccept("not-a-media-type, application/json;q=bad, text/plain")
+	if len(got) != 1 || got[0].Type != "text" || got[0].Subtype != "plain" {
+		t.Fatalf("malformed segments were not skipped: %#v", got)
+	}
+}
+
+func TestParseAcceptEmptyHeader(t *testing.T) {
+	if got := accept.ParseAccept(""); len(got) != 0 {
+		t.Fatalf("empty header produced ranges: %#v", got)
+	}
+}
diff --git a/test_operations/binding/preferred_test.go b/test_operations/binding/preferred_test.go
