+// Copyright 2024 Gin Core Team. All rights reserved.
+// Use of this source code is governed by a MIT style
+// license that can be found in the LICENSE file.
+
+package gin
+
+import (
+	"errors"
+	"net/http"
+
+	"github.com/gin-gonic/gin/render"
+)
+
+// ErrNotAcceptable indicates that content negotiation could not find a
+// representation acceptable to the client's Accept header.
+var ErrNotAcceptable = errors.New("gin: no acceptable content type offered")
+
+// NegotiateRender selects a renderer for the request's Accept header using the
+// supplied Negotiator, writes the negotiated representation with the given
+// status code and returns true.
+//
+// When no offered media type is acceptable it writes an HTTP 406 Not Acceptable
+// response and returns false.
+//
+// A nil Negotiator falls back to the Engine's configured Negotiator (if any),
+// and then to a Negotiator built from render.DefaultOffers().
+func (c *Context) NegotiateRender(code int, data any, n *render.Negotiator) bool {
+	if n == nil && c.engine != nil {
+		n = c.engine.Negotiator
+	}
+	if n == nil {
+		n = render.NewNegotiator(render.DefaultOffers()...)
+	}
+
+	accept := ""
+	if c.Request != nil {
+		accept = c.Request.Header.Get("Accept")
+	}
+
+	offer, ok := n.Match(accept)
+	if !ok {
+		c.Status(http.StatusNotAcceptable)
+		c.Writer.WriteHeaderNow()
+		return false
+	}
+
+	c.Render(code, offer.Factory(data))
+	return true
+}
