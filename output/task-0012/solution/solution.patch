new file mode 100644
index 0000000..c4cb30a
--- /dev/null
+++ b/render/negotiate.go
@@ -0,0 +1,84 @@
+// Copyright 2024 Gin Core Team. All rights reserved.
+// Use of this source code is governed by a MIT style
+// license that can be found in the LICENSE file.
+
+package render
+
+import "github.com/gin-gonic/gin/internal/accept"
+
+// RenderFactory builds a Render for the supplied data. It is used by a
+// Negotiator to lazily construct the concrete renderer once a media type has
+// been selected via content negotiation.
+type RenderFactory func(data any) Render
+
+// Offer associates a media type (e.g. "application/json") with a RenderFactory
+// able to produce the corresponding representation.
+type Offer struct {
+	MediaType string
+	Factory   RenderFactory
+}
+
+// Negotiator maps media types to renderer factories and selects the best offer
+// for a client's Accept header using the shared internal/accept engine.
+type Negotiator struct {
+	offers []Offer
+}
+
+// NewNegotiator returns a Negotiator built from the supplied offers, preserving
+// their order (used to break ties during negotiation).
+func NewNegotiator(offers ...Offer) *Negotiator {
+	return &Negotiator{offers: offers}
+}
+
+// Offers returns the registered offers in their original order.
+func (n *Negotiator) Offers() []Offer {
+	if n == nil {
+		return nil
+	}
+	return n.offers
+}
+
+// Match selects the best offer for the given Accept header. It returns the
+// matching Offer and true when an acceptable media type is found, or a zero
+// Offer and false otherwise.
+func (n *Negotiator) Match(accept string) (Offer, bool) {
+	if n == nil || len(n.offers) == 0 {
+		return Offer{}, false
+	}
+
+	mediaTypes := make([]string, len(n.offers))
+	for i := range n.offers {
+		mediaTypes[i] = n.offers[i].MediaType
+	}
+
+	best := acceptNegotiate(accept, mediaTypes)
+	if best == "" {
+		return Offer{}, false
+	}
+	for i := range n.offers {
+		if n.offers[i].MediaType == best {
+			return n.offers[i], true
+		}
+	}
+	return Offer{}, false
+}
+
+// acceptNegotiate delegates to the shared media-type engine.
+func acceptNegotiate(header string, offers []string) string {
+	return accept.Negotiate(header, offers)
+}
+
+// DefaultOffers returns the standard set of content-negotiation offers wired to
+// Gin's built-in renderers: JSON, XML (application/xml and text/xml), YAML,
+// TOML and plain text.
+func DefaultOffers() []Offer {
+	return []Offer{
+		{MediaType: "application/json", Factory: func(data any) Render { return JSON{Data: data} }},
+		{MediaType: "application/xml", Factory: func(data any) Render { return XML{Data: data} }},
+		{MediaType: "text/xml", Factory: func(data any) Render { return XML{Data: data} }},
+		{MediaType: "application/yaml", Factory: func(data any) Render { return YAML{Data: data} }},
+		{MediaType: "application/x-yaml", Factory: func(data any) Render { return YAML{Data: data} }},
+		{MediaType: "application/toml", Factory: func(data any) Render { return TOML{Data: data} }},
+		{MediaType: "text/plain", Factory: func(data any) Render { return String{Format: "%v", Data: []any{data}} }},
+	}
+}
