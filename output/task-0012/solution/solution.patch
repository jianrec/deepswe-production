new file mode 100644
index 0000000..5600eb7
--- /dev/null
+++ b/internal/accept/accept.go
@@ -0,0 +1,230 @@
+// Copyright 2024 Gin Core Team. All rights reserved.
+// Use of this source code is governed by a MIT style
+// license that can be found in the LICENSE file.
+
+// Package accept implements a small, shared media-type engine used to parse
+// HTTP Accept headers and negotiate a best offer from a caller-supplied list.
+//
+// Ranking follows the usual content-negotiation rules: descending quality
+// ("q=") values first, then descending media-range specificity (a fully
+// specified type beats "type/*", which beats "*/*"), and finally the caller's
+// offer order. A media range with q=0 explicitly rejects a match. Malformed
+// segments are skipped rather than causing a panic.
+package accept
+
+import (
+	"mime"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// MediaRange represents a single parsed entry of an Accept header, such as
+// "application/json;q=0.8".
+type MediaRange struct {
+	Type    string
+	Subtype string
+	Quality float64
+	Params  map[string]string
+}
+
+// ParseAccept parses an Accept header into an ordered slice of media ranges.
+// The result is sorted by descending quality, then descending specificity, and
+// finally by the order the ranges appeared in the header. Malformed segments
+// are skipped without panicking.
+func ParseAccept(header string) []MediaRange {
+	header = strings.TrimSpace(header)
+	if header == "" {
+		return nil
+	}
+
+	parts := strings.Split(header, ",")
+
+	type indexed struct {
+		mr  MediaRange
+		idx int
+	}
+	items := make([]indexed, 0, len(parts))
+
+	for i, part := range parts {
+		part = strings.TrimSpace(part)
+		if part == "" {
+			continue
+		}
+
+		mediaType, params, err := mime.ParseMediaType(part)
+		if err != nil {
+			// Go's parser rejects duplicate parameters, while deployed clients
+			// commonly send duplicate q values. Recover the media type and the
+			// last q value without accepting malformed q tokens.
+			semi := strings.IndexByte(part, ';')
+			if semi <= 0 {
+				continue
+			}
+			mediaType = strings.TrimSpace(part[:semi])
+			params = map[string]string{}
+			for _, raw := range strings.Split(part[semi+1:], ";") {
+				kv := strings.SplitN(strings.TrimSpace(raw), "=", 2)
+				if len(kv) == 2 {
+					params[strings.ToLower(strings.TrimSpace(kv[0]))] = strings.Trim(strings.TrimSpace(kv[1]), "\"")
+				}
+			}
+		}
+
+		typ, sub := splitMediaType(mediaType)
+		if typ == "" {
+			continue
+		}
+
+		quality := 1.0
+		if q, ok := params["q"]; ok {
+			qv, perr := strconv.ParseFloat(strings.TrimSpace(q), 64)
+			if perr != nil {
+				continue
+			}
+			quality = qv
+			delete(params, "q")
+		}
+		if quality < 0 {
+			quality = 0
+		}
+		if quality > 1 {
+			quality = 1
+		}
+
+		items = append(items, indexed{
+			mr: MediaRange{
+				Type:    typ,
+				Subtype: sub,
+				Quality: quality,
+				Params:  params,
+			},
+			idx: i,
+		})
+	}
+
+	sort.SliceStable(items, func(a, b int) bool {
+		if items[a].mr.Quality != items[b].mr.Quality {
+			return items[a].mr.Quality > items[b].mr.Quality
+		}
+		sa, sb := specificity(items[a].mr), specificity(items[b].mr)
+		if sa != sb {
+			return sa > sb
+		}
+		return items[a].idx < items[b].idx
+	})
+
+	ranges := make([]MediaRange, 0, len(items))
+	for _, it := range items {
+		ranges = append(ranges, it.mr)
+	}
+	return ranges
+}
+
+// Matches reports whether the given media type (e.g. "application/json") is
+// matched by the media range, honoring wildcards. A media range with q=0 never
+// matches.
+func (m MediaRange) Matches(mediaType string) bool {
+	if m.Quality <= 0 {
+		return false
+	}
+	return m.structuralMatch(mediaType)
+}
+
+// structuralMatch reports whether the media type is matched by the range's
+// type/subtype (honoring wildcards) without considering the quality value.
+func (m MediaRange) structuralMatch(mediaType string) bool {
+	mt := mediaType
+	if parsed, _, err := mime.ParseMediaType(mediaType); err == nil {
+		mt = parsed
+	}
+	typ, sub := splitMediaType(mt)
+	if typ == "" {
+		return false
+	}
+
+	if m.Type == "*" {
+		return true
+	}
+	if !strings.EqualFold(m.Type, typ) {
+		return false
+	}
+	if m.Subtype == "*" || m.Subtype == "" {
+		return true
+	}
+	return strings.EqualFold(m.Subtype, sub)
+}
+
+// Negotiate returns the best matching offer for the supplied Accept header.
+// It honors q-values and wildcards. An empty header (or "*/*") returns the
+// first offer. When the header is present but nothing is acceptable, it
+// returns the empty string.
+func Negotiate(header string, offers []string) string {
+	if len(offers) == 0 {
+		return ""
+	}
+
+	header = strings.TrimSpace(header)
+	if header == "" || header == "*/*" {
+		return offers[0]
+	}
+
+	ranges := ParseAccept(header)
+	if len(ranges) == 0 {
+		return offers[0]
+	}
+
+	bestOffer := ""
+	bestQuality := 0.0
+	bestOfferSpecificity := -1
+	for _, offer := range offers {
+		// Determine the most specific structurally-matching range for this
+		// offer; its quality (which may be 0, i.e. an explicit rejection)
+		// governs whether the offer is acceptable.
+		bestSpec := -1
+		quality := 0.0
+		matched := false
+		for i := range ranges {
+			if !ranges[i].structuralMatch(offer) {
+				continue
+			}
+			s := specificity(ranges[i])
+			if s > bestSpec || (s == bestSpec && ranges[i].Quality > quality) {
+				bestSpec = s
+				quality = ranges[i].Quality
+				matched = true
+			}
+		}
+
+		if !matched || quality <= 0 {
+			continue
+		}
+		if quality > bestQuality || (quality == bestQuality && bestSpec > bestOfferSpecificity) {
+			bestQuality = quality
+			bestOfferSpecificity = bestSpec
+			bestOffer = offer
+		}
+	}
+	return bestOffer
+}
+
+// splitMediaType splits a "type/subtype" media type into its two components.
+func splitMediaType(mediaType string) (typ, sub string) {
+	mediaType = strings.TrimSpace(mediaType)
+	if slash := strings.IndexByte(mediaType, '/'); slash > 0 && slash < len(mediaType)-1 {
+		return mediaType[:slash], mediaType[slash+1:]
+	}
+	return "", ""
+}
+
+// specificity ranks a media range: a fully specified type (2) is more specific
+// than "type/*" (1), which is more specific than "*/*" (0).
+func specificity(m MediaRange) int {
+	if m.Type == "*" {
+		return 0
+	}
+	if m.Subtype == "*" || m.Subtype == "" {
+		return 1
+	}
+	return 2
+}
