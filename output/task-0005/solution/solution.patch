+    assert_eq!(
+        serde_json::to_string(&LimitReason::MaxWallTime).unwrap(),
+        "\"max_wall_time\""
+    );
+    let parsed: LimitReason = serde_json::from_str("\"max_wall_time\"").unwrap();
+    assert_eq!(parsed, LimitReason::MaxWallTime);
+}
+
+#[test]
+fn reached_event_serializes_with_flat_type_tag() {
+    let event = crate::exec_events::RunLimitReachedEvent {
+        reason: LimitReason::MaxCommands,
+        commands_started: 3,
+        elapsed_ms: 250,
+        max_commands: Some(3),
+        max_wall_time_ms: Some(1_000),
+    };
+    let value = serde_json::to_value(crate::exec_events::ThreadEvent::RunLimitReached(event))
+        .expect("serialize run-limit event");
+
+    assert_eq!(
+        value,
+        serde_json::json!({
+            "type": "run_limit_reached",
+            "reason": "max_commands",
+            "commands_started": 3,
+            "elapsed_ms": 250,
+            "max_commands": 3,
+            "max_wall_time_ms": 1000
+        })
+    );
+}
