+/// TOML representation of the `[exec]` run-limit table.
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
+#[schemars(deny_unknown_fields)]
+pub struct ExecLimitsToml {
+    /// Maximum number of shell/tool command executions before the run is stopped.
+    pub max_commands: Option<u64>,
+    /// Maximum elapsed wall-clock time before the run is stopped. Accepts a bare
+    /// integer (seconds) or a suffixed value using `ms`, `s`, `m`, or `h`.
+    pub max_wall_time: Option<String>,
+}
+
+/// Resolved `[exec]` run limits with the wall-time string parsed to a Duration.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct ExecLimits {
+    pub max_commands: Option<u64>,
+    pub max_wall_time: Option<std::time::Duration>,
+}
+
+impl ExecLimits {
+    /// Resolve a [`ExecLimitsToml`] into [`ExecLimits`], parsing the wall-time
+    /// string. Returns an error string if the duration is unparseable.
+    pub fn from_toml(toml: &ExecLimitsToml) -> Result<Self, String> {
+        if toml.max_commands == Some(0) {
+            return Err("max_commands must be greater than zero".to_string());
+        }
+        let max_wall_time = match toml.max_wall_time.as_deref() {
+            Some(raw) => Some(parse_wall_time(raw)?),
+            None => None,
+        };
+        Ok(Self {
+            max_commands: toml.max_commands,
+            max_wall_time,
+        })
+    }
+}
+
+/// Parse a wall-time DURATION string. Accepts a bare integer (seconds) or a
+/// suffixed value using `ms`, `s`, `m`, or `h`. Rejects zero, empty, negative,
+/// and otherwise unparseable input.
+pub fn parse_wall_time(raw: &str) -> Result<std::time::Duration, String> {
+    let trimmed = raw.trim();
+    if trimmed.is_empty() {
+        return Err("max_wall_time must not be empty".to_string());
+    }
+
+    let (value_str, multiplier_ms): (&str, u64) = if let Some(rest) = trimmed.strip_suffix("ms") {
+        (rest.trim(), 1)
+    } else if let Some(rest) = trimmed.strip_suffix('s') {
+        (rest.trim(), 1_000)
+    } else if let Some(rest) = trimmed.strip_suffix('m') {
+        (rest.trim(), 60_000)
+    } else if let Some(rest) = trimmed.strip_suffix('h') {
+        (rest.trim(), 3_600_000)
+    } else {
+        (trimmed, 1_000)
+    };
+
+    let value: u64 = value_str
+        .parse()
+        .map_err(|_| format!("invalid max_wall_time value: {raw:?}"))?;
+    let millis = value
+        .checked_mul(multiplier_ms)
+        .ok_or_else(|| format!("max_wall_time is too large: {raw:?}"))?;
+    if millis == 0 {
+        return Err("max_wall_time must be greater than zero".to_string());
+    }
+    Ok(std::time::Duration::from_millis(millis))
+}
