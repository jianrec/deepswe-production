+++ b/codex-rs/exec/src/limits.rs
@@ -0,0 +1,155 @@
+//! Pure, unit-testable run-limit accounting for `codex exec`.
+//!
+//! [`LimitTracker`] counts command starts observed on the event stream and
+//! evaluates whether a configured limit has been reached against a monotonic
+//! clock. `max_commands` takes precedence over `max_wall_time` when both
+//! trigger, giving deterministic reason selection.
+
+use std::time::Duration;
+use std::time::Instant;
+
+use serde::Deserialize;
+use serde::Serialize;
+
+/// Resolved run limits for a single `codex exec` invocation.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct RunLimits {
+    pub max_commands: Option<u64>,
+    pub max_wall_time: Option<Duration>,
+}
+
+impl RunLimits {
+    /// True when no limit is configured and the run is unbounded.
+    pub fn is_unbounded(&self) -> bool {
+        self.max_commands.is_none() && self.max_wall_time.is_none()
+    }
+
+    /// Bridge resolved config limits into exec run limits.
+    pub fn from_exec_limits(limits: &codex_config::ExecLimits) -> RunLimits {
+        RunLimits {
+            max_commands: limits.max_commands,
+            max_wall_time: limits.max_wall_time,
+        }
+    }
+
+    /// Configured max wall-time expressed in milliseconds, if any.
+    pub fn max_wall_time_ms(&self) -> Option<u64> {
+        self.max_wall_time
+            .map(|duration| duration.as_millis().min(u128::from(u64::MAX)) as u64)
+    }
+}
+
+/// Reason a run was stopped because a limit was reached.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum LimitReason {
+    MaxCommands,
+    MaxWallTime,
+}
+
+impl LimitReason {
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            LimitReason::MaxCommands => "max_commands",
+            LimitReason::MaxWallTime => "max_wall_time",
+        }
+    }
+}
+
+/// Pure accounting for run limits. Counts command starts and evaluates the
+/// active reason against a monotonic clock.
+#[derive(Clone, Copy, Debug)]
+pub struct LimitTracker {
+    limits: RunLimits,
+    started_at: Instant,
+    commands_started: u64,
+    stopped: bool,
+}
+
+impl LimitTracker {
+    pub fn new(limits: RunLimits, started_at: Instant) -> Self {
+        Self {
+            limits,
+            started_at,
+            commands_started: 0,
+            stopped: false,
+        }
+    }
+
+    /// Record that a shell/tool command execution has started.
+    pub fn record_command_started(&mut self) {
+        self.commands_started = self.commands_started.saturating_add(1);
+    }
+
+    /// Number of command executions observed so far.
+    pub fn commands_started(&self) -> u64 {
+        self.commands_started
+    }
+
+    /// Monotonic start instant for the run.
+    pub fn started_at(&self) -> Instant {
+        self.started_at
+    }
+
+    /// Configured limits for the run.
+    pub fn limits(&self) -> RunLimits {
+        self.limits
+    }
+
+    /// True when no limit is configured and the run is unbounded.
+    pub fn is_unbounded(&self) -> bool {
+        self.limits.is_unbounded()
+    }
+
+    /// Mark that the run has been stopped because a limit was reached.
+    pub fn mark_stopped(&mut self) {
+        self.stopped = true;
+    }
+
+    /// True once [`LimitTracker::mark_stopped`] has been called.
+    pub fn is_stopped(&self) -> bool {
+        self.stopped
+    }
+
+    /// Elapsed wall-clock time since the run started, in milliseconds.
+    pub fn elapsed_ms(&self, now: Instant) -> u64 {
+        now.saturating_duration_since(self.started_at)
+            .as_millis()
+            .min(u128::from(u64::MAX)) as u64
+    }
+
+    /// Build the structured payload describing the reached limit.
+    pub fn to_reached_event(
+        &self,
+        reason: LimitReason,
+        now: Instant,
+    ) -> crate::exec_events::RunLimitReachedEvent {
+        crate::exec_events::RunLimitReachedEvent {
+            reason,
+            commands_started: self.commands_started,
+            elapsed_ms: self.elapsed_ms(now),
+            max_commands: self.limits.max_commands,
+            max_wall_time_ms: self.limits.max_wall_time_ms(),
+        }
+    }
+
+    /// Evaluate the active limit reason, if any. `max_commands` takes
+    /// precedence over `max_wall_time` when both are satisfied.
+    pub fn evaluate(&self, now: Instant) -> Option<LimitReason> {
+        if let Some(max_commands) = self.limits.max_commands
+            && self.commands_started >= max_commands
+        {
+            return Some(LimitReason::MaxCommands);
+        }
+        if let Some(max_wall_time) = self.limits.max_wall_time
+            && now.saturating_duration_since(self.started_at) >= max_wall_time
+        {
+            return Some(LimitReason::MaxWallTime);
+        }
+        None
+    }
+}
