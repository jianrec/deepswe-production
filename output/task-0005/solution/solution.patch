+/// Validate a `--max-wall-time` value at parse time so unparseable durations
+/// fail before the run starts, while preserving the raw string for later
+/// re-parsing alongside config values.
+fn parse_wall_time_arg(raw: &str) -> Result<String, String> {
+    codex_config::parse_wall_time(raw)?;
+    Ok(raw.to_string())
+}
+
+/// Validate a `--max-commands` value at parse time. Zero is rejected because a
+/// run allowed zero commands is meaningless and must fail before starting.
+fn parse_max_commands_arg(raw: &str) -> Result<u64, String> {
+    let value: u64 = raw
+        .trim()
+        .parse()
+        .map_err(|_| format!("invalid max_commands value: {raw:?}"))?;
+    if value == 0 {
+        return Err("max_commands must be greater than zero".to_string());
+    }
+    Ok(value)
+}
