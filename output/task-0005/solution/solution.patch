+use super::ExecLimits;
+use super::ExecLimitsToml;
+use super::parse_wall_time;
+use std::time::Duration;
+
+#[test]
+fn parse_wall_time_bare_seconds() {
+    assert_eq!(parse_wall_time("30").unwrap(), Duration::from_secs(30));
+}
+
+#[test]
+fn parse_wall_time_millis() {
+    assert_eq!(
+        parse_wall_time("500ms").unwrap(),
+        Duration::from_millis(500)
+    );
+}
+
+#[test]
+fn parse_wall_time_seconds_suffix() {
+    assert_eq!(parse_wall_time("90s").unwrap(), Duration::from_secs(90));
+}
+
+#[test]
+fn parse_wall_time_minutes() {
+    assert_eq!(parse_wall_time("10m").unwrap(), Duration::from_secs(600));
+}
+
+#[test]
+fn parse_wall_time_hours() {
+    assert_eq!(parse_wall_time("2h").unwrap(), Duration::from_secs(7200));
+}
+
+#[test]
+fn parse_wall_time_rejects_zero() {
+    assert!(parse_wall_time("0").is_err());
+    assert!(parse_wall_time("0ms").is_err());
+}
+
+#[test]
+fn parse_wall_time_rejects_empty() {
+    assert!(parse_wall_time("").is_err());
+    assert!(parse_wall_time("   ").is_err());
+}
+
+#[test]
+fn parse_wall_time_rejects_negative() {
+    assert!(parse_wall_time("-5").is_err());
+    assert!(parse_wall_time("-5s").is_err());
+}
+
+#[test]
+fn parse_wall_time_rejects_garbage() {
+    assert!(parse_wall_time("abc").is_err());
+    assert!(parse_wall_time("10x").is_err());
+    assert!(parse_wall_time("1.5s").is_err());
+}
+
+#[test]
+fn exec_limits_from_toml_parses_duration() {
+    let toml = ExecLimitsToml {
+        max_commands: Some(3),
+        max_wall_time: Some("90s".to_string()),
+    };
+    let resolved = ExecLimits::from_toml(&toml).unwrap();
+    assert_eq!(resolved.max_commands, Some(3));
+    assert_eq!(resolved.max_wall_time, Some(Duration::from_secs(90)));
+}
+
+#[test]
+fn exec_limits_from_toml_defaults_empty() {
+    let resolved = ExecLimits::from_toml(&ExecLimitsToml::default()).unwrap();
+    assert_eq!(resolved, ExecLimits::default());
+    assert!(resolved.max_commands.is_none());
+    assert!(resolved.max_wall_time.is_none());
+}
+
+#[test]
+fn exec_limits_from_toml_propagates_error() {
+    let toml = ExecLimitsToml {
+        max_commands: None,
+        max_wall_time: Some("0".to_string()),
+    };
+    assert!(ExecLimits::from_toml(&toml).is_err());
+}
+
+#[test]
+fn exec_limits_from_toml_rejects_zero_commands() {
+    let toml = ExecLimitsToml {
+        max_commands: Some(0),
+        max_wall_time: None,
+    };
+    assert_eq!(
+        ExecLimits::from_toml(&toml),
+        Err("max_commands must be greater than zero".to_string())
+    );
+}
