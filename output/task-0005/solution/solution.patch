+        Ok(response) => response,
+        Err(_) => {
+            let now = std::time::Instant::now();
+            let event = limit_tracker.to_reached_event(LimitReason::MaxWallTime, now);
+            limit_tracker.mark_stopped();
+            let _ = event_processor.process_run_limit_reached(event);
+            event_processor.print_final_output();
+            std::process::exit(EXIT_CODE_RUN_LIMIT_REACHED);
