+use super::*;
+use std::time::Duration;
+use std::time::Instant;
+
+fn base() -> Instant {
+    Instant::now()
+}
+
+#[test]
+fn run_limits_default_is_unbounded() {
+    let limits = RunLimits::default();
+    assert!(limits.is_unbounded());
+    assert_eq!(limits.max_wall_time_ms(), None);
+}
+
+#[test]
+fn run_limits_from_exec_limits_bridges_fields() {
+    let exec_limits = codex_config::ExecLimits {
+        max_commands: Some(4),
+        max_wall_time: Some(Duration::from_secs(30)),
+    };
+    let limits = RunLimits::from_exec_limits(&exec_limits);
+    assert_eq!(limits.max_commands, Some(4));
+    assert_eq!(limits.max_wall_time, Some(Duration::from_secs(30)));
+    assert_eq!(limits.max_wall_time_ms(), Some(30_000));
+    assert!(!limits.is_unbounded());
+}
+
+#[test]
+fn tracker_starts_with_zero_commands() {
+    let tracker = LimitTracker::new(RunLimits::default(), base());
+    assert_eq!(tracker.commands_started(), 0);
+    assert!(tracker.is_unbounded());
+    assert!(!tracker.is_stopped());
+}
+
+#[test]
+fn tracker_counts_command_starts() {
+    let mut tracker = LimitTracker::new(
+        RunLimits {
+            max_commands: Some(3),
+            max_wall_time: None,
+        },
+        base(),
+    );
+    tracker.record_command_started();
+    tracker.record_command_started();
+    assert_eq!(tracker.commands_started(), 2);
+}
+
+#[test]
+fn unbounded_tracker_never_triggers() {
+    let start = base();
+    let tracker = LimitTracker::new(RunLimits::default(), start);
+    assert_eq!(tracker.evaluate(start), None);
+    assert_eq!(tracker.evaluate(start + Duration::from_secs(3600)), None);
+}
+
+#[test]
+fn max_commands_triggers_after_nth_start() {
+    let start = base();
+    let mut tracker = LimitTracker::new(
+        RunLimits {
+            max_commands: Some(2),
+            max_wall_time: None,
+        },
+        start,
+    );
+    assert_eq!(tracker.evaluate(start), None);
+    tracker.record_command_started();
+    assert_eq!(tracker.evaluate(start), None);
+    tracker.record_command_started();
+    assert_eq!(tracker.evaluate(start), Some(LimitReason::MaxCommands));
+}
+
+#[test]
+fn max_wall_time_triggers_at_threshold() {
+    let start = base();
+    let tracker = LimitTracker::new(
+        RunLimits {
+            max_commands: None,
+            max_wall_time: Some(Duration::from_millis(50)),
+        },
+        start,
+    );
+    assert_eq!(tracker.evaluate(start), None);
+    assert_eq!(tracker.evaluate(start + Duration::from_millis(49)), None);
+    assert_eq!(
+        tracker.evaluate(start + Duration::from_millis(50)),
+        Some(LimitReason::MaxWallTime)
+    );
+}
+
+#[test]
+fn max_commands_takes_precedence_over_wall_time() {
+    let start = base();
+    let mut tracker = LimitTracker::new(
+        RunLimits {
+            max_commands: Some(1),
+            max_wall_time: Some(Duration::from_millis(1)),
+        },
+        start,
+    );
+    tracker.record_command_started();
+    assert_eq!(
+        tracker.evaluate(start + Duration::from_secs(10)),
+        Some(LimitReason::MaxCommands)
+    );
+}
+
+#[test]
+fn elapsed_ms_is_saturating() {
+    let start = base();
+    let tracker = LimitTracker::new(RunLimits::default(), start);
+    assert_eq!(tracker.elapsed_ms(start), 0);
+    assert_eq!(tracker.elapsed_ms(start + Duration::from_millis(250)), 250);
+    assert_eq!(tracker.elapsed_ms(start), 0);
+}
+
+#[test]
+fn to_reached_event_captures_state() {
+    let start = base();
+    let mut tracker = LimitTracker::new(
+        RunLimits {
+            max_commands: Some(2),
+            max_wall_time: Some(Duration::from_secs(5)),
+        },
+        start,
+    );
+    tracker.record_command_started();
+    tracker.record_command_started();
+    let event =
+        tracker.to_reached_event(LimitReason::MaxCommands, start + Duration::from_millis(10));
+    assert_eq!(event.reason, LimitReason::MaxCommands);
+    assert_eq!(event.commands_started, 2);
+    assert_eq!(event.elapsed_ms, 10);
+    assert_eq!(event.max_commands, Some(2));
+    assert_eq!(event.max_wall_time_ms, Some(5_000));
+}
+
+#[test]
+fn mark_stopped_sets_flag() {
+    let mut tracker = LimitTracker::new(RunLimits::default(), base());
+    assert!(!tracker.is_stopped());
+    tracker.mark_stopped();
+    assert!(tracker.is_stopped());
+}
+
+#[test]
+fn limit_reason_as_str_is_stable() {
+    assert_eq!(LimitReason::MaxCommands.as_str(), "max_commands");
+    assert_eq!(LimitReason::MaxWallTime.as_str(), "max_wall_time");
+}
+
+#[test]
+fn limit_reason_serializes_snake_case() {
+    assert_eq!(
+        serde_json::to_string(&LimitReason::MaxCommands).unwrap(),
+        "\"max_commands\""
