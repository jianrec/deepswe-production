+#[path = "support/exec_limits.rs"]
+mod support;
+
+use std::fs;
+use std::time::Duration;
+use support::MockResponsesServer;
+use support::assistant_response;
+use support::command_response;
+use support::limit_events;
+use support::run_codex;
+use support::shell_write_command;
+use support::test_home;
+
+#[test]
+fn config_max_commands_is_honored() {
+    let marker_dir = tempfile::tempdir().unwrap();
+    let command = shell_write_command(&marker_dir.path().join("first"), "yes", 20);
+    let server =
+        MockResponsesServer::start(vec![(Duration::ZERO, command_response("call-1", &command))]);
+    let home = test_home(&server, Some("[exec]\nmax_commands = 1\n"));
+    let output = run_codex(
+        home.path(),
+        &["exec", "--json", "--skip-git-repo-check", "run"],
+    );
+    assert_eq!(output.status.code(), Some(7));
+    assert_eq!(limit_events(&output)[0]["max_commands"], 1);
+}
+
+#[test]
+fn config_max_wall_time_is_honored() {
+    let server =
+        MockResponsesServer::start(vec![(Duration::from_secs(2), assistant_response("late"))]);
+    let home = test_home(&server, Some("[exec]\nmax_wall_time = '100ms'\n"));
+    let output = run_codex(
+        home.path(),
+        &["exec", "--json", "--skip-git-repo-check", "wait"],
+    );
+    assert_eq!(output.status.code(), Some(7));
+    assert_eq!(limit_events(&output)[0]["reason"], "max_wall_time");
+}
+
+#[test]
+fn cli_max_commands_overrides_config_value() {
+    let marker_dir = tempfile::tempdir().unwrap();
+    let first_marker = marker_dir.path().join("first");
+    let second_marker = marker_dir.path().join("second");
+    let first = shell_write_command(&first_marker, "one", 20);
+    let second = shell_write_command(&second_marker, "two", 20);
+    let server = MockResponsesServer::start(vec![
+        (Duration::ZERO, command_response("call-1", &first)),
+        (Duration::ZERO, command_response("call-2", &second)),
+    ]);
+    let home = test_home(&server, Some("[exec]\nmax_commands = 1\n"));
+    let output = run_codex(
+        home.path(),
+        &[
+            "exec",
+            "--json",
+            "--skip-git-repo-check",
+            "--max-commands",
+            "2",
+            "run twice",
+        ],
+    );
+    assert_eq!(output.status.code(), Some(7));
+    assert_eq!(fs::read_to_string(first_marker).unwrap(), "one");
+    assert_eq!(fs::read_to_string(second_marker).unwrap(), "two");
+    let events = limit_events(&output);
+    assert_eq!(events.len(), 1);
+    assert_eq!(events[0]["commands_started"], 2);
+    assert_eq!(events[0]["max_commands"], 2);
+}
+
+#[test]
+fn cli_max_wall_time_overrides_config_value() {
+    let server = MockResponsesServer::start(vec![(
+        Duration::from_millis(300),
+        assistant_response("done"),
+    )]);
+    let home = test_home(&server, Some("[exec]\nmax_wall_time = '50ms'\n"));
+    let output = run_codex(
+        home.path(),
+        &[
+            "exec",
+            "--json",
+            "--skip-git-repo-check",
+            "--max-wall-time",
+            "5s",
+            "finish",
+        ],
+    );
+    assert_eq!(output.status.code(), Some(0));
+    assert!(limit_events(&output).is_empty());
+}
+
+#[test]
+fn default_unbounded_run_has_no_limit_event() {
+    let server = MockResponsesServer::start(vec![(Duration::ZERO, assistant_response("done"))]);
+    let home = test_home(&server, None);
+    let output = run_codex(
+        home.path(),
+        &["exec", "--json", "--skip-git-repo-check", "finish"],
+    );
+    assert_eq!(output.status.code(), Some(0));
+    assert!(limit_events(&output).is_empty());
+}
