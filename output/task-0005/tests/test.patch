@@ -0,0 +1,168 @@
+use codex_exec::limits::LimitReason;
+use codex_exec::limits::LimitTracker;
+use codex_exec::limits::RunLimits;
+use std::time::Duration;
+use std::time::Instant;
+
+fn new_tracker(limits: RunLimits) -> (LimitTracker, Instant) {
+    let started_at = Instant::now();
+    (LimitTracker::new(limits, started_at), started_at)
+}
+
+#[test]
+fn no_limits_are_unbounded() {
+    assert!(
+        RunLimits {
+            max_commands: None,
+            max_wall_time: None,
+        }
+        .is_unbounded()
+    );
+}
+
+#[test]
+fn command_limit_is_bounded() {
+    assert!(
+        !RunLimits {
+            max_commands: Some(2),
+            max_wall_time: None,
+        }
+        .is_unbounded()
+    );
+}
+
+#[test]
+fn wall_limit_is_bounded() {
+    assert!(
+        !RunLimits {
+            max_commands: None,
+            max_wall_time: Some(Duration::from_secs(2)),
+        }
+        .is_unbounded()
+    );
+}
+
+#[test]
+fn tracker_initially_reports_zero_commands() {
+    let (tracker, _) = new_tracker(RunLimits {
+        max_commands: Some(3),
+        max_wall_time: None,
+    });
+    assert_eq!(tracker.commands_started(), 0);
+}
+
+#[test]
+fn record_command_started_increments_count() {
+    let (mut tracker, _) = new_tracker(RunLimits {
+        max_commands: Some(3),
+        max_wall_time: None,
+    });
+    tracker.record_command_started();
+    assert_eq!(tracker.commands_started(), 1);
+}
+
+#[test]
+fn command_count_is_monotonic() {
+    let (mut tracker, _) = new_tracker(RunLimits {
+        max_commands: Some(10),
+        max_wall_time: None,
+    });
+    for expected in 1..=10 {
+        tracker.record_command_started();
+        assert_eq!(tracker.commands_started(), expected);
+    }
+}
+
+#[test]
+fn command_limit_is_inactive_before_threshold() {
+    let (mut tracker, started_at) = new_tracker(RunLimits {
+        max_commands: Some(2),
+        max_wall_time: None,
+    });
+    tracker.record_command_started();
+    assert_eq!(tracker.evaluate(started_at), None);
+}
+
+#[test]
+fn command_limit_is_active_at_threshold() {
+    let (mut tracker, started_at) = new_tracker(RunLimits {
+        max_commands: Some(2),
+        max_wall_time: None,
+    });
+    tracker.record_command_started();
+    tracker.record_command_started();
+    assert_eq!(tracker.evaluate(started_at), Some(LimitReason::MaxCommands));
+}
+
+#[test]
+fn command_limit_remains_active_after_threshold() {
+    let (mut tracker, started_at) = new_tracker(RunLimits {
+        max_commands: Some(1),
+        max_wall_time: None,
+    });
+    tracker.record_command_started();
+    tracker.record_command_started();
+    assert_eq!(tracker.evaluate(started_at), Some(LimitReason::MaxCommands));
+}
+
+#[test]
+fn wall_limit_is_inactive_before_boundary() {
+    let (tracker, started_at) = new_tracker(RunLimits {
+        max_commands: None,
+        max_wall_time: Some(Duration::from_millis(10)),
+    });
+    assert_eq!(
+        tracker.evaluate(started_at + Duration::from_millis(9)),
+        None
+    );
+}
+
+#[test]
+fn wall_limit_is_active_at_boundary() {
+    let (tracker, started_at) = new_tracker(RunLimits {
+        max_commands: None,
+        max_wall_time: Some(Duration::from_millis(10)),
+    });
+    assert_eq!(
+        tracker.evaluate(started_at + Duration::from_millis(10)),
+        Some(LimitReason::MaxWallTime)
+    );
+}
+
+#[test]
+fn command_limit_wins_when_both_are_active() {
+    let (mut tracker, started_at) = new_tracker(RunLimits {
+        max_commands: Some(1),
+        max_wall_time: Some(Duration::from_millis(10)),
+    });
+    tracker.record_command_started();
+    assert_eq!(
+        tracker.evaluate(started_at + Duration::from_millis(10)),
+        Some(LimitReason::MaxCommands)
+    );
+}
+
+#[test]
+fn unbounded_tracker_never_triggers() {
+    let (mut tracker, started_at) = new_tracker(RunLimits {
+        max_commands: None,
+        max_wall_time: None,
+    });
+    for _ in 0..100 {
+        tracker.record_command_started();
+    }
+    assert_eq!(
+        tracker.evaluate(started_at + Duration::from_secs(86_400)),
+        None
+    );
+}
+
+#[test]
+fn max_commands_reason_has_stable_name() {
+    assert_eq!(LimitReason::MaxCommands.as_str(), "max_commands");
+}
+
+#[test]
+fn max_wall_time_reason_has_stable_name() {
+    assert_eq!(LimitReason::MaxWallTime.as_str(), "max_wall_time");
+}
