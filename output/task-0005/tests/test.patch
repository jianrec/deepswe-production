@@ -0,0 +1,98 @@
+#[path = "support/exec_limits.rs"]
+mod support;
+
+use std::time::Duration;
+use support::MockResponsesServer;
+use support::assistant_response;
+use support::combined_output;
+use support::command_response;
+use support::run_codex;
+use support::shell_write_command;
+use support::test_home;
+
+#[test]
+fn human_output_prints_one_single_line_limit_notice() {
+    let marker_dir = tempfile::tempdir().unwrap();
+    let command = shell_write_command(&marker_dir.path().join("settled"), "yes", 20);
+    let server =
+        MockResponsesServer::start(vec![(Duration::ZERO, command_response("call-1", &command))]);
+    let home = test_home(&server, None);
+    let output = run_codex(
+        home.path(),
+        &[
+            "exec",
+            "--skip-git-repo-check",
+            "--max-commands",
+            "1",
+            "run",
+        ],
+    );
+    assert_eq!(output.status.code(), Some(7));
+    let output_text = combined_output(&output);
+    let notices: Vec<_> = output_text
+        .lines()
+        .filter(|line| line.to_ascii_lowercase().contains("run limit reached"))
+        .collect();
+    assert_eq!(notices.len(), 1);
+    assert!(!notices[0].contains('\n'));
+    assert!(notices[0].contains("max_commands"));
+}
+
+fn assert_invalid_wall_time(raw: &str) {
+    let server =
+        MockResponsesServer::start(vec![(Duration::ZERO, assistant_response("unexpected"))]);
+    let home = test_home(&server, None);
+    let option = format!("--max-wall-time={raw}");
+    let output = run_codex(
+        home.path(),
+        &[
+            "exec",
+            "--json",
+            "--skip-git-repo-check",
+            &option,
+            "must not start",
+        ],
+    );
+    assert!(!output.status.success());
+    assert_eq!(server.request_count(), 0);
+    let text = combined_output(&output).to_ascii_lowercase();
+    assert!(text.contains("max-wall-time") || text.contains("duration"));
+}
+
+#[test]
+fn cli_rejects_zero_wall_time_before_server_request() {
+    assert_invalid_wall_time("0");
+}
+
+#[test]
+fn cli_rejects_zero_millisecond_wall_time_before_server_request() {
+    assert_invalid_wall_time("0ms");
+}
+
+#[test]
+fn cli_rejects_negative_wall_time_before_server_request() {
+    assert_invalid_wall_time("-1s");
+}
+
+#[test]
+fn cli_rejects_unparseable_wall_time_before_server_request() {
+    assert_invalid_wall_time("forever");
+}
+
+#[test]
+fn config_rejects_invalid_wall_time_before_server_request() {
+    let server =
+        MockResponsesServer::start(vec![(Duration::ZERO, assistant_response("unexpected"))]);
+    let home = test_home(&server, Some("[exec]\nmax_wall_time = 'invalid'\n"));
+    let output = run_codex(
+        home.path(),
+        &["exec", "--json", "--skip-git-repo-check", "must not start"],
+    );
+    assert!(!output.status.success());
+    assert_eq!(server.request_count(), 0);
+    assert!(
+        combined_output(&output)
+            .to_ascii_lowercase()
+            .contains("max_wall_time")
+    );
+}
