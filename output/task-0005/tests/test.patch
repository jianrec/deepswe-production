+use codex_config::ExecLimits;
+use codex_exec::limits::RunLimits;
+use std::time::Duration;
+
+#[test]
+fn converts_empty_resolved_exec_limits() {
+    let converted = RunLimits::from_exec_limits(&ExecLimits {
+        max_commands: None,
+        max_wall_time: None,
+    });
+    assert_eq!(converted.max_commands, None);
+    assert_eq!(converted.max_wall_time, None);
+    assert!(converted.is_unbounded());
+}
+
+#[test]
+fn converts_resolved_command_limit() {
+    let converted = RunLimits::from_exec_limits(&ExecLimits {
+        max_commands: Some(12),
+        max_wall_time: None,
+    });
+    assert_eq!(converted.max_commands, Some(12));
+    assert_eq!(converted.max_wall_time, None);
+}
+
+#[test]
+fn converts_resolved_wall_limit() {
+    let converted = RunLimits::from_exec_limits(&ExecLimits {
+        max_commands: None,
+        max_wall_time: Some(Duration::from_millis(750)),
+    });
+    assert_eq!(converted.max_commands, None);
+    assert_eq!(converted.max_wall_time, Some(Duration::from_millis(750)));
+}
+
+#[test]
+fn converts_both_resolved_limits() {
+    let converted = RunLimits::from_exec_limits(&ExecLimits {
+        max_commands: Some(4),
+        max_wall_time: Some(Duration::from_secs(2)),
+    });
+    assert_eq!(converted.max_commands, Some(4));
+    assert_eq!(converted.max_wall_time, Some(Duration::from_secs(2)));
+}
+
+#[test]
+fn conversion_preserves_large_command_limit() {
+    let converted = RunLimits::from_exec_limits(&ExecLimits {
+        max_commands: Some(u64::MAX),
+        max_wall_time: None,
+    });
+    assert_eq!(converted.max_commands, Some(u64::MAX));
+}
+
+#[test]
+fn conversion_preserves_millisecond_precision() {
+    let converted = RunLimits::from_exec_limits(&ExecLimits {
+        max_commands: None,
+        max_wall_time: Some(Duration::from_millis(1)),
+    });
+    assert_eq!(converted.max_wall_time, Some(Duration::from_millis(1)));
+}
diff --git a/codex-rs/cli/tests/support/exec_limits.rs b/codex-rs/cli/tests/support/exec_limits.rs
new file mode 100644
index 0000000..797de7f
--- /dev/null
+++ b/codex-rs/cli/tests/support/exec_limits.rs
@@ -0,0 +1,227 @@
+use serde_json::Value;
+use serde_json::json;
+use std::fs;
+use std::io::Read;
+use std::io::Write;
+use std::net::TcpListener;
+use std::net::TcpStream;
+use std::path::Path;
+use std::path::PathBuf;
+use std::process::Command;
+use std::process::Output;
+use std::sync::Arc;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use std::thread;
+use std::time::Duration;
+use tempfile::TempDir;
+
+pub struct MockResponsesServer {
+    address: String,
+    requests: Arc<AtomicUsize>,
+    _worker: thread::JoinHandle<()>,
+}
+
+impl MockResponsesServer {
+    pub fn start(responses: Vec<(Duration, String)>) -> Self {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let address = listener.local_addr().unwrap().to_string();
+        let requests = Arc::new(AtomicUsize::new(0));
+        let request_counter = requests.clone();
+        let worker = thread::spawn(move || {
+            for stream in listener.incoming() {
+                let mut stream = stream.unwrap();
+                read_request(&mut stream);
+                let index = request_counter.fetch_add(1, Ordering::SeqCst);
+                let (delay, body) = responses
+                    .get(index)
+                    .cloned()
+                    .unwrap_or_else(|| (Duration::ZERO, assistant_response("done")));
+                thread::sleep(delay);
+                write_response(&mut stream, &body);
+            }
+        });
+        Self {
+            address,
+            requests,
+            _worker: worker,
+        }
+    }
+
+    pub fn base_url(&self) -> String {
+        format!("http://{}", self.address)
+    }
+
+    pub fn request_count(&self) -> usize {
+        self.requests.load(Ordering::SeqCst)
+    }
+}
+
+fn read_request(stream: &mut TcpStream) {
+    stream
+        .set_read_timeout(Some(Duration::from_secs(2)))
+        .unwrap();
+    let mut bytes = Vec::new();
+    let mut buffer = [0_u8; 4096];
+    loop {
+        match stream.read(&mut buffer) {
+            Ok(0) | Err(_) => break,
+            Ok(count) => {
+                bytes.extend_from_slice(&buffer[..count]);
+                if bytes.windows(4).any(|window| window == b"\r\n\r\n") {
+                    break;
+                }
+            }
+        }
+    }
+}
+
+fn write_response(stream: &mut TcpStream, body: &str) {
+    let response = format!(
+        "HTTP/1.1 200 OK\r\ncontent-type: text/event-stream\r\ncontent-length: {}\r\nconnection: close\r\n\r\n{}",
+        body.len(),
+        body
+    );
+    stream.write_all(response.as_bytes()).unwrap();
+    stream.flush().unwrap();
+}
+
+fn sse(event: Value) -> String {
+    format!("data: {}\n\n", serde_json::to_string(&event).unwrap())
+}
+
+fn completed_response(response_id: &str) -> Value {
+    json!({
+        "type": "response.completed",
+        "sequence_number": 1,
+        "response": {
+            "id": response_id,
+            "object": "response",
+            "created_at": 0,
+            "status": "completed",
+            "error": null,
+            "incomplete_details": null,
+            "instructions": null,
+            "max_output_tokens": null,
+            "model": "test-model",
+            "output": [],
+            "parallel_tool_calls": true,
+            "previous_response_id": null,
+            "reasoning": {"effort": null, "summary": null},
+            "store": false,
+            "temperature": null,
+            "text": {"format": {"type": "text"}},
+            "tool_choice": "auto",
+            "tools": [],
+            "top_p": null,
+            "truncation": "disabled",
+            "usage": null,
+            "metadata": {}
+        }
+    })
+}
+
+pub fn command_response(call_id: &str, command: &str) -> String {
+    let arguments = serde_json::to_string(&json!({"command": command})).unwrap();
+    let function_call = json!({
+        "type": "response.output_item.done",
+        "sequence_number": 0,
+        "output_index": 0,
+        "item": {
+            "id": call_id,
+            "type": "function_call",
+            "status": "completed",
+            "arguments": arguments,
+            "call_id": call_id,
+            "name": "shell_command"
+        }
+    });
+    format!(
+        "{}{}",
+        sse(function_call),
+        sse(completed_response("response-command"))
+    )
+}
+
+pub fn assistant_response(text: &str) -> String {
+    let message = json!({
+        "type": "response.output_item.done",
+        "sequence_number": 0,
+        "output_index": 0,
+        "item": {
+            "id": "message-1",
+            "type": "message",
+            "status": "completed",
+            "role": "assistant",
+            "content": [{"type": "output_text", "text": text, "annotations": []}]
+        }
+    });
+    format!(
+        "{}{}",
+        sse(message),
+        sse(completed_response("response-message"))
+    )
+}
+
+pub fn test_home(server: &MockResponsesServer, exec_table: Option<&str>) -> TempDir {
+    let home = tempfile::tempdir().unwrap();
+    let mut config = format!(
+        "model = 'test-model'\nmodel_provider = 'mock'\n[model_providers.mock]\nname = 'mock'\nbase_url = '{}'\nwire_api = 'responses'\nrequires_openai_auth = false\n",
+        server.base_url()
+    );
+    if let Some(exec_table) = exec_table {
+        config.push_str(exec_table);
+    }
+    fs::write(home.path().join("config.toml"), config).unwrap();
+    home
+}
+
+pub fn run_codex(home: &Path, arguments: &[&str]) -> Output {
+    let binary = codex_utils_cargo_bin::cargo_bin("codex").unwrap();
+    let mut command = Command::new(binary);
+    command.env("CODEX_HOME", home).env("RUST_LOG", "off");
+    if let Some((first, rest)) = arguments.split_first() {
+        command.arg(first);
+        if *first == "exec" {
+            command.args(["-s", "danger-full-access"]);
+        }
+        command.args(rest);
+    }
+    command.output().unwrap()
+}
+
+pub fn json_events(output: &Output) -> Vec<Value> {
+    String::from_utf8_lossy(&output.stdout)
+        .lines()
+        .filter_map(|line| serde_json::from_str(line).ok())
+        .collect()
+}
+
+pub fn limit_events(output: &Output) -> Vec<Value> {
+    json_events(output)
+        .into_iter()
+        .filter(|event| event["type"] == "run_limit_reached")
+        .collect()
+}
+
+pub fn combined_output(output: &Output) -> String {
+    format!(
+        "{}{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    )
+}
+
+pub fn shell_write_command(path: &Path, value: &str, delay_ms: u64) -> String {
+    format!(
+        "sh -c 'sleep {}; printf %s {} > {}'",
+        delay_ms as f64 / 1000.0,
+        value,
+        shell_quote(path)
+    )
+}
+
+fn shell_quote(path: &Path) -> String {
+    let path: PathBuf = path.to_path_buf();
+    format!("'{}'", path.display().to_string().replace('\'', "'\\''"))
+}
