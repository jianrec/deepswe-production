+use codex_config::config_toml::ConfigToml;
+use codex_config::config_toml::ExecLimitsToml;
+
+#[test]
+fn deserializes_both_exec_limit_keys() {
+    let config: ConfigToml =
+        toml::from_str("[exec]\nmax_commands = 7\nmax_wall_time = '2m'\n").unwrap();
+    let exec = config.exec.unwrap();
+    assert_eq!(exec.max_commands, Some(7));
+    assert_eq!(exec.max_wall_time.as_deref(), Some("2m"));
+}
+
+#[test]
+fn missing_exec_table_remains_none() {
+    let config: ConfigToml = toml::from_str("").unwrap();
+    assert_eq!(config.exec, None);
+}
+
+#[test]
+fn exec_limits_toml_default_has_no_limits() {
+    let exec = ExecLimitsToml::default();
+    assert_eq!(exec.max_commands, None);
+    assert_eq!(exec.max_wall_time, None);
+}
+
+#[test]
+fn rejects_string_max_commands() {
+    let result: Result<ConfigToml, _> = toml::from_str("[exec]\nmax_commands = '7'\n");
+    assert!(result.is_err());
+}
+
+#[test]
+fn rejects_integer_max_wall_time() {
+    let result: Result<ConfigToml, _> = toml::from_str("[exec]\nmax_wall_time = 7\n");
+    assert!(result.is_err());
+}
+
+#[test]
+fn exec_limits_toml_round_trips() {
+    let original = ExecLimitsToml {
+        max_commands: Some(3),
+        max_wall_time: Some("1h".to_string()),
+    };
+    let encoded = toml::to_string(&original).unwrap();
+    let decoded: ExecLimitsToml = toml::from_str(&encoded).unwrap();
+    assert_eq!(decoded, original);
+}
