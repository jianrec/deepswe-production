index 0000000..a16d9b1
--- /dev/null
+++ b/codex-rs/cli/tests/exec_limits_commands.rs
@@ -0,0 +1,138 @@
+#[path = "support/exec_limits.rs"]
+mod support;
+
+use std::fs;
+use std::time::Duration;
+use support::MockResponsesServer;
+use support::command_response;
+use support::limit_events;
+use support::run_codex;
+use support::shell_write_command;
+use support::test_home;
+
+#[test]
+fn max_commands_runner_exits_with_code_seven() {
+    let marker_dir = tempfile::tempdir().unwrap();
+    let command = shell_write_command(&marker_dir.path().join("settled"), "yes", 50);
+    let server =
+        MockResponsesServer::start(vec![(Duration::ZERO, command_response("call-1", &command))]);
+    let home = test_home(&server, None);
+    let output = run_codex(
+        home.path(),
+        &[
+            "exec",
+            "--json",
+            "--skip-git-repo-check",
+            "--max-commands",
+            "1",
+            "run one command",
+        ],
+    );
+    assert_eq!(output.status.code(), Some(7));
+}
+
+#[test]
+fn max_commands_allows_started_command_to_settle() {
+    let marker_dir = tempfile::tempdir().unwrap();
+    let marker = marker_dir.path().join("settled");
+    let command = shell_write_command(&marker, "complete", 150);
+    let server =
+        MockResponsesServer::start(vec![(Duration::ZERO, command_response("call-1", &command))]);
+    let home = test_home(&server, None);
+    let output = run_codex(
+        home.path(),
+        &[
+            "exec",
+            "--json",
+            "--skip-git-repo-check",
+            "--max-commands",
+            "1",
+            "run one command",
+        ],
+    );
+    assert_eq!(output.status.code(), Some(7));
+    assert_eq!(fs::read_to_string(marker).unwrap(), "complete");
+}
+
+#[test]
+fn max_commands_emits_exactly_one_flattened_limit_event() {
+    let marker_dir = tempfile::tempdir().unwrap();
+    let command = shell_write_command(&marker_dir.path().join("settled"), "yes", 20);
+    let server =
+        MockResponsesServer::start(vec![(Duration::ZERO, command_response("call-1", &command))]);
+    let home = test_home(&server, None);
+    let output = run_codex(
+        home.path(),
+        &[
+            "exec",
+            "--json",
+            "--skip-git-repo-check",
+            "--max-commands",
+            "1",
+            "run one command",
+        ],
+    );
+    let events = limit_events(&output);
+    assert_eq!(events.len(), 1);
+    assert_eq!(events[0]["type"], "run_limit_reached");
+    assert_eq!(events[0]["reason"], "max_commands");
+    assert_eq!(events[0]["commands_started"], 1);
+    assert_eq!(events[0]["max_commands"], 1);
+    assert!(events[0]["elapsed_ms"].is_u64());
+    assert!(events[0]["max_wall_time_ms"].is_null());
+}
+
+#[test]
+fn max_commands_interrupts_before_another_command_starts() {
+    let marker_dir = tempfile::tempdir().unwrap();
+    let first = shell_write_command(&marker_dir.path().join("first"), "yes", 20);
+    let second = shell_write_command(&marker_dir.path().join("second"), "no", 20);
+    let server = MockResponsesServer::start(vec![
+        (Duration::ZERO, command_response("call-1", &first)),
+        (Duration::ZERO, command_response("call-2", &second)),
+    ]);
+    let home = test_home(&server, None);
+    let output = run_codex(
+        home.path(),
+        &[
+            "exec",
+            "--json",
+            "--skip-git-repo-check",
+            "--max-commands",
+            "1",
+            "run commands",
+        ],
+    );
+    assert_eq!(output.status.code(), Some(7));
+    assert!(marker_dir.path().join("first").exists());
+    assert!(!marker_dir.path().join("second").exists());
+    assert_eq!(server.request_count(), 1);
+}
+
+#[test]
+fn command_reason_wins_when_wall_time_also_elapsed() {
+    let marker_dir = tempfile::tempdir().unwrap();
+    let command = shell_write_command(&marker_dir.path().join("settled"), "yes", 5200);
+    let server =
+        MockResponsesServer::start(vec![(Duration::ZERO, command_response("call-1", &command))]);
+    let home = test_home(&server, None);
+    let output = run_codex(
+        home.path(),
+        &[
+            "exec",
+            "--json",
+            "--skip-git-repo-check",
+            "--max-commands",
+            "1",
+            "--max-wall-time",
+            "5s",
+            "run one command",
+        ],
+    );
+    let events = limit_events(&output);
+    assert_eq!(output.status.code(), Some(7));
+    assert_eq!(events.len(), 1);
+    assert_eq!(events[0]["reason"], "max_commands");
+    assert_eq!(events[0]["max_commands"], 1);
+    assert_eq!(events[0]["max_wall_time_ms"], 5000);
+}
