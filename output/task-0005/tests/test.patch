+use codex_config::config_toml::parse_wall_time;
+use std::time::Duration;
+
+#[test]
+fn parses_bare_integer_as_seconds() {
+    assert_eq!(parse_wall_time("30").unwrap(), Duration::from_secs(30));
+}
+
+#[test]
+fn parses_one_bare_second() {
+    assert_eq!(parse_wall_time("1").unwrap(), Duration::from_secs(1));
+}
+
+#[test]
+fn parses_millisecond_suffix() {
+    assert_eq!(
+        parse_wall_time("500ms").unwrap(),
+        Duration::from_millis(500)
+    );
+}
+
+#[test]
+fn parses_one_millisecond() {
+    assert_eq!(parse_wall_time("1ms").unwrap(), Duration::from_millis(1));
+}
+
+#[test]
+fn parses_seconds_suffix() {
+    assert_eq!(parse_wall_time("90s").unwrap(), Duration::from_secs(90));
+}
+
+#[test]
+fn parses_minutes_suffix() {
+    assert_eq!(parse_wall_time("10m").unwrap(), Duration::from_secs(600));
+}
+
+#[test]
+fn parses_hours_suffix() {
+    assert_eq!(parse_wall_time("2h").unwrap(), Duration::from_secs(7200));
+}
+
+#[test]
+fn rejects_empty_duration() {
+    assert!(parse_wall_time("").is_err());
+}
+
+#[test]
+fn rejects_whitespace_only_duration() {
+    assert!(parse_wall_time("   ").is_err());
+}
+
+#[test]
+fn rejects_zero_bare_seconds() {
+    assert!(parse_wall_time("0").is_err());
+}
+
+#[test]
+fn rejects_zero_milliseconds() {
+    assert!(parse_wall_time("0ms").is_err());
+}
+
+#[test]
+fn rejects_zero_suffixed_seconds() {
+    assert!(parse_wall_time("0s").is_err());
+}
+
+#[test]
+fn rejects_negative_duration() {
+    assert!(parse_wall_time("-1s").is_err());
+}
+
+#[test]
+fn rejects_decimal_duration() {
+    assert!(parse_wall_time("1.5s").is_err());
+}
+
+#[test]
+fn rejects_unknown_suffix() {
+    assert!(parse_wall_time("3d").is_err());
+}
+
+#[test]
+fn rejects_suffix_without_number() {
+    assert!(parse_wall_time("ms").is_err());
+}
+
+#[test]
+fn rejects_non_numeric_duration() {
+    assert!(parse_wall_time("forever").is_err());
+}
+
+#[test]
+fn rejects_overflowing_hours() {
+    assert!(parse_wall_time("18446744073709551615h").is_err());
+}
