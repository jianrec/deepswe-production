+#[path = "support/exec_limits.rs"]
+mod support;
+
+use std::time::Duration;
+use std::time::Instant;
+use support::MockResponsesServer;
+use support::assistant_response;
+use support::limit_events;
+use support::run_codex;
+use support::test_home;
+
+#[test]
+fn max_wall_time_stops_while_runner_waits_for_response() {
+    let server =
+        MockResponsesServer::start(vec![(Duration::from_secs(30), assistant_response("late"))]);
+    let home = test_home(&server, None);
+    let started = Instant::now();
+    let output = run_codex(
+        home.path(),
+        &[
+            "exec",
+            "--json",
+            "--skip-git-repo-check",
+            "--max-wall-time",
+            "100ms",
+            "wait",
+        ],
+    );
+    assert_eq!(output.status.code(), Some(7));
+    assert!(started.elapsed() < Duration::from_secs(30));
+}
+
+#[test]
+fn max_wall_time_emits_exactly_one_wall_limit_event() {
+    let server =
+        MockResponsesServer::start(vec![(Duration::from_secs(2), assistant_response("late"))]);
+    let home = test_home(&server, None);
+    let output = run_codex(
+        home.path(),
+        &[
+            "exec",
+            "--json",
+            "--skip-git-repo-check",
+            "--max-wall-time",
+            "100ms",
+            "wait",
+        ],
+    );
+    let events = limit_events(&output);
+    assert_eq!(events.len(), 1);
+    assert_eq!(events[0]["reason"], "max_wall_time");
+    assert_eq!(events[0]["commands_started"], 0);
+    assert_eq!(events[0]["max_wall_time_ms"], 100);
+    assert!(events[0]["max_commands"].is_null());
+    assert!(events[0]["elapsed_ms"].as_u64().unwrap() >= 100);
+}
+
+#[test]
+fn bare_seconds_wall_time_is_accepted_by_cli() {
+    let server = MockResponsesServer::start(vec![(Duration::ZERO, assistant_response("done"))]);
+    let home = test_home(&server, None);
+    let output = run_codex(
+        home.path(),
+        &[
+            "exec",
+            "--json",
+            "--skip-git-repo-check",
+            "--max-wall-time",
+            "30",
+            "finish",
+        ],
+    );
+    assert_eq!(output.status.code(), Some(0));
+    assert!(limit_events(&output).is_empty());
+}
